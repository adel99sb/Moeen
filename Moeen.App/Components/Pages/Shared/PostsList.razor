@using Moeen.App.Services.Abstractions
@using Moeen.Shared.Constants
@using Moeen.Shared.Responses.ContentSharing
@inject IContentShaeringService ContentShaeringService

<style>
    .mobile-posts-wrapper {
        direction: rtl;
        text-align: right;
        background-color: #f4f7f6;
        min-height: 100vh;
        padding-bottom: 2.5rem;
    }

    .mobile-posts-header {
        background-color: #195042;
        color: #d6cabc;
        padding: 2rem 1rem;
        border-bottom: 6px solid #d6cabc;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .mobile-posts-container {
        padding: 0 1rem;
    }

    .mobile-post-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        margin-bottom: 1rem;
    }

    .mobile-post-image {
        background: linear-gradient(135deg, #195042 0%, #246b59 100%);
        height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #d6cabc;
        font-size: 2rem;
        font-weight: 700;
    }

    .mobile-post-content {
        padding: 1.25rem;
    }

    .mobile-post-title {
        color: #195042;
        font-weight: 700;
        font-size: 1.15rem;
        margin-bottom: .6rem;
    }

    .mobile-post-body {
        color: #5a6c7d;
        font-size: .95rem;
        line-height: 1.7;
        white-space: pre-wrap;
    }

    .mobile-post-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 1rem;
        border-top: 2px solid #d6cabc;
        margin-top: 1rem;
        color: #195042;
        font-weight: 600;
    }

    .mobile-post-actions {
        display: flex;
        gap: .5rem;
        margin-top: 1rem;
    }

    .mobile-post-action-btn {
        flex: 1;
        border: 1px solid #d6cabc;
        border-radius: 12px;
        background: #fff;
        color: #195042;
        padding: .65rem .5rem;
        font-weight: 700;
    }

    .mobile-post-action-btn.active {
        background: #195042;
        color: #d6cabc;
        border-color: #195042;
    }

    .mobile-post-action-btn:disabled {
        opacity: .65;
    }

    .mobile-post-error {
        color: #842029;
        font-size: .85rem;
        margin-top: .75rem;
    }

    .mobile-state-box {
        background: #fff;
        border-radius: 16px;
        padding: 1.5rem;
        text-align: center;
        color: #195042;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    .mobile-error-box {
        color: #842029;
        background: #f8d7da;
        border: 1px solid #f5c2c7;
    }
</style>

<div class="mobile-posts-wrapper">
    <header class="mobile-posts-header">
        <h1>@Title</h1>
        <p class="mb-0">@Subtitle</p>
    </header>

    <div class="mobile-posts-container">
        @if (isLoading)
        {
            <div class="mobile-state-box">
                <div class="spinner-border text-success" role="status"></div>
                <p class="mt-3 mb-0">جاري تحميل المنشورات...</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="mobile-state-box mobile-error-box">
                <p class="mb-3">@errorMessage</p>
                <button class="btn btn-sm btn-outline-danger" @onclick="LoadPostsAsync">إعادة المحاولة</button>
            </div>
        }
        else if (posts.Count == 0)
        {
            <div class="mobile-state-box">
                لا توجد منشورات حالياً.
            </div>
        }
        else
        {
            @foreach (var post in posts)
            {
                var isInteracted = interactedPostIds.Contains(post.Id);
                var isBusy = busyPostIds.Contains(post.Id);
                interactionErrors.TryGetValue(post.Id, out var postError);

                <article class="mobile-post-card" @key="post.Id">
                    <div class="mobile-post-image">مُعين</div>
                    <div class="mobile-post-content">
                        <h3 class="mobile-post-title">@SafeTitle(post)</h3>
                        <p class="mobile-post-body">@SafeBody(post)</p>
                        <div class="mobile-post-footer">
                            <span>@GetDisplayedInteractionCount(post) تفاعل</span>
                            <span>@(post.IsAnnouncement ? "إعلان" : "منشور")</span>
                        </div>
                        <div class="mobile-post-actions">
                            <button class="mobile-post-action-btn @(isInteracted ? "active" : string.Empty)"
                                    disabled="@isBusy"
                                    @onclick="() => ToggleInteractionAsync(post)">
                                @(isInteracted ? "تم التفاعل" : "أعجبني")
                            </button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(postError))
                        {
                            <div class="mobile-post-error">@postError</div>
                        }
                    </div>
                </article>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "الإعلانات";

    [Parameter]
    public string Subtitle { get; set; } = "متابعة آخر الإعلانات والفرص المتاحة لدى مُعين";

    private bool isLoading = true;
    private string? errorMessage;
    private List<PostDto> posts = new();
    private readonly HashSet<Guid> interactedPostIds = new();
    private readonly HashSet<Guid> busyPostIds = new();
    private readonly Dictionary<Guid, string> interactionErrors = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadPostsAsync();
    }

    private async Task LoadPostsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            posts = await ContentShaeringService.GetAllAsync();
        }
        catch (Exception ex)
        {
            posts = new List<PostDto>();
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleInteractionAsync(PostDto post)
    {
        if (busyPostIds.Contains(post.Id))
            return;

        busyPostIds.Add(post.Id);
        interactionErrors.Remove(post.Id);

        var wasInteracted = interactedPostIds.Contains(post.Id);
        ApplyLocalInteractionState(post, !wasInteracted);

        try
        {
            await ContentShaeringService.InteractAsync(post.Id, InteractionType.Like);
        }
        catch (Exception ex)
        {
            ApplyLocalInteractionState(post, wasInteracted);
            interactionErrors[post.Id] = ex.Message;
        }
        finally
        {
            busyPostIds.Remove(post.Id);
        }
    }

    private void ApplyLocalInteractionState(PostDto post, bool shouldBeInteracted)
    {
        if (shouldBeInteracted)
        {
            if (interactedPostIds.Add(post.Id))
                post.InteractionsCount++;
        }
        else
        {
            if (interactedPostIds.Remove(post.Id) && post.InteractionsCount > 0)
                post.InteractionsCount--;
        }
    }

    private int GetDisplayedInteractionCount(PostDto post)
        => Math.Max(0, post.InteractionsCount);

    private static string SafeTitle(PostDto post)
        => string.IsNullOrWhiteSpace(post.Title) ? "منشور بدون عنوان" : post.Title;

    private static string SafeBody(PostDto post)
        => string.IsNullOrWhiteSpace(post.Body) ? "لا يوجد محتوى لهذا المنشور." : post.Body;
}
