@using Moeen.App.Services.Abstractions
@using Moeen.Shared.Constants
@using Moeen.Shared.Responses.ContentSharing
@using System.Globalization
@inject IContentShaeringService ContentShaeringService

<style>
    .mobile-posts-wrapper {
        direction: rtl;
        text-align: right;
        background-color: #f4f7f6;
        min-height: 100vh;
        padding-bottom: 2.5rem;
    }

    .mobile-posts-header {
        background: linear-gradient(135deg, #195042 0%, #24705d 100%);
        color: #ffffff;
        padding: 2rem 1rem;
        border-bottom: 6px solid #d6cabc;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .mobile-posts-header p {
        color: #d6cabc;
    }

    .mobile-posts-container {
        padding: 0 1rem;
    }

    .mobile-post-toolbar,
    .mobile-post-card,
    .mobile-state-box {
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    .mobile-post-toolbar {
        padding: 1rem;
        margin-bottom: 1rem;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: .65rem;
    }

    .mobile-search-input {
        border: 1px solid #d6cabc;
        border-radius: 12px;
        padding: .8rem 1rem;
        color: #195042;
        outline: none;
        background: #fafbfb;
        width: 100%;
    }

    .mobile-refresh-btn,
    .mobile-post-action-btn {
        border: 1px solid #d6cabc;
        border-radius: 12px;
        background: #ffffff;
        color: #195042;
        padding: .7rem 1rem;
        font-weight: 800;
    }

    .mobile-refresh-btn:hover,
    .mobile-post-action-btn.active {
        background: #195042;
        color: #d6cabc;
        border-color: #195042;
    }

    .mobile-refresh-btn:disabled,
    .mobile-post-action-btn:disabled {
        opacity: .65;
    }

    .mobile-post-card {
        overflow: hidden;
        margin-bottom: 1rem;
    }

    .mobile-post-image {
        background: linear-gradient(135deg, #195042 0%, #246b59 100%);
        height: 135px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #d6cabc;
        font-size: 2.4rem;
        font-weight: 700;
        overflow: hidden;
    }

    .mobile-post-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .mobile-post-content {
        padding: 1.25rem;
    }

    .mobile-post-title {
        color: #195042;
        font-weight: 900;
        font-size: 1.15rem;
        margin-bottom: .6rem;
    }

    .mobile-post-body {
        color: #5a6c7d;
        font-size: .95rem;
        line-height: 1.75;
        white-space: pre-wrap;
    }

    .mobile-post-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .75rem;
        flex-wrap: wrap;
        padding-top: 1rem;
        border-top: 2px solid #d6cabc;
        margin-top: 1rem;
        color: #195042;
        font-weight: 700;
        font-size: .88rem;
    }

    .mobile-post-badge {
        display: inline-flex;
        border-radius: 999px;
        padding: .25rem .7rem;
        background: rgba(25,80,66,.12);
        color: #195042;
        font-size: .8rem;
        font-weight: 800;
    }

    .mobile-post-actions {
        display: flex;
        gap: .5rem;
        margin-top: 1rem;
    }

    .mobile-post-action-btn {
        flex: 1;
    }

    .mobile-post-error {
        color: #842029;
        background: #f8d7da;
        border: 1px solid #f5c2c7;
        border-radius: 10px;
        padding: .55rem .75rem;
        font-size: .85rem;
        margin-top: .75rem;
    }

    .mobile-state-box {
        padding: 1.5rem;
        text-align: center;
        color: #195042;
    }

    .mobile-error-box {
        color: #842029;
        background: #f8d7da;
        border: 1px solid #f5c2c7;
    }

    @@media (max-width: 720px) {
        .mobile-post-toolbar {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="mobile-posts-wrapper">
    <header class="mobile-posts-header">
        <h1>@Title</h1>
        <p class="mb-0">@Subtitle</p>
    </header>

    <div class="mobile-posts-container">
        @if (ShowSearch)
        {
            <section class="mobile-post-toolbar">
                <input class="mobile-search-input" placeholder="ابحث في المنشورات..." @bind="searchText" @bind:event="oninput" />
                <button class="mobile-refresh-btn" @onclick="LoadPostsAsync" disabled="@isLoading">
                    <i class="bi bi-arrow-clockwise ms-1"></i>تحديث
                </button>
            </section>
        }

        @if (isLoading)
        {
            <div class="mobile-state-box">
                <div class="spinner-border text-success" role="status"></div>
                <p class="mt-3 mb-0">جاري تحميل المنشورات...</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="mobile-state-box mobile-error-box">
                <p class="mb-3">@errorMessage</p>
                <button class="mobile-refresh-btn" @onclick="LoadPostsAsync">إعادة المحاولة</button>
            </div>
        }
        else if (!FilteredPosts.Any())
        {
            <div class="mobile-state-box">
                <i class="bi bi-megaphone fs-2 d-block mb-2"></i>
                لا توجد منشورات متاحة حالياً.
            </div>
        }
        else
        {
            @foreach (var post in FilteredPosts)
            {
                var isInteracted = interactedPostIds.Contains(post.Id);
                var isBusy = busyPostIds.Contains(post.Id);
                interactionErrors.TryGetValue(post.Id, out var postError);

                <article class="mobile-post-card" @key="post.Id">
                    <div class="mobile-post-image">
                        @if (!string.IsNullOrWhiteSpace(post.ImageUrl))
                        {
                            <img src="@post.ImageUrl" alt="@SafeTitle(post)" />
                        }
                        else
                        {
                            <i class="bi bi-megaphone-fill"></i>
                        }
                    </div>
                    <div class="mobile-post-content">
                        <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap mb-2">
                            <h3 class="mobile-post-title mb-0">@SafeTitle(post)</h3>
                            <span class="mobile-post-badge">@(post.IsAnnouncement ? "إعلان عام" : "منشور حلقة")</span>
                        </div>

                        <p class="mobile-post-body">@SafeBody(post)</p>

                        <div class="mobile-post-footer">
                            <span><i class="bi bi-calendar3 ms-1"></i>@FormatDate(post.CreatedAt)</span>
                            <span><i class="bi bi-building ms-1"></i>@Fallback(post.MosqueName, "مسجد غير محدد")</span>
                            <span><i class="bi bi-chat-square-text ms-1"></i>@Fallback(post.HalqaName, post.IsAnnouncement ? "كل الحلقات" : "حلقة غير محددة")</span>
                            <span><i class="bi bi-heart-fill ms-1"></i>@GetDisplayedInteractionCount(post) إعجاب</span>
                        </div>

                        @if (AllowInteractions)
                        {
                            <div class="mobile-post-actions">
                                <button class="mobile-post-action-btn @(isInteracted ? "active" : string.Empty)"
                                        disabled="@isBusy"
                                        @onclick="() => ToggleInteractionAsync(post)">
                                    @(isInteracted ? "تم الإعجاب" : "إعجاب")
                                </button>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(postError))
                        {
                            <div class="mobile-post-error">@postError</div>
                        }
                    </div>
                </article>
            }
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "المنشورات";
    [Parameter] public string Subtitle { get; set; } = "آخر الإعلانات والمنشورات المتاحة.";
    [Parameter] public bool AllowInteractions { get; set; }
    [Parameter] public bool ShowSearch { get; set; } = true;

    private bool isLoading = true;
    private string? errorMessage;
    private string searchText = string.Empty;
    private List<PostDto> posts = new();
    private readonly HashSet<Guid> interactedPostIds = new();
    private readonly HashSet<Guid> busyPostIds = new();
    private readonly Dictionary<Guid, string> interactionErrors = new();

    private IEnumerable<PostDto> FilteredPosts
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchText))
                return posts;

            var term = searchText.Trim();
            return posts.Where(post =>
                Contains(post.Title, term) ||
                Contains(post.Body, term) ||
                Contains(post.MosqueName, term) ||
                Contains(post.HalqaName, term));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPostsAsync();
    }

    private async Task LoadPostsAsync()
    {
        isLoading = true;
        errorMessage = null;
        interactionErrors.Clear();

        try
        {
            posts = await ContentShaeringService.GetAllAsync();
        }
        catch (Exception ex)
        {
            posts = new List<PostDto>();
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleInteractionAsync(PostDto post)
    {
        if (!AllowInteractions || busyPostIds.Contains(post.Id))
            return;

        busyPostIds.Add(post.Id);
        interactionErrors.Remove(post.Id);

        var wasInteracted = interactedPostIds.Contains(post.Id);
        ApplyLocalInteractionState(post, !wasInteracted);

        try
        {
            await ContentShaeringService.InteractAsync(post.Id, InteractionType.Like);
        }
        catch (Exception ex)
        {
            ApplyLocalInteractionState(post, wasInteracted);
            interactionErrors[post.Id] = ex.Message;
        }
        finally
        {
            busyPostIds.Remove(post.Id);
        }
    }

    private void ApplyLocalInteractionState(PostDto post, bool shouldBeInteracted)
    {
        if (shouldBeInteracted)
        {
            if (interactedPostIds.Add(post.Id))
                post.InteractionsCount++;
        }
        else
        {
            if (interactedPostIds.Remove(post.Id) && post.InteractionsCount > 0)
                post.InteractionsCount--;
        }
    }

    private static int GetDisplayedInteractionCount(PostDto post)
        => Math.Max(0, post.InteractionsCount);

    private static string SafeTitle(PostDto post)
        => Fallback(post.Title, "منشور بدون عنوان");

    private static string SafeBody(PostDto post)
        => Fallback(post.Body, "لا يوجد محتوى لهذا المنشور.");

    private static string Fallback(string? value, string fallback)
        => string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static bool Contains(string? source, string term)
        => !string.IsNullOrWhiteSpace(source) && source.Contains(term, StringComparison.OrdinalIgnoreCase);

    private static string FormatDate(DateTime date)
        => date == default ? "غير محدد" : date.ToString("yyyy/MM/dd", CultureInfo.InvariantCulture);
}
