@page "/Guest/Post"
@using Moeen.App.Services.Abstractions
@using Moeen.Shared.Responses.ContentSharing

@inject IContentShaeringService ContentShaeringService
@inject NavigationManager mgr

<style>
    /* 1. متغيرات الصفحة (مركزية بالكامل للألوان، الخطوط، والأحجام) */
    :root {
        --color-primary-green: #195042;
        --color-luxury-beige: #d6cabc;
        --color-bg-light: #f4f7f6;
        --color-white: #ffffff;
        --color-text-muted: #5a6c7d;
        --shadow-card: 0 10px 30px rgba(0, 0, 0, 0.08);
        --shadow-card-hover: 0 14px 35px rgba(0, 0, 0, 0.12);
        --radius-card: 20px;
        --font-base: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        --spacing-sm: 0.6rem;
        --spacing-md: 1rem;
        --spacing-lg: 1.5rem;
        --transition-base: 0.3s ease;
    }

    /* 2. حاوية الصفحة */
    .ads-wrapper {
        direction: rtl;
        text-align: right;
        font-family: var(--font-base);
        background-color: var(--color-bg-light);
        padding-bottom: 2.5rem;
        min-height: 100vh;
    }

    /* 3. الترويسة */
    .header-custom {
        background-color: var(--color-primary-green);
        color: var(--color-luxury-beige);
        padding: 2.5rem 0;
        border-bottom: 6px solid var(--color-luxury-beige);
        margin-bottom: 2.5rem;
        width: 100%;
        margin-top: 0;
    }

    /* 4. تصميم كارد الإعلان */
    .ad-card {
        background: var(--color-white);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card);
        overflow: hidden;
        transition: transform var(--transition-base), box-shadow var(--transition-base);
        height: 100%;
        border: none;
        display: flex;
        flex-direction: column;
    }

        .ad-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-card-hover);
        }

    /* 5. منطقة صورة الإعلان */
    .ad-image {
        background: linear-gradient(135deg, var(--color-primary-green) 0%, #246b59 100%);
        height: 160px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

        .ad-image::after {
            content: '';
            position: absolute;
            width: 140px;
            height: 140px;
            background: rgba(214, 202, 188, 0.15);
            border-radius: 50%;
            top: -30px;
            right: -30px;
            z-index: 1;
            pointer-events: none;
        }

        .ad-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
            transition: transform var(--transition-base);
        }

    .ad-card:hover .ad-image img {
        transform: scale(1.05);
    }

    /* 6. محتوى الكارد */
    .ad-content {
        padding: var(--spacing-lg);
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .ad-title {
        color: var(--color-primary-green);
        font-weight: 700;
        font-size: 1.25rem;
        margin-bottom: var(--spacing-sm);
    }

    .ad-desc {
        color: var(--color-text-muted);
        font-size: 0.92rem;
        line-height: 1.65;
        margin-bottom: var(--spacing-md);
        flex-grow: 1;
    }

    /* 7. تذييل الكارد (التاريخ) */
    .ad-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: var(--spacing-md);
        border-top: 2px solid var(--color-luxury-beige);
        margin-top: auto;
    }

    .ad-date {
        font-size: 0.88rem;
        color: var(--color-primary-green);
        font-weight: 600;
    }

    /* 8. أزرار التفاعل (مضافة حديثاً وتعتمد على المتغيرات فقط) */
    .ad-actions {
        display: flex;
        gap: var(--spacing-sm);
        margin-top: var(--spacing-md);
    }

    .ad-action-btn {
        flex: 1;
        padding: var(--spacing-sm) 0;
        border: 1px solid var(--color-luxury-beige);
        border-radius: 10px;
        background-color: transparent;
        color: var(--color-text-muted);
        font-size: 0.85rem;
        font-weight: 600;
        font-family: var(--font-base);
        cursor: pointer;
        transition: all var(--transition-base);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
    }

        .ad-action-btn:hover {
            background-color: var(--color-bg-light);
            color: var(--color-primary-green);
            border-color: var(--color-primary-green);
        }

    /* 9. تحسينات التجاوب */
    @@media (max-width: 768px) {
        .header-custom {
            padding: 2rem 0;
            margin-bottom: 2rem;
        }

        .ad-image {
            height: 140px;
        }

        .ad-content {
            padding: 1.2rem;
        }
    }
    /* === بداية إضافة تفاعل أزرار الإعجاب (بدون تعديل الهيكل) === */

    /* زر "أعجبني" (الزر الأول داخل .ad-actions) عند الضغط أو التركيز */
    .ad-actions .ad-action-btn:first-of-type:active,
    .ad-actions .ad-action-btn:first-of-type:focus {
        background-color: var(--color-primary-green) !important;
        color: var(--color-luxury-beige) !important;
        border-color: var(--color-primary-green) !important;
        outline: none;
    }

    /* زر "لم يعجبني" (الزر الثاني داخل .ad-actions) عند الضغط أو التركيز */
    .ad-actions .ad-action-btn:last-of-type:active,
    .ad-actions .ad-action-btn:last-of-type:focus {
        background-color: #b8a99a !important; /* درجة أغمق من --color-luxury-beige */
        color: var(--color-white) !important;
        border-color: #b8a99a !important;
        outline: none;
    }

    /* الحفاظ على التأثير عند استخدام لوحة المفاتيح (إمكانية الوصول) */
    .ad-actions .ad-action-btn:focus-visible {
        box-shadow: 0 0 0 3px rgba(25, 80, 66, 0.3);
    }
    /* === نهاية الإضافة === */

</style>
<!-- الترويسة المطلوبة -->
<header class="header-custom text-center">

    <h1 class="fw-bold">الإعلانات</h1>
    <p class="mb-0"> متابعة آخر الإعلانات والفرص المتاحة لدى معين</p>

</header>


<div class="ads-wrapper">

    <!-- شبكة الإعلانات (كاردان في كل صف) -->
    <div class="container">
        <div class="row g-4">

            @foreach (var item in data)
            {
                <div class="col-lg-6 col-md-12">
                    <article class="ad-card">
                        <div class="ad-image">
                            <img src="@item.ImageUrl" loading="lazy">
                        </div>
                        <div class="ad-content">
                            <h3 class="ad-title">@item.Title</h3>
                            <p class="ad-desc">@item.Body</p>
                            <div class="ad-footer">
                                <span class="ad-date"><i class="bi bi-calendar-event me-2"></i>@item.CreatedAt</span>
                            </div>
                            <div class="ad-actions">
                                <button class="ad-action-btn"><i class="bi bi-hand-thumbs-up"></i> أعجبني</button>
                                <button class="ad-action-btn"><i class="bi bi-hand-thumbs-down"></i> لم يعجبني</button>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<PostDto> data = new List<PostDto>();
    protected override async Task OnInitializedAsync()
    {

        await LoadDataAsync();
    }
    private async Task LoadDataAsync()
    {
        try
        {
            data = await ContentShaeringService.GetAllAsync();
        }
        catch (Exception ex)
        {
            
            throw new Exception(ex.Message);
        }
    }
}
