@page "/Student/StudentDashboard"
@using Moeen.App.Services.Abstractions
@using Moeen.Shared.Responses.Mobile
@inject IStudentDashboardService DashboardService
@inject AppSessionService AppSession
@inject NavigationManager Navigation

<style>
    :root {
        --theme-primary: #195042;
        --theme-beige-light: #F4F1E8;
        --theme-beige-medium: #EAE6D9;
        --theme-bg-page: #F5F7FA;
        --theme-gradient-primary: linear-gradient(135deg, #195042 0%, #24705D 100%);
        --theme-gradient-beige: linear-gradient(145deg, #ffffff 0%, #F4F1E8 100%);
        --theme-gradient-accent: linear-gradient(90deg, #195042 0%, #EAE6D9 100%);
        --theme-shadow-sm: 0 2px 8px rgba(25, 80, 66, 0.06);
        --theme-shadow-md: 0 6px 16px rgba(25, 80, 66, 0.09);
        --theme-shadow-lg: 0 10px 24px rgba(25, 80, 66, 0.12);
        --theme-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .dashboard-wrapper {
        direction: rtl;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        background-color: var(--theme-bg-page);
        min-height: 100vh;
        padding: 0.8rem 0 2rem;
    }

    .dashboard-card {
        background: var(--theme-gradient-beige);
        border: 1px solid var(--theme-beige-medium);
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--theme-shadow-md);
        transition: var(--theme-transition);
    }

    .dashboard-card:hover {
        box-shadow: var(--theme-shadow-lg);
        transform: translateY(-2px);
    }

    .dashboard-card .card-header {
        background: var(--theme-gradient-primary);
        border-bottom: none;
        padding: 1rem 1.25rem;
        color: #ffffff;
    }

    .dashboard-card .card-header h5 {
        margin: 0;
        font-weight: 600;
        font-size: 1.1rem;
    }

    .stat-box {
        background: var(--theme-gradient-beige);
        border: 1px solid var(--theme-beige-medium);
        border-radius: 0.85rem;
        padding: 1.5rem 1rem;
        position: relative;
        transition: var(--theme-transition);
    }

    .stat-box::after {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 100%;
        height: 4px;
        background: var(--theme-gradient-accent);
        border-radius: 0.85rem 0.85rem 0 0;
    }

    .stat-box:hover {
        transform: translateY(-4px);
        border-color: var(--theme-primary);
        box-shadow: var(--theme-shadow-lg);
    }

    .icon-wrapper {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--theme-primary);
        font-size: 1.5rem;
        transition: var(--theme-transition);
    }

    .stat-box:hover .icon-wrapper {
        transform: scale(1.05);
    }

    .stat-value {
        color: var(--theme-primary);
        font-weight: 700;
        font-size: 1.25rem;
    }

    .activity-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.85rem 0;
        border-bottom: 1px solid var(--theme-beige-medium);
    }

    .activity-item:last-child { border-bottom: none; }

    .status-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 2rem;
        font-size: 0.75rem;
        font-weight: 600;
        white-space: nowrap;
        background-color: var(--theme-beige-light);
        color: var(--theme-primary);
        border: 1px solid var(--theme-beige-medium);
        transition: var(--theme-transition);
    }

    .status-badge.active {
        background-color: #d1fae5;
        color: #065f46;
        border-color: #a7f3d0;
    }

    .status-badge.inactive {
        background-color: #fee2e2;
        color: #991b1b;
        border-color: #fecaca;
    }

    details summary {
        cursor: pointer;
        list-style: none;
        user-select: none;
        color: var(--theme-primary);
        font-weight: 600;
    }

    details summary::-webkit-details-marker { display: none; }
    .toggle-icon { transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    details[open] .toggle-icon { transform: rotate(180deg); }

    .logo-container {
        text-align: center;
        margin: 0.2rem 0 0.6rem;
    }

    .logo-container img {
        width: 110px;
        height: auto;
        object-fit: contain;
        transition: var(--theme-transition);
    }

    .student-greeting {
        color: var(--theme-primary);
        font-weight: 700;
        text-align: center;
        margin-bottom: 0.85rem;
        font-size: 1rem;
    }

    .dashboard-state-card {
        background: #ffffff;
        border: 1px solid var(--theme-beige-medium);
        border-radius: 1rem;
        box-shadow: var(--theme-shadow-md);
        color: var(--theme-primary);
        margin: 1rem;
        padding: 1.25rem;
        text-align: center;
    }

    .refresh-btn {
        border: none;
        border-radius: 999px;
        background: var(--theme-gradient-primary);
        color: #ffffff;
        padding: 0.55rem 1rem;
        font-weight: 700;
    }

    .empty-state {
        color: #6b7280;
        font-size: 0.9rem;
        padding: 0.75rem 0;
        text-align: center;
    }

    .icon-success { color: #198754; }
    .icon-danger { color: #dc3545; }
    .icon-gold { color: #b8860b; }
    .icon-green { color: #28a745; }
    .icon-primary-custom { color: var(--theme-primary); }
</style>

<div class="container-fluid dashboard-wrapper">
    <div class="logo-container">
        <img src="/image/LOGO.svg" alt="شعار الموقع" />
    </div>

    @if (_loading)
    {
        <div class="dashboard-state-card">
            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
            جاري تحميل الصفحة الرئيسية...
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="dashboard-state-card">
            <div class="mb-3">@_error</div>
            <button type="button" class="refresh-btn" @onclick="LoadDashboardAsync">
                <i class="bi bi-arrow-clockwise me-1"></i>
                إعادة المحاولة
            </button>
        </div>
    }
    else if (_dashboard is not null)
    {
        <div class="student-greeting">
            أهلاً @_dashboard.StudentName، هذه آخر بياناتك التعليمية
        </div>

        <div class="dashboard-card mb-4">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-speedometer2 fs-5"></i>
                <h5>الإحصائيات الأخيرة</h5>
            </div>
            <div class="card-body p-3">
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <div class="stat-box text-center h-100">
                            <div class="icon-wrapper mb-2 mx-auto"><i class="bi bi-trophy-fill"></i></div>
                            <div class="small text-muted mb-1">مجموع النقاط</div>
                            <div class="stat-value">@FormatNumber(_dashboard.Stats.TotalPoints)</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-box text-center h-100">
                            <div class="icon-wrapper mb-2 mx-auto"><i class="bi bi-book"></i></div>
                            <div class="small text-muted mb-1">إجمالي التسميعات</div>
                            <div class="stat-value">@FormatNumber(_dashboard.Stats.TotalMemorizations)</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-box text-center h-100">
                            <div class="icon-wrapper mb-2 mx-auto"><i class="bi bi-arrow-counterclockwise"></i></div>
                            <div class="small text-muted mb-1">المراجعات المنجزة</div>
                            <div class="stat-value">@_dashboard.Stats.CompletedReviewJuzCount جزء</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-box text-center h-100">
                            <div class="icon-wrapper mb-2 mx-auto"><i class="bi bi-clipboard-check"></i></div>
                            <div class="small text-muted mb-1">الاختبارات المنجزة</div>
                            <div class="stat-value">@FormatNumber(_dashboard.Stats.CompletedExamsCount)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="dashboard-card mb-4">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-journal-text fs-5"></i>
                <h5>الواجب اليومي</h5>
            </div>
            <div class="card-body p-3">
                <details open>
                    <summary class="d-flex align-items-center justify-content-between py-2">
                        <span><i class="bi bi-list-task me-2"></i> عرض المهام اليومية</span>
                        <i class="bi bi-chevron-down toggle-icon"></i>
                    </summary>
                    <div class="mt-3 ps-1">
                        @if (_dashboard.DailyAssignments.Count == 0)
                        {
                            <div class="empty-state">لا توجد واجبات مسجلة لهذا اليوم.</div>
                        }
                        else
                        {
                            @foreach (var item in _dashboard.DailyAssignments)
                            {
                                <div class="activity-item">
                                    <i class="@item.IconCssClass fs-5 @GetIconClass(item)"></i>
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold small">@item.Title</div>
                                        <div class="small text-muted">@item.Subtitle</div>
                                    </div>
                                    <span class="status-badge @GetBadgeClass(item)">@item.StatusText</span>
                                </div>
                            }
                        }
                    </div>
                </details>
            </div>
        </div>

        <div class="dashboard-card mb-4">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-award fs-5"></i>
                <h5>آخر الإنجازات والسجلات</h5>
            </div>
            <div class="card-body p-3">
                <details>
                    <summary class="d-flex align-items-center justify-content-between py-2">
                        <span><i class="bi bi-check-circle me-2"></i> عرض آخر النشاطات</span>
                        <i class="bi bi-chevron-down toggle-icon"></i>
                    </summary>
                    <div class="mt-3 ps-1">
                        @if (_dashboard.RecentActivities.Count == 0)
                        {
                            <div class="empty-state">لا توجد نشاطات حديثة بعد.</div>
                        }
                        else
                        {
                            @foreach (var item in _dashboard.RecentActivities)
                            {
                                <div class="activity-item">
                                    <i class="@item.IconCssClass fs-5 @GetIconClass(item)"></i>
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold small">@item.Title</div>
                                        <div class="small text-muted">@item.Subtitle</div>
                                    </div>
                                    <span class="status-badge @GetBadgeClass(item)">@item.StatusText</span>
                                </div>
                            }
                        }
                    </div>
                </details>
            </div>
        </div>

        <div class="dashboard-card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-bell fs-5"></i>
                <h5>الملاحظات والتنبيهات</h5>
            </div>
            <div class="card-body p-3">
                <details>
                    <summary class="d-flex align-items-center justify-content-between py-2">
                        <span><i class="bi bi-exclamation-triangle me-2"></i> عرض المتابعات والتنبيهات</span>
                        <i class="bi bi-chevron-down toggle-icon"></i>
                    </summary>
                    <div class="mt-3 ps-1">
                        @foreach (var item in _dashboard.Alerts)
                        {
                            <div class="activity-item">
                                <i class="@item.IconCssClass fs-5 @GetIconClass(item)"></i>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold small">@item.Title</div>
                                    <div class="small text-muted">@item.Subtitle</div>
                                </div>
                                <span class="status-badge @GetBadgeClass(item)">@item.StatusText</span>
                            </div>
                        }
                    </div>
                </details>
            </div>
        </div>
    }
</div>

@code {
    private StudentDashboardResponse? _dashboard;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        if (AppSession.CurrentMode != AppUserMode.Student || !AppSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        _loading = true;
        _error = null;

        try
        {
            _dashboard = await DashboardService.GetMyDashboardAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatNumber(int value) => value.ToString("N0");

    private static string GetBadgeClass(StudentDashboardItemDto item)
        => item.IsCompleted ? "active" : "inactive";

    private static string GetIconClass(StudentDashboardItemDto item)
        => item.StatusKind?.ToLowerInvariant() switch
        {
            "success" => "icon-success",
            "danger" => "icon-danger",
            "warning" => "icon-gold",
            _ => item.IsCompleted ? "icon-green" : "icon-primary-custom"
        };
}
