@page "/Student/Profile"
@using Moeen.App.Services.Abstractions
@using Moeen.Shared.Responses.Mobile
@inject IStudentProfileService ProfileService
@inject AppSessionService AppSession
@inject NavigationManager Navigation

<style>
    .profile-wrapper { direction: rtl; min-height: 100vh; background: #f4f7f6; padding-bottom: 2rem; color: #195042; }
    .profile-header { background: #195042; color: #d6cabc; padding: 2rem 1rem; border-bottom: 6px solid #d6cabc; text-align: center; }
    .avatar { width: 74px; height: 74px; border-radius: 50%; background: #d6cabc; color: #195042; display: grid; place-items: center; margin: 0 auto .75rem; font-size: 1.5rem; font-weight: 800; }
    .profile-card { background: #fff; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,.08); padding: 1.25rem; margin: 1rem; }
    .profile-title { font-size: 1.2rem; font-weight: 800; border-bottom: 1px solid #d6cabc; padding-bottom: .65rem; margin-bottom: 1rem; }
    .info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap: .75rem; }
    .info-item { display: flex; gap: .7rem; align-items: center; background: #fafbfb; border: 1px solid #d6cabc; border-radius: 12px; padding: .8rem; }
    .info-item i { font-size: 1.25rem; color: #195042; }
    .label { display: block; color: #5a6c7d; font-size: .85rem; font-weight: 700; }
    .value { display: block; color: #195042; font-weight: 800; }
    .schedule-table { width: 100%; border-collapse: collapse; overflow: hidden; border-radius: 12px; }
    .schedule-table th { background: #195042; color: #fff; padding: .7rem; }
    .schedule-table td { background: #fafbfb; border-bottom: 1px solid #d6cabc; padding: .7rem; text-align: center; }
    .badge-state { background: #fff3cd; color: #664d03; border-radius: 999px; padding: .25rem .65rem; font-weight: 700; font-size: .8rem; }
    .note-box { width: 100%; min-height: 120px; resize: none; border: 1px solid #d6cabc; border-radius: 12px; background: #fafbfb; padding: .85rem; }
    .primary-btn { border: 0; border-radius: 10px; background: #195042; color: #d6cabc; padding: .75rem 1.25rem; font-weight: 800; }
    .primary-btn:disabled { opacity: .65; }
    .state-card { margin: 1rem; background: white; border-radius: 20px; padding: 1.5rem; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,.08); }
    .success { background: #d1e7dd; color: #0f5132; padding: .7rem; border-radius: 12px; margin-bottom: .75rem; }
    .error { background: #f8d7da; color: #842029; padding: .7rem; border-radius: 12px; margin-bottom: .75rem; }
</style>

<div class="profile-wrapper">
    <header class="profile-header">
        <div class="avatar">@(_profile?.StudentInitials ?? "ط")</div>
        <h1>الملف الشخصي للطالب</h1>
        <p>@(_profile?.StudentName ?? "إدارة البيانات الأكاديمية والجدول الدراسي")</p>
    </header>

    @if (_loading)
    {
        <div class="state-card">جاري تحميل الملف الشخصي...</div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="state-card">
            <div class="error">@_error</div>
            <button class="primary-btn" @onclick="LoadProfileAsync">إعادة المحاولة</button>
        </div>
    }
    else if (_profile is not null)
    {
        <section class="profile-card">
            <h2 class="profile-title"><i class="bi bi-person-circle"></i> البيانات الشخصية</h2>
            <div class="info-grid">
                @Info("bi bi-person", "اسم الطالب", _profile.StudentName)
                @Info("bi bi-calendar", "العمر", _profile.Age > 0 ? _profile.Age.ToString() : "غير محدد")
                @Info("bi bi-gender-ambiguous", "الجنس", _profile.Gender)
                @Info("bi bi-envelope", "الإيميل", Fallback(_profile.Email))
                @Info("bi bi-telephone", "رقم الطالب", Fallback(_profile.PhoneNumber))
                @Info("bi bi-building", "المسجد", Fallback(_profile.MosqueName))
                @Info("bi bi-people", "الفوج", Fallback(_profile.FoujName))
                @Info("bi bi-book", "الحلقة", Fallback(_profile.HalqaName))
                @Info("bi bi-person-badge", "المعلم", Fallback(_profile.TeacherName))
                @Info("bi bi-shield-check", "ولي الأمر", Fallback(_profile.ParentName))
                @Info("bi bi-telephone-forward", "رقم ولي الأمر", Fallback(_profile.ParentPhoneNumber))
                @Info("bi bi-star", "مجموع النقاط", _profile.TotalPoints.ToString())
            </div>
        </section>

        <section class="profile-card">
            <h2 class="profile-title"><i class="bi bi-trophy"></i> الإنجازات والحفظ</h2>
            @foreach (var achievement in _profile.Achievements)
            {
                <div class="info-item mb-2"><i class="bi bi-check-circle"></i><span class="value">@achievement</span></div>
            }
        </section>

        <section class="profile-card">
            <h2 class="profile-title"><i class="bi bi-calendar-week"></i> جدول الدروس الأسبوعي</h2>
            <table class="schedule-table">
                <thead><tr><th>اليوم</th><th>الدرس</th><th>الوقت</th><th>الحالة</th></tr></thead>
                <tbody>
                    @foreach (var item in _profile.WeeklySchedule)
                    {
                        <tr>
                            <td>@item.DayName</td>
                            <td>@item.LessonTitle</td>
                            <td>@item.TimeRange</td>
                            <td><span class="badge-state">@item.StatusText</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="profile-card">
            <h2 class="profile-title"><i class="bi bi-chat-dots"></i> ملاحظة أو استفسار</h2>
            @if (!string.IsNullOrWhiteSpace(_noteMessage))
            {
                <div class="@(_noteSuccess ? "success" : "error")">@_noteMessage</div>
            }
            <textarea class="note-box" placeholder="اكتب هنا ما تريد مشاركته مع الإدارة أو المعلم..." @bind="_noteText"></textarea>
            <div class="text-center mt-3">
                <button type="button" class="primary-btn" disabled="@_submittingNote" @onclick="SubmitNoteAsync">
                    @(_submittingNote ? "جاري الإرسال..." : "إرسال")
                </button>
            </div>
        </section>
    }
</div>

@code {
    private StudentProfileResponse? _profile;
    private bool _loading = true;
    private bool _submittingNote;
    private bool _noteSuccess;
    private string? _error;
    private string? _noteMessage;
    private string _noteText = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadProfileAsync();

    private async Task LoadProfileAsync()
    {
        if (AppSession.CurrentMode != AppUserMode.Student || !AppSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        _loading = true;
        _error = null;
        try
        {
            _profile = await ProfileService.GetMyProfileAsync();
        }
        catch (Exception ex)
        {
            _profile = null;
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SubmitNoteAsync()
    {
        _noteMessage = null;
        _noteSuccess = false;

        if (string.IsNullOrWhiteSpace(_noteText) || _noteText.Trim().Length < 5)
        {
            _noteMessage = "اكتب ملاحظة من 5 أحرف على الأقل.";
            return;
        }

        _submittingNote = true;
        try
        {
            await ProfileService.SubmitNoteAsync(_noteText.Trim());
            _noteText = string.Empty;
            _noteSuccess = true;
            _noteMessage = "تم إرسال الملاحظة بنجاح.";
        }
        catch (Exception ex)
        {
            _noteMessage = ex.Message;
        }
        finally
        {
            _submittingNote = false;
        }
    }

    private static string Fallback(string? value) => string.IsNullOrWhiteSpace(value) ? "غير محدد" : value;

    private static RenderFragment Info(string icon, string label, string value) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "info-item");
        builder.OpenElement(2, "i");
        builder.AddAttribute(3, "class", icon);
        builder.CloseElement();
        builder.OpenElement(4, "div");
        builder.OpenElement(5, "span");
        builder.AddAttribute(6, "class", "label");
        builder.AddContent(7, label);
        builder.CloseElement();
        builder.OpenElement(8, "span");
        builder.AddAttribute(9, "class", "value");
        builder.AddContent(10, value);
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
    };
}
