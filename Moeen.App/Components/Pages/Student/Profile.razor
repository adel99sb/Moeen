@page "/Student/Profile"

<style>
    :root {
        --color-primary-green: #195042;
        --color-luxury-beige: #d6cabc;
        --color-bg-light: #f4f7f6;
        --color-white: #ffffff;
        --color-text-muted: #5a6c7d;
        --color-input-border: #d6cabc;
        --color-input-bg: #fafbfb;
        --color-btn-primary: #195042;
        --color-btn-primary-hover: #246b59;
        --shadow-card: 0 10px 30px rgba(0, 0, 0, 0.08);
        --shadow-card-hover: 0 14px 35px rgba(0, 0, 0, 0.12);
        --shadow-soft: 0 2px 8px rgba(0, 0, 0, 0.04);
        --radius-card: 20px;
        --radius-input: 12px;
        --radius-btn: 10px;
        --font-base: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        --font-weight-semibold: 600;
        --font-weight-bold: 700;
        --font-size-sm: 0.88rem;
        --font-size-base: 0.95rem;
        --font-size-xl: 1.35rem;
        --spacing-xs: 0.6rem;
        --spacing-sm: 0.8rem;
        --spacing-md: 1rem;
        --spacing-lg: 1.5rem;
        --spacing-xl: 2rem;
        --spacing-xxl: 2.5rem;
        --transition-base: 0.3s ease;
        --border-header: 6px solid var(--color-luxury-beige);
        --border-light: 1px solid var(--color-input-border);
    }

    .profile-wrapper {
        direction: rtl;
        text-align: right;
        font-family: var(--font-base);
        background-color: var(--color-bg-light);
        padding-bottom: var(--spacing-xxl);
        min-height: 100vh;
    }

    .header-custom {
        background-color: var(--color-primary-green);
        color: var(--color-luxury-beige);
        padding: var(--spacing-xxl) 0;
        border-bottom: var(--border-header);
        margin-bottom: var(--spacing-xxl);
    }

    .profile-card {
        background: var(--color-white);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card);
        padding: var(--spacing-xl);
        margin-bottom: var(--spacing-lg);
        transition: transform var(--transition-base), box-shadow var(--transition-base);
    }

        .profile-card:hover {
            box-shadow: var(--shadow-card-hover);
        }

    .profile-title {
        color: var(--color-primary-green);
        font-weight: var(--font-weight-bold);
        font-size: var(--font-size-xl);
        margin-bottom: var(--spacing-lg);
        padding-bottom: var(--spacing-sm);
        border-bottom: var(--border-light);
    }

    /* شبكة وعرض البيانات */
    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: var(--spacing-md);
    }

    .data-item {
        display: flex;
        align-items: center;
        background: var(--color-input-bg);
        border: var(--border-light);
        border-radius: var(--radius-input);
        padding: var(--spacing-sm) var(--spacing-md);
        box-shadow: var(--shadow-soft);
        transition: all var(--transition-base);
    }

        .data-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(25, 80, 66, 0.15);
            border-color: var(--color-primary-green);
        }

    .data-icon {
        font-size: 1.4rem;
        color: var(--color-primary-green);
        margin-left: var(--spacing-sm);
        flex-shrink: 0;
    }

    .data-content {
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .data-label {
        font-size: var(--font-size-sm);
        color: var(--color-text-muted);
        font-weight: var(--font-weight-semibold);
    }

    .data-value {
        font-size: var(--font-size-base);
        color: var(--color-primary-green);
        font-weight: var(--font-weight-bold);
    }

    .data-item.full-width {
        grid-column: 1 / -1;
        align-items: flex-start;
    }

        .data-item.full-width .data-value {
            line-height: 1.8;
            white-space: pre-wrap;
            margin-top: var(--spacing-xs);
        }

    /* الجدول والشارات */
    .schedule-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        border: var(--border-light);
        border-radius: var(--radius-input);
        overflow: hidden;
        margin-top: var(--spacing-sm);
    }

        .schedule-table th, .schedule-table td {
            padding: var(--spacing-sm);
            text-align: center;
            font-size: var(--font-size-base);
        }

        .schedule-table th {
            background-color: var(--color-primary-green);
            color: var(--color-white);
            font-weight: var(--font-weight-semibold);
        }

        .schedule-table td {
            background-color: var(--color-input-bg);
            color: var(--color-text-muted);
            border-bottom: 1px solid var(--color-input-border);
        }

        .schedule-table tr:last-child td {
            border-bottom: none;
        }

    .status-badge {
        display: inline-block;
        padding: 0.25em 0.6em;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: var(--font-weight-semibold);
    }

    .status-active {
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .status-upcoming {
        background-color: #fff3cd;
        color: #664d03;
    }

    /* نموذج الملاحظات */
    .form-group {
        margin-bottom: var(--spacing-lg);
    }

    .form-label {
        display: block;
        color: var(--color-primary-green);
        font-weight: var(--font-weight-semibold);
        font-size: var(--font-size-base);
        margin-bottom: var(--spacing-xs);
    }

    .form-control-custom {
        width: 100%;
        padding: var(--spacing-sm) var(--spacing-md);
        border: var(--border-light);
        border-radius: var(--radius-input);
        background-color: var(--color-input-bg);
        color: var(--color-text-muted);
        font-family: var(--font-base);
        font-size: var(--font-size-base);
        box-shadow: var(--shadow-soft);
        min-height: 120px;
        resize: vertical;
    }

        .form-control-custom:focus {
            outline: none;
            border-color: var(--color-primary-green);
            background-color: var(--color-white);
            box-shadow: 0 4px 12px rgba(25, 80, 66, 0.15);
        }

    .btn {
        border: none;
        border-radius: var(--radius-btn);
        padding: var(--spacing-sm) var(--spacing-lg);
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-semibold);
        font-family: var(--font-base);
        cursor: pointer;
        transition: all var(--transition-base);
        display: inline-flex;
        align-items: center;
        gap: var(--spacing-xs);
        box-shadow: var(--shadow-soft);
    }

    .btn-primary {
        background-color: var(--color-btn-primary);
        color: var(--color-luxury-beige);
    }

        .btn-primary:hover {
            background-color: var(--color-btn-primary-hover);
            color: var(--color-white);
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(25, 80, 66, 0.25);
        }

    @@media (max-width: 768px) {
        .header-custom {
            padding: 2rem 0;
            margin-bottom: 2rem;
        }

        .profile-card {
            padding: 1.2rem;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="profile-wrapper">
    <header class="header-custom text-center">
        <div class="container">
            <h1 class="fw-bold">الملف الشخصي للطالب</h1>
            <p class="mb-0">إدارة البيانات الأكاديمية والجدول الدراسي</p>
        </div>
    </header>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-12">
                <!-- بطاقة المعلومات الشخصية -->
                <div class="profile-card">
                    <h2 class="profile-title"><i class="bi bi-person-circle ms-2"></i> البيانات الشخصية</h2>
                    <div class="info-grid">
                        <div class="data-item">
                            <i class="bi bi-person data-icon"></i>
                            <div class="data-content">
                                <span class="data-label">اسم الطالب</span>
                                <span class="data-value">احمد محمد العبدالله</span>
                            </div>
                        </div>
                        <div class="data-item">
                            <i class="bi bi-calendar data-icon"></i>
                            <div class="data-content">
                                <span class="data-label">العمر</span>
                                <span class="data-value">14</span>
                            </div>
                        </div>
                        <div class="data-item">
                            <i class="bi bi-people data-icon"></i>
                            <div class="data-content">
                                <span class="data-label">اسم الفوج</span>
                                <span class="data-value">فوج النجوم</span>
                            </div>
                        </div>
                        <div class="data-item">
                            <i class="bi bi-book data-icon"></i>
                            <div class="data-content">
                                <span class="data-label">الحلقة / المستوى</span>
                                <span class="data-value">حلقة المتوسطين</span>
                            </div>
                        </div>
                        <div class="data-item">
                            <i class="bi bi-shield-check data-icon"></i>
                            <div class="data-content">
                                <span class="data-label">ولي الأمر</span>
                                <span class="data-value">خالد العلي</span>
                            </div>
                        </div>
                        <div class="data-item">
                            <i class="bi bi-telephone data-icon"></i>
                            <div class="data-content">
                                <span class="data-label">رقم التواصل</span>
                                <span class="data-value">+966 55 123 4567</span>
                            </div>
                        </div>
                        <div class="data-item full-width">
                            <i class="bi bi-trophy data-icon"></i>
                            <div class="data-content">
                                <span class="data-label">الإنجازات والحفظ</span>
                                <div class="data-value">
                                    - حفظ 5 أجزاء كاملة
                                    - المركز الثاني في مسابقة التلاوة المحلية
                                    - الالتزام الكامل بالحضور منذ بداية العام
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- بطاقة جدول الدروس -->
                <div class="profile-card">
                    <h2 class="profile-title"><i class="bi bi-calendar-week ms-2"></i> جدول الدروس الأسبوعي</h2>
                    <div class="table-responsive">
                        <table class="schedule-table">
                            <thead>
                                <tr><th>اليوم</th><th>الدرس / المادة</th><th>الوقت</th><th>الحالة</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>الأحد</td><td>حفظ القرآن</td><td>08:00 - 09:30</td><td><span class="status-badge status-active">مكتمل</span></td></tr>
                                <tr><td>الثلاثاء</td><td>أحكام التجويد</td><td>08:00 - 09:30</td><td><span class="status-badge status-upcoming">قادم</span></td></tr>
                                <tr><td>الخميس</td><td>مراجعة الحفظ</td><td>10:00 - 11:30</td><td><span class="status-badge status-upcoming">قادم</span></td></tr>
                                <tr><td>السبت</td><td>ورشة التلاوة</td><td>04:00 - 05:30</td><td><span class="status-badge status-upcoming">قادم</span></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- بطاقة الملاحظات أو الاستفسار -->
                <div class="profile-card">
                    <h2 class="profile-title"><i class="bi bi-chat-dots ms-2"></i> ملاحظة أو استفسار</h2>
                    <form>
                        <div class="form-group">
                            <label class="form-label" for="feedback"><i class="bi bi-pencil-square ms-1"></i> اكتب ملاحظتك أو استفسارك</label>
                            <textarea id="feedback" class="form-control-custom" placeholder="اكتب هنا ما تريد مشاركته مع الإدارة أو المعلم..."></textarea>
                        </div>
                        <div class="text-center">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-send-fill"></i> إرسال</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

