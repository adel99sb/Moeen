@page "/Student/Profile"
<style>
    :root {
        /* الألوان */
        --color-primary-green: #195042;
        --color-luxury-beige: #d6cabc;
        --color-bg-light: #f4f7f6;
        --color-white: #ffffff;
        --color-text-muted: #5a6c7d;
        --color-input-border: #d6cabc;
        --color-input-bg: #fafbfb;
        --color-input-readonly: #f8f9fa;
        --color-btn-primary: #195042;
        --color-btn-primary-hover: #246b59;
        /* الظلال */
        --shadow-card: 0 10px 30px rgba(0, 0, 0, 0.08);
        --shadow-card-hover: 0 14px 35px rgba(0, 0, 0, 0.12);
        --shadow-input: 0 2px 8px rgba(0, 0, 0, 0.04);
        /* الزوايا */
        --radius-card: 20px;
        --radius-input: 12px;
        --radius-btn: 10px;
        /* الخطوط */
        --font-base: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        --font-weight-normal: 400;
        --font-weight-semibold: 600;
        --font-weight-bold: 700;
        /* الأحجام */
        --font-size-sm: 0.88rem;
        --font-size-base: 0.95rem;
        --font-size-lg: 1.15rem;
        --font-size-xl: 1.35rem;
        /* المسافات */
        --spacing-xs: 0.6rem;
        --spacing-sm: 0.8rem;
        --spacing-md: 1rem;
        --spacing-lg: 1.5rem;
        --spacing-xl: 2rem;
        --spacing-xxl: 2.5rem;
        /* التحولات */
        --transition-base: 0.3s ease;
        --border-header: 6px solid var(--color-luxury-beige);
        --border-input: 2px solid var(--color-input-border);
    }

    .profile-wrapper {
        direction: rtl;
        text-align: right;
        font-family: var(--font-base);
        background-color: var(--color-bg-light);
        padding-bottom: var(--spacing-xxl);
        min-height: 100vh;
    }

    .header-custom {
        background-color: var(--color-primary-green);
        color: var(--color-luxury-beige);
        padding: var(--spacing-xxl) 0;
        border-bottom: var(--border-header);
        margin-bottom: var(--spacing-xxl);
    }

    .profile-card {
        background: var(--color-white);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card);
        padding: var(--spacing-xl);
        margin-bottom: var(--spacing-lg);
        transition: transform var(--transition-base), box-shadow var(--transition-base);
    }

        .profile-card:hover {
            box-shadow: var(--shadow-card-hover);
        }

    .profile-title {
        color: var(--color-primary-green);
        font-weight: var(--font-weight-bold);
        font-size: var(--font-size-xl);
        margin-bottom: var(--spacing-lg);
        padding-bottom: var(--spacing-sm);
        border-bottom: var(--border-input);
    }

    .form-group {
        margin-bottom: var(--spacing-lg);
    }

    .form-label {
        display: block;
        color: var(--color-primary-green);
        font-weight: var(--font-weight-semibold);
        font-size: var(--font-size-base);
        margin-bottom: var(--spacing-xs);
    }

    .form-control-custom {
        width: 100%;
        padding: var(--spacing-sm) var(--spacing-md);
        border: var(--border-input);
        border-radius: var(--radius-input);
        background-color: var(--color-input-bg);
        color: var(--color-text-muted);
        font-family: var(--font-base);
        font-size: var(--font-size-base);
        transition: all var(--transition-base);
        box-shadow: var(--shadow-input);
    }

        .form-control-custom:focus {
            outline: none;
            border-color: var(--color-primary-green);
            background-color: var(--color-white);
            box-shadow: 0 4px 12px rgba(25, 80, 66, 0.15);
        }

        .form-control-custom[readonly] {
            background-color: var(--color-input-readonly);
            cursor: not-allowed;
            opacity: 0.85;
        }

    textarea.form-control-custom {
        min-height: 80px;
        resize: none;
    }

    .btn {
        border: none;
        border-radius: var(--radius-btn);
        padding: var(--spacing-sm) var(--spacing-lg);
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-semibold);
        font-family: var(--font-base);
        cursor: pointer;
        transition: all var(--transition-base);
        display: inline-flex;
        align-items: center;
        gap: var(--spacing-xs);
        box-shadow: var(--shadow-input);
    }

    .btn-primary {
        background-color: var(--color-btn-primary);
        color: var(--color-luxury-beige);
    }

        .btn-primary:hover {
            background-color: var(--color-btn-primary-hover);
            color: var(--color-white);
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(25, 80, 66, 0.25);
        }

    .btn:active {
        transform: translateY(0);
    }

    #edit-toggle {
        display: none;
    }

        #edit-toggle:checked ~ .profile-card .form-control-custom {
            background-color: var(--color-input-bg);
            cursor: text;
            opacity: 1;
        }

        #edit-toggle:checked ~ .profile-card .btn-edit-mode {
            display: none;
        }

        #edit-toggle:checked ~ .profile-card .btn-save-mode {
            display: inline-flex;
        }

    .btn-edit-mode {
        display: inline-flex;
    }

    .btn-save-mode {
        display: none;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: var(--spacing-md);
    }

    .schedule-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        border: var(--border-input);
        border-radius: var(--radius-input);
        overflow: hidden;
        margin-top: var(--spacing-sm);
    }

        .schedule-table th, .schedule-table td {
            padding: var(--spacing-sm);
            text-align: center;
            font-size: var(--font-size-base);
        }

        .schedule-table th {
            background-color: var(--color-primary-green);
            color: var(--color-white);
            font-weight: var(--font-weight-semibold);
        }

        .schedule-table td {
            background-color: var(--color-input-bg);
            color: var(--color-text-muted);
            border-bottom: 1px solid var(--color-input-border);
        }

        .schedule-table tr:last-child td {
            border-bottom: none;
        }

    .status-badge {
        display: inline-block;
        padding: 0.25em 0.6em;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: var(--font-weight-semibold);
    }

    .status-active {
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .status-upcoming {
        background-color: #fff3cd;
        color: #664d03;
    }

    @@media (max-width: 768px) {
        .header-custom {
            padding: 2rem 0;
            margin-bottom: 2rem;
        }

        .profile-card {
            padding: 1.2rem;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="profile-wrapper">
    <header class="header-custom text-center">
        <div class="container">
            <h1 class="fw-bold">الملف الشخصي للطالب</h1>
            <p class="mb-0">إدارة البيانات الأكاديمية والجدول الدراسي</p>
        </div>
    </header>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-12">
                <input type="checkbox" id="edit-toggle">

                <!-- بطاقة المعلومات الشخصية -->
                <div class="profile-card">
                    <h2 class="profile-title"><i class="bi bi-person-circle ms-2"></i> البيانات الشخصية</h2>
                    <div class="info-grid">
                        <div class="form-group">
                            <label class="form-label" for="studentName"><i class="bi bi-person ms-1"></i> اسم الطالب</label>
                            <input type="text" id="studentName" class="form-control-custom" value="احمد محمد العبدالله" readonly>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="age"><i class="bi bi-calendar ms-1"></i> العمر</label>
                            <input type="number" id="age" class="form-control-custom" value="14" readonly>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="groupName"><i class="bi bi-people ms-1"></i> اسم الفوج</label>
                            <input type="text" id="groupName" class="form-control-custom" value="فوج النجوم" readonly>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="circleName"><i class="bi bi-book ms-1"></i> الحلقة / المستوى</label>
                            <input type="text" id="circleName" class="form-control-custom" value="حلقة المتوسطين" readonly>
                        </div>
                    </div>

                    <div class="info-grid">
                        <div class="form-group">
                            <label class="form-label" for="guardian"><i class="bi bi-shield-check ms-1"></i> ولي الأمر</label>
                            <input type="text" id="guardian" class="form-control-custom" value="خالد العلي" readonly>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="contact"><i class="bi bi-telephone ms-1"></i> رقم التواصل</label>
                            <input type="tel" id="contact" class="form-control-custom" value="+966 55 123 4567" readonly>
                        </div>
                    </div>

                 

                    <div class="form-group">
                        <label class="form-label" for="achievements"><i class="bi bi-trophy ms-1"></i> الإنجازات والحفظ</label>
                        <textarea id="achievements" class="form-control-custom" readonly>- حفظ 5 أجزاء كاملة&#10;- المركز الثاني في مسابقة التلاوة المحلية&#10;- الالتزام الكامل بالحضور منذ بداية العام</textarea>
                    </div>

                    <div class="text-center mt-4">
                        <label for="edit-toggle" class="btn btn-primary btn-edit-mode"><i class="bi bi-pencil-square"></i> تعديل</label>
                        <label for="edit-toggle" class="btn btn-primary btn-save-mode"><i class="bi bi-check-lg"></i> حفظ التغييرات</label>
                    </div>
                </div>

                <!-- بطاقة جدول الدروس -->
                <div class="profile-card">
                    <h2 class="profile-title"><i class="bi bi-calendar-week ms-2"></i> جدول الدروس الأسبوعي</h2>
                    <div class="table-responsive">
                        <table class="schedule-table">
                            <thead>
                                <tr>
                                    <th>اليوم</th>
                                    <th>الدرس / المادة</th>
                                    <th>الوقت</th>
                                    <th>الحالة</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td>الأحد</td><td>حفظ القرآن</td><td>08:00 - 09:30</td><td><span class="status-badge status-active">مكتمل</span></td></tr>
                                <tr><td>الثلاثاء</td><td>أحكام التجويد</td><td>08:00 - 09:30</td><td><span class="status-badge status-upcoming">قادم</span></td></tr>
                                <tr><td>الخميس</td><td>مراجعة الحفظ</td><td>10:00 - 11:30</td><td><span class="status-badge status-upcoming">قادم</span></td></tr>
                                <tr><td>السبت</td><td>ورشة التلاوة</td><td>04:00 - 05:30</td><td><span class="status-badge status-upcoming">قادم</span></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- بطاقة الملاحظات أو الاستفسار -->
                <div class="profile-card">
                    <h2 class="profile-title"><i class="bi bi-chat-dots ms-2"></i> ملاحظة أو استفسار</h2>
                    <form>
                        <div class="form-group">
                            <label class="form-label" for="feedback"><i class="bi bi-pencil-square ms-1"></i> اكتب ملاحظتك أو استفسارك</label>
                            <textarea id="feedback" class="form-control-custom" placeholder="اكتب هنا ما تريد مشاركته مع الإدارة أو المعلم..." style="min-height: 120px;"></textarea>
                        </div>
                        <div class="text-center">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-send-fill"></i> إرسال</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

