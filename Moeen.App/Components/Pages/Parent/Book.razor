@page "/Parent/Book"
@using Moeen.App.Services
@using Moeen.App.Services.Abstractions
@using Moeen.Shared.Responses.Library
@using Moeen.Shared.Responses.Mobile
@using System.Globalization
@inject IParentLibraryService ParentLibraryService
@inject AppSessionService AppSession
@inject NavigationManager Navigation

<style>
    .parent-library-page {
        direction: rtl;
        text-align: right;
        min-height: 100vh;
        background: #f9f7f5;
        padding: 1rem;
        color: #195042;
    }

    .library-hero {
        background: linear-gradient(135deg, #195042 0%, #24705d 100%);
        color: #ffffff;
        border-radius: 1.1rem;
        padding: 1.25rem;
        margin-bottom: 1rem;
        box-shadow: 0 10px 24px rgba(25, 80, 66, 0.16);
    }

    .library-hero small {
        color: #d6cabc;
    }

    .toolbar-card,
    .state-box,
    .book-card {
        background: #ffffff;
        border: 1px solid rgba(214, 202, 188, 0.55);
        border-radius: 1rem;
        box-shadow: 0 6px 16px rgba(25, 80, 66, 0.08);
    }

    .toolbar-card {
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .toolbar-grid {
        display: grid;
        grid-template-columns: 1fr auto auto;
        gap: 0.65rem;
        align-items: center;
    }

    .search-input {
        border: 1px solid #e4ded2;
        border-radius: 0.8rem;
        padding: 0.65rem 0.85rem;
        color: #195042;
        background: #fbfaf7;
        outline: none;
        width: 100%;
    }

    .search-input:focus {
        border-color: #195042;
        background: #ffffff;
    }

    .btn-library {
        border: none;
        border-radius: 0.8rem;
        background: #195042;
        color: #ffffff;
        padding: 0.64rem 1rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .btn-library.outline {
        background: #ffffff;
        color: #195042;
        border: 1px solid #195042;
    }

    .btn-library:disabled {
        opacity: 0.6;
    }

    .books-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .book-card {
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-height: 100%;
    }

    .book-cover {
        height: 135px;
        background: linear-gradient(135deg, #195042 0%, #246b59 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    .book-cover::after {
        content: '';
        position: absolute;
        width: 130px;
        height: 130px;
        border-radius: 50%;
        background: rgba(214, 202, 188, 0.14);
        top: -35px;
        right: -35px;
    }

    .book-cover i {
        color: #d6cabc;
        font-size: 3.1rem;
        z-index: 1;
    }

    .book-body {
        padding: 1rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .book-title {
        font-size: 1rem;
        font-weight: 900;
        color: #195042;
        margin-bottom: 0.45rem;
    }

    .book-desc {
        color: #5a6c7d;
        font-size: 0.86rem;
        line-height: 1.65;
        margin-bottom: 0.8rem;
        flex-grow: 1;
    }

    .book-meta {
        display: grid;
        gap: 0.35rem;
        color: #6c757d;
        font-size: 0.78rem;
        margin-bottom: 0.9rem;
    }

    .book-actions {
        display: flex;
        gap: 0.55rem;
        flex-wrap: wrap;
        border-top: 1px solid #eae6d9;
        padding-top: 0.85rem;
    }

    .download-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        text-decoration: none;
        border-radius: 0.75rem;
        background: #195042;
        color: #ffffff;
        padding: 0.55rem 0.8rem;
        font-size: 0.82rem;
        font-weight: 800;
        flex: 1;
    }

    .download-link:hover {
        color: #d6cabc;
    }

    .pagination-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        background: #ffffff;
        border: 1px solid rgba(214, 202, 188, 0.55);
        border-radius: 1rem;
        padding: 0.8rem;
        margin-bottom: 1rem;
    }

    .state-box {
        padding: 1.5rem;
        text-align: center;
        margin-bottom: 1rem;
    }

    .error-box {
        background: #f8d7da;
        border-color: #f5c2c7;
        color: #842029;
    }

    @@media (max-width: 720px) {
        .toolbar-grid {
            grid-template-columns: 1fr;
        }

        .pagination-row {
            flex-direction: column;
            align-items: stretch;
            text-align: center;
        }
    }
</style>

<div class="parent-library-page">
    <section class="library-hero">
        <h4 class="fw-bold mb-1"><i class="bi bi-book-half ms-2"></i>مكتبة ولي الأمر</h4>
        <small>كتب وملفات مساعدة لمتابعة الطالب وحفظه.</small>
    </section>

    <section class="toolbar-card">
        <div class="toolbar-grid">
            <input class="search-input" @bind="_searchText" placeholder="ابحث باسم الكتاب أو الوصف..." />
            <button class="btn-library" @onclick="SearchAsync" disabled="@_loading">
                <i class="bi bi-search ms-1"></i>بحث
            </button>
            <button class="btn-library outline" @onclick="ClearSearchAsync" disabled="@_loading">
                <i class="bi bi-x-circle ms-1"></i>مسح
            </button>
        </div>
    </section>

    @if (_loading)
    {
        <div class="state-box">
            <div class="spinner-border text-success" role="status"></div>
            <p class="mt-3 mb-0">جاري تحميل المكتبة...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="state-box error-box">
            <p class="mb-3">@_error</p>
            <button class="btn-library outline" @onclick="ReloadAsync">إعادة المحاولة</button>
        </div>
    }
    else if (_library is not null)
    {
        <div class="pagination-row">
            <span>عدد النتائج: <strong>@_library.TotalCount</strong></span>
            <span>الصفحة <strong>@_library.Page</strong> من <strong>@TotalPagesText</strong></span>
        </div>

        @if (!_library.Books.Any())
        {
            <div class="state-box">
                <i class="bi bi-journal-x fs-2 d-block mb-2"></i>
                <p class="mb-0">لا توجد كتب متاحة حالياً ضمن البحث الحالي.</p>
            </div>
        }
        else
        {
            <section class="books-grid">
                @foreach (var book in _library.Books)
                {
                    <article class="book-card" @key="book.Id">
                        <div class="book-cover">
                            <i class="bi bi-file-earmark-pdf"></i>
                        </div>
                        <div class="book-body">
                            <h5 class="book-title">@Fallback(book.Title, "كتاب بدون عنوان")</h5>
                            <p class="book-desc">@Fallback(book.Description, "لا يوجد وصف لهذا الكتاب.")</p>

                            <div class="book-meta">
                                <span><i class="bi bi-person ms-1"></i>الرافع: @Fallback(book.Author, "غير محدد")</span>
                                <span><i class="bi bi-calendar3 ms-1"></i>السنة: @PublicationYear(book)</span>
                                <span><i class="bi bi-clock ms-1"></i>تاريخ الإضافة: @FormatDate(book.CreatedAt)</span>
                            </div>

                            <div class="book-actions">
                                @if (!string.IsNullOrWhiteSpace(book.CoverImageUrl))
                                {
                                    <a class="download-link" href="@book.CoverImageUrl" target="_blank">
                                        <i class="bi bi-download"></i>فتح / تحميل
                                    </a>
                                }
                                else
                                {
                                    <span class="download-link" style="opacity:.6; pointer-events:none;">لا يوجد ملف</span>
                                }
                            </div>
                        </div>
                    </article>
                }
            </section>
        }

        <div class="pagination-row">
            <button class="btn-library outline" @onclick="PreviousPageAsync" disabled="@(!CanGoPrevious)">
                <i class="bi bi-chevron-right ms-1"></i>السابق
            </button>
            <span>صفحة @_pageNumber</span>
            <button class="btn-library outline" @onclick="NextPageAsync" disabled="@(!CanGoNext)">
                التالي<i class="bi bi-chevron-left me-1"></i>
            </button>
        </div>
    }
</div>

@code {
    private const int PageSize = 20;
    private ParentLibraryResponse? _library;
    private bool _loading = true;
    private string? _error;
    private string _searchText = string.Empty;
    private int _pageNumber = 1;

    private bool CanGoPrevious => _pageNumber > 1 && !_loading;
    private bool CanGoNext => _library is not null && _library.TotalPages > _pageNumber && !_loading;
    private string TotalPagesText => _library?.TotalPages > 0 ? _library.TotalPages.ToString(CultureInfo.InvariantCulture) : "1";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(1);
    }

    private async Task SearchAsync()
    {
        await LoadAsync(1);
    }

    private async Task ClearSearchAsync()
    {
        _searchText = string.Empty;
        await LoadAsync(1);
    }

    private async Task ReloadAsync()
    {
        await LoadAsync(_pageNumber);
    }

    private async Task PreviousPageAsync()
    {
        if (CanGoPrevious)
            await LoadAsync(_pageNumber - 1);
    }

    private async Task NextPageAsync()
    {
        if (CanGoNext)
            await LoadAsync(_pageNumber + 1);
    }

    private async Task LoadAsync(int pageNumber)
    {
        if (AppSession.CurrentMode != AppUserMode.Parent || !AppSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        _loading = true;
        _error = null;

        try
        {
            _pageNumber = Math.Max(pageNumber, 1);
            _library = await ParentLibraryService.GetBooksAsync(_pageNumber, PageSize, _searchText);
            _pageNumber = _library.Page;
        }
        catch (Exception ex)
        {
            _library = null;
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Fallback(string? value, string fallback)
        => string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static string PublicationYear(BookResponseDto book)
        => book.PublicationYear?.ToString(CultureInfo.InvariantCulture) ?? (book.CreatedAt == default ? "غير محددة" : book.CreatedAt.Year.ToString(CultureInfo.InvariantCulture));

    private static string FormatDate(DateTime date)
        => date == default ? "غير محدد" : date.ToString("yyyy/MM/dd", CultureInfo.InvariantCulture);
}
