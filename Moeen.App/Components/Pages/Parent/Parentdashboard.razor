@page "/Parent/Parentdashboard"
@using Moeen.App.Services
@using Moeen.App.Services.Abstractions
@using Moeen.Shared.Responses.Mobile
@inject IParentDashboardService ParentDashboardService
@inject AppSessionService AppSession
@inject NavigationManager Navigation

<style>
    .parent-dashboard-wrapper {
        direction: rtl;
        text-align: right;
        background-color: #f5f7fa;
        min-height: 100vh;
        padding: 1rem 0 2.5rem;
    }

    .parent-logo {
        text-align: center;
        margin-bottom: 1rem;
    }

    .parent-logo img {
        width: 105px;
        height: auto;
    }

    .dashboard-card {
        background: linear-gradient(145deg, #ffffff 0%, #f4f1e8 100%);
        border: 1px solid #eae6d9;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 6px 16px rgba(25, 80, 66, 0.09);
        margin-bottom: 1rem;
    }

    .dashboard-card .card-header {
        background: linear-gradient(135deg, #195042 0%, #24705d 100%);
        border-bottom: none;
        padding: 1rem 1.25rem;
        color: #ffffff;
    }

    .dashboard-card .card-header h5 {
        margin: 0;
        font-weight: 700;
        font-size: 1.05rem;
    }

    .child-selector-inline {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.35rem 0.65rem;
        background: rgba(214, 202, 188, 0.22);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 0.65rem;
        color: #d6cabc;
        max-width: 180px;
    }

    .child-dropdown-inline {
        background: transparent;
        border: none;
        color: #d6cabc;
        font-weight: 700;
        font-size: 0.84rem;
        cursor: pointer;
        outline: none;
        width: 130px;
    }

    .child-dropdown-inline option {
        background: #195042;
        color: #ffffff;
    }

    .stat-box {
        background: linear-gradient(145deg, #ffffff 0%, #f4f1e8 100%);
        border: 1px solid #eae6d9;
        border-radius: 0.85rem;
        padding: 1.35rem 0.75rem;
        position: relative;
        height: 100%;
    }

    .stat-box::after {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, #195042 0%, #eae6d9 100%);
        border-radius: 0.85rem 0.85rem 0 0;
    }

    .icon-wrapper {
        color: #195042;
        font-size: 1.5rem;
    }

    .stat-value {
        color: #195042;
        font-weight: 800;
        font-size: 1.25rem;
    }

    .child-summary {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        padding: 1rem;
    }

    .child-avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #195042;
        color: #d6cabc;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.05rem;
        flex-shrink: 0;
    }

    .activity-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.85rem 0;
        border-bottom: 1px solid #eae6d9;
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-icon {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(25, 80, 66, 0.1);
        color: #195042;
        flex-shrink: 0;
    }

    .status-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 2rem;
        font-size: 0.75rem;
        font-weight: 700;
        white-space: nowrap;
        background-color: #f4f1e8;
        color: #195042;
        border: 1px solid #eae6d9;
    }

    .status-badge.success {
        background-color: #d1fae5;
        color: #065f46;
        border-color: #a7f3d0;
    }

    .status-badge.warning {
        background-color: #fff3cd;
        color: #856404;
        border-color: #ffeeba;
    }

    .status-badge.danger {
        background-color: #fee2e2;
        color: #991b1b;
        border-color: #fecaca;
    }

    .state-box {
        background: #ffffff;
        border-radius: 16px;
        padding: 1.5rem;
        text-align: center;
        color: #195042;
        box-shadow: 0 6px 16px rgba(25, 80, 66, 0.09);
    }

    .error-box {
        color: #842029;
        background: #f8d7da;
        border: 1px solid #f5c2c7;
    }

    details summary {
        cursor: pointer;
        list-style: none;
        user-select: none;
        color: #195042;
        font-weight: 700;
    }

    details summary::-webkit-details-marker {
        display: none;
    }

    .toggle-icon {
        transition: transform 0.25s ease;
    }

    details[open] .toggle-icon {
        transform: rotate(180deg);
    }

    @@media (max-width: 576px) {
        .dashboard-card .card-header {
            padding: 0.9rem;
        }

        .child-selector-inline {
            max-width: 155px;
        }

        .child-dropdown-inline {
            width: 105px;
        }
    }
</style>

<div class="container-fluid parent-dashboard-wrapper">
    <div class="parent-logo">
        <img src="/image/LOGO.svg" alt="معين" />
    </div>

    @if (_loading)
    {
        <div class="state-box">
            <div class="spinner-border text-success" role="status"></div>
            <p class="mt-3 mb-0">جاري تحميل لوحة ولي الأمر...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="state-box error-box">
            <p class="mb-3">@_error</p>
            <button class="btn btn-sm btn-outline-danger" @onclick="ReloadAsync">إعادة المحاولة</button>
        </div>
    }
    else if (_dashboard is not null)
    {
        <div class="dashboard-card">
            <div class="card-header d-flex align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-speedometer2 fs-5"></i>
                    <h5>لوحة ولي الأمر</h5>
                </div>

                <div class="child-selector-inline">
                    <i class="bi bi-people-fill"></i>
                    <select class="child-dropdown-inline" value="@SelectedChildValue" @onchange="OnChildChanged" disabled="@(!_dashboard.Children.Any())">
                        @if (!_dashboard.Children.Any())
                        {
                            <option value="">لا يوجد طلاب</option>
                        }
                        else
                        {
                            @foreach (var child in _dashboard.Children)
                            {
                                <option value="@child.StudentId">@child.StudentName</option>
                            }
                        }
                    </select>
                    <i class="bi bi-chevron-down"></i>
                </div>
            </div>

            <div class="child-summary">
                <div class="child-avatar">@SelectedChildInitials</div>
                <div class="flex-grow-1">
                    <div class="fw-bold text-success">@Fallback(_dashboard.SelectedStudentName, "لم يتم اختيار طالب")</div>
                    <div class="small text-muted">@SelectedChildDetails</div>
                </div>
            </div>

            <div class="card-body p-3 pt-0">
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <div class="stat-box text-center">
                            <div class="icon-wrapper mb-2"><i class="bi bi-trophy-fill"></i></div>
                            <div class="small text-muted mb-1">مجموع النقاط</div>
                            <div class="stat-value">@_dashboard.Stats.TotalPoints</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-box text-center">
                            <div class="icon-wrapper mb-2"><i class="bi bi-book"></i></div>
                            <div class="small text-muted mb-1">جلسات الحفظ</div>
                            <div class="stat-value">@_dashboard.Stats.TotalMemorizations</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-box text-center">
                            <div class="icon-wrapper mb-2"><i class="bi bi-arrow-counterclockwise"></i></div>
                            <div class="small text-muted mb-1">أجزاء المراجعة</div>
                            <div class="stat-value">@_dashboard.Stats.CompletedReviewJuzCount</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-box text-center">
                            <div class="icon-wrapper mb-2"><i class="bi bi-clipboard-check"></i></div>
                            <div class="small text-muted mb-1">الاختبارات</div>
                            <div class="stat-value">@_dashboard.Stats.CompletedExamsCount</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="dashboard-card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-journal-text fs-5"></i>
                <h5>واجبات اليوم</h5>
            </div>
            <div class="card-body p-3">
                <details open>
                    <summary class="d-flex align-items-center justify-content-between py-2">
                        <span><i class="bi bi-list-task ms-2"></i>عرض واجبات اليوم</span>
                        <i class="bi bi-chevron-down toggle-icon"></i>
                    </summary>
                    <div class="mt-3">
                        @if (!_dashboard.DailyAssignments.Any())
                        {
                            <div class="small text-muted text-center py-3">لا توجد واجبات مسجلة لهذا اليوم.</div>
                        }
                        else
                        {
                            @foreach (var item in _dashboard.DailyAssignments)
                            {
                                <div class="activity-item" @key="item.Id">
                                    <span class="activity-icon"><i class="@item.IconCssClass"></i></span>
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold small">@SafeItemTitle(item)</div>
                                        <div class="small text-muted">@SafeItemSubtitle(item)</div>
                                    </div>
                                    <span class="status-badge @ItemStatusClass(item)">@SafeStatus(item)</span>
                                </div>
                            }
                        }
                    </div>
                </details>
            </div>
        </div>

        <div class="dashboard-card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-award fs-5"></i>
                <h5>آخر إنجازات الطالب</h5>
            </div>
            <div class="card-body p-3">
                <details open>
                    <summary class="d-flex align-items-center justify-content-between py-2">
                        <span><i class="bi bi-check-circle ms-2"></i>عرض آخر الإنجازات</span>
                        <i class="bi bi-chevron-down toggle-icon"></i>
                    </summary>
                    <div class="mt-3">
                        @if (!_dashboard.RecentActivities.Any())
                        {
                            <div class="small text-muted text-center py-3">لا توجد إنجازات حديثة.</div>
                        }
                        else
                        {
                            @foreach (var item in _dashboard.RecentActivities)
                            {
                                <div class="activity-item" @key="item.Id">
                                    <span class="activity-icon"><i class="@item.IconCssClass"></i></span>
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold small">@SafeItemTitle(item)</div>
                                        <div class="small text-muted">@SafeItemSubtitle(item)</div>
                                    </div>
                                    <span class="status-badge @ItemStatusClass(item)">@SafeStatus(item)</span>
                                </div>
                            }
                        }
                    </div>
                </details>
            </div>
        </div>

        <div class="dashboard-card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-bell fs-5"></i>
                <h5>تنبيهات المتابعة</h5>
            </div>
            <div class="card-body p-3">
                <details open>
                    <summary class="d-flex align-items-center justify-content-between py-2">
                        <span><i class="bi bi-exclamation-triangle ms-2"></i>عرض التنبيهات</span>
                        <i class="bi bi-chevron-down toggle-icon"></i>
                    </summary>
                    <div class="mt-3">
                        @if (!_dashboard.Alerts.Any())
                        {
                            <div class="small text-muted text-center py-3">لا توجد تنبيهات حالياً.</div>
                        }
                        else
                        {
                            @foreach (var item in _dashboard.Alerts)
                            {
                                <div class="activity-item" @key="item.Id ?? Guid.NewGuid()">
                                    <span class="activity-icon"><i class="@item.IconCssClass"></i></span>
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold small">@SafeItemTitle(item)</div>
                                        <div class="small text-muted">@SafeItemSubtitle(item)</div>
                                    </div>
                                    <span class="status-badge @ItemStatusClass(item)">@SafeStatus(item)</span>
                                </div>
                            }
                        }
                    </div>
                </details>
            </div>
        </div>
    }
</div>

@code {
    private ParentDashboardResponse? _dashboard;
    private bool _loading = true;
    private string? _error;
    private Guid? _selectedChildId;

    private string SelectedChildValue => _dashboard?.SelectedStudentId?.ToString() ?? string.Empty;

    private string SelectedChildInitials
    {
        get
        {
            var child = SelectedChild;
            return string.IsNullOrWhiteSpace(child?.StudentInitials) ? "ط" : child.StudentInitials;
        }
    }

    private string SelectedChildDetails
    {
        get
        {
            var child = SelectedChild;
            if (child == null)
                return "لا توجد بيانات طالب مرتبطة.";

            var mosque = Fallback(child.MosqueName, "المسجد غير محدد");
            var halqa = Fallback(child.HalqaName, "الحلقة غير محددة");
            return $"{mosque} · {halqa} · {child.TotalPoints} نقطة";
        }
    }

    private ParentChildDto? SelectedChild => _dashboard?.Children.FirstOrDefault(c => c.StudentId == _dashboard.SelectedStudentId);

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync(null);
    }

    private async Task ReloadAsync()
    {
        await LoadDashboardAsync(_selectedChildId);
    }

    private async Task OnChildChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        if (!Guid.TryParse(value, out var childId))
            return;

        await LoadDashboardAsync(childId);
    }

    private async Task LoadDashboardAsync(Guid? childId)
    {
        if (AppSession.CurrentMode != AppUserMode.Parent || !AppSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        _loading = true;
        _error = null;

        try
        {
            _dashboard = await ParentDashboardService.GetMyDashboardAsync(childId);
            _selectedChildId = _dashboard.SelectedStudentId;
        }
        catch (Exception ex)
        {
            _dashboard = null;
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string SafeItemTitle(StudentDashboardItemDto item)
        => Fallback(item.Title, "عنصر متابعة");

    private static string SafeItemSubtitle(StudentDashboardItemDto item)
        => Fallback(item.Subtitle, "لا توجد تفاصيل إضافية.");

    private static string SafeStatus(StudentDashboardItemDto item)
        => Fallback(item.StatusText, "متابعة");

    private static string ItemStatusClass(StudentDashboardItemDto item)
        => item.StatusKind switch
        {
            "success" => "success",
            "warning" => "warning",
            "danger" => "danger",
            _ => string.Empty
        };

    private static string Fallback(string? value, string fallback)
        => string.IsNullOrWhiteSpace(value) ? fallback : value;
}
