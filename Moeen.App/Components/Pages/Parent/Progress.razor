@page "/Parent/Progress"
@using Moeen.App.Services
@using Moeen.App.Services.Abstractions
@using Moeen.Shared.Constants
@using Moeen.Shared.Responses.Mobile
@using System.Globalization
@inject IParentProgressService ParentProgressService
@inject AppSessionService AppSession
@inject NavigationManager Navigation

<style>
    .parent-progress-page {
        direction: rtl;
        text-align: right;
        min-height: 100vh;
        padding: 1rem;
        background: #f9f7f5;
        color: #195042;
    }

    .progress-header {
        background: linear-gradient(135deg, #195042 0%, #24705d 100%);
        color: #d6cabc;
        border-radius: 1rem;
        padding: 1.25rem;
        margin-bottom: 1rem;
        box-shadow: 0 10px 24px rgba(25, 80, 66, 0.16);
    }

    .student-line {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        flex-wrap: wrap;
    }

    .student-avatar {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: #d6cabc;
        color: #195042;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        flex-shrink: 0;
    }

    .child-select {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(214, 202, 188, 0.45);
        color: #ffffff;
        border-radius: 0.75rem;
        padding: 0.55rem 0.75rem;
        outline: none;
        min-width: 170px;
    }

    .child-select option {
        color: #195042;
        background: #ffffff;
    }

    .filter-card,
    .progress-card,
    .state-box {
        background: #ffffff;
        border: 1px solid rgba(214, 202, 188, 0.5);
        border-radius: 1rem;
        box-shadow: 0 6px 16px rgba(25, 80, 66, 0.08);
    }

    .filter-card {
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 0.75rem;
        align-items: end;
    }

    .filter-label {
        display: block;
        font-size: 0.82rem;
        color: #6c757d;
        margin-bottom: 0.3rem;
        font-weight: 700;
    }

    .input,
    .select {
        width: 100%;
        border: 1px solid #e4ded2;
        border-radius: 0.75rem;
        padding: 0.6rem 0.75rem;
        color: #195042;
        background: #fbfaf7;
        outline: none;
    }

    .btn-parent {
        border: none;
        border-radius: 0.75rem;
        background: #195042;
        color: #ffffff;
        padding: 0.62rem 1rem;
        font-weight: 700;
    }

    .btn-parent.outline {
        background: #ffffff;
        color: #195042;
        border: 1px solid #195042;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .stat-card {
        background: linear-gradient(145deg, #ffffff 0%, #f4f1e8 100%);
        border: 1px solid #eae6d9;
        border-radius: 0.9rem;
        padding: 1rem 0.75rem;
        text-align: center;
    }

    .stat-icon {
        font-size: 1.35rem;
        color: #195042;
        margin-bottom: 0.4rem;
    }

    .stat-value {
        display: block;
        font-size: 1.35rem;
        font-weight: 800;
        color: #195042;
    }

    .stat-label {
        color: #6c757d;
        font-size: 0.78rem;
    }

    .progress-card {
        overflow: hidden;
        margin-bottom: 1rem;
    }

    .card-titlebar {
        background: #195042;
        color: #ffffff;
        padding: 0.9rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
    }

    .card-titlebar h5 {
        font-size: 1rem;
        font-weight: 800;
        margin: 0;
    }

    .card-body-custom {
        padding: 1rem;
    }

    .timeline-item {
        position: relative;
        padding: 0 1.25rem 1rem 0;
        border-right: 2px solid #e4ded2;
        margin-right: 0.45rem;
    }

    .timeline-item::before {
        content: '';
        position: absolute;
        right: -0.48rem;
        top: 0.2rem;
        width: 0.9rem;
        height: 0.9rem;
        border-radius: 50%;
        background: #195042;
        border: 3px solid #d6cabc;
    }

    .record-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .record-title {
        font-weight: 800;
        color: #195042;
    }

    .record-date {
        color: #6c757d;
        font-size: 0.82rem;
    }

    .record-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(115px, 1fr));
        gap: 0.5rem;
        margin-top: 0.7rem;
    }

    .record-chip {
        background: #f9f7f5;
        border: 1px solid #eae6d9;
        border-radius: 0.65rem;
        padding: 0.45rem 0.6rem;
        font-size: 0.8rem;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        border-radius: 999px;
        padding: 0.28rem 0.7rem;
        font-size: 0.76rem;
        font-weight: 800;
        background: #eef2f1;
        color: #195042;
        white-space: nowrap;
    }

    .status-badge.excellent,
    .status-badge.verygood {
        background: #d1fae5;
        color: #065f46;
    }

    .status-badge.good {
        background: #dbeafe;
        color: #1e40af;
    }

    .status-badge.warning,
    .status-badge.repeat {
        background: #fff3cd;
        color: #856404;
    }

    .summary-row {
        margin-bottom: 0.9rem;
    }

    .summary-label {
        display: flex;
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 0.35rem;
        color: #195042;
        font-size: 0.85rem;
        font-weight: 700;
    }

    .bar-bg {
        height: 0.6rem;
        background: #e9ecef;
        border-radius: 999px;
        overflow: hidden;
    }

    .bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #195042 0%, #24705d 100%);
        border-radius: 999px;
    }

    .state-box {
        padding: 1.5rem;
        text-align: center;
    }

    .error-box {
        background: #f8d7da;
        border-color: #f5c2c7;
        color: #842029;
    }

    @@media (max-width: 720px) {
        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .child-select {
            width: 100%;
        }
    }
</style>

<div class="parent-progress-page">
    @if (_loading)
    {
        <div class="state-box">
            <div class="spinner-border text-success" role="status"></div>
            <p class="mt-3 mb-0">جاري تحميل تقدم الطالب...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="state-box error-box">
            <p class="mb-3">@_error</p>
            <button class="btn-parent outline" @onclick="ReloadAsync">إعادة المحاولة</button>
        </div>
    }
    else if (_page is not null)
    {
        <section class="progress-header">
            <div class="student-line">
                <div class="student-avatar">@SelectedInitials</div>
                <div class="flex-grow-1">
                    <h4 class="mb-1 fw-bold">@Fallback(_page.SelectedStudentName, "لا يوجد طالب محدد")</h4>
                    <div class="small opacity-75">
                        ولي الأمر: @Fallback(_page.ParentName, "غير محدد")
                        <span class="mx-2">•</span>
                        رقم الطالب: @Fallback(_page.Progress.StudentNumber, "غير متوفر")
                    </div>
                </div>

                <select class="child-select" value="@SelectedChildValue" @onchange="OnChildChanged" disabled="@(!_page.Children.Any())">
                    @if (!_page.Children.Any())
                    {
                        <option value="">لا يوجد طلاب مرتبطون</option>
                    }
                    else
                    {
                        @foreach (var child in _page.Children)
                        {
                            <option value="@child.StudentId">@child.StudentName</option>
                        }
                    }
                </select>
            </div>
        </section>

        @if (!_page.Children.Any())
        {
            <div class="state-box">
                <i class="bi bi-people fs-2 d-block mb-2"></i>
                <p class="mb-0">لا يوجد طلاب مرتبطون بحساب ولي الأمر الحالي.</p>
            </div>
        }
        else
        {
            <section class="filter-card">
                <div class="filter-grid">
                    <div>
                        <label class="filter-label" for="fromDate">من تاريخ</label>
                        <input id="fromDate" type="date" class="input" value="@_fromDateText" @onchange="OnFromDateChanged" />
                    </div>
                    <div>
                        <label class="filter-label" for="toDate">إلى تاريخ</label>
                        <input id="toDate" type="date" class="input" value="@_toDateText" @onchange="OnToDateChanged" />
                    </div>
                    <div>
                        <label class="filter-label" for="recordType">نوع السجل</label>
                        <select id="recordType" class="select" value="@_selectedTypeValue" @onchange="OnTypeChanged">
                            <option value="">الكل</option>
                            <option value="1">حفظ</option>
                            <option value="2">مراجعة</option>
                            <option value="3">اختبار</option>
                            <option value="4">استماع</option>
                        </select>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn-parent flex-fill" @onclick="ApplyFiltersAsync"><i class="bi bi-funnel ms-1"></i>تطبيق</button>
                        <button class="btn-parent outline" @onclick="ResetFiltersAsync"><i class="bi bi-arrow-clockwise"></i></button>
                    </div>
                </div>
            </section>

            <section class="stats-grid">
                <div class="stat-card">
                    <i class="bi bi-book stat-icon"></i>
                    <span class="stat-value">@_page.Progress.Stats.MemorizationSessions</span>
                    <span class="stat-label">جلسات الحفظ</span>
                </div>
                <div class="stat-card">
                    <i class="bi bi-arrow-repeat stat-icon"></i>
                    <span class="stat-value">@_page.Progress.Stats.ReviewSessions</span>
                    <span class="stat-label">جلسات المراجعة</span>
                </div>
                <div class="stat-card">
                    <i class="bi bi-trophy stat-icon"></i>
                    <span class="stat-value">@_page.Progress.Stats.ExamsCount</span>
                    <span class="stat-label">الاختبارات</span>
                </div>
                <div class="stat-card">
                    <i class="bi bi-star stat-icon"></i>
                    <span class="stat-value">@_page.Progress.Stats.TotalPoints</span>
                    <span class="stat-label">مجموع النقاط</span>
                </div>
            </section>

            <section class="progress-card">
                <div class="card-titlebar">
                    <h5><i class="bi bi-clock-history ms-1"></i>سجل تقدم الطالب</h5>
                    <small>@Fallback(_page.Progress.Summary.PeriodTitle, "آخر 30 يوم")</small>
                </div>
                <div class="card-body-custom">
                    @if (!_page.Progress.Records.Any())
                    {
                        <div class="text-center text-muted py-4">لا توجد سجلات ضمن الفلاتر الحالية.</div>
                    }
                    else
                    {
                        @foreach (var record in _page.Progress.Records)
                        {
                            <div class="timeline-item" @key="record.Id">
                                <div class="record-head">
                                    <div>
                                        <div class="record-date"><i class="bi bi-calendar-check ms-1"></i>@FormatDate(record.Date)</div>
                                        <div class="record-title"><i class="@RecordIcon(record.Type) ms-1"></i>@RecordTitle(record)</div>
                                    </div>
                                    <span class="status-badge @StatusClass(record)">@RatingLabel(record)</span>
                                </div>

                                <div class="record-details">
                                    <div class="record-chip">النوع: <strong>@TypeLabel(record.Type)</strong></div>
                                    @if (record.JuzNumber.HasValue)
                                    {
                                        <div class="record-chip">الجزء: <strong>@record.JuzNumber</strong></div>
                                    }
                                    @if (record.JuzFrom.HasValue || record.JuzTo.HasValue)
                                    {
                                        <div class="record-chip">الأجزاء: <strong>@RangeText(record.JuzFrom, record.JuzTo)</strong></div>
                                    }
                                    @if (record.FromPage.HasValue || record.ToPage.HasValue)
                                    {
                                        <div class="record-chip">الصفحات: <strong>@RangeText(record.FromPage, record.ToPage)</strong></div>
                                    }
                                    @if (record.Mark.HasValue)
                                    {
                                        <div class="record-chip">العلامة: <strong>@record.Mark / 100</strong></div>
                                    }
                                    <div class="record-chip">النقاط: <strong>+@record.Points</strong></div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(record.TeacherNote))
                                {
                                    <div class="small text-muted mt-2"><i class="bi bi-chat-square-text ms-1"></i>@record.TeacherNote</div>
                                }
                            </div>
                        }
                    }
                </div>
            </section>

            <section class="progress-card">
                <div class="card-titlebar">
                    <h5><i class="bi bi-graph-up-arrow ms-1"></i>ملخص الفترة</h5>
                    <small>@_page.Progress.Summary.PointsInPeriod نقطة</small>
                </div>
                <div class="card-body-custom">
                    @SummaryBar("إنجاز الحفظ", _page.Progress.Summary.MemorizationCompletionPercentage)
                    @SummaryBar("إنجاز المراجعة", _page.Progress.Summary.ReviewCompletionPercentage)
                    @SummaryBar("متوسط التقييم", _page.Progress.Summary.AverageRatingPercentage)
                    @SummaryBar("نقاط الفترة", _page.Progress.Summary.PointsInPeriodPercentage)
                </div>
            </section>
        }
    }
</div>

@code {
    private ParentProgressResponse? _page;
    private bool _loading = true;
    private string? _error;
    private Guid? _selectedChildId;
    private string _fromDateText = string.Empty;
    private string _toDateText = string.Empty;
    private string _selectedTypeValue = string.Empty;

    private string SelectedChildValue => _page?.SelectedStudentId?.ToString() ?? string.Empty;

    private ParentChildDto? SelectedChild => _page?.Children.FirstOrDefault(c => c.StudentId == _page.SelectedStudentId);

    private string SelectedInitials => Fallback(SelectedChild?.StudentInitials ?? _page?.Progress.StudentInitials, "ط");

    protected override async Task OnInitializedAsync()
    {
        ResetDateRange();
        await LoadAsync(null);
    }

    private async Task ReloadAsync()
    {
        await LoadAsync(_selectedChildId);
    }

    private async Task OnChildChanged(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var childId))
            await LoadAsync(childId);
    }

    private void OnFromDateChanged(ChangeEventArgs args)
    {
        _fromDateText = args.Value?.ToString() ?? string.Empty;
    }

    private void OnToDateChanged(ChangeEventArgs args)
    {
        _toDateText = args.Value?.ToString() ?? string.Empty;
    }

    private void OnTypeChanged(ChangeEventArgs args)
    {
        _selectedTypeValue = args.Value?.ToString() ?? string.Empty;
    }

    private async Task ApplyFiltersAsync()
    {
        await LoadAsync(_selectedChildId);
    }

    private async Task ResetFiltersAsync()
    {
        _selectedTypeValue = string.Empty;
        ResetDateRange();
        await LoadAsync(_selectedChildId);
    }

    private async Task LoadAsync(Guid? childId)
    {
        if (AppSession.CurrentMode != AppUserMode.Parent || !AppSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        _loading = true;
        _error = null;

        try
        {
            _page = await ParentProgressService.GetMyChildProgressAsync(childId, ParseDate(_fromDateText), ParseDate(_toDateText), ParseType());
            _selectedChildId = _page.SelectedStudentId;
        }
        catch (Exception ex)
        {
            _page = null;
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetDateRange()
    {
        var today = DateTime.Today;
        _fromDateText = today.AddDays(-30).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        _toDateText = today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }

    private DateTime? ParseDate(string value)
    {
        return DateTime.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var date)
            ? date.Date
            : null;
    }

    private ProgressRecordType? ParseType()
    {
        if (!int.TryParse(_selectedTypeValue, out var value))
            return null;

        return Enum.IsDefined(typeof(ProgressRecordType), value)
            ? (ProgressRecordType)value
            : null;
    }

    private static string RecordTitle(StudentProgressRecordDto record)
    {
        return record.Type switch
        {
            ProgressRecordType.Memorization => record.FromPage.HasValue || record.ToPage.HasValue
                ? $"تسميع من صفحة {record.FromPage ?? 0} إلى {record.ToPage ?? record.FromPage ?? 0}"
                : "جلسة حفظ",
            ProgressRecordType.Review => record.JuzNumber.HasValue ? $"مراجعة الجزء {record.JuzNumber}" : "جلسة مراجعة",
            ProgressRecordType.Exam => record.JuzFrom == record.JuzTo && record.JuzFrom.HasValue
                ? $"اختبار الجزء {record.JuzFrom}"
                : "اختبار قرآني",
            ProgressRecordType.Listening => "جلسة استماع",
            _ => "سجل تقدم"
        };
    }

    private static string TypeLabel(ProgressRecordType type)
    {
        return type switch
        {
            ProgressRecordType.Memorization => "حفظ",
            ProgressRecordType.Review => "مراجعة",
            ProgressRecordType.Exam => "اختبار",
            ProgressRecordType.Listening => "استماع",
            _ => "سجل"
        };
    }

    private static string RecordIcon(ProgressRecordType type)
    {
        return type switch
        {
            ProgressRecordType.Memorization => "bi bi-book",
            ProgressRecordType.Review => "bi bi-arrow-repeat",
            ProgressRecordType.Exam => "bi bi-clipboard-check",
            ProgressRecordType.Listening => "bi bi-headphones",
            _ => "bi bi-check2-circle"
        };
    }

    private static string RatingLabel(StudentProgressRecordDto record)
    {
        return record.StatusKind switch
        {
            "excellent" => "ممتاز",
            "verygood" => "جيد جداً",
            "good" => "جيد",
            "warning" => "يحتاج متابعة",
            "repeat" => "إعادة",
            _ => record.Points > 0 ? "منجز" : "متابعة"
        };
    }

    private static string StatusClass(StudentProgressRecordDto record)
    {
        return record.StatusKind switch
        {
            "excellent" => "excellent",
            "verygood" => "verygood",
            "good" => "good",
            "warning" => "warning",
            "repeat" => "repeat",
            _ => string.Empty
        };
    }

    private static string RangeText(int? from, int? to)
    {
        if (from.HasValue && to.HasValue)
            return from.Value == to.Value ? from.Value.ToString(CultureInfo.InvariantCulture) : $"{from.Value}-{to.Value}";

        return (from ?? to)?.ToString(CultureInfo.InvariantCulture) ?? "-";
    }

    private static string FormatDate(DateTime date)
        => date.ToString("yyyy/MM/dd", CultureInfo.InvariantCulture);

    private static string Fallback(string? value, string fallback)
        => string.IsNullOrWhiteSpace(value) ? fallback : value;
}

@code {
    private RenderFragment SummaryBar(string Label, int Value) => builder =>
    {
        var seq = 0;
        var safeValue = Math.Clamp(Value, 0, 100);
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "summary-row");

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "summary-label");
        builder.OpenElement(seq++, "span");
        builder.AddContent(seq++, Label);
        builder.CloseElement();
        builder.OpenElement(seq++, "span");
        builder.AddContent(seq++, $"{safeValue}%");
        builder.CloseElement();
        builder.CloseElement();

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "bar-bg");
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "bar-fill");
        builder.AddAttribute(seq++, "style", $"width:{safeValue}%");
        builder.CloseElement();
        builder.CloseElement();

        builder.CloseElement();
    };
}
