@implements IDisposable
@inject AppSessionService AppSession
@inject NavigationManager Navigation

<div class="nav-scrollable">
    <nav class="nav-menu">

        @if (CurrentMode == AppUserMode.Guest)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="Guest/Post" Match="NavLinkMatch.All">
                    <i class="bi bi-megaphone-fill"></i>
                    <span class="nav-text">المنشورات</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="Guest/Book">
                    <i class="bi bi-book-fill"></i>
                    <span class="nav-text">المكتبة</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <button type="button" class="nav-link logout-link" @onclick="GoToEntry">
                    <i class="bi bi-arrow-right-circle"></i>
                    <span class="nav-text">اختيار نوع الدخول</span>
                </button>
            </div>
        }
        else if (CurrentMode == AppUserMode.Student)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="Student/StudentDashboard" Match="NavLinkMatch.All">
                    <i class="bi bi-house-door-fill"></i>
                    <span class="nav-text">الرئيسية</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="Student/Book">
                    <i class="bi bi-book-fill"></i>
                    <span class="nav-text">المكتبة</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="Student/Post">
                    <i class="bi bi-megaphone-fill"></i>
                    <span class="nav-text">المنشورات</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="Student/Progress">
                    <i class="bi bi-graph-up-arrow"></i>
                    <span class="nav-text">التقدم</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="Student/Profile">
                    <i class="bi bi-person-circle"></i>
                    <span class="nav-text">الملف الشخصي</span>
                </NavLink>
            </div>

            <div class="nav-item logout-item">
                <button type="button" class="nav-link logout-link" @onclick="LogoutAsync">
                    <i class="bi bi-box-arrow-right"></i>
                    <span class="nav-text">تسجيل الخروج</span>
                </button>
            </div>
        }
        else if (CurrentMode == AppUserMode.Parent)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="Parent/Parentdashboard" Match="NavLinkMatch.All">
                    <i class="bi bi-house-door-fill"></i>
                    <span class="nav-text">الرئيسية</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="Parent/Post">
                    <i class="bi bi-megaphone-fill"></i>
                    <span class="nav-text">المنشورات</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="Parent/Book">
                    <i class="bi bi-book-fill"></i>
                    <span class="nav-text">المكتبة</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="Parent/Progress">
                    <i class="bi bi-graph-up-arrow"></i>
                    <span class="nav-text">التقدم</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="Parent/Profile">
                    <i class="bi bi-person-circle"></i>
                    <span class="nav-text">الملف الشخصي</span>
                </NavLink>
            </div>

            <div class="nav-item logout-item">
                <button type="button" class="nav-link logout-link" @onclick="LogoutAsync">
                    <i class="bi bi-box-arrow-right"></i>
                    <span class="nav-text">تسجيل الخروج</span>
                </button>
            </div>
        }

    </nav>
</div>

@code {
    private AppUserMode CurrentMode => AppSession.CurrentMode ?? AppUserMode.Guest;

    protected override void OnInitialized()
    {
        AppSession.Changed += OnSessionChanged;
    }

    private async Task LogoutAsync()
    {
        await AppSession.LogoutAsync();
        Navigation.NavigateTo("/", replace: true);
    }

    private void GoToEntry()
    {
        AppSession.Clear();
        Navigation.NavigateTo("/", replace: true);
    }

    private void OnSessionChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AppSession.Changed -= OnSessionChanged;
    }
}
