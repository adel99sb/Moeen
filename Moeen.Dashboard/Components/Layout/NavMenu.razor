@rendermode InteractiveServer
@inject IAuthSessionService AuthSession

<div class="top-row ps-3 navbar navbar-dark">
    <div>
        <label style="color:red; margin-left: 10px;">الدور الحالي:</label>
        <strong>@CurrentRoleLabel</strong>
    </div>
    <div class="container-fluid">
        <a class="navbar-brand" href="">Dashboard</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        @if (CurrentRole == "owner")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill"></span> Home
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/owner/AccountManagement">
                    <span class="bi bi-person-lines-fill"></span> حسابات المستخدمين
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/management/mosques-management">
                    <span class="bi bi-building"></span> إدارة المساجد
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/settings">
                    <span class="bi bi-gear" aria-hidden="true"></span>
                    <span>إعدادات</span>
                </NavLink>
            </div>
        }
        else if (CurrentRole == "supervisor")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/supervisor/SupervisorDashboard" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill"></span> إحصائيات رئيسية
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/supervisor/student">
                    <span class="bi bi-mortarboard-fill"></span> إدارة طلاب
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/supervisor/teacher">
                    <span class="bi bi-person-workspace"></span> إدارة معلمين
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/supervisor/managementfouj">
                    <span class="bi bi-diagram-3 nav-menu"></span>
                    <span>الأفواج والحلقات</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/supervisor/book">
                    <span class="bi bi-book-fill"></span> إدارة الكتب
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/parents">
                    <span class="bi bi-people-fill"></span> إدارة الأهالي
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/supervisor/complaint-and-suggestions">
                    <span class="bi bi-chat-dots-fill nav-menu"></span>
                    <span>الشكاوي</span>
                </NavLink>
            </div>
        }
        else if (CurrentRole == "teacher")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/Teacher/TeacherDashboard" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill"></span> الرئيسية
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/Teacher/Halaka">
                    <span class="bi bi-graph-up-arrow"></span> تقدم حلقاتي
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/Teacher/WeekSessions">
                    <span class="bi bi-calendar-check-fill"></span> الدروس الاسبوعية
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/Teacher/Library">
                    <span class="bi bi-journals"></span> المكتبة
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/Teacher/Profile">
                    <span class="bi bi-person-circle"></span> ملفي الشخصي
                </NavLink>
            </div>
        }
        else if (CurrentRole == "examer")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/Examer/Dashboard" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill"></span> الرئيسية
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/examer/exam">
                    <span class="bi bi-mortarboard-fill"></span> إدارة طلاب
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/examer/postexamer">
                    <span class="bi bi-megaphone-fill"></span> الاعلانات
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/examer/bookexamer">
                    <span class="bi bi-journals"></span> المكتبة
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/examer/profileexamer">
                    <span class="bi bi-person-circle"></span> ملفي الشخصي
                </NavLink>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/Teacher/Profile">
                    <span class="bi bi-person-circle"></span> ملفي الشخصي
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private string CurrentRole => AuthSession.Role?.ToLowerInvariant() ?? "owner";
    private string CurrentRoleLabel => CurrentRole switch
    {
        "owner" => "مالك",
        "supervisor" => "مشرف",
        "teacher" => "معلم",
        "examer" => "مختبر",
        _ => "غير محدد"
    };
}
