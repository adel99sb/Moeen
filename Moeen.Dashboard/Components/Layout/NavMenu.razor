@rendermode InteractiveServer


<div class="top-row ps-3 navbar navbar-dark">
    <div>
        <label style="color:red; margin-left: 10px;">اختر الدور:</label>
        <select @bind="userRole" style="padding: 5px; border-radius: 5px;">
            <option value="owner"> مالك</option>
            <option value="supervisor"> مشرف</option>
            <option value="teacher"> معلم</option>
        </select>
    </div>
    <div class="container-fluid">
        <a class="navbar-brand" href="">Dashboard</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        
        @if (userRole == "owner")
        {
            <!-- قائمة المالك -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill"></span> Home
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/owner/AccountManagement">
                    <span class="bi bi-person-lines-fill"></span> حسابات المستخدمين
                </NavLink>
            </div>
           
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/management/mosques-management">
                    <span class="bi bi-building"></span> إدارة المساجد
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="style-guide">
                    <span class="bi bi-palette-fill nav-menu" aria-hidden="true"></span>
                    <span>نموذج</span>
                </NavLink>
            </div>

        }
        else if (userRole == "supervisor")
        {
            <!-- قائمة المشرف -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill"></span> الرئيسية
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="supervisor/student">
                    <span class="bi bi-mortarboard-fill"></span> إدارة طلاب
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="supervisor/teacher">
                    <span class="bi bi-person-workspace"></span> إدارة معلمين
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="supervisor/fouj-and-halqa">
                    <span class="bi bi-diagram-3-fill"></span> الأفواج والحلقات
                <NavLink class="nav-link" href="/supervisor/managementfouj">
                    <span class="bi bi-diagram-3 nav-menu"></span>
                    <span>الأفواج والحلقات</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="supervisor/book">
                    <span class="bi bi-book-fill"></span> إدارة الكتب
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/parents">
                    <span class="bi bi-people-fill"></span> إدارة الأهالي
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="supervisor/posts">
                    <span class="bi bi-megaphone-fill nav-menu"></span>
                    <span>المنشورات</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="supervisor/complaint-and-suggestions">
                    <span class="bi bi-chat-dots-fill nav-menu"></span>
                    <span>الشكاوي</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="supervisor/reports">
                    <span class="bi bi-file-earmark-text-fill nav-menu"></span>
                    <span>التقارير</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/supervisor/managementfouj">
                    <span class="bi bi-people-fill nav-menu"></span>
                    <span>إدارة halaqa</span>
                </NavLink>
            </div>
            
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="supervisor/saturdaylesson">
                    <span class="bi bi-calendar-week-fill nav-menu"></span>
                    <span>دروس السبت</span>
                </NavLink>
            </div>


        }
        else if (userRole == "teacher")
        {
            <!-- قائمة المعلم -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Teacher/TeacherDashboard" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill"></span> الرئيسية
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Teacher/MyLessons">
                    <span class="bi bi-graph-up-arrow"></span> تقدم حلقاتي
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Teacher/Attendance">
                    <span class="bi bi-calendar-check-fill"></span>  الدروس الاسبوعية
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Teacher/Profile">
                    <span class="bi bi-journals"></span> المكتبة
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Teacher/Profile">
                    <span class="bi bi-megaphone-fill"></span>  الاعلانات
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/examer/exam">
                    <span class="bi bi-people nav-menu"></span>
                    <span>اختبارات</span>
                </NavLink>
            </div>
          
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Teacher/Profile">
                    <span class="bi bi-person-circle"></span> ملفي الشخصي
                </NavLink>
            </div>
        }

    </nav>
</div>

@code {
    private string userRole = "owner";
}