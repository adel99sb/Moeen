@rendermode InteractiveServer
@using Moeen.Dashboard.Services.Abstractions
@inject ITokenService TokenService
@inject NavigationManager Nav

<div class="sidebar-header">
    <a class="sidebar-brand" href="">
        <span class="sidebar-brand-icon bi bi-grid-1x2-fill" aria-hidden="true"></span>
        <span>لوحة تحكم</span>
    </a>

    <div class="sidebar-role-card">
        @if (isLoadingRole)
        {
            <span class="role-loading">جاري تحميل الصلاحيات...</span>
        }
        else
        {
            <span class="role-label">الدور الحالي</span>
            <span class="role-value">
                <span class="bi bi-person-badge" aria-hidden="true"></span>
                @GetRoleLabel(userRole)
            </span>
        }
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler')?.click()">
    <nav class="sidebar-nav flex-column">
        @if (userRole == "owner")
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill"></span>
                    <span>الرئيسية</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="/owner/AccountManagement">
                    <span class="bi bi-person-lines-fill"></span>
                    <span>حسابات المستخدمين</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="/management/mosques-management">
                    <span class="bi bi-building"></span>
                    <span>إدارة المساجد</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="style-guide">
                    <span class="bi bi-palette-fill" aria-hidden="true"></span>
                    <span>نموذج</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="/settings">
                    <span class="bi bi-gear" aria-hidden="true"></span>
                    <span>إعدادات</span>
                </NavLink>
            </div>
        }
        else if (userRole == "supervisor")
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="/supervisor/SupervisorDashboard" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill"></span>
                    <span>إحصائيات رئيسية</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="supervisor/student">
                    <span class="bi bi-mortarboard-fill"></span>
                    <span>إدارة الطلاب</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="supervisor/teacher">
                    <span class="bi bi-person-workspace"></span>
                    <span>إدارة المعلمين</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="/supervisor/managementfouj">
                    <span class="bi bi-diagram-3"></span>
                    <span>الأفواج والحلقات</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="supervisor/book">
                    <span class="bi bi-book-fill"></span>
                    <span>إدارة الكتب</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="/parents">
                    <span class="bi bi-people-fill"></span>
                    <span>إدارة الأهالي</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="supervisor/posts">
                    <span class="bi bi-megaphone-fill"></span>
                    <span>المنشورات</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="supervisor/complaint-and-suggestions">
                    <span class="bi bi-chat-dots-fill"></span>
                    <span>الشكاوي</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="supervisor/saturdaylesson">
                    <span class="bi bi-calendar-week-fill"></span>
                    <span>دروس السبت</span>
                </NavLink>
            </div>
        }
        else if (userRole == "teacher")
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="Teacher/TeacherDashboard" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill"></span>
                    <span>الرئيسية</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="Teacher/Halaka">
                    <span class="bi bi-graph-up-arrow"></span>
                    <span>تقدم حلقاتي</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="Teacher/WeekSessions">
                    <span class="bi bi-calendar-check-fill"></span>
                    <span>الدروس الأسبوعية</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="Teacher/Library">
                    <span class="bi bi-journals"></span>
                    <span>المكتبة</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="Teacher/Post">
                    <span class="bi bi-megaphone-fill"></span>
                    <span>الإعلانات</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="Teacher/Profile">
                    <span class="bi bi-person-circle"></span>
                    <span>ملفي الشخصي</span>
                </NavLink>
            </div>
        }
        else if (userRole == "examer")
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="/Examer/Dashboard" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill"></span>
                    <span>الرئيسية</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="examer/exam">
                    <span class="bi bi-mortarboard-fill"></span>
                    <span>إدارة الطلاب</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="examer/postexamer">
                    <span class="bi bi-megaphone-fill"></span>
                    <span>الإعلانات</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="examer/bookexamer">
                    <span class="bi bi-journals"></span>
                    <span>المكتبة</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="examer/profileexamer">
                    <span class="bi bi-person-circle"></span>
                    <span>ملفي الشخصي</span>
                </NavLink>
            </div>
        }
        else
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="Teacher/Profile">
                    <span class="bi bi-person-circle"></span>
                    <span>ملفي الشخصي</span>
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private string? userRole;
    private bool isLoadingRole = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var session = await TokenService.GetSession();
        if (!session.IsAuthenticated)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        userRole = session.PrimaryRole;
        isLoadingRole = false;
        StateHasChanged();
    }

    private static string GetRoleLabel(string? role)
        => role switch
        {
            "owner" => "مالك",
            "supervisor" => "مشرف",
            "teacher" => "أستاذ",
            "examer" => "مختبر",
            _ => "غير معروف"
        };
}
