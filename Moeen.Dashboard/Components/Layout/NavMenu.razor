@rendermode InteractiveServer
@using Moeen.Dashboard.Services.Abstractions
@inject ITokenService TokenService
@inject NavigationManager Nav

<div class="sidebar-header">
    <a class="sidebar-brand" href="@HomeRoute">
        <span class="sidebar-brand-icon bi bi-grid-1x2-fill" aria-hidden="true"></span>
        <span>لوحة معين</span>
    </a>

    <div class="sidebar-role-card">
        @if (isLoadingRole)
        {
            <span class="role-loading">جاري تحميل الصلاحيات...</span>
        }
        else
        {
            <span class="role-label">نوع الحساب</span>
            <span class="role-value">
                <span class="bi bi-person-badge" aria-hidden="true"></span>
                @GetRoleLabel(userRole)
            </span>
        }
    </div>
</div>

<input type="checkbox" title="فتح القائمة" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler')?.click()">
    <nav class="sidebar-nav flex-column">
        @foreach (var item in CurrentMenuItems)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="@item.Href" Match="@item.Match">
                    <span class="@($"bi {item.Icon}")" aria-hidden="true"></span>
                    <span>@item.Label</span>
                </NavLink>
            </div>
        }

        @if (!isLoadingRole)
        {
            <div class="nav-item nav-item-separator">
                <button type="button" class="nav-link logout-link" @onclick="LogoutAsync">
                    <span class="bi bi-box-arrow-right" aria-hidden="true"></span>
                    <span>تسجيل الخروج</span>
                </button>
            </div>
        }
    </nav>
</div>

@code {
    private string? userRole;
    private string homeRoute = "/";
    private bool isLoadingRole = true;

    private string HomeRoute => string.IsNullOrWhiteSpace(homeRoute) ? "/" : homeRoute;

    private IReadOnlyList<DashboardMenuItem> CurrentMenuItems => userRole switch
    {
        "owner" => OwnerMenu,
        "supervisor" => SupervisorMenu,
        "teacher" => TeacherMenu,
        "examer" => ExamerMenu,
        _ => Array.Empty<DashboardMenuItem>()
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var session = await TokenService.GetSession();
        if (!session.IsAuthenticated)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        userRole = session.PrimaryRole;
        homeRoute = session.HomeRoute;
        isLoadingRole = false;
        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        await TokenService.Clear();
        Nav.NavigateTo("/", replace: true);
    }

    private static string GetRoleLabel(string? role)
        => role switch
        {
            "owner" => "مالك النظام",
            "supervisor" => "مشرف",
            "teacher" => "معلم",
            "examer" => "مختبر",
            _ => "غير محدد"
        };

    private sealed record DashboardMenuItem(string Label, string Href, string Icon, NavLinkMatch Match = NavLinkMatch.Prefix);

    private static readonly IReadOnlyList<DashboardMenuItem> OwnerMenu = new[]
    {
        new DashboardMenuItem("الرئيسية", "/owner/dashboard", "bi-house-door-fill", NavLinkMatch.All),
        new DashboardMenuItem("إدارة الحسابات", "/owner/AccountManagement", "bi-person-lines-fill"),
        new DashboardMenuItem("إدارة المساجد", "/management/mosques-management", "bi-building"),
        new DashboardMenuItem("الإعدادات", "/settings", "bi-gear")
    };

    private static readonly IReadOnlyList<DashboardMenuItem> SupervisorMenu = new[]
    {
        new DashboardMenuItem("الرئيسية", "/Supervisor/SupervisorDashboard", "bi-house-door-fill", NavLinkMatch.All),
        new DashboardMenuItem("إدارة الطلاب", "/supervisor/student", "bi-mortarboard-fill"),
        new DashboardMenuItem("إدارة المعلمين", "/supervisor/teacher", "bi-person-workspace"),
        new DashboardMenuItem("إدارة الأفواج", "/supervisor/managementfouj", "bi-diagram-3"),
        new DashboardMenuItem("إدارة الحلقات", "/supervisor/managementhalqa", "bi-diagram-2-fill"),
        new DashboardMenuItem("إدارة الأهالي", "/parents", "bi-people-fill"),
        new DashboardMenuItem("المكتبة", "/supervisor/book", "bi-book-fill"),
        new DashboardMenuItem("المنشورات", "/supervisor/posts", "bi-megaphone-fill"),
        new DashboardMenuItem("الشكاوى والاقتراحات", "/supervisor/complaint-and-suggestions", "bi-chat-dots-fill"),
        new DashboardMenuItem("الدروس الأسبوعية", "/supervisor/saturdaylesson", "bi-calendar-week-fill")
    };

    private static readonly IReadOnlyList<DashboardMenuItem> TeacherMenu = new[]
    {
        new DashboardMenuItem("الرئيسية", "/Teacher/TeacherDashboard", "bi-house-door-fill", NavLinkMatch.All),
        new DashboardMenuItem("حلقاتي", "/Teacher/Halaka", "bi-collection-fill"),
        new DashboardMenuItem("جلسات الأسبوع", "/Teacher/WeekSessions", "bi-calendar-check-fill"),
        new DashboardMenuItem("المكتبة", "/Teacher/Library", "bi-journals"),
        new DashboardMenuItem("المنشورات", "/Teacher/Post", "bi-megaphone-fill"),
        new DashboardMenuItem("الشكاوى والاقتراحات", "/Teacher/feedback", "bi-chat-dots-fill"),
        new DashboardMenuItem("الملف الشخصي", "/Teacher/Profile", "bi-person-circle")
    };

    private static readonly IReadOnlyList<DashboardMenuItem> ExamerMenu = new[]
    {
        new DashboardMenuItem("الرئيسية", "/Examer/Dashboard", "bi-house-door-fill", NavLinkMatch.All),
        new DashboardMenuItem("الطلاب والاختبارات", "/examer/exam", "bi-mortarboard-fill"),
        new DashboardMenuItem("المنشورات", "/examer/postexamer", "bi-megaphone-fill"),
        new DashboardMenuItem("المكتبة", "/examer/bookexamer", "bi-journals"),
        new DashboardMenuItem("الشكاوى والاقتراحات", "/examer/feedback", "bi-chat-dots-fill"),
        new DashboardMenuItem("الملف الشخصي", "/examer/profileexamer", "bi-person-circle")
    };
}
