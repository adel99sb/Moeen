@inherits LayoutComponentBase
@using Moeen.Dashboard.Services.Abstractions
@inject ITokenService TokenService
@inject NavigationManager Nav

<div class="page dashboard-shell" dir="rtl">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="dashboard-main">
        <header class="dashboard-topbar">
            <button class="dashboard-logout-button" type="button" @onclick="Logout">
                <span class="bi bi-box-arrow-left" aria-hidden="true"></span>
                <span>تسجيل الخروج</span>
            </button>
        </header>

        <article class="content dashboard-content">
            <DashboardCrashBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="problem">
                    <DashboardCrashPanel Problem="problem" />
                </ErrorContent>
            </DashboardCrashBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    حدث خطأ غير متوقع.
    <a href="" class="reload">إعادة تحميل</a>
    <a class="dismiss">×</a>
</div>

@code {
    private async Task Logout()
    {
        await TokenService.Clear();
        Nav.NavigateTo("/", replace: true);
    }
}
