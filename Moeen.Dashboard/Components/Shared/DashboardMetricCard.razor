<div class="dashboard-metric-card">
    <div class="dashboard-metric-icon @IconClass">
        <i class="@Icon"></i>
    </div>
    <div>
        <small class="dashboard-metric-label">@Label</small>
        <h4 class="dashboard-metric-value">@Value</h4>
        @if (!string.IsNullOrWhiteSpace(Hint))
        {
            <div class="dashboard-metric-hint">@Hint</div>
        }
    </div>
</div>

<style>
    .dashboard-metric-card {
        background: #fff;
        border: 1px solid #dfece7;
        border-radius: 18px;
        padding: 18px;
        height: 100%;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 8px 24px rgba(25, 80, 66, 0.06);
        transition: transform .2s ease, border-color .2s ease;
    }

    .dashboard-metric-card:hover {
        transform: translateY(-3px);
        border-color: #195042;
    }

    .dashboard-metric-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: #f4f1ee;
        color: #195042;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex: 0 0 auto;
    }

    .dashboard-metric-icon.danger { color: #b42318; background: #fff1f1; }
    .dashboard-metric-icon.info { color: #145c9e; background: #eef7ff; }
    .dashboard-metric-icon.gold { color: #8a6d1d; background: #fff8df; }

    .dashboard-metric-label {
        display: block;
        color: #6b7280;
        margin-bottom: 4px;
    }

    .dashboard-metric-value {
        margin: 0;
        color: #195042;
        font-weight: 800;
    }

    .dashboard-metric-hint {
        margin-top: 3px;
        color: #8a8f98;
        font-size: .85rem;
    }
</style>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string Icon { get; set; } = "bi bi-info-circle";
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string IconClass { get; set; } = string.Empty;
}
