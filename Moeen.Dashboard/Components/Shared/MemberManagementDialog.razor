@using Moeen.Shared.Responses.Mosuq
@using Moeen.Shared.Responses.Fouj
@using Moeen.Shared.Responses.Halqa

@if (IsOpen)
{
    <div class="moeen-dialog-backdrop" @onclick="CancelAsync">
        <div class="moeen-management-dialog" @onclick:stopPropagation="true">
            <div class="moeen-dialog-header">
                <div>
                    <h3 class="moeen-dialog-title">
                        <i class="@(IsEditMode ? "bi bi-pencil-square" : "bi bi-person-plus")"></i>
                        @(IsEditMode ? $"تعديل بيانات {EntityName}" : $"إضافة {EntityName} جديد")
                    </h3>
                    <p class="moeen-dialog-subtitle">املأ البيانات ثم اضغط تطبيق، سيتم تحديث الجدول تلقائياً بعد الحفظ.</p>
                </div>
                <button class="moeen-dialog-close" type="button" @onclick="CancelAsync" disabled="@IsSaving">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm Model="Model" OnValidSubmit="ApplyAsync">
                <DataAnnotationsValidator />
                <DashboardValidationSummary />
                <div class="moeen-dialog-body">
                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="alert alert-danger">@ErrorMessage</div>
                    }

                    <div class="moeen-form-grid">
                        <div class="moeen-form-field">
                            <label>الاسم الكامل</label>
                            <InputText class="form-control moeen-control" @bind-Value="Model.Name" placeholder="أدخل الاسم" />
                            <ValidationMessage For="@(() => Model.Name)" />
                        </div>

                        <div class="moeen-form-field">
                            <label>البريد الإلكتروني</label>
                            <InputText class="form-control moeen-control" @bind-Value="Model.Email" placeholder="name@example.com" />
                            <ValidationMessage For="@(() => Model.Email)" />
                        </div>

                        <div class="moeen-form-field">
                            <label>رقم الهاتف</label>
                            <InputText class="form-control moeen-control" @bind-Value="Model.Phone" placeholder="اختياري" />
                            <ValidationMessage For="@(() => Model.Phone)" />
                        </div>

                        <div class="moeen-form-field">
                            <label>الجنس</label>
                            <InputSelect class="form-control moeen-control" @bind-Value="Model.Gender">
                                <option value="Male">ذكر</option>
                                <option value="Female">أنثى</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => Model.Gender)" />
                        </div>

                        @if (ShowJoinedAt)
                        {
                            <div class="moeen-form-field">
                                <label>تاريخ التسجيل</label>
                                <InputDate class="form-control moeen-control" @bind-Value="Model.JoinedAt" />
                            </div>
                        }

                        @if (ShowStatus)
                        {
                            <div class="moeen-form-field">
                                <label>حالة الحساب</label>
                                <InputSelect class="form-control moeen-control" @bind-Value="Model.Status">
                                    <option value="0">نشط</option>
                                    <option value="1">متوقف</option>
                                    <option value="2">متخرج</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => Model.Status)" />
                            </div>
                        }

                        @if (ShowScore)
                        {
                            <div class="moeen-form-field">
                                <label>النقاط</label>
                                <InputNumber class="form-control moeen-control" @bind-Value="Model.Score" />
                                <ValidationMessage For="@(() => Model.Score)" />
                            </div>
                        }

                        @if (ShowMosque)
                        {
                            <div class="moeen-form-field">
                                <label>المسجد</label>
                                <InputSelect class="form-control moeen-control" @bind-Value="Model.MosqueId" disabled="@DisableMosque">
                                    <option value="@Guid.Empty">اختر المسجد</option>
                                    @foreach (var mosque in Mosques)
                                    {
                                        <option value="@mosque.Id">@mosque.name</option>
                                    }
                                </InputSelect>
                            </div>
                        }

                        @if (ShowFouj)
                        {
                            <div class="moeen-form-field">
                                <label>الفوج</label>
                                <InputSelect class="form-control moeen-control" @bind-Value="Model.FoujId" disabled="@DisableFoujAndHalqa">
                                    <option value="@Guid.Empty">اختر الفوج</option>
                                    @foreach (var fouj in Foujs)
                                    {
                                        <option value="@fouj.Id">@fouj.Name</option>
                                    }
                                </InputSelect>
                            </div>
                        }

                        @if (ShowHalqa)
                        {
                            <div class="moeen-form-field">
                                <label>الحلقة</label>
                                <InputSelect class="form-control moeen-control" @bind-Value="Model.HalqaId" disabled="@DisableFoujAndHalqa">
                                    <option value="">اختر الحلقة</option>
                                    @foreach (var halqa in DialogHalqas)
                                    {
                                        <option value="@halqa.Id">@halqa.Name</option>
                                    }
                                </InputSelect>
                            </div>
                        }

                        @if (ShowPassword)
                        {
                            <div class="moeen-form-field">
                                <label>كلمة المرور</label>
                                <InputText type="password" class="form-control moeen-control" @bind-Value="Model.Password" placeholder="كلمة مرور الحساب" />
                                <ValidationMessage For="@(() => Model.Password)" />
                            </div>
                        }

                        @if (ShowAssignedAt)
                        {
                            <div class="moeen-form-field">
                                <label>تاريخ التعيين</label>
                                <InputDate class="form-control moeen-control" @bind-Value="Model.AssignedAt" />
                                <ValidationMessage For="@(() => Model.AssignedAt)" />
                            </div>
                        }

                        @if (ShowBio)
                        {
                            <div class="moeen-form-field moeen-form-field-full">
                                <label>لمحة عن الخبرات</label>
                                <InputTextArea class="form-control moeen-control moeen-textarea" @bind-Value="Model.Bio" placeholder="اكتب نبذة مختصرة عن المعلم..." />
                                <ValidationMessage For="@(() => Model.Bio)" />
                            </div>
                        }
                    </div>
                </div>

                <div class="moeen-dialog-footer">
                    <button class="moeen-btn-primary" type="submit" disabled="@IsSaving">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>جاري التطبيق...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle"></i>
                            <span>تطبيق</span>
                        }
                    </button>
                    <button class="moeen-btn-light" type="button" @onclick="CancelAsync" disabled="@IsSaving">
                        <i class="bi bi-x-circle"></i>
                        <span>إلغاء</span>
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<style>
    .moeen-dialog-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 28px;
        background: rgba(9, 30, 24, 0.42);
        backdrop-filter: blur(7px);
        direction: rtl;
    }

    .moeen-management-dialog {
        width: min(100%, 820px);
        max-height: calc(100vh - 56px);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        border-radius: 26px;
        background: #fff;
        box-shadow: 0 30px 90px rgba(0, 0, 0, 0.24);
        color: #163f35;
    }

    .moeen-management-dialog > form {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .moeen-dialog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 24px 28px;
        border-bottom: 1px solid #eee8e0;
        background: linear-gradient(135deg, #f7f3ed 0%, #fff 100%);
    }

    .moeen-dialog-header {
        flex-shrink: 0;
    }

    .moeen-dialog-title {
        margin: 0;
        color: #195042;
        font-size: 1.35rem;
        font-weight: 900;
    }

    .moeen-dialog-subtitle {
        margin: 6px 0 0;
        color: #7b7067;
        font-size: 0.92rem;
    }

    .moeen-dialog-close {
        width: 42px;
        height: 42px;
        border: 0;
        border-radius: 14px;
        background: #f4f1e8;
        color: #195042;
        font-size: 1.15rem;
    }

    .moeen-dialog-body {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: 26px 28px;
    }

    .moeen-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .moeen-form-field-full {
        grid-column: 1 / -1;
    }

    .moeen-form-field label {
        display: block;
        margin-bottom: 9px;
        color: #263f37;
        font-weight: 800;
        font-size: 0.92rem;
    }

    .moeen-control {
        min-height: 48px;
        border: 1px solid #ddd5cc;
        border-radius: 13px;
        background-color: #fbfaf8;
        color: #163f35;
    }

    .moeen-control:focus {
        border-color: #195042;
        box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.10);
        background-color: #fff;
    }

    .moeen-textarea {
        min-height: 96px;
        resize: vertical;
    }

    .validation-message {
        display: block;
        margin-top: 7px;
        color: #b42318;
        font-size: 0.82rem;
    }

    .moeen-dialog-footer {
        display: flex;
        justify-content: flex-start;
        gap: 12px;
        padding: 20px 28px 24px;
        border-top: 1px solid #eee8e0;
        background: #fff;
    }

    .moeen-dialog-footer {
        flex-shrink: 0;
    }

    .moeen-btn-primary,
    .moeen-btn-light {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 0 17px;
        border-radius: 14px;
        font-weight: 800;
        transition: transform 0.18s ease, background 0.18s ease;
    }

    .moeen-btn-primary {
        background: #195042;
        color: #fff;
        border: 0;
        box-shadow: 0 14px 28px rgba(25, 80, 66, 0.18);
    }

    .moeen-btn-primary:hover:not(:disabled) {
        background: #123d32;
        transform: translateY(-1px);
    }

    .moeen-btn-light {
        background: #f4f1e8;
        color: #195042;
        border: 1px solid #e2dbd2;
    }

    .moeen-btn-primary:disabled,
    .moeen-btn-light:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    @@media (max-width: 760px) {
        .moeen-dialog-backdrop { padding: 12px; }
        .moeen-form-grid { grid-template-columns: 1fr; }
        .moeen-dialog-header,
        .moeen-dialog-body,
        .moeen-dialog-footer { padding-left: 18px; padding-right: 18px; }
    }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public string EntityName { get; set; } = "عضو";
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public MemberManagementDialogModel Model { get; set; } = new();
    [Parameter] public List<MosquDto> Mosques { get; set; } = new();
    [Parameter] public List<FoujDto> Foujs { get; set; } = new();
    [Parameter] public List<HalqaDto> Halqas { get; set; } = new();
    [Parameter] public bool ShowMosque { get; set; } = true;
    [Parameter] public bool DisableMosque { get; set; }
    [Parameter] public bool ShowFouj { get; set; }
    [Parameter] public bool ShowHalqa { get; set; }
    [Parameter] public bool DisableFoujAndHalqa { get; set; }
    [Parameter] public bool ShowPassword { get; set; } = true;
    [Parameter] public bool ShowJoinedAt { get; set; } = true;
    [Parameter] public bool ShowStatus { get; set; }
    [Parameter] public bool ShowScore { get; set; }
    [Parameter] public bool ShowBio { get; set; }
    [Parameter] public bool ShowAssignedAt { get; set; }
    [Parameter] public EventCallback OnApply { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private IEnumerable<HalqaDto> DialogHalqas => Model.FoujId == Guid.Empty
        ? Halqas
        : Halqas.Where(halqa => halqa.FoujId == Model.FoujId);

    private async Task ApplyAsync()
        => await OnApply.InvokeAsync();

    private async Task CancelAsync()
    {
        if (!IsSaving)
            await OnCancel.InvokeAsync();
    }
}
