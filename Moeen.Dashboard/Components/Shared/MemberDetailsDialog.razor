@if (IsOpen)
{
    <div class="details-dialog-backdrop" @onclick="CloseAsync">
        <div class="details-dialog" @onclick:stopPropagation="true">
            <div class="details-dialog-header">
                <div class="details-title-wrap">
                    <span class="details-avatar"><i class="bi bi-person-vcard"></i></span>
                    <div>
                        <h3 class="details-title">@Model.Title</h3>
                        <p class="details-subtitle">@Model.Subtitle</p>
                    </div>
                </div>
                <button class="details-close" type="button" @onclick="CloseAsync">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="details-dialog-body">
                @if (Model.Sections.Count == 0)
                {
                    <div class="details-empty">لا توجد بيانات للعرض.</div>
                }
                else
                {
                    @foreach (var detailsSection in Model.Sections)
                    {
                        <div class="details-section">
                            @if (!string.IsNullOrWhiteSpace(detailsSection.Title))
                            {
                                <h4 class="details-section-title">@detailsSection.Title</h4>
                            }
                            <div class="details-grid">
                                @foreach (var item in detailsSection.Items)
                                {
                                    <div class="details-item @(item.Wide ? "details-item-wide" : string.Empty)">
                                        <span class="details-label">@item.Label</span>
                                        <span class="details-value">@(string.IsNullOrWhiteSpace(item.Value) ? "—" : item.Value)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="details-dialog-footer">
                <button class="details-primary" type="button" @onclick="CloseAsync">
                    <i class="bi bi-check2-circle"></i>
                    <span>تم</span>
                </button>
            </div>
        </div>
    </div>
}

<style>
    .details-dialog-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 28px;
        background: rgba(9, 30, 24, 0.42);
        backdrop-filter: blur(7px);
        direction: rtl;
    }

    .details-dialog {
        width: min(100%, 780px);
        max-height: calc(100vh - 56px);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        border-radius: 26px;
        background: #fff;
        box-shadow: 0 30px 90px rgba(0, 0, 0, 0.24);
        color: #163f35;
    }

    .details-dialog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 24px 28px;
        border-bottom: 1px solid #eee8e0;
        background: linear-gradient(135deg, #f7f3ed 0%, #fff 100%);
    }

    .details-title-wrap {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .details-avatar {
        width: 52px;
        height: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: #195042;
        color: #fff;
        font-size: 1.35rem;
        box-shadow: 0 14px 28px rgba(25, 80, 66, 0.18);
    }

    .details-title {
        margin: 0;
        color: #195042;
        font-size: 1.35rem;
        font-weight: 900;
    }

    .details-subtitle {
        margin: 6px 0 0;
        color: #7b7067;
        font-size: 0.92rem;
    }

    .details-close {
        width: 42px;
        height: 42px;
        border: 0;
        border-radius: 14px;
        background: #f4f1e8;
        color: #195042;
        font-size: 1.15rem;
    }

    .details-dialog-body {
        overflow-y: auto;
        padding: 26px 28px;
    }

    .details-section + .details-section {
        margin-top: 22px;
    }

    .details-section-title {
        margin: 0 0 12px;
        font-size: 1rem;
        color: #195042;
        font-weight: 900;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .details-item {
        min-height: 82px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 8px;
        padding: 15px 16px;
        border: 1px solid #eee8e0;
        border-radius: 17px;
        background: #fbfaf8;
    }

    .details-item-wide {
        grid-column: 1 / -1;
    }

    .details-label {
        color: #7b7067;
        font-size: 0.84rem;
        font-weight: 800;
    }

    .details-value {
        color: #163f35;
        font-size: 1rem;
        font-weight: 900;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
    }

    .details-empty {
        padding: 22px;
        border: 1px solid #eee8e0;
        border-radius: 18px;
        color: #7b7067;
        background: #fbfaf8;
        text-align: center;
    }

    .details-dialog-footer {
        display: flex;
        justify-content: flex-start;
        gap: 12px;
        padding: 20px 28px 24px;
        border-top: 1px solid #eee8e0;
        background: #fff;
    }

    .details-primary {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 0 17px;
        border-radius: 14px;
        border: 0;
        background: #195042;
        color: #fff;
        font-weight: 800;
        box-shadow: 0 14px 28px rgba(25, 80, 66, 0.18);
    }

    @@media (max-width: 760px) {
        .details-dialog-backdrop { padding: 12px; }
        .details-grid { grid-template-columns: 1fr; }
        .details-dialog-header,
        .details-dialog-body,
        .details-dialog-footer { padding-left: 18px; padding-right: 18px; }
    }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public MemberDetailsDialogModel Model { get; set; } = new();
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task CloseAsync()
        => await OnClose.InvokeAsync();
}
