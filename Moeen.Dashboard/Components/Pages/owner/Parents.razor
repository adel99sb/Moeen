@page "/owner/parents"
<h3>Parents</h3>

<section class="management-container">
    <header class="page-header">
        <h2 class="page-title">إدارة حسابات الاهالي</h2>
    </header>
    <nav class="tabs-navigation">
        <NavLink class="tab-item" href="owner/AccountManagement">
            المشرفون
        </NavLink>
        <NavLink class="tab-item " href="owner/Teachers">
            المعلمون
        </NavLink>
        <NavLink class="tab-item " href="owner/Students">
            الطلاب
        </NavLink>
        <NavLink class="tab-item active" href="owner/Parents">
            الأهالي
        </NavLink>
    </nav>

    <div class="action-bar">
        <div class="search-wrapper">
            <i class="bi bi-search"></i>
            <input type="text" class="search-input" placeholder="ابحث ...">
        </div>
       
    </div>

    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>الاسم</th>
                    <th>الجامع</th>
                    <th>الفوج</th>
                    <th>الحالة</th>
                    <th class="text-center">الابناء</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>أحمد العلي</td>
                    <td>جامع التوبة</td>
                    <td>الفوج الأول</td>
                    <td><span class="status-badge active">نشط</span></td>
                    <td class="actions-cell">
                        محمد علي
                    </td>
                </tr>
                <tr>
                    <td>محمد العلي</td>
                    <td>جامع أبي حنيفة</td>
                    <td>الفوج الثاني</td>
                    <td><span class="status-badge inactive">غير نشط</span></td>
                    <td class="actions-cell">
                       تامر العلي
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</section>


