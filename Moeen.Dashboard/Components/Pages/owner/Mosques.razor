@page "/management/mosques-management"
@rendermode InteractiveServer
@inject NavigationManager mgr
@inject IMosqueApiService MosqueApiService

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap');

    :root {
        --color-primary: #195042;
        --color-bg: #fcfbf9;
        --color-card-bg: #ffffff;
        --color-beige-btn: #efedea;
        --radius-lg: 25px;
    }

    body {
        background-color: var(--color-bg);
        direction: rtl;
    }

    .page-container {
        padding: 40px;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 50px;
        gap: 20px;
    }

    .search-wrapper {
        position: relative;
        flex-grow: 1;
        max-width: 500px;
    }

    .search-input {
        width: 100%;
        padding: 12px 45px 12px 20px;
        border-radius: 15px;
        border: 1px solid #ddd;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        font-size: 0.9rem;
    }

    .search-icon {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #888;
    }

    .btn-add-mosque {
        background-color: var(--color-primary);
        color: white !important;
        border-radius: 10px;
        padding: 10px 25px;
        font-weight: 700;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
        border: none;
    }

    .mosque-card {
        background: var(--color-card-bg);
        border-radius: var(--radius-lg);
        padding: 30px;
        position: relative;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        text-align: center;
        height: 100%;
        border: none;
    }

    .delete-btn {
        position: absolute;
        top: 20px;
        left: 20px;
        color: var(--color-primary);
        font-size: 1.2rem;
        cursor: pointer;
    }

    .mosque-title {
        color: var(--color-primary);
        font-weight: 700;
        font-size: 1.4rem;
        margin-top: 10px;
        margin-bottom: 15px;
    }

    .mosque-details {
        color: #666;
        line-height: 1.8;
        margin-bottom: 25px;
        font-weight: 400;
    }

    .card-actions {
        display: flex;
        justify-content: center;
        gap: 15px;
    }

    .btn-action {
        background-color: var(--color-beige-btn);
        color: var(--color-primary);
        border: none;
        border-radius: 8px;
        padding: 6px 25px;
        font-weight: 600;
        transition: 0.3s;
    }

    .btn-action:hover {
        background-color: #e0d8d0;
    }
</style>

<div class="page-container">
    <div class="top-bar">
        <div class="search-wrapper">
            <i class="bi bi-search search-icon"></i>
            <input type="text" class="search-input" placeholder="ابحث عن جامع..." @bind="SearchText" @bind:event="oninput">
        </div>
        <button class="btn-add-mosque" @onclick="moveTopageAdd">
            إضافة جامع +
        </button>
    </div>

    <div class="row g-4">
        @if (IsLoading)
        {
            <div class="col-12"><p>جاري التحميل...</p></div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="col-12"><p>@ErrorMessage</p></div>
        }
        else if (!FilteredMosques.Any())
        {
            <div class="col-12"><p>لا يوجد مساجد</p></div>
        }
        else
        {
            @foreach (var mosque in FilteredMosques)
            {
                <div class="col-12 col-md-4">
                    <div class="mosque-card">
                        <button class="btn btn-danger" @onclick="() => DeleteMosqueAsync(mosque.Id)">
                            <i class="bi bi-trash3"></i>
                        </button>
                        <h3 class="mosque-title">@mosque.Name</h3>

                        <div class="mosque-details">
                            العنوان <br />
                            @mosque.Address
                        </div>

                        <div class="card-actions">
                            <button class="btn-action" @onclick="() => moveTopage(mosque.Id)">عرض</button>
                            <button class="btn-action" @onclick="() => moveTopageE(mosque.Id)">تعديل</button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private List<MosqueResponse> MosqueItems = [];
    private string SearchText = string.Empty;
    private string? ErrorMessage;
    private bool IsLoading = true;

    private IEnumerable<MosqueResponse> FilteredMosques =>
        MosqueItems.Where(mosque =>
            string.IsNullOrWhiteSpace(SearchText) ||
            (mosque.Name ?? string.Empty).Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
            (mosque.Address ?? string.Empty).Contains(SearchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadMosquesAsync();
    }

    private async Task LoadMosquesAsync()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;
            MosqueItems = (await MosqueApiService.GetAllMosquesAsync()).ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"تعذر جلب المساجد: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task DeleteMosqueAsync(Guid mosqueId)
    {
        await MosqueApiService.DeleteMosqueAsync(mosqueId);
        await LoadMosquesAsync();
    }

    private void moveTopage(Guid mosqueId) => mgr.NavigateTo($"/details/{mosqueId}");
    private void moveTopageE(Guid mosqueId) => mgr.NavigateTo($"/Mend-mE/{mosqueId}");
    private void moveTopageAdd() => mgr.NavigateTo("/Mend-m");
}
