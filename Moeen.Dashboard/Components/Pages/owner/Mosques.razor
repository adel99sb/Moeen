@page "/management/mosques-management"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components.Web
@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Requests.Mosuq
@using Moeen.Shared.Responses.Mosuq
@inject IMosquService MosquService
@inject IDashboardErrorFormatter ErrorFormatter
@inject NavigationManager Navigation

<PageTitle>إدارة المساجد</PageTitle>

<style>
    .mosques-page {
        direction: rtl;
        padding: 12px;
        color: #24342f;
    }

    .mosques-hero {
        background: linear-gradient(135deg, #195042, #28715f);
        color: #fff;
        border-radius: 24px;
        padding: 26px;
        margin-bottom: 22px;
        box-shadow: 0 18px 45px rgba(25, 80, 66, .16);
    }

    .mosques-hero h1 {
        margin: 0 0 8px;
        font-weight: 800;
    }

    .mosques-hero p {
        margin: 0;
        opacity: .92;
    }

    .mosques-panel {
        background: #fff;
        border: 1px solid #e4eee9;
        border-radius: 22px;
        padding: 20px;
        box-shadow: 0 10px 30px rgba(25, 80, 66, .06);
    }

    .mosques-toolbar {
        display: grid;
        grid-template-columns: minmax(220px, 1fr) auto auto;
        gap: 12px;
        align-items: center;
        margin-bottom: 18px;
    }

    .mosques-search {
        position: relative;
    }

    .mosques-search i {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #195042;
    }

    .mosques-search input {
        width: 100%;
        border: 1.5px solid #d6cabc;
        border-radius: 14px;
        padding: 11px 42px 11px 14px;
        outline: none;
        background: #fff;
        transition: .2s ease;
    }

    .mosques-search input:focus {
        border-color: #195042;
        box-shadow: 0 0 0 4px rgba(25, 80, 66, .08);
    }

    .btn-mosque-primary,
    .btn-mosque-light {
        border: none;
        border-radius: 14px;
        padding: 11px 18px;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        white-space: nowrap;
    }

    .btn-mosque-primary {
        background: #195042;
        color: #fff;
    }

    .btn-mosque-light {
        background: #f4f1ee;
        color: #195042;
    }

    .mosques-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .summary-card {
        background: #f9fbfa;
        border: 1px solid #e4eee9;
        border-radius: 16px;
        padding: 14px;
    }

    .summary-card small {
        color: #6b7280;
    }

    .summary-card strong {
        display: block;
        color: #195042;
        font-size: 1.35rem;
        margin-top: 4px;
    }

    .table-scroll {
        width: 100%;
        overflow-x: auto;
    }

    .mosques-table {
        width: 100%;
        min-width: 900px;
        border-collapse: separate;
        border-spacing: 0 10px;
    }

    .mosques-table th {
        background: #f4f1ee;
        color: #195042;
        padding: 13px;
        white-space: nowrap;
        font-weight: 900;
    }

    .mosques-table th:first-child { border-radius: 0 14px 14px 0; }
    .mosques-table th:last-child { border-radius: 14px 0 0 14px; }

    .mosques-table td {
        background: #fff;
        border-top: 1px solid #eef3f0;
        border-bottom: 1px solid #eef3f0;
        padding: 13px;
        vertical-align: middle;
    }

    .mosques-table tr td:first-child {
        border-right: 1px solid #eef3f0;
        border-radius: 0 14px 14px 0;
    }

    .mosques-table tr td:last-child {
        border-left: 1px solid #eef3f0;
        border-radius: 14px 0 0 14px;
    }

    .mosque-name-cell {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 900;
        color: #195042;
    }

    .mosque-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #e7f0ec;
        color: #195042;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 42px;
    }

    .description-cell {
        max-width: 360px;
        color: #667085;
        line-height: 1.7;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .contact-pill {
        background: #f9fbfa;
        border: 1px solid #e4eee9;
        color: #195042;
        border-radius: 999px;
        padding: 6px 10px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-weight: 700;
    }

    .icon-action {
        border: none;
        border-radius: 10px;
        width: 36px;
        height: 36px;
        margin: 0 2px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: .2s ease;
    }

    .icon-action.view { background: #eef7ff; color: #145c9e; }
    .icon-action.edit { background: #f4f1ee; color: #195042; }
    .icon-action.delete { background: #fff1f1; color: #b42318; }
    .icon-action:hover { transform: translateY(-2px); }

    .empty-state,
    .loading-state {
        border: 1px dashed #d6cabc;
        border-radius: 18px;
        padding: 28px;
        color: #667085;
        text-align: center;
    }

    @@media (max-width: 900px) {
        .mosques-toolbar,
        .mosques-summary {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="mosques-page">
    <section class="mosques-hero">
        <h1>إدارة المساجد</h1>
        <p>عرض المساجد المسجلة، البحث بينها، وتعديل أو حذف بياناتها من جدول واحد واضح.</p>
    </section>

    <DashboardStatusMessages
        SuccessMessage="@_successMessage"
        ErrorMessage="@_errorMessage"
        OnSuccessDismiss="EventCallback.Factory.Create(this, () => _successMessage = null)"
        OnErrorDismiss="EventCallback.Factory.Create(this, () => _errorMessage = null)" />

    <section class="mosques-panel">
        <div class="mosques-toolbar">
            <div class="mosques-search">
                <i class="bi bi-search"></i>
                <input value="@_searchText" @oninput="HandleSearchInput" placeholder="ابحث باسم المسجد، العنوان، أو رقم التواصل..." />
            </div>

            <button type="button" class="btn-mosque-light" disabled="@_isLoading" @onclick="ReloadAsync">
                <i class="bi bi-arrow-clockwise"></i> تحديث
            </button>

            <button type="button" class="btn-mosque-primary" @onclick="GoToCreate">
                <i class="bi bi-plus-lg"></i> إضافة مسجد
            </button>
        </div>

        <div class="mosques-summary">
            <div class="summary-card">
                <small>إجمالي المساجد</small>
                <strong>@_mosques.Count</strong>
            </div>
            <div class="summary-card">
                <small>نتائج البحث</small>
                <strong>@FilteredMosques.Count</strong>
            </div>
            <div class="summary-card">
                <small>الحالة</small>
                <strong>@(_isLoading ? "تحميل" : "جاهز")</strong>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="loading-state">
                <span class="spinner-border text-success" role="status"></span>
                <div class="mt-3">جاري تحميل المساجد...</div>
            </div>
        }
        else if (FilteredMosques.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-building fs-1 d-block mb-2"></i>
                لا توجد مساجد مطابقة للبحث الحالي.
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="mosques-table">
                    <thead>
                        <tr>
                            <th>المسجد</th>
                            <th>العنوان</th>
                            <th>رقم التواصل</th>
                            <th>الوصف</th>
                            <th>الإحداثيات</th>
                            <th class="text-center">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mosque in FilteredMosques)
                        {
                            <tr>
                                <td>
                                    <div class="mosque-name-cell">
                                        <span class="mosque-avatar"><i class="bi bi-building"></i></span>
                                        <span>@Display(mosque.name)</span>
                                    </div>
                                </td>
                                <td>@Display(mosque.address)</td>
                                <td>
                                    <span class="contact-pill">
                                        <i class="bi bi-telephone"></i>
                                        @Display(mosque.contactPhone)
                                    </span>
                                </td>
                                <td>
                                    <div class="description-cell" title="@Display(mosque.Description)">
                                        @Display(mosque.Description)
                                    </div>
                                </td>
                                <td>@FormatCoordinates(mosque)</td>
                                <td class="text-center">
                                    <button type="button" class="icon-action view" title="عرض" @onclick="() => GoToDetails(mosque.Id)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button type="button" class="icon-action edit" title="تعديل" @onclick="() => GoToEdit(mosque.Id)">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button type="button" class="icon-action delete" title="حذف" disabled="@_isBusy" @onclick="() => DeleteMosqueAsync(mosque)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private List<MosquDto> _mosques = new();
    private string _searchText = string.Empty;
    private bool _isLoading = true;
    private bool _isBusy;
    private string? _errorMessage;
    private string? _successMessage;

    private List<MosquDto> FilteredMosques => string.IsNullOrWhiteSpace(_searchText)
        ? _mosques
        : _mosques.Where(m => Contains(m.name) || Contains(m.address) || Contains(m.contactPhone) || Contains(m.Description)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task ReloadAsync()
    {
        _successMessage = null;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _isBusy = true;
        _errorMessage = null;

        try
        {
            _mosques = await MosquService.GetAllMosqus(new GetAllMosqusRequest
            {
                Page = 1,
                PageSize = 200
            }) ?? new();
        }
        catch (Exception ex)
        {
            _mosques = new();
            _errorMessage = ErrorFormatter.FromException(ex, "تحميل بيانات المساجد");
        }
        finally
        {
            _isLoading = false;
            _isBusy = false;
        }
    }

    private void HandleSearchInput(ChangeEventArgs args)
    {
        _searchText = args.Value?.ToString() ?? string.Empty;
    }

    private async Task DeleteMosqueAsync(MosquDto mosque)
    {
        _isBusy = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var response = await MosquService.DeleteMosqueAsync(new DeleteMosqueRequest { MosqueId = mosque.Id });
            if (!response.Success)
            {
                _errorMessage = ErrorFormatter.FromResponse(response, "فشل حذف المسجد.");
                return;
            }

            _successMessage = response.Message;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ErrorFormatter.FromException(ex, "حذف المسجد");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void GoToCreate()
        => Navigation.NavigateTo("/management/mosques-management/new");

    private void GoToDetails(Guid mosqueId)
        => Navigation.NavigateTo($"/details?mosqueId={mosqueId}");

    private void GoToEdit(Guid mosqueId)
        => Navigation.NavigateTo($"/management/mosques-management/edit/{mosqueId}");

    private bool Contains(string? value)
        => !string.IsNullOrWhiteSpace(value) && value.Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase);

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "غير محدد" : value;

    private static string FormatCoordinates(MosquDto mosque)
        => mosque.Latitude == 0 && mosque.Longitude == 0
            ? "غير محدد"
            : $"{mosque.Latitude:0.######}, {mosque.Longitude:0.######}";
}