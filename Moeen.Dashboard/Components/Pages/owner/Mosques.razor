@page "/management/mosques-management"
@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Requests.Mosuq
@using Moeen.Shared.Responses.Mosuq

@inject IMosquService MosquService

@rendermode InteractiveServer
@inject NavigationManager mgr

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap');

    :root {
        --color-primary: #195042;
        --color-bg: #fcfbf9;
        --color-card-bg: #ffffff;
        --color-beige-btn: #efedea;
        --radius-lg: 25px;
    }

    body {
        background-color: var(--color-bg);
        direction: rtl;
    }

    .page-container {
        padding: 40px;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 50px;
        gap: 20px;
    }

    .search-wrapper {
        position: relative;
        flex-grow: 1;
        max-width: 500px;
    }

    .search-input {
        width: 100%;
        padding: 12px 45px 12px 20px;
        border-radius: 15px;
        border: 1px solid #ddd;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        font-size: 0.9rem;
    }

    .search-icon {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #888;
    }

    .btn-add-mosque {
        background-color: var(--color-primary);
        color: white !important;
        border-radius: 10px;
        padding: 10px 25px;
        font-weight: 700; /* وزن عريض للخط */
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
        border: none;
    }

    .mosque-card {
        background: var(--color-card-bg);
        border-radius: var(--radius-lg);
        padding: 30px;
        position: relative;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        text-align: center;
        height: 100%;
        border: none;
    }

    .delete-btn {
        position: absolute;
        top: 20px;
        left: 20px;
        color: var(--color-primary);
        font-size: 1.2rem;
        cursor: pointer;
    }

    .mosque-title {
        color: var(--color-primary);
        font-weight: 700;
        font-size: 1.4rem;
        margin-top: 10px;
        margin-bottom: 15px;
    }

    .mosque-details {
        color: #666;
        line-height: 1.8;
        margin-bottom: 25px;
        font-weight: 400;
    }

    .card-actions {
        display: flex;
        justify-content: center;
        gap: 15px;
    }

    .btn-action {
        background-color: var(--color-beige-btn);
        color: var(--color-primary);
        border: none;
        border-radius: 8px;
        padding: 6px 25px;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-action:hover {
            background-color: #e0d8d0;
        }
</style>

<div class="page-container">
    <div class="top-bar">
        <div class="search-wrapper">
            <i class="bi bi-search search-icon"></i>
            <input type="text" class="search-input" placeholder="ابحث عن جامع...">
        </div>
        <button class="btn-add-mosque" @onclick="() => moveTopage2(null)">
            إضافة جامع +
        </button>
    </div>

    <div class="row g-4">
        @if (data.Count == 0)
        {
            <p>لا يوجد مساجد</p>
        }
        else
        {
            @foreach (var m in data)
            {
                <div class="col-12 col-md-4">
                    <div class="mosque-card">
                        <button class="btn btn-danger"
                                @onclick="() => DeleteMosqe(m.Id)">
                            <i class="bi bi-trash3"></i>
                        </button>
                        <h3 class="mosque-title">@m.name</h3>

                        <div class="mosque-details">
                            العنوان <br />
                            @m.address
                            رقم التواصل <br />
                            @m.contactPhone
                            الوصف
                            @m.Description
                        </div>

                        <div class="card-actions">
                            <button class="btn-action" @onclick="moveTopage">عرض</button>
                            <button class="btn-action" @onclick="() => moveTopage2(m.Id)">تعديل</button>
                        </div>
                    </div>
                </div>
            }
        }

    </div>
</div>

@code {
    private Guid ThisMosqe;
    private List<MosquDto> data = new();
    protected override async Task OnInitializedAsync()
    {

         await LoadDataAsync();
    }
    private async Task LoadDataAsync()
    {
        data = await MosquService.GetAllMosqus(new GetAllMosqusRequest
        {
            Page = 1,
            PageSize = 10
        });
    }
    private async Task DeleteMosqe(Guid id)
    {
        var req = new DeleteMosqueRequest
        {
            MosqueId = id
        };
        await MosquService.DeleteMosqueAsync(req);
        
         await LoadDataAsync();
    }
    private void moveTopage() => mgr.NavigateTo("/details");
    private void moveTopage2(Guid? id)
    {
        mgr.NavigateTo($"/Mend-m/{id}");
    }
   }