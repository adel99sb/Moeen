@page "/Mend-m"
@rendermode InteractiveServer
@inject NavigationManager mgr
@inject IMosqueApiService MosqueApiService

<style>
    :root {
        --primary-green: #1a4d3e;
        --bg-light: #f8f5f0;
        --border-color: #e0ddd7;
        --text-color: #333;
        --icon-color: #8a9a95;
    }

    .form-container {
        width: 100% !important;
        max-width: 850px;
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        margin: 20px auto;
        direction: rtl !important;
        text-align: right !important;
    }

    .form-header { background-color: var(--primary-green); height: 100px; width: 100%; }
    .form-body { padding: 40px; }
    .input-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 25px; }
    .full-width { grid-column: span 2; }
    .input-group { display: flex; flex-direction: column; align-items: flex-start; }
    .input-group label { display: block; font-weight: 600; margin-bottom: 10px; color: var(--text-color); font-size: 0.95rem; width: 100%; text-align: right; }
    .input-wrapper { position: relative; display: flex; width: 100%; }
    .input-wrapper input { width: 100%; padding: 15px 45px 15px 15px; background-color: var(--bg-light); border: 1px solid var(--border-color); border-radius: 12px; outline: none; font-size: 14px; font-family: inherit; text-align: right; }
    .input-wrapper i { position: absolute; right: 15px; top: 50%; transform: translateY(-50%); color: var(--icon-color); }
    .form-footer { margin-top: 40px; padding-top: 25px; border-top: 1px solid #f0f0f0; display: flex; justify-content: flex-start; gap: 15px; }
    .btn-save { background-color: var(--primary-green); color: white; border: none; padding: 12px 30px; border-radius: 10px; cursor: pointer; display: flex; align-items: center; gap: 10px; font-weight: bold; }
    .btn-cancel { background-color: transparent; color: #cc4b4b; border: none; padding: 12px 20px; cursor: pointer; display: flex; align-items: center; gap: 8px; }
    @@media (max-width: 768px) {
        .input-grid { grid-template-columns: 1fr; }
        .full-width { grid-column: span 1; }
    }
</style>

<div class="form-container">
    <div class="form-header"></div>
    <div class="form-body">
        <EditForm Model="Model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="input-grid">
                <div class="input-group">
                    <label>اسم الجامع</label>
                    <div class="input-wrapper">
                        <InputText class="form-control" @bind-Value="Model.Name" />
                        <i class="fas fa-user"></i>
                    </div>
                </div>

                <div class="input-group">
                    <label>العنوان</label>
                    <div class="input-wrapper">
                        <InputText class="form-control" @bind-Value="Model.Address" />
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                </div>
            </div>

            <div class="form-footer">
                <button type="submit" class="btn-save" disabled="@IsSaving">
                    <span>@(IsSaving ? "جاري الحفظ..." : "حفظ البيانات")</span>
                    <i class="fas fa-check-double"></i>
                </button>
                <button type="button" class="btn-cancel" @onclick="Cancel">
                    <span>إلغاء</span>
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </EditForm>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="alert @(IsSuccess ? "alert-success" : "alert-danger")">@Message</div>
        }
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

@code {
    private CreateMosqueRequest Model { get; set; } = new();
    private string? Message;
    private bool IsSuccess;
    private bool IsSaving;

    private async Task SaveAsync()
    {
        try
        {
            IsSaving = true;
            Message = await MosqueApiService.CreateMosqueAsync(Model);
            IsSuccess = true;
        }
        catch (Exception ex)
        {
            IsSuccess = false;
            Message = $"تعذر حفظ الجامع: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void Cancel()
    {
        mgr.NavigateTo("/management/mosques-management");
    }
}
