@page "/Mend-m"
@page "/Mend-m/{Id:guid}"
@page "/management/mosques-management/new"
@page "/management/mosques-management/edit/{Id:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Requests.Mosuq
@inject IMosquService MosquService
@inject IDashboardErrorFormatter ErrorFormatter
@inject NavigationManager Navigation

<PageTitle>@(IsEditMode ? "تعديل مسجد" : "إضافة مسجد")</PageTitle>

<style>
    .mosque-form-page {
        min-height: calc(100vh - 80px);
        direction: rtl;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 48px 18px;
        color: #163f35;
    }

    .mosque-form-shell {
        width: min(860px, 100%);
    }

    .mosque-form-card {
        background: #fff;
        border: 1px solid #e7ded2;
        border-radius: 18px;
        box-shadow: 0 26px 70px rgba(25, 80, 66, .16);
        overflow: hidden;
    }

    .mosque-form-header {
        min-height: 82px;
        background: #195042;
        color: #fff;
        padding: 22px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .mosque-form-title h1 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 900;
    }

    .mosque-form-title p {
        margin: 6px 0 0;
        color: rgba(255, 255, 255, .82);
        font-size: .86rem;
    }

    .close-form-btn {
        border: 0;
        background: rgba(255, 255, 255, .12);
        color: #fff;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .mosque-form-body {
        padding: 26px 28px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px 20px;
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-field label {
        font-size: .86rem;
        font-weight: 900;
        color: #263c36;
    }

    .field-box {
        position: relative;
    }

    .field-box i {
        position: absolute;
        right: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: #195042;
        opacity: .78;
        pointer-events: none;
    }

    .field-box input,
    .field-box textarea {
        width: 100%;
        border: 1.5px solid #d6cabc;
        border-radius: 12px;
        background: #fbfaf8;
        color: #1c332d;
        min-height: 44px;
        padding: 10px 42px 10px 12px;
        outline: none;
        transition: .2s ease;
    }

    .field-box textarea {
        min-height: 92px;
        resize: vertical;
        padding-top: 12px;
    }

    .field-box.textarea i {
        top: 18px;
        transform: none;
    }

    .field-box input:focus,
    .field-box textarea:focus {
        border-color: #195042;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(25, 80, 66, .08);
    }

    .full-span { grid-column: 1 / -1; }

    .validation-message {
        color: #b42318;
        font-size: .78rem;
    }

    .form-actions {
        border-top: 1px solid #eee5da;
        margin-top: 26px;
        padding-top: 20px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .btn-form-save,
    .btn-form-cancel {
        min-height: 48px;
        border: 0;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-weight: 900;
        text-decoration: none;
    }

    .btn-form-save {
        background: #195042;
        color: #fff;
    }

    .btn-form-save:disabled {
        opacity: .65;
        cursor: not-allowed;
    }

    .btn-form-cancel {
        background: #f8f9fa;
        color: #c61f32;
    }

    .loading-box {
        border: 1px dashed #d6cabc;
        border-radius: 16px;
        padding: 24px;
        text-align: center;
        color: #667085;
    }

    @@media (max-width: 760px) {
        .mosque-form-page { padding: 24px 10px; }
        .mosque-form-header,
        .mosque-form-body { padding: 20px; }
        .form-grid,
        .form-actions { grid-template-columns: 1fr; }
    }
</style>

<div class="mosque-form-page">
    <div class="mosque-form-shell">
        <DashboardStatusMessages
            SuccessMessage="@_successMessage"
            ErrorMessage="@_errorMessage"
            OnSuccessDismiss="EventCallback.Factory.Create(this, () => _successMessage = null)"
            OnErrorDismiss="EventCallback.Factory.Create(this, () => _errorMessage = null)" />

        <section class="mosque-form-card">
            <header class="mosque-form-header">
                <button type="button" class="close-form-btn" title="إغلاق" @onclick="Cancel">
                    <i class="bi bi-x-lg"></i>
                </button>
                <div class="mosque-form-title text-end">
                    <h1><i class="bi bi-building-add"></i> @(IsEditMode ? "تعديل بيانات المسجد" : "إضافة مسجد جديد")</h1>
                    <p>أدخل بيانات المسجد ثم اضغط حفظ. بعد الحفظ ستعود إلى جدول المساجد.</p>
                </div>
            </header>

            <div class="mosque-form-body">
                @if (_isLoading)
                {
                    <div class="loading-box">
                        <span class="spinner-border text-success" role="status"></span>
                        <div class="mt-3">جاري تحميل بيانات المسجد...</div>
                    </div>
                }
                else
                {
                    <EditForm Model="Model" OnValidSubmit="HandleSaveMosqueAsync">
                        <DataAnnotationsValidator />

                        <div class="form-grid">
                            <div class="form-field">
                                <label>اسم المسجد</label>
                                <div class="field-box">
                                    <i class="bi bi-building"></i>
                                    <InputText @bind-Value="Model.name" placeholder="أدخل اسم المسجد" />
                                </div>
                                <ValidationMessage For="@(() => Model.name)" />
                            </div>

                            <div class="form-field">
                                <label>رقم الهاتف</label>
                                <div class="field-box">
                                    <i class="bi bi-telephone"></i>
                                    <InputText @bind-Value="Model.contact_phone" type="tel" placeholder="مثال: 09xxxxxxxx" />
                                </div>
                                <ValidationMessage For="@(() => Model.contact_phone)" />
                            </div>

                            <div class="form-field full-span">
                                <label>العنوان</label>
                                <div class="field-box">
                                    <i class="bi bi-geo-alt"></i>
                                    <InputText @bind-Value="Model.address" placeholder="أدخل العنوان بالتفصيل" />
                                </div>
                                <ValidationMessage For="@(() => Model.address)" />
                            </div>

                            <div class="form-field">
                                <label>خط العرض Latitude</label>
                                <div class="field-box">
                                    <i class="bi bi-geo"></i>
                                    <InputNumber @bind-Value="Model.Latitude" />
                                </div>
                                <ValidationMessage For="@(() => Model.Latitude)" />
                            </div>

                            <div class="form-field">
                                <label>خط الطول Longitude</label>
                                <div class="field-box">
                                    <i class="bi bi-geo"></i>
                                    <InputNumber @bind-Value="Model.Longitude" />
                                </div>
                                <ValidationMessage For="@(() => Model.Longitude)" />
                            </div>

                            <div class="form-field full-span">
                                <label>الوصف</label>
                                <div class="field-box textarea">
                                    <i class="bi bi-card-text"></i>
                                    <InputTextArea @bind-Value="Model.Description" placeholder="اكتب وصفاً مختصراً عن المسجد..." />
                                </div>
                                <ValidationMessage For="@(() => Model.Description)" />
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn-form-save" disabled="@_isSaving">
                                @if (_isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                    <span>جاري الحفظ...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-all"></i>
                                    <span>@(IsEditMode ? "تحديث البيانات" : "حفظ البيانات")</span>
                                }
                            </button>
                            <button type="button" class="btn-form-cancel" @onclick="Cancel">
                                <i class="bi bi-x-lg"></i> إلغاء
                            </button>
                        </div>
                    </EditForm>
                }
            </div>
        </section>
    </div>
</div>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool IsEditMode => Id.HasValue;
    private AddMosquReq Model = new()
    {
        name = string.Empty,
        address = string.Empty,
        contact_phone = string.Empty,
        Description = string.Empty
    };

    private bool _isLoading;
    private bool _isSaving;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!IsEditMode || !Id.HasValue)
            return;

        _isLoading = true;
        _errorMessage = null;

        try
        {
            var mosque = await MosquService.GetMosqueByIdAsync(Id.Value);
            Model = new AddMosquReq
            {
                name = mosque.name ?? string.Empty,
                address = mosque.address ?? string.Empty,
                contact_phone = mosque.contactPhone ?? string.Empty,
                Description = mosque.Description ?? string.Empty,
                Latitude = mosque.Latitude,
                Longitude = mosque.Longitude
            };
        }
        catch (Exception ex)
        {
            _errorMessage = ErrorFormatter.FromException(ex, "تحميل بيانات المسجد");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSaveMosqueAsync()
    {
        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var response = IsEditMode && Id.HasValue
                ? await MosquService.UpdateMosqueInfoAsync(new UpdateMosqueInfoRequest
                {
                    MosqueId = Id.Value,
                    Name = Model.name,
                    Address = Model.address,
                    ContactPhone = Model.contact_phone,
                    Description = Model.Description,
                    Latitude = Model.Latitude,
                    Longitude = Model.Longitude
                })
                : await MosquService.AddMosqu(Model);

            if (!response.Success)
            {
                _errorMessage = ErrorFormatter.FromResponse(response, IsEditMode ? "فشل تحديث المسجد." : "فشل إضافة المسجد.");
                return;
            }

            _successMessage = response.Message;
            Navigation.NavigateTo("/management/mosques-management", replace: true);
        }
        catch (Exception ex)
        {
            _errorMessage = ErrorFormatter.FromException(ex, IsEditMode ? "تحديث المسجد" : "إضافة المسجد");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel()
        => Navigation.NavigateTo("/management/mosques-management");
}