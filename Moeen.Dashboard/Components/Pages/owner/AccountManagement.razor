@page "/owner/AccountManagement"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web
@using Moeen.Dashboard.Application.Services.Abstractions
@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Requests.Enrollment
@using Moeen.Shared.Responses
@using Moeen.Shared.Responses.Enrollment
@inject IEnrollmentService EnrollmentService
@inject IDashboardErrorFormatter ErrorFormatter
@inject NavigationManager Navigation

<PageTitle>إدارة المشرفين</PageTitle>

<style>
    .accounts-page { direction: rtl; padding: 12px; color: #24342f; }
    .accounts-hero { background: linear-gradient(135deg, #195042, #28715f); color: #fff; border-radius: 24px; padding: 26px; margin-bottom: 22px; box-shadow: 0 18px 45px rgba(25, 80, 66, .16); }
    .accounts-hero h1 { margin: 0 0 8px; font-weight: 800; }
    .accounts-hero p { margin: 0; opacity: .92; }
    .accounts-panel { background: #fff; border: 1px solid #e4eee9; border-radius: 22px; padding: 20px; box-shadow: 0 10px 30px rgba(25, 80, 66, .06); }
    .accounts-tabs { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 18px; border-bottom: 1px solid #edf3f0; padding-bottom: 14px; }
    .account-tab { border: 1px solid #dfece7; background: #fff; color: #195042; border-radius: 14px; padding: 10px 16px; display: inline-flex; align-items: center; gap: 8px; font-weight: 800; transition: .2s ease; }
    .account-tab:hover, .account-tab.active { background: #195042; color: #fff; border-color: #195042; transform: translateY(-2px); }
    .account-tab .count { background: rgba(255, 255, 255, .18); border-radius: 999px; padding: 2px 8px; font-size: .8rem; }
    .accounts-toolbar { display: grid; grid-template-columns: minmax(220px, 1fr) auto auto; gap: 12px; margin-bottom: 18px; align-items: center; }
    .accounts-search { position: relative; }
    .accounts-search i { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); color: #195042; }
    .accounts-search input, .accounts-toolbar select { width: 100%; border: 1.5px solid #d6cabc; border-radius: 14px; padding: 11px 42px 11px 14px; outline: none; background: #fff; transition: .2s ease; }
    .accounts-toolbar select { padding: 11px 14px; min-width: 140px; }
    .accounts-search input:focus, .accounts-toolbar select:focus { border-color: #195042; box-shadow: 0 0 0 4px rgba(25, 80, 66, .08); }
    .btn-owner-primary, .btn-owner-light, .btn-owner-success { border: none; border-radius: 14px; padding: 11px 18px; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; white-space: nowrap; }
    .btn-owner-primary { background: #195042; color: #fff; }
    .btn-owner-success { background: #14723a; color: #fff; }
    .btn-owner-light { background: #f4f1ee; color: #195042; }
    .btn-owner-primary:disabled, .btn-owner-light:disabled, .btn-owner-success:disabled { opacity: .65; cursor: not-allowed; }
    .accounts-summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-bottom: 18px; }
    .summary-card { background: #f9fbfa; border: 1px solid #e4eee9; border-radius: 16px; padding: 14px; }
    .summary-card small { color: #6b7280; }
    .summary-card strong { display: block; color: #195042; font-size: 1.35rem; margin-top: 4px; }
    .permission-note { background: #fff8e7; border: 1px solid #f1d69a; color: #775900; border-radius: 16px; padding: 14px 16px; margin-bottom: 16px; line-height: 1.8; }
    .accounts-table { width: 100%; border-collapse: separate; border-spacing: 0 10px; min-width: 920px; }
    .accounts-table th { background: #f4f1ee; color: #195042; padding: 13px; white-space: nowrap; }
    .accounts-table td { background: #fff; border-top: 1px solid #eef3f0; border-bottom: 1px solid #eef3f0; padding: 13px; vertical-align: middle; }
    .accounts-table tr td:first-child { border-radius: 0 14px 14px 0; }
    .accounts-table tr td:last-child { border-radius: 14px 0 0 14px; }
    .account-avatar { width: 42px; height: 42px; border-radius: 50%; background: #e7f0ec; color: #195042; display: inline-flex; align-items: center; justify-content: center; font-weight: 800; margin-left: 10px; }
    .status-pill, .role-pill { border-radius: 999px; padding: 5px 11px; font-size: .85rem; font-weight: 800; display: inline-flex; align-items: center; gap: 6px; }
    .status-active { background: #eaf8f0; color: #14723a; }
    .status-other { background: #eef7ff; color: #145c9e; }
    .role-pill { background: #f4f1ee; color: #195042; }
    .icon-action { border: none; border-radius: 10px; width: 36px; height: 36px; margin: 0 2px; display: inline-flex; align-items: center; justify-content: center; transition: .2s ease; }
    .icon-action.view { background: #eef7ff; color: #145c9e; }
    .icon-action.edit { background: #f4f1ee; color: #195042; }
    .icon-action.delete { background: #fff1f1; color: #b42318; }
    .icon-action:hover { transform: translateY(-2px); }
    .accounts-pagination { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 16px; color: #6b7280; }
    .empty-state, .loading-state { border: 1px dashed #d6cabc; border-radius: 18px; padding: 28px; text-align: center; color: #667085; background: #fffdfb; }
    @@media (max-width: 900px) { .accounts-toolbar { grid-template-columns: 1fr; } .accounts-summary { grid-template-columns: 1fr; } }
</style>

<div class="accounts-page">
    <section class="accounts-hero">
        <h1>إدارة المشرفين</h1>
        <p>صلاحيات المالك هنا محصورة بإدارة المشرفين فقط، مع إمكانية ترقية معلم موجود ليصبح مشرفاً.</p>
    </section>

    <section class="accounts-panel">
        <DashboardStatusMessages
            SuccessMessage="@_successMessage"
            ErrorMessage="@_errorMessage"
            OnSuccessDismiss="EventCallback.Factory.Create(this, () => _successMessage = null)"
            OnErrorDismiss="EventCallback.Factory.Create(this, () => _errorMessage = null)" />

        <div class="accounts-tabs">
            <button type="button" class="@GetTabClass(OwnerAccountView.Supervisors)" disabled="@_isBusy" @onclick="() => SelectViewAsync(OwnerAccountView.Supervisors)">
                <i class="bi bi-person-badge"></i>
                <span>المشرفون</span>
                @if (_view == OwnerAccountView.Supervisors && _totalCount > 0)
                {
                    <span class="count">@_totalCount</span>
                }
            </button>
            <button type="button" class="@GetTabClass(OwnerAccountView.PromoteTeacher)" disabled="@_isBusy" @onclick="() => SelectViewAsync(OwnerAccountView.PromoteTeacher)">
                <i class="bi bi-arrow-up-circle"></i>
                <span>ترقية معلم إلى مشرف</span>
                @if (_view == OwnerAccountView.PromoteTeacher && _totalCount > 0)
                {
                    <span class="count">@_totalCount</span>
                }
            </button>
        </div>

        <div class="permission-note">
            <i class="bi bi-shield-check"></i>
            المالك لا يدير الطلاب أو الأهالي أو المعلمين من هذه الشاشة. إدارة المشرفين متاحة بالكامل، والمعلم يمكن ترقيته إلى مشرف فقط.
        </div>

        <div class="accounts-toolbar">
            <div class="accounts-search">
                <i class="bi bi-search"></i>
                <input value="@_searchText" @oninput="HandleSearchInput" @onkeydown="HandleSearchKey" placeholder="@SearchPlaceholder" />
            </div>

            <select value="@_pageSize" @onchange="ChangePageSizeAsync" disabled="@_isBusy">
                <option value="10">10 بالسطر</option>
                <option value="20">20 بالسطر</option>
                <option value="50">50 بالسطر</option>
            </select>

            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn-owner-light" disabled="@_isBusy" @onclick="ReloadAsync">
                    <i class="bi bi-arrow-clockwise"></i> تحديث
                </button>
                @if (_view == OwnerAccountView.Supervisors)
                {
                    <button type="button" class="btn-owner-primary" @onclick="GoToCreateSupervisorForm">
                        <i class="bi bi-plus-lg"></i> إضافة مشرف
                    </button>
                }
            </div>
        </div>

        <div class="accounts-summary">
            <div class="summary-card">
                <small>القسم الحالي</small>
                <strong>@SelectedViewLabel</strong>
            </div>
            <div class="summary-card">
                <small>عدد النتائج</small>
                <strong>@_totalCount</strong>
            </div>
            <div class="summary-card">
                <small>الصفحة</small>
                <strong>@_page / @TotalPages</strong>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="loading-state">
                <span class="spinner-border text-success" role="status"></span>
                <div class="mt-3">جاري تحميل البيانات...</div>
            </div>
        }
        else if (_members.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-people fs-1 d-block mb-2"></i>
                لا توجد نتائج مطابقة ضمن قسم @SelectedViewLabel.
            </div>
        }
        else if (_view == OwnerAccountView.Supervisors)
        {
            <div class="table-responsive">
                <table class="accounts-table">
                    <thead>
                        <tr>
                            <th>الاسم</th>
                            <th>النوع</th>
                            <th>المسجد</th>
                            <th>البريد</th>
                            <th>الهاتف</th>
                            <th>الحالة</th>
                            <th>تاريخ الانضمام</th>
                            <th class="text-center">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in _members)
                        {
                            <tr>
                                <td><span class="account-avatar">@GetInitial(member.Name)</span><span class="fw-bold">@Display(member.Name)</span></td>
                                <td><span class="role-pill"><i class="bi bi-person-badge"></i>مشرف</span></td>
                                <td>@Display(member.MosqueName)</td>
                                <td>@Display(member.Email)</td>
                                <td>@Display(member.Phone)</td>
                                <td><span class="status-pill status-active">نشط</span></td>
                                <td>@FormatDate(member.JoinedAt)</td>
                                <td class="text-center">
                                    <button type="button" class="icon-action view" title="عرض" @onclick="() => GoToSupervisorDetails(member)"><i class="bi bi-eye"></i></button>
                                    <button type="button" class="icon-action edit" title="تعديل" @onclick="() => GoToSupervisorEdit(member)"><i class="bi bi-pencil-square"></i></button>
                                    <button type="button" class="icon-action delete" title="حذف" disabled="@_isBusy" @onclick="() => DeleteSupervisorAsync(member)"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="accounts-table">
                    <thead>
                        <tr>
                            <th>المعلم</th>
                            <th>المسجد</th>
                            <th>البريد</th>
                            <th>الهاتف</th>
                            <th>تاريخ الانضمام</th>
                            <th class="text-center">الإجراء المتاح</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var teacher in _members)
                        {
                            <tr>
                                <td><span class="account-avatar">@GetInitial(teacher.Name)</span><span class="fw-bold">@Display(teacher.Name)</span></td>
                                <td>@Display(teacher.MosqueName)</td>
                                <td>@Display(teacher.Email)</td>
                                <td>@Display(teacher.Phone)</td>
                                <td>@FormatDate(teacher.JoinedAt)</td>
                                <td class="text-center">
                                    <button type="button" class="btn-owner-success" disabled="@_isBusy" @onclick="() => PromoteTeacherAsync(teacher)">
                                        <i class="bi bi-arrow-up-circle"></i> ترقية إلى مشرف
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (!_isLoading && _members.Count > 0)
        {
            <div class="accounts-pagination">
                <span>يعرض @_members.Count من أصل @_totalCount نتيجة</span>
                <div class="d-flex gap-2">
                    <button type="button" class="btn-owner-light" disabled="@(_page <= 1 || _isBusy)" @onclick="PreviousPageAsync">السابق</button>
                    <button type="button" class="btn-owner-light" disabled="@(_page >= TotalPages || _isBusy)" @onclick="NextPageAsync">التالي</button>
                </div>
            </div>
        }
    </section>
</div>

@code {
    private enum OwnerAccountView { Supervisors, PromoteTeacher }

    private readonly JsonSerializerOptions _jsonOptions = new() { PropertyNameCaseInsensitive = true };
    private List<MemberProfileDto> _members = new();
    private OwnerAccountView _view = OwnerAccountView.Supervisors;
    private string _searchText = string.Empty;
    private bool _isLoading = true;
    private bool _isBusy;
    private int _page = 1;
    private int _pageSize = 10;
    private int _totalCount;
    private string? _errorMessage;
    private string? _successMessage;

    private string SelectedViewLabel => _view == OwnerAccountView.Supervisors ? "المشرفون" : "ترقية معلم إلى مشرف";
    private string CurrentMemberType => _view == OwnerAccountView.Supervisors ? "Supervisor" : "Teacher";
    private string SearchPlaceholder => _view == OwnerAccountView.Supervisors ? "ابحث باسم المشرف..." : "ابحث باسم المعلم المراد ترقيته...";
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)_pageSize));

    protected override async Task OnInitializedAsync() => await LoadMembersAsync();

    private async Task SelectViewAsync(OwnerAccountView view)
    {
        if (_view == view) return;
        _view = view;
        _page = 1;
        _successMessage = null;
        _errorMessage = null;
        await LoadMembersAsync();
    }

    private async Task ReloadAsync()
    {
        _successMessage = null;
        await LoadMembersAsync();
    }

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadMembersAsync();
    }

    private void HandleSearchInput(ChangeEventArgs args) => _searchText = args.Value?.ToString() ?? string.Empty;

    private async Task HandleSearchKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await SearchAsync();
    }

    private async Task ChangePageSizeAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value))
        {
            _pageSize = Math.Clamp(value, 5, 100);
            _page = 1;
            await LoadMembersAsync();
        }
    }

    private async Task PreviousPageAsync()
    {
        if (_page <= 1) return;
        _page--;
        await LoadMembersAsync();
    }

    private async Task NextPageAsync()
    {
        if (_page >= TotalPages) return;
        _page++;
        await LoadMembersAsync();
    }

    private async Task LoadMembersAsync()
    {
        _isLoading = true;
        _isBusy = true;
        _errorMessage = null;

        try
        {
            var response = await EnrollmentService.SearchMembersAsync(new SearchMembersRequest
            {
                MemberType = CurrentMemberType,
                Name = string.IsNullOrWhiteSpace(_searchText) ? string.Empty : _searchText.Trim(),
                Email = string.Empty,
                Phone = string.Empty,
                PageNumber = _page,
                PageSize = _pageSize,
                SortBy = "Name",
                SortDescending = false
            });

            if (!response.Success)
            {
                _members = new();
                _totalCount = 0;
                _errorMessage = ErrorFormatter.FromResponse(response, "فشل تحميل البيانات.");
                return;
            }

            _members = DeserializeMembers(response.Data);
            _totalCount = response.TotalCount ?? _members.Count;
        }
        catch (Exception ex)
        {
            _members = new();
            _totalCount = 0;
            _errorMessage = ErrorFormatter.FromException(ex, "تحميل البيانات");
        }
        finally
        {
            _isLoading = false;
            _isBusy = false;
        }
    }

    private async Task DeleteSupervisorAsync(MemberProfileDto member)
    {
        _isBusy = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var response = await EnrollmentService.DeleteSupervisorAsync(member.Id);
            if (!response.Success)
            {
                _errorMessage = ErrorFormatter.FromResponse(response, "فشل حذف المشرف.");
                return;
            }

            _successMessage = response.Message;
            await LoadMembersAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ErrorFormatter.FromException(ex, "حذف المشرف");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task PromoteTeacherAsync(MemberProfileDto teacher)
    {
        _isBusy = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var response = await EnrollmentService.PromoteTeacherToSupervisorAsync(teacher.Id);
            if (!response.Success)
            {
                _errorMessage = ErrorFormatter.FromResponse(response, "فشل ترقية المعلم إلى مشرف.");
                return;
            }

            _successMessage = response.Message;
            await LoadMembersAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ErrorFormatter.FromException(ex, "ترقية المعلم إلى مشرف");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private List<MemberProfileDto> DeserializeMembers(object? data)
    {
        if (data is null) return new();
        if (data is JsonElement element) return element.Deserialize<List<MemberProfileDto>>(_jsonOptions) ?? new();
        var json = JsonSerializer.Serialize(data, _jsonOptions);
        return JsonSerializer.Deserialize<List<MemberProfileDto>>(json, _jsonOptions) ?? new();
    }

    private void GoToCreateSupervisorForm() => Navigation.NavigateTo("/owner/Form?type=Supervisor");
    private void GoToSupervisorEdit(MemberProfileDto member) => Navigation.NavigateTo($"/owner/Form?memberId={member.Id}&type=Supervisor&mode=edit");
    private void GoToSupervisorDetails(MemberProfileDto member) => Navigation.NavigateTo($"/owner/Form?memberId={member.Id}&type=Supervisor&mode=view");
    private string GetTabClass(OwnerAccountView view) => _view == view ? "account-tab active" : "account-tab";
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "غير محدد" : value;
    private static string GetInitial(string? value) => string.IsNullOrWhiteSpace(value) ? "؟" : value.Trim()[0].ToString();
    private static string FormatDate(DateTime value) => value == default ? "-" : value.ToLocalTime().ToString("yyyy/MM/dd");
}
