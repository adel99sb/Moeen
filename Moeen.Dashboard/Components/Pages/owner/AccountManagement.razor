@page "/owner/AccountManagement"
<h3>AccountManagement</h3>
   
<section class="management-container">
    <header class="page-header">
        <h2 class="page-title">إدارة حسابات المستخدمين</h2>
    </header>
    <nav class="tabs-navigation">
        <NavLink class="tab-item" href="owner/AccountManagement" >
            المشرفون
        </NavLink>
        <NavLink class="tab-item" href="owner/Teachers">
            المعلمون
        </NavLink>
        <NavLink class="tab-item" href="owner/Students">
            الطلاب
        </NavLink>
        <NavLink class="tab-item" href="owner/Parents">
            الأهالي
        </NavLink>
    </nav>

    <div class="action-bar">
        <div class="search-wrapper">
            <i class="bi bi-search"></i>
            <input type="text" class="search-input" placeholder="ابحث عن مشرف...">
        </div>
        <a href="owner/Form" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> إضافة مشرف
        </a>
    </div>

    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>الاسم</th>
                    <th>الجامع</th>
                    <th>الفوج</th>
                    <th>الحالة</th>
                    <th class="text-center">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                
                <tr>
                    <td>أحمد العلي</td>
                    <td>جامع التوبة</td>
                    <td>الفوج الأول</td>
                    <td><span class="status-badge active">نشط</span></td>
                    <td class="actions-cell">
                        <a href="/owner/Form"> <button class="btn-icon edit" title="تعديل"><i class="bi bi-pencil-square"></i></button></a>

                        <button class="btn-icon delete" title="حذف"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
                <tr>
                    <td>محمد العلي</td>
                    <td>جامع ابي حنيفة</td>
                    <td> الفوج الأول</td>
                    <td><span class="status-badge active">نشط</span></td>
                    <td class="actions-cell">
                        <button class="btn-icon edit" title="تعديل"><i class="bi bi-pencil-square"></i></button>
                        <button class="btn-icon delete" title="حذف"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</section>
@code {

}
