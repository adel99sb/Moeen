@page "/details/{MosqueId:guid}"
@inject NavigationManager mgr
@inject IMosqueApiService MosqueApiService

<style>
    :root {
        --primary-green: #195042;
        --primary-green-dark: #123d32;
        --accent-beige: #d6cabc;
        --light-beige: #f4f1ee;
        --white: #ffffff;
        --text-gray: #636e72;
        --status-green: #2ecc71;
        --danger-red: #e74c3c;
        --bg-gray: #f9f9f9;
        --border-gray: #f1f1f1;
        --bg-row-hover: #fafafa;
        --font-main: 'Tajawal', sans-serif;
        --radius-container: 20px;
        --radius-badge: 20px;
        --shadow-card: 0 10px 30px rgba(0,0,0,0.05);
    }

    body {
        font-family: var(--font-main);
        background-color: var(--bg-gray);
        direction: rtl;
        text-align: right;
    }

    .management-container {
        background: var(--white);
        margin: 20px;
        padding: 30px;
        border-radius: var(--radius-container);
        box-shadow: var(--shadow-card);
    }

    h2 {
        color: var(--primary-green);
        margin: 25px 0 15px 0;
        font-size: 1.5rem;
    }

    .button-wrapper {
        display: flex;
        justify-content: flex-end;
        margin-bottom: -40px;
    }

    .btn-primary {
        background-color: var(--primary-green);
        border: none;
        padding: 10px 20px;
        border-radius: 10px;
        transition: 0.3s;
    }

    .btn-primary:hover {
        background-color: var(--primary-green-dark);
        transform: translateY(-2px);
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
        margin-bottom: 20px;
    }

    .data-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 8px;
    }

    .data-table th {
        background-color: var(--light-beige);
        color: var(--primary-green);
        padding: 15px;
        text-align: right;
        border-radius: 0;
    }

    .data-table tbody tr {
        background-color: var(--white);
        transition: 0.3s;
    }

    .data-table tbody tr td {
        padding: 15px;
        border-top: 1px solid var(--border-gray);
        border-bottom: 1px solid var(--border-gray);
    }

    .data-table tbody tr:hover {
        background-color: var(--bg-row-hover);
    }

    .status-badge {
        padding: 5px 12px;
        border-radius: var(--radius-badge);
        font-size: 0.85rem;
        display: inline-block;
    }

    .status-badge.active {
        background-color: rgba(46, 204, 113, 0.1);
        color: var(--status-green);
    }

    .status-badge.inactive {
        background-color: rgba(231, 76, 60, 0.1);
        color: var(--danger-red);
    }

    .btn-icon {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--danger-red);
        font-size: 1.2rem;
        transition: 0.3s;
    }

    .btn-icon:hover {
        transform: scale(1.2);
    }
</style>

<section class="management-container">
    <div class="button-wrapper">
        <button class="btn btn-primary" @onclick="moveTopage">إضافة مشرف +</button>
    </div>

    <h2>أعضاء الجامع</h2>
    

    @if (IsLoading)
    {
        <p>جاري التحميل...</p>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <p>@ErrorMessage</p>
    }
    else if (!FilteredUsers.Any())
    {
        <p>لا يوجد مشرفون أو أساتذة لهذا الجامع.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>الاسم</th>
                        <th>الدور</th>
                        <th>الحالة</th>
                        <th style="text-align: center;">الإجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in FilteredUsers)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@GetRoleLabel(user.UserRole)</td>
                            <td>
                                <span class="status-badge @(user.EmailConfirmed ? "active" : "inactive")">
                                    @(user.EmailConfirmed ? "نشط" : "متوقف")
                                </span>
                            </td>
                            <td style="text-align: center;">
                                <button class="btn-icon" title="حذف"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <hr />
</section>

@code {
    [Parameter] public Guid MosqueId { get; set; }

    private List<UserResponse> Users = [];
    private bool IsLoading = true;
    private string? ErrorMessage;

    private IEnumerable<UserResponse> FilteredUsers =>
        Users.Where(user => user.UserRole is UserRole.Supervisor or UserRole.Teacher);

    protected override async Task OnParametersSetAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;
            Users = (await MosqueApiService.GetMosqueUsersAsync(MosqueId)).ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"تعذر جلب أعضاء الجامع: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private string GetRoleLabel(UserRole role) => role switch
    {
        UserRole.Supervisor => "مشرف",
        UserRole.Teacher => "أستاذ",
        _ => role.ToString()
    };

    private void moveTopage()
    {
        mgr.NavigateTo("/owner/Form");
    }
}
