@page "/owner/dashboard"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components.Web
@using Moeen.Dashboard.Infrastructure.Http.Clients
@using Moeen.Shared.Responses.OwnerDashboard
@inject OwnerDashboardApiClient DashboardApiClient
@inject Moeen.Dashboard.Services.Abstractions.ITokenService TokenService

<PageTitle>لوحة المالك</PageTitle>

<style>
    .owner-dashboard {
        direction: rtl;
        padding: 10px;
        color: #1f2933;
    }

    .owner-hero {
        background: linear-gradient(135deg, #195042, #28715f);
        color: white;
        border-radius: 24px;
        padding: 28px;
        margin-bottom: 24px;
        box-shadow: 0 18px 45px rgba(25, 80, 66, .18);
    }

    .owner-hero h1 {
        font-weight: 800;
        margin-bottom: 8px;
    }

    .owner-hero p {
        margin: 0;
        opacity: .9;
    }

    .owner-section-title {
        color: #195042;
        font-weight: 800;
        margin: 28px 0 16px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .owner-card {
        background: #fff;
        border: 1px solid #e5eee9;
        border-radius: 18px;
        padding: 20px;
        height: 100%;
        box-shadow: 0 8px 24px rgba(25, 80, 66, .05);
    }

    .owner-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px;
    }

    .owner-table th {
        color: #195042;
        background: #f4f1ee;
        padding: 12px;
        white-space: nowrap;
    }

    .owner-table td {
        background: #fff;
        border-top: 1px solid #eef2f0;
        border-bottom: 1px solid #eef2f0;
        padding: 12px;
        vertical-align: middle;
    }

    .owner-table tr td:first-child { border-radius: 0 14px 14px 0; }
    .owner-table tr td:last-child { border-radius: 14px 0 0 14px; }

    .activity-item,
    .alert-item {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 12px 0;
        border-bottom: 1px solid #f1f5f3;
    }

    .activity-item:last-child,
    .alert-item:last-child { border-bottom: none; }

    .activity-icon {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f4f1ee;
        color: #195042;
        flex: 0 0 auto;
    }

    .alert-severity-danger .activity-icon { background: #fff1f1; color: #b42318; }
    .alert-severity-warning .activity-icon { background: #fff8df; color: #8a6d1d; }
    .alert-severity-info .activity-icon { background: #eef7ff; color: #145c9e; }

    .state-card {
        background: #fff;
        border: 1px solid #e5eee9;
        border-radius: 18px;
        padding: 24px;
        color: #195042;
    }
</style>

<div class="owner-dashboard">
    <section class="owner-hero">
        <h1>لوحة المالك</h1>
        <p>نظرة شاملة على المساجد، المستخدمين، الحلقات، والشكاوى ضمن المنصة.</p>
    </section>

    @if (_isLoading)
    {
        <div class="state-card d-flex align-items-center gap-3">
            <span class="spinner-border text-success" role="status"></span>
            <span>جاري تحميل لوحة المالك...</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">
            @_errorMessage
        </div>
    }
    else if (_dashboard is not null)
    {
        <section>
            <div class="owner-section-title"><i class="bi bi-speedometer2"></i> المؤشرات العامة</div>
            <div class="row g-4">
                <div class="col-xl-3 col-md-6"><DashboardMetricCard Label="المساجد" Value="@FormatNumber(_dashboard.TotalMosques)" Icon="bi bi-building" Hint="كل المساجد المسجلة" /></div>
                <div class="col-xl-3 col-md-6"><DashboardMetricCard Label="المشرفون" Value="@FormatNumber(_dashboard.TotalSupervisors)" Icon="bi bi-person-badge" /></div>
                <div class="col-xl-3 col-md-6"><DashboardMetricCard Label="المعلمون" Value="@FormatNumber(_dashboard.TotalTeachers)" Icon="bi bi-person-video3" /></div>
                <div class="col-xl-3 col-md-6"><DashboardMetricCard Label="الطلاب" Value="@FormatNumber(_dashboard.TotalStudents)" Icon="bi bi-mortarboard" /></div>
                <div class="col-xl-3 col-md-6"><DashboardMetricCard Label="الحلقات" Value="@FormatNumber(_dashboard.TotalHalqas)" Icon="bi bi-diagram-3" /></div>
                <div class="col-xl-3 col-md-6"><DashboardMetricCard Label="الشكاوى المفتوحة" Value="@FormatNumber(_dashboard.TotalOpenComplaints)" Icon="bi bi-exclamation-octagon" IconClass="danger" /></div>
                <div class="col-xl-3 col-md-6"><DashboardMetricCard Label="المنشورات" Value="@FormatNumber(_dashboard.TotalPosts)" Icon="bi bi-megaphone" IconClass="info" /></div>
                <div class="col-xl-3 col-md-6"><DashboardMetricCard Label="ملفات المكتبة" Value="@FormatNumber(_dashboard.TotalBooks)" Icon="bi bi-journals" IconClass="gold" /></div>
            </div>
        </section>

        <section class="row g-4 mt-1">
            <div class="col-xl-8">
                <div class="owner-section-title"><i class="bi bi-building-check"></i> ملخص المساجد</div>
                <div class="owner-card table-responsive">
                    @if (_dashboard.MosqueSummaries.Count == 0)
                    {
                        <div class="text-muted py-3">لا توجد مساجد لعرضها حالياً.</div>
                    }
                    else
                    {
                        <table class="owner-table">
                            <thead>
                                <tr>
                                    <th>المسجد</th>
                                    <th>العنوان</th>
                                    <th>مشرفون</th>
                                    <th>معلمون</th>
                                    <th>طلاب</th>
                                    <th>حلقات</th>
                                    <th>شكاوى</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var mosque in _dashboard.MosqueSummaries)
                                {
                                    <tr>
                                        <td class="fw-bold text-success">@mosque.MosqueName</td>
                                        <td>@(string.IsNullOrWhiteSpace(mosque.Address) ? "غير محدد" : mosque.Address)</td>
                                        <td>@FormatNumber(mosque.Supervisors)</td>
                                        <td>@FormatNumber(mosque.Teachers)</td>
                                        <td>@FormatNumber(mosque.Students)</td>
                                        <td>@FormatNumber(mosque.Halqas)</td>
                                        <td>@FormatNumber(mosque.OpenComplaints)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <div class="col-xl-4">
                <div class="owner-section-title"><i class="bi bi-bell"></i> تنبيهات مهمة</div>
                <div class="owner-card">
                    @if (_dashboard.Alerts.Count == 0)
                    {
                        <div class="text-muted py-3">لا توجد تنبيهات حالياً.</div>
                    }
                    else
                    {
                        @foreach (var alert in _dashboard.Alerts)
                        {
                            <div class="@($"alert-item alert-severity-{alert.Severity}")">
                                <div class="activity-icon"><i class="bi bi-exclamation-circle"></i></div>
                                <div>
                                    <div class="fw-bold">@alert.Title</div>
                                    <small class="text-muted">@alert.Details</small>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </section>

        <section class="mt-4">
            <div class="owner-section-title"><i class="bi bi-clock-history"></i> آخر النشاطات</div>
            <div class="owner-card">
                @if (_dashboard.RecentActivities.Count == 0)
                {
                    <div class="text-muted py-3">لا يوجد نشاط حديث حتى الآن.</div>
                }
                else
                {
                    @foreach (var activity in _dashboard.RecentActivities)
                    {
                        <div class="activity-item">
                            <div class="activity-icon"><i class="@activity.Icon"></i></div>
                            <div class="flex-grow-1">
                                <div class="fw-bold">@activity.Title</div>
                                <small class="text-muted">@activity.Description</small>
                            </div>
                            <small class="text-muted">@FormatDate(activity.CreatedAt)</small>
                        </div>
                    }
                }
            </div>
        </section>
    }
</div>

@code {
    private OwnerDashboardResponse? _dashboard;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadDashboardAsync();
        StateHasChanged();
    }

    private async Task LoadDashboardAsync()
    {
        try
        {
            var token = await TokenService.Get();
            if (string.IsNullOrWhiteSpace(token))
            {
                _errorMessage = "تعذر تحميل لوحة المالك: لم يتم العثور على رمز تسجيل الدخول. يرجى تسجيل الدخول مرة ثانية.";
                return;
            }

            _dashboard = await DashboardApiClient.GetOverviewAsync(token);
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر تحميل لوحة المالك: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string FormatNumber(int value)
        => value.ToString("N0");

    private static string FormatDate(DateTime value)
        => value == default ? "-" : value.ToLocalTime().ToString("yyyy/MM/dd HH:mm");
}
