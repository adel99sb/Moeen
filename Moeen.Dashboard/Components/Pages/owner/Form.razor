    private string? ValidateForm()
    {
        if (string.IsNullOrWhiteSpace(_model.Name))
            return "الاسم الكامل مطلوب.";

        if (string.IsNullOrWhiteSpace(_model.Email))
            return "البريد الإلكتروني مطلوب.";

        if (!_model.Email.Contains('@'))
            return "صيغة البريد الإلكتروني غير صحيحة.";

        if (!IsExistingMember && (string.IsNullOrWhiteSpace(_model.Password) || _model.Password.Length < 6))
            return "كلمة المرور مطلوبة ويجب أن تكون 6 أحرف على الأقل.";

        if (!IsExistingMember && _model.Type != "Parent" && !Guid.TryParse(_selectedMosqueId, out _))
            return "يجب اختيار المسجد.";

        if (!IsExistingMember && _model.Type == "Parent" && !Guid.TryParse(_selectedStudentId, out _))
            return "يجب اختيار الطالب المرتبط بولي الأمر.";

        return null;
    }

    private MemberProfileDto? DeserializeMember(object? data)
    {
        if (data is null)
            return null;

        if (data is MemberProfileDto dto)
            return dto;

        if (data is JsonElement element)
            return element.Deserialize<MemberProfileDto>(_jsonOptions);

        var json = JsonSerializer.Serialize(data, _jsonOptions);
        return JsonSerializer.Deserialize<MemberProfileDto>(json, _jsonOptions);
    }

    private List<MemberProfileDto> DeserializeMembers(object? data)
    {
        if (data is null)
            return new();

        if (data is JsonElement element)
            return element.Deserialize<List<MemberProfileDto>>(_jsonOptions) ?? new();

        var json = JsonSerializer.Serialize(data, _jsonOptions);
        return JsonSerializer.Deserialize<List<MemberProfileDto>>(json, _jsonOptions) ?? new();
    }

