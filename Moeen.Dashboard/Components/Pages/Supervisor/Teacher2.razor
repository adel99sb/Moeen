}

form { padding: 30px; }

/* دمج الصفوف والمجموعات */
.grid-row, .actions, .form-header h2, .save, .cancel, .input-wrapper {
    display: flex;
    align-items: center;
    gap: 20px;
    border-radius:5px;
    padding:5px;
}

.grid-row { margin-bottom: 20px; flex-wrap: wrap; gap: 20px; }
.input-group { flex: 1; min-width: 250px; }

.input-group {
    flex:1 1 45%;
    display: flex;
    flex-direction:column;
    margin-bottom: 8px;
    color: #1d3937;
    font-weight: 600;
    font-size: 14px;
}

/* تنسيق المدخلات الموحد */
.input-wrapper { position: relative; }

.input-wrapper i {
    position: absolute;
    right: 12px;
    color: #195042;
    font-size: 18px;
}

.input-wrapper input, .input-wrapper select {
    width: 100%;
    padding: 12px 40px 12px 12px;
    border: 2px solid #f0f0f0;
    border-radius: 10px;
    outline: none;
    transition: 0.3s;
    background: #fdfdfd;
    font: inherit;
    margin-right:5px;
    flex:1;
}

.input-wrapper input:focus, .input-wrapper select:focus {
    border-color: #d6cabc;
    background: #fff;
    box-shadow: 0 0 8px rgba(214, 202, 188, 0.3);
}

