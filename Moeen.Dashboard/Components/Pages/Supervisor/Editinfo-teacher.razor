@page "/supervisor/editinfo_teacher/{Id}"
@using Moeen.Dashboard.Application.Services.Abstractions
@using Moeen.Shared.Requests.Enrollment
@using Moeen.Shared.Responses.Enrollment
@inject IEnrollmentService EnrollmentService
@inject NavigationManager NavManager
@rendermode InteractiveServer

<style>
    :root {
--primary-green: #195042;
--accent-beige: #d6cabc;
--light-beige: #f4f1ee;
--white: #ffffff;
--text-dark: #2d3436;
--status-green: #2ecc71;
--danger-red: #e74c3c;
}
body {
font-family: 'Tajawal', sans-serif;
background-color: #f9f9f9;
direction: rtl;
}
        .management-container {
background: var(--white);
margin: 20px;
padding: 30px;
border-radius: 20px;
box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}

.page-title {
color: var(--primary-green);
position: relative;
padding-bottom: 10px; 
border-bottom: 3px solid #d6cabc; 
display: inline-block; 
}
 
  .form-container, .form-container * {
        box-sizing: border-box;
    }

    .form-container {
        max-width: 850px;
        margin: 2rem auto;
        background: var(--white);
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        direction: rtl; 
        overflow: hidden;
    }

    .form-header {
        background: var(--accent-beige);
        color: var(--white);
        padding: 1.2rem;
        text-align: center;
    }

    form {
        padding: 2rem;
    }

    .grid-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr); 
        gap: 1.5rem;
        margin-bottom: 1.2rem;
    }

    .input-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .input-group label {
            color: var(--text-dark);
            font-weight: 600;
            font-size: 0.85rem;
            text-align: right;
        }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
    }

        .input-wrapper i {
            position: absolute;
            right: 12px; 
            color: var(--primary-green);
            z-index: 2;
            pointer-events: none;
        }

        .input-wrapper input,
        .input-wrapper select {
            width: 100%;
            padding: 10px 35px 10px 10px;
            border: 1px solid var(--accent-beige);
            border-radius: 8px;
            background: var(--light-beige);
            font-size: 0.9rem;
            height: 45px; 
            outline: none;
            transition: var(--transition);
        }

            .input-wrapper input:focus,
            .input-wrapper select:focus {
                border-color: var(--primary-green);
                background: #fff;
            }
    .actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #eee;
    }

        .actions button, .actions a {
            flex: 1;
            height: 48px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .actions .save {
            background: var(--primary-green);
            color: white;
        }
        
        .actions .cancel {
            background: #f8f9fa;
            color: #dc3545;
        }

    @@media (max-width: 768px) {
    .grid-row {
        grid-template-columns: 1fr !important;
    }
  }
</style>

<section class="management-container">
    <header class="page-header">
      <h2 class="page-title"> تعديل معلومات معلم </h2>
    </header>
   
    <div class="form-container">
        <div class="form-header">
            <h2><i class="bi bi-pencil"></i> تعديل المعلومات المشتركة</h2>
        </div>
   
        <EditForm Model="editModel" OnValidSubmit="HandleUpdate">
            <DataAnnotationsValidator />
            <ValidationSummary />
 <div class="grid-row">
                <div class="input-group">
                    <label>الاسم الكامل</label>
                    <div class="input-wrapper">
                        <i class="bi bi-person"></i>
                        <input type="text" @bind="editModel.Name" placeholder="أدخل الاسم">
                    </div>
                </div>
                <div class="input-group">
                    <label>رقم الهاتف</label>
                    <div class="input-wrapper">
                        <i class="bi bi-telephone"></i>
                        <input type="tel" @bind="editModel.Phone" placeholder="أدخل رقم الهاتف">
                    </div>
                </div>
            </div>
            
            <div class="grid-row">
                <div class="input-group">
                    <label>البريد الإلكتروني</label>
                    <div class="input-wrapper">
                        <i class="bi bi-envelope"></i>
                        <input type="email" @bind="editModel.Email" placeholder="أدخل البريد الالكتروني">
                    </div>
                </div>
                <div class="input-group">
                    <label>الجنس</label>
                    <div class="input-wrapper">
                        <i class="bi bi-gender-ambiguous"></i>
                        <select @bind="editModel.Gender">
                            <option value="Male">ذكر</option>
                            <option value="Female">أنثى</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="grid-row">
                <div class="input-group">
                    <label>لمحة عن الخبرات (Bio)</label>
                    <div class="input-wrapper">
                        <i class="bi bi-person-workspace"></i>
                        <input type="text" @bind="editModel.Bio" placeholder="تعديل السيرة الذاتية...">
                    </div>
                </div>
                <div class="input-group">
                    <label>تاريخ التعيين (Assigned At)</label>
                    <div class="input-wrapper">
                        <i class="bi bi-calendar-event"></i>
                        <input type="text" @bind="editModel.AssignedAt" placeholder="تعديل تاريخ التعيين">
                    </div>
                </div>
            </div>

            <div class="actions">
                <button type="submit" class="save"><i class="bi bi-check2-all"></i> حفظ التعديلات</button>
                <a href="/supervisor/teacher" class="cancel"><i class="bi bi-x-lg"></i> إلغاء</a>
            </div>
        </EditForm>
    </div>
</section>

@code {
    [Parameter] public string Id { get; set; }
    
    // تم ربط الكود بـ UpdateMemberInfoRequest المعتمد بالباك اند للتعديل الموحد
    private UpdateMemberInfoRequest editModel = new UpdateMemberInfoRequest();

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Id))
        {
            editModel.MemberId = Id;
            
            // استخدام الميثود العامة المتاحة بالباك اند لجلب معلومات الحساب الشخصي
            var profileRequest = new GetMemberProfileRequest { MemberId = Id };
            var response = await EnrollmentService.GetMemberProfileAsync(profileRequest);
            
            if (response != null && response.Success && response.Data != null)
            {
                var profile = System.Text.Json.JsonSerializer.Deserialize<MemberProfileDto>(response.Data.ToString(),
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                
                if (profile != null)
                {
                    editModel.Name = profile.Name;
                    editModel.Email = profile.Email;
                    editModel.Phone = profile.Phone;
                    editModel.Gender = profile.Gender;
                    
                    if (profile.TeacherDetails != null)
                    {
                        editModel.Bio = profile.TeacherDetails.Bio;
                        editModel.AssignedAt = profile.TeacherDetails.AssignedAt;
                    }
                }
            }
        }
    }

    private async Task HandleUpdate()
    {
        // استخدام UpdateMemberInfoAsync الحقيقية للتعديل بالباك اند
        var response = await EnrollmentService.UpdateMemberInfoAsync(editModel);
        if (response != null && response.Success)
        {
            NavManager.NavigateTo("/supervisor/teacher");
        }
    }
}