@page "/supervisor/complaint-and-suggestions"
<style>
   :root {
--primary-green: #195042;
--accent-beige: #d6cabc;
--light-beige: #f4f1ee;
--white: #ffffff;
--text-dark: #2d3436;
--status-green: #2ecc71;
--danger-red: #e74c3c;
}
body {
font-family: 'Tajawal', sans-serif;
background-color: #f9f9f9;
direction: rtl;
}
.management-container {
background: var(--white);
margin: 20px;
padding: 30px;
border-radius: 20px;
box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}
/* العنوان */
.page-title {
color: var(--primary-green);
position: relative;
padding-bottom: 10px; /* مسافة بين النص والخط */
border-bottom: 3px solid #d6cabc; /* جعل الخط بلون البيج */
display: inline-block; /* ليصبح طول الخط على قدر الكلمة فقط */
}
.table {
    width: 100%;
    table-layout: fixed;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
     font-family: 'Tajawal', sans-serif;
        font-size: clamp(1rem,2.5vw,1.5rem);
        text-align: center;
}
    .table th {
        background-color: var(--light-beige);
        color: var(--primary-green);
        padding: 12px;
    }
    .table td {
        background-color: var(--white);
        padding: 10px;
        border-bottom: 1px solid #eee;

    }
    .table tbody tr:hover {
        background-color: #fafafa;
        transform: scale(1.01);
    }
	</style>
<header class="page-header">
