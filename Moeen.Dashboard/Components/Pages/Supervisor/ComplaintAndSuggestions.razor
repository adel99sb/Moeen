@page "/supervisor/complaint-and-suggestions"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using System.Text.Json.Serialization
@using Moeen.Dashboard.Components.Shared
@using Moeen.Frontend.Services.Abstractions
@using Moeen.Shared.Constants
@using Moeen.Shared.Requests
@using Moeen.Shared.Requests.Feedback
@inject IFeedbackService FeedbackService
@inject IJSRuntime JS

<style>
    .management-page { direction: rtl; color: #163f35; }
    .management-card { background: #fff; border: 1px solid rgba(25, 80, 66, 0.10); border-radius: 24px; padding: 28px; box-shadow: 0 22px 60px rgba(25, 80, 66, 0.08); }
    .management-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin-bottom: 24px; }
    .management-title { margin: 0; color: #195042; font-size: 1.65rem; font-weight: 900; letter-spacing: -0.04em; }
    .management-subtitle { margin: 7px 0 0; color: #7b7067; font-size: 0.95rem; }
    .management-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 22px; flex-wrap: wrap; }
    .search-wrapper { position: relative; width: min(100%, 470px); }
    .search-wrapper .bi { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: #195042; }
    .search-input { width: 100%; height: 48px; padding: 0 44px 0 16px; border: 1px solid #ddd5cc; border-radius: 15px; outline: none; background: #fbfaf8; color: #163f35; transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease; }
    .search-input:focus { border-color: #195042; background: #fff; box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.10); }
    .toolbar-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .btn-moeen-primary, .btn-moeen-light { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 0 17px; border-radius: 14px; border: 0; font-weight: 800; transition: transform 0.18s ease, background 0.18s ease; }
    .btn-moeen-primary { background: #195042; color: #fff; box-shadow: 0 14px 28px rgba(25, 80, 66, 0.18); }
    .btn-moeen-primary:hover:not(:disabled) { background: #123d32; transform: translateY(-1px); }
    .btn-moeen-light { background: #f4f1e8; color: #195042; border: 1px solid #e2dbd2; }
    .section-title { display: flex; align-items: center; gap: 10px; color: #195042; font-size: 1.15rem; font-weight: 900; margin: 26px 0 14px; }
    .section-count { display: inline-flex; align-items: center; justify-content: center; min-width: 30px; height: 30px; border-radius: 999px; background: #f4f1e8; color: #195042; font-size: 0.9rem; }
    .management-table-wrap { overflow-x: auto; border: 1px solid #eee8e0; border-radius: 18px; }
    .management-table { width: 100%; margin: 0; border-collapse: collapse; min-width: 1060px; }
    .management-table th { background: #f4f1e8; color: #195042; font-weight: 900; padding: 15px 18px; border-bottom: 1px solid rgba(25, 80, 66, 0.18); white-space: nowrap; text-align: center; }
    .management-table td { padding: 15px 18px; border-bottom: 1px solid #f1ece6; vertical-align: middle; color: #263f37; text-align: center; }
    .management-table tr:last-child td { border-bottom: 0; }
    .management-table tbody tr:hover td { background: #fbfaf8; }
    .name-cell { display: flex; align-items: center; gap: 12px; font-weight: 900; color: #163f35; text-align: right; }
    .entity-avatar { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 14px; background: #195042; color: #fff; font-size: 1rem; }
    .content-cell { max-width: 360px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .status-pill { display: inline-flex; align-items: center; justify-content: center; min-width: 90px; padding: 7px 12px; border-radius: 999px; font-weight: 900; }
    .status-pill.in-progress { background: #fffaeb; color: #b54708; }
    .status-pill.resolved { background: #ecfdf3; color: #027a48; }
    .status-pill.deleted { background: #fef3f2; color: #b42318; }
    .status-select { min-height: 40px; border: 1px solid #ddd5cc; border-radius: 12px; padding: 0 10px; color: #195042; background: #fff; font-weight: 800; outline: none; }
    .row-actions { display: flex; justify-content: center; gap: 8px; }
    .icon-btn { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid #e2dbd2; border-radius: 12px; background: #fff; color: #195042; transition: transform 0.18s ease, background 0.18s ease; }
    .icon-btn:hover { background: #f4f1e8; transform: translateY(-1px); }
    .icon-btn.info { color: #039855; }
    .icon-btn.edit { color: #2563eb; }
    .icon-btn.danger { color: #b42318; }
    .state-card { padding: 22px; border: 1px solid #eee8e0; border-radius: 18px; background: #fff; color: #195042; }
    .dialog-backdrop { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 28px; background: rgba(9, 30, 24, 0.42); backdrop-filter: blur(7px); direction: rtl; }
    .dialog-panel { width: min(100%, 820px); max-height: calc(100vh - 56px); overflow: hidden; display: flex; flex-direction: column; border-radius: 26px; background: #fff; box-shadow: 0 30px 90px rgba(0, 0, 0, 0.24); }
    .dialog-header { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 24px 28px; border-bottom: 1px solid #eee8e0; background: linear-gradient(135deg, #f7f3ed 0%, #fff 100%); }
    .dialog-title { margin: 0; color: #195042; font-size: 1.25rem; font-weight: 900; }
    .dialog-subtitle { margin: 6px 0 0; color: #7b7067; font-size: 0.9rem; }
    .dialog-close { width: 42px; height: 42px; border: 0; border-radius: 14px; background: #f4f1e8; color: #195042; }
    .dialog-body { overflow-y: auto; padding: 26px 28px; }
    .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .form-field { display: flex; flex-direction: column; gap: 8px; }
    .form-field.full { grid-column: 1 / -1; }
    .form-field label { color: #195042; font-weight: 900; font-size: 0.9rem; }
    .form-control-moeen { width: 100%; min-height: 46px; border: 1px solid #ddd5cc; border-radius: 14px; padding: 0 14px; background: #fbfaf8; color: #163f35; outline: none; font-weight: 700; }
    textarea.form-control-moeen { min-height: 120px; padding-top: 12px; resize: vertical; }
    .form-control-moeen:focus { border-color: #195042; background: #fff; box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.10); }
    .dialog-footer { display: flex; justify-content: flex-start; gap: 12px; padding: 20px 28px 24px; border-top: 1px solid #eee8e0; }
    .dialog-error { margin-bottom: 16px; }
    @@media (max-width: 760px) { .management-card { padding: 20px; } .management-header { flex-direction: column; } .form-grid { grid-template-columns: 1fr; } .form-field.full { grid-column: auto; } .dialog-backdrop { padding: 12px; } }
</style>

<section class="management-page">
    <div class="management-card">
        <header class="management-header">
            <div>
                <h2 class="management-title">إدارة الشكاوي والاقتراحات</h2>
                <p class="management-subtitle">متابعة الشكاوي والاقتراحات وتحديث حالتها والرد عليها من نفس الصفحة.</p>
            </div>
        </header>

        <div class="management-toolbar">
            <div class="search-wrapper">
                <i class="bi bi-search"></i>
                <input class="search-input" value="@_searchText" placeholder="ابحث بالمحتوى أو المستخدم أو الرد..." @oninput="HandleSearch" />
            </div>
            <div class="toolbar-actions">
                <button class="btn-moeen-light" type="button" @onclick="() => LoadFeedbackAsync()" disabled="@_isLoading">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>تحديث</span>
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success">@_successMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }

        @if (_isLoading)
        {
            <div class="state-card d-flex align-items-center gap-3">
                <span class="spinner-border text-success" role="status"></span>
                <span>جاري تحميل الشكاوي والاقتراحات...</span>
            </div>
        }
        else
        {
            <h3 class="section-title">
                <i class="bi bi-exclamation-circle"></i>
                <span>قائمة الشكاوي</span>
                <span class="section-count">@FilteredComplaints.Count</span>
            </h3>
            <div class="management-table-wrap">
                <table class="management-table">
                    <thead>
                        <tr>
                            <th>المستخدم</th>
                            <th>ملخص الشكوى</th>
                            <th>تاريخ الإرسال</th>
                            <th>الحالة</th>
                            <th>تغيير الحالة</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredComplaints.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">لا يوجد شكاوي حالياً.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in FilteredComplaints)
                            {
                                <tr>
                                    <td>
                                        <div class="name-cell">
                                            <span class="entity-avatar"><i class="bi bi-person"></i></span>
                                            <span>@ShortId(item.UserId)</span>
                                        </div>
                                    </td>
                                    <td class="content-cell" title="@item.Content">@Display(item.Content)</td>
                                    <td>@FormatDate(item.CreatedAt)</td>
                                    <td><span class="status-pill @StatusCss(CurrentStatusValue(item))">@StatusLabel(CurrentStatusValue(item))</span></td>
                                    <td>
                                        <select class="status-select" value="@CurrentStatusValue(item)" @onchange="args => UpdateStatusAsync(item, args)">
                                            <option value="1">قيد المعالجة</option>
                                            <option value="2">تمت المعالجة</option>
                                            <option value="3">مغلقة/محذوفة</option>
                                        </select>
                                    </td>
                                    <td>
                                        <div class="row-actions">
                                            <button class="icon-btn info" type="button" title="عرض" @onclick="() => OpenDetailsDialog(item)"><i class="bi bi-info-circle"></i></button>
                                            <button class="icon-btn edit" type="button" title="إدارة" @onclick="() => OpenManageDialog(item)"><i class="bi bi-pencil-square"></i></button>
                                            <button class="icon-btn danger" type="button" title="حذف" @onclick="() => DeleteFeedbackAsync(item)"><i class="bi bi-trash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <h3 class="section-title">
                <i class="bi bi-lightbulb"></i>
                <span>قائمة الاقتراحات</span>
                <span class="section-count">@FilteredSuggestions.Count</span>
            </h3>
            <div class="management-table-wrap">
                <table class="management-table">
                    <thead>
                        <tr>
                            <th>المستخدم</th>
                            <th>العنوان</th>
                            <th>ملخص الاقتراح</th>
                            <th>تاريخ الإرسال</th>
                            <th>الحالة</th>
                            <th>تغيير الحالة</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredSuggestions.Count == 0)
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">لا يوجد اقتراحات حالياً.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in FilteredSuggestions)
                            {
                                <tr>
                                    <td>
                                        <div class="name-cell">
                                            <span class="entity-avatar"><i class="bi bi-person"></i></span>
                                            <span>@ShortId(item.UserId)</span>
                                        </div>
                                    </td>
                                    <td>@Display(item.Title)</td>
                                    <td class="content-cell" title="@item.Content">@Display(item.Content)</td>
                                    <td>@FormatDate(item.CreatedAt)</td>
                                    <td><span class="status-pill @StatusCss(CurrentStatusValue(item))">@StatusLabel(CurrentStatusValue(item))</span></td>
                                    <td>
                                        <select class="status-select" value="@CurrentStatusValue(item)" @onchange="args => UpdateStatusAsync(item, args)">
                                            <option value="1">قيد المعالجة</option>
                                            <option value="2">سيتم العمل عليه</option>
                                            <option value="3">مغلق/مرفوض</option>
                                        </select>
                                    </td>
                                    <td>
                                        <div class="row-actions">
                                            <button class="icon-btn info" type="button" title="عرض" @onclick="() => OpenDetailsDialog(item)"><i class="bi bi-info-circle"></i></button>
                                            <button class="icon-btn edit" type="button" title="إدارة" @onclick="() => OpenManageDialog(item)"><i class="bi bi-pencil-square"></i></button>
                                            <button class="icon-btn danger" type="button" title="حذف" @onclick="() => DeleteFeedbackAsync(item)"><i class="bi bi-trash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (_isManageDialogOpen)
    {
        <div class="dialog-backdrop" @onclick="CloseManageDialog">
            <div class="dialog-panel" @onclick:stopPropagation="true">
                <div class="dialog-header">
                    <div>
                        <h3 class="dialog-title">إدارة @(_manageForm.Type == FeedbackType.Complaint ? "الشكوى" : "الاقتراح")</h3>
                        <p class="dialog-subtitle">حدّث الحالة وأضف رداً إدارياً يظهر على السجل.</p>
                    </div>
                    <button class="dialog-close" type="button" @onclick="CloseManageDialog"><i class="bi bi-x-lg"></i></button>
                </div>

                <div class="dialog-body">
                    @if (!string.IsNullOrWhiteSpace(_dialogError))
                    {
                        <div class="alert alert-danger dialog-error">@_dialogError</div>
                    }

                    <div class="form-grid">
                        <div class="form-field">
                            <label>الحالة</label>
                            <select class="form-control-moeen" @bind="_manageForm.StatusValue">
                                <option value="1">قيد المعالجة</option>
                                <option value="2">تمت المعالجة / سيتم العمل عليه</option>
                                <option value="3">مغلق/مرفوض</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label>المستخدم</label>
                            <input class="form-control-moeen" value="@_manageForm.UserId" disabled />
                        </div>
                        <div class="form-field full">
                            <label>النص الأصلي</label>
                            <textarea class="form-control-moeen" value="@_manageForm.Content" disabled></textarea>
                        </div>
                        <div class="form-field full">
                            <label>الرد الإداري</label>
                            <textarea class="form-control-moeen" @bind="_manageForm.Response" placeholder="اكتب الرد أو الملاحظة هنا"></textarea>
                        </div>
                    </div>
                </div>

                <div class="dialog-footer">
                    <button class="btn-moeen-primary" type="button" @onclick="ApplyManageDialogAsync" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle"></i>
                        }
                        <span>حفظ</span>
                    </button>
                    <button class="btn-moeen-light" type="button" @onclick="CloseManageDialog" disabled="@_isSaving">
                        <i class="bi bi-x-lg"></i>
                        <span>إلغاء</span>
                    </button>
                </div>
            </div>
        </div>
    }

    <MemberDetailsDialog IsOpen="@_isDetailsOpen" Model="@_detailsModel" OnClose="CloseDetailsDialog" />
</section>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    private readonly List<FeedbackItemModel> _complaints = new();
    private readonly List<FeedbackItemModel> _suggestions = new();
    private MemberDetailsDialogModel _detailsModel = new();
    private ManageFeedbackForm _manageForm = new();

    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isDetailsOpen;
    private bool _isManageDialogOpen;
    private string _searchText = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _dialogError;

    private List<FeedbackItemModel> FilteredComplaints => FilterItems(_complaints);
    private List<FeedbackItemModel> FilteredSuggestions => FilterItems(_suggestions);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadFeedbackAsync();
        StateHasChanged();
    }

    private async Task LoadFeedbackAsync(bool showLoading = true)
    {
        if (showLoading)
            _isLoading = true;

        _errorMessage = null;

        try
        {
            var request = new PaginationRequest { Page = 1, PageSize = 500 };

            var complaintsResponse = await FeedbackService.GetComplaintsResponseAsync(request);
            var suggestionsResponse = await FeedbackService.GetSuggestionsAsync(request);

            if (complaintsResponse == null || !complaintsResponse.Success)
                throw new InvalidOperationException(complaintsResponse?.Message ?? "فشل تحميل الشكاوي.");

            if (suggestionsResponse == null || !suggestionsResponse.Success)
                throw new InvalidOperationException(suggestionsResponse?.Message ?? "فشل تحميل الاقتراحات.");

            _complaints.Clear();
            _complaints.AddRange(ReadFeedbackItems(complaintsResponse.Data)
                .Select(item => { item.Type = FeedbackType.Complaint; return item; })
                .OrderByDescending(item => item.CreatedAt));

            _suggestions.Clear();
            _suggestions.AddRange(ReadFeedbackItems(suggestionsResponse.Data)
                .Select(item => { item.Type = FeedbackType.Suggestion; return item; })
                .OrderByDescending(item => item.CreatedAt));
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر تحميل الشكاوي والاقتراحات: {ex.Message}";
            _complaints.Clear();
            _suggestions.Clear();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleSearch(ChangeEventArgs args)
        => _searchText = args.Value?.ToString() ?? string.Empty;

    private List<FeedbackItemModel> FilterItems(IEnumerable<FeedbackItemModel> items)
    {
        if (string.IsNullOrWhiteSpace(_searchText))
            return items.ToList();

        return items.Where(item =>
            item.UserId.ToString().Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
            (item.Title ?? string.Empty).Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
            (item.Content ?? string.Empty).Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
            (item.Response ?? string.Empty).Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private async Task UpdateStatusAsync(FeedbackItemModel item, ChangeEventArgs args)
    {
        _successMessage = null;
        _errorMessage = null;

        if (!int.TryParse(args.Value?.ToString(), out var value))
            return;

        try
        {
            var response = item.Type == FeedbackType.Complaint
                ? await FeedbackService.UpdateComplaintStatusAsync(new UpdateComplaintStatusRequest
                {
                    ComplaintId = item.Id,
                    Status = (ComplaintStatus)value,
                    Note = item.Response
                })
                : await FeedbackService.UpdateSuggestionStatusAsync(new UpdateSuggestionStatusRequest
                {
                    SuggestionId = item.Id,
                    Status = (SuggestionStatus)value
                });

            if (response == null || !response.Success)
            {
                _errorMessage = response?.Message ?? "فشل تحديث الحالة.";
                return;
            }

            _successMessage = "تم تحديث الحالة بنجاح.";
            await LoadFeedbackAsync(showLoading: false);
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر تحديث الحالة: {ex.Message}";
        }
    }

    private void OpenManageDialog(FeedbackItemModel item)
    {
        _dialogError = null;
        _successMessage = null;
        _manageForm = new ManageFeedbackForm
        {
            Id = item.Id,
            Type = item.Type,
            UserId = item.UserId,
            Content = item.Content ?? string.Empty,
            StatusValue = CurrentStatusValue(item),
            Response = item.Response ?? string.Empty
        };
        _isManageDialogOpen = true;
    }

    private void CloseManageDialog()
    {
        if (_isSaving)
            return;

        _isManageDialogOpen = false;
        _dialogError = null;
    }

    private async Task ApplyManageDialogAsync()
    {
        _isSaving = true;
        _dialogError = null;
        _successMessage = null;

        try
        {
            var statusResponse = _manageForm.Type == FeedbackType.Complaint
                ? await FeedbackService.UpdateComplaintStatusAsync(new UpdateComplaintStatusRequest
                {
                    ComplaintId = _manageForm.Id,
                    Status = (ComplaintStatus)_manageForm.StatusValue,
                    Note = string.IsNullOrWhiteSpace(_manageForm.Response) ? null : _manageForm.Response.Trim()
                })
                : await FeedbackService.UpdateSuggestionStatusAsync(new UpdateSuggestionStatusRequest
                {
                    SuggestionId = _manageForm.Id,
                    Status = (SuggestionStatus)_manageForm.StatusValue
                });

            if (statusResponse == null || !statusResponse.Success)
            {
                _dialogError = statusResponse?.Message ?? "فشل تحديث حالة السجل.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(_manageForm.Response))
            {
                var manageResponse = await FeedbackService.ManageFeedbackAsync(new ManageFeedbackRequest
                {
                    Id = _manageForm.Id,
                    Type = _manageForm.Type,
                    Response = _manageForm.Response.Trim()
                });

                if (manageResponse == null || !manageResponse.Success)
                {
                    _dialogError = manageResponse?.Message ?? "فشل حفظ الرد الإداري.";
                    return;
                }
            }

            _successMessage = "تم حفظ التعديلات بنجاح.";
            _isManageDialogOpen = false;
            await LoadFeedbackAsync(showLoading: false);
        }
        catch (Exception ex)
        {
            _dialogError = $"تعذر حفظ تعديلات السجل: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteFeedbackAsync(FeedbackItemModel item)
    {
        _successMessage = null;
        _errorMessage = null;

        var label = item.Type == FeedbackType.Complaint ? "الشكوى" : "الاقتراح";
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"هل تريد حذف {label} بشكل نهائي؟");
        if (!confirmed)
            return;

        try
        {
            var response = await FeedbackService.DeleteFeedbackAsync(item.Id);
            if (response == null || !response.Success)
            {
                _errorMessage = response?.Message ?? "فشل حذف السجل.";
                return;
            }

            _successMessage = "تم الحذف بنجاح.";
            await LoadFeedbackAsync(showLoading: false);
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر حذف السجل: {ex.Message}";
        }
    }

    private void OpenDetailsDialog(FeedbackItemModel item)
    {
        _detailsModel = new MemberDetailsDialogModel
        {
            Title = item.Type == FeedbackType.Complaint ? "تفاصيل الشكوى" : "تفاصيل الاقتراح",
            Subtitle = StatusLabel(CurrentStatusValue(item)),
            Sections = new List<MemberDetailsSectionModel>
            {
                new()
                {
                    Title = "البيانات الأساسية",
                    Items = new List<MemberDetailsItemModel>
                    {
                        DetailItem("المستخدم", item.UserId.ToString()),
                        DetailItem("النوع", item.Type == FeedbackType.Complaint ? "شكوى" : "اقتراح"),
                        DetailItem("العنوان", item.Title),
                        DetailItem("الحالة", StatusLabel(CurrentStatusValue(item))),
                        DetailItem("تاريخ الإرسال", FormatDate(item.CreatedAt)),
                        DetailItem("آخر تعديل", item.UpdatedAt.HasValue ? FormatDate(item.UpdatedAt.Value) : null)
                    }
                },
                new()
                {
                    Title = "النص والرد",
                    Items = new List<MemberDetailsItemModel>
                    {
                        DetailItem("المحتوى", item.Content),
                        DetailItem("الرد الإداري", item.Response)
                    }
                }
            }
        };

        _isDetailsOpen = true;
    }

    private void CloseDetailsDialog()
        => _isDetailsOpen = false;

    private static List<FeedbackItemModel> ReadFeedbackItems(object? data)
    {
        if (data == null)
            return new List<FeedbackItemModel>();

        var json = JsonSerializer.Serialize(data);
        return JsonSerializer.Deserialize<List<FeedbackItemModel>>(json, JsonOptions) ?? new List<FeedbackItemModel>();
    }

    private static int CurrentStatusValue(FeedbackItemModel item)
        => item.Type == FeedbackType.Complaint
            ? (int)(item.Status ?? ComplaintStatus.InProgress)
            : (int)(item.SuggestionStatus ?? SuggestionStatus.InProgress);

    private static string StatusLabel(int value)
        => value switch
        {
            1 => "قيد المعالجة",
            2 => "تمت المعالجة",
            3 => "مغلق/مرفوض",
            _ => "غير محدد"
        };

    private static string StatusCss(int value)
        => value switch
        {
            1 => "in-progress",
            2 => "resolved",
            3 => "deleted",
            _ => "in-progress"
        };

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string FormatDate(DateTime date)
        => date == default ? "—" : date.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    private static string ShortId(Guid id)
        => id == Guid.Empty ? "—" : id.ToString()[..8];

    private static MemberDetailsItemModel DetailItem(string label, string? value)
        => new()
        {
            Label = label,
            Value = string.IsNullOrWhiteSpace(value) ? "—" : value
        };

    private sealed class FeedbackItemModel
    {
        public Guid Id { get; set; }
        public Guid UserId { get; set; }
        public string? Title { get; set; }

        [JsonPropertyName("content")]
        public string? Content { get; set; }

        [JsonPropertyName("created_at")]
        public DateTime CreatedAt { get; set; }

        public FeedbackType Type { get; set; }
        public ComplaintStatus? Status { get; set; }
        public SuggestionStatus? SuggestionStatus { get; set; }
        public string? Response { get; set; }
        public DateTime? UpdatedAt { get; set; }
    }

    private sealed class ManageFeedbackForm
    {
        public Guid Id { get; set; }
        public FeedbackType Type { get; set; }
        public Guid UserId { get; set; }
        public string Content { get; set; } = string.Empty;
        public int StatusValue { get; set; } = 1;
        public string Response { get; set; } = string.Empty;
    }
}
