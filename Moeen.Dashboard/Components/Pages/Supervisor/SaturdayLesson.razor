@page "/supervisor/saturdaylesson"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Moeen.Dashboard.Application.Services.Abstractions
@using Moeen.Dashboard.Components.Shared
@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Requests.Enrollment
@using Moeen.Shared.Requests.Halqa
@using Moeen.Shared.Requests.LessonManagement
@using Moeen.Shared.Responses.Enrollment
@using Moeen.Shared.Responses.Halqa
@using Moeen.Shared.Responses.LessonManagement
@inject IWeeklyLessonService WeeklyLessonService
@inject IEnrollmentService EnrollmentService
@inject IHalqaManagementService HalqaService
@inject IJSRuntime JS

<style>
    .weekly-page { direction: rtl; color: #163f35; }
    .weekly-card { background: #fff; border: 1px solid rgba(25, 80, 66, .10); border-radius: 24px; padding: 28px; box-shadow: 0 22px 60px rgba(25, 80, 66, .08); }
    .weekly-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; margin-bottom: 24px; }
    .weekly-title { margin: 0; color: #195042; font-size: 1.65rem; font-weight: 900; letter-spacing: -.04em; }
    .weekly-subtitle { margin: 7px 0 0; color: #7b7067; font-size: .95rem; }
    .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 14px; margin-bottom: 22px; flex-wrap: wrap; }
    .search-wrapper { position: relative; width: min(100%, 450px); }
    .search-wrapper .bi { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: #195042; }
    .search-input, .moeen-control { width: 100%; min-height: 46px; border: 1px solid #ddd5cc; border-radius: 14px; background: #fbfaf8; color: #163f35; outline: none; font-weight: 700; }
    .search-input { padding: 0 44px 0 16px; }
    .moeen-control { padding: 0 14px; }
    textarea.moeen-control { padding-top: 12px; min-height: 110px; resize: vertical; }
    .search-input:focus, .moeen-control:focus { border-color: #195042; background: #fff; box-shadow: 0 0 0 4px rgba(25,80,66,.10); }
    .btn-moeen-primary, .btn-moeen-light { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 0 17px; border-radius: 14px; border: 0; font-weight: 900; }
    .btn-moeen-primary { background: #195042; color: #fff; box-shadow: 0 14px 28px rgba(25,80,66,.18); }
    .btn-moeen-light { background: #f4f1e8; color: #195042; border: 1px solid #e2dbd2; }
    .stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-bottom: 22px; }
    .stat-card { padding: 16px; border-radius: 18px; background: #fbfaf8; border: 1px solid #eee8e0; }
    .stat-label { color: #7b7067; font-weight: 800; font-size: .86rem; }
    .stat-value { color: #195042; font-weight: 950; font-size: 1.55rem; margin-top: 6px; }
    .lesson-list { display: grid; gap: 18px; }
    .lesson-panel { border: 1px solid #eee8e0; border-radius: 20px; overflow: hidden; background: #fff; }
    .lesson-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 20px; background: #fbfaf8; border-bottom: 1px solid #eee8e0; }
    .lesson-name { margin: 0; color: #195042; font-size: 1.15rem; font-weight: 950; }
    .lesson-desc { margin: 6px 0 0; color: #7b7067; font-weight: 700; }
    .lesson-actions, .row-actions { display: flex; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap; }
    .icon-btn { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid #e2dbd2; border-radius: 12px; background: #fff; color: #195042; }
    .icon-btn.info { color: #039855; } .icon-btn.edit { color: #2563eb; } .icon-btn.danger { color: #b42318; }
    .table-wrap { overflow-x: auto; }
    .weekly-table { width: 100%; margin: 0; border-collapse: collapse; min-width: 900px; }
    .weekly-table th { background: #f4f1e8; color: #195042; font-weight: 900; padding: 14px 16px; border-bottom: 1px solid rgba(25,80,66,.18); text-align: center; }
    .weekly-table td { padding: 14px 16px; border-bottom: 1px solid #f1ece6; vertical-align: middle; color: #263f37; text-align: center; }
    .name-cell { display: flex; align-items: center; gap: 10px; font-weight: 900; color: #163f35; text-align: right; }
    .entity-avatar { width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center; border-radius: 13px; background: #195042; color: #fff; }
    .time-pill { display: inline-flex; align-items: center; justify-content: center; min-width: 112px; padding: 7px 12px; border-radius: 999px; background: #eef4ff; color: #1849a9; font-weight: 900; }
    .state-card { padding: 22px; border: 1px solid #eee8e0; border-radius: 18px; background: #fff; color: #195042; }
    .dialog-backdrop { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 28px; background: rgba(9,30,24,.42); backdrop-filter: blur(7px); direction: rtl; }
    .dialog-panel { width: min(100%, 780px); max-height: calc(100vh - 56px); overflow: hidden; display: flex; flex-direction: column; border-radius: 26px; background: #fff; box-shadow: 0 30px 90px rgba(0,0,0,.24); }
    .dialog-header { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 24px 28px; border-bottom: 1px solid #eee8e0; background: linear-gradient(135deg,#f7f3ed 0%,#fff 100%); }
    .dialog-title { margin: 0; color: #195042; font-size: 1.25rem; font-weight: 900; }
    .dialog-subtitle { margin: 6px 0 0; color: #7b7067; font-size: .9rem; }
    .dialog-close { width: 42px; height: 42px; border: 0; border-radius: 14px; background: #f4f1e8; color: #195042; }
    .dialog-body { overflow-y: auto; padding: 26px 28px; }
    .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .form-field { display: flex; flex-direction: column; gap: 8px; }
    .form-field.full { grid-column: 1 / -1; }
    .form-field label { color: #195042; font-weight: 900; font-size: .9rem; }
    .student-pick-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; max-height: 260px; overflow-y: auto; padding: 12px; border: 1px solid #ddd5cc; border-radius: 14px; background: #fbfaf8; }
    .student-pick-item { display: grid; grid-template-columns: auto 1fr; gap: 8px 10px; align-items: center; padding: 10px 12px; border: 1px solid #eee8e0; border-radius: 12px; background: #fff; color: #163f35; font-weight: 800; }
    .student-pick-item small { grid-column: 2; color: #7b7067; font-weight: 700; }
    .dialog-footer { display: flex; justify-content: flex-start; gap: 12px; padding: 20px 28px 24px; border-top: 1px solid #eee8e0; }
    @@media (max-width: 900px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } .weekly-header, .toolbar { flex-direction: column; align-items: stretch; } }
    @@media (max-width: 700px) { .weekly-card { padding: 18px; } .stats-grid, .form-grid, .student-pick-list { grid-template-columns: 1fr; } .form-field.full { grid-column: auto; } }
</style>

<section class="weekly-page">
    <div class="weekly-card">
        <header class="weekly-header">
            <div>
                <h2 class="weekly-title">الدروس الأسبوعية</h2>
                <p class="weekly-subtitle">أضف درساً أسبوعياً مثل فقه أو عقيدة، ثم اربط به حلقات موجودة مع المعلم ووقت الحضور.</p>
            </div>
            <button class="btn-moeen-primary" type="button" @onclick="OpenCreateLessonDialog" disabled="@_isLoading">
                <i class="bi bi-plus-circle"></i>
                <span>إضافة درس جديد</span>
            </button>
        </header>

        <div class="toolbar">
            <div class="search-wrapper">
                <i class="bi bi-search"></i>
                <input class="search-input" value="@_searchText" placeholder="ابحث باسم الدرس أو المعلم أو الحلقة..." @oninput="HandleSearch" />
            </div>
            <button class="btn-moeen-light" type="button" @onclick="LoadAllAsync" disabled="@_isLoading">
                <i class="bi bi-arrow-clockwise"></i>
                <span>تحديث</span>
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success">@_successMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }

        @if (_isLoading)
        {
            <div class="state-card d-flex align-items-center gap-3">
                <span class="spinner-border text-success" role="status"></span>
                <span>جاري تحميل الدروس الأسبوعية...</span>
            </div>
        }
        else
        {
            <div class="stats-grid">
                <div class="stat-card"><div class="stat-label">عدد الدروس</div><div class="stat-value">@_lessons.Count</div></div>
                <div class="stat-card"><div class="stat-label">عدد المواعيد</div><div class="stat-value">@_lessons.Sum(l => l.AssignmentsCount)</div></div>
                <div class="stat-card"><div class="stat-label">المعلمين المتاحين</div><div class="stat-value">@_teachers.Count</div></div>
                <div class="stat-card"><div class="stat-label">الطلاب المتاحون</div><div class="stat-value">@_students.Count</div></div>
            </div>

            @if (FilteredLessons.Count == 0)
            {
                <div class="state-card text-center text-muted">لا يوجد دروس أسبوعية حالياً.</div>
            }
            else
            {
                <div class="lesson-list">
                    @foreach (var lesson in FilteredLessons)
                    {
                        <article class="lesson-panel">
                            <div class="lesson-panel-header">
                                <div>
                                    <h3 class="lesson-name">@lesson.Title</h3>
                                    <p class="lesson-desc">@(string.IsNullOrWhiteSpace(lesson.Description) ? "لا يوجد وصف" : lesson.Description)</p>
                                </div>
                                <div class="lesson-actions">
                                    <button class="btn-moeen-light" type="button" @onclick="() => OpenCreateRowDialog(lesson)">
                                        <i class="bi bi-calendar-plus"></i>
                                        <span>إضافة حلقة / وقت</span>
                                    </button>
                                    <button class="icon-btn info" type="button" title="عرض" @onclick="() => OpenLessonDetails(lesson)"><i class="bi bi-info-circle"></i></button>
                                    <button class="icon-btn edit" type="button" title="تعديل" @onclick="() => OpenEditLessonDialog(lesson)"><i class="bi bi-pencil-square"></i></button>
                                    <button class="icon-btn danger" type="button" title="حذف" @onclick="() => DeleteLessonAsync(lesson)"><i class="bi bi-trash"></i></button>
                                </div>
                            </div>

                            <div class="table-wrap">
                                <table class="weekly-table">
                                    <thead>
                                        <tr>
                                            <th>المعلم</th>
                                            <th>الطلاب المطلوب حضورهم</th>
                                            <th>وقت الدرس</th>
                                            <th>إجراءات</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (lesson.Assignments.Count == 0)
                                        {
                                            <tr><td colspan="4" class="text-center text-muted py-4">لا يوجد مواعيد مرتبطة بهذا الدرس.</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var row in lesson.Assignments.OrderBy(r => r.StartTime))
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="name-cell"><span class="entity-avatar"><i class="bi bi-person-workspace"></i></span><span>@Display(row.TeacherName)</span></div>
                                                    </td>
                                                    <td>@Display(row.StudentNames)</td>
                                                    <td><span class="time-pill">@FormatTime(row.StartTime) - @FormatTime(row.EndTime)</span></td>
                                                    <td>
                                                        <div class="row-actions">
                                                            <button class="icon-btn info" type="button" title="عرض" @onclick="() => OpenRowDetails(lesson, row)"><i class="bi bi-info-circle"></i></button>
                                                            <button class="icon-btn edit" type="button" title="تعديل" @onclick="() => OpenEditRowDialog(lesson, row)"><i class="bi bi-pencil-square"></i></button>
                                                            <button class="icon-btn danger" type="button" title="حذف" @onclick="() => DeleteRowAsync(row)"><i class="bi bi-trash"></i></button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </article>
                    }
                </div>
            }
        }
    </div>

    @if (_isLessonDialogOpen)
    {
        <div class="dialog-backdrop" @onclick="CloseLessonDialog">
            <div class="dialog-panel" @onclick:stopPropagation="true">
                <div class="dialog-header">
                    <div>
                        <h3 class="dialog-title">@(_isEditLessonMode ? "تعديل الدرس الأسبوعي" : "إضافة درس أسبوعي")</h3>
                        <p class="dialog-subtitle">مثال: فقه، عقيدة، حديث، سيرة.</p>
                    </div>
                    <button class="dialog-close" type="button" @onclick="CloseLessonDialog"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="dialog-body">
                    @if (!string.IsNullOrWhiteSpace(_dialogError)) { <div class="alert alert-danger">@_dialogError</div> }
                    <div class="form-grid">
                        <div class="form-field full">
                            <label>اسم الدرس</label>
                            <input class="moeen-control" @bind="_lessonForm.Title" placeholder="مثلاً: فقه" />
                        </div>
                        <div class="form-field full">
                            <label>وصف اختياري</label>
                            <textarea class="moeen-control" @bind="_lessonForm.Description" placeholder="ملاحظات عن هذا الدرس الأسبوعي"></textarea>
                        </div>
                    </div>
                </div>
                <div class="dialog-footer">
                    <button class="btn-moeen-primary" type="button" @onclick="ApplyLessonDialogAsync" disabled="@_isSaving"><i class="bi bi-check2-circle"></i><span>حفظ</span></button>
                    <button class="btn-moeen-light" type="button" @onclick="CloseLessonDialog" disabled="@_isSaving"><i class="bi bi-x-lg"></i><span>إلغاء</span></button>
                </div>
            </div>
        </div>
    }

    @if (_isRowDialogOpen)
    {
        <div class="dialog-backdrop" @onclick="CloseRowDialog">
            <div class="dialog-panel" @onclick:stopPropagation="true">
                <div class="dialog-header">
                    <div>
                        <h3 class="dialog-title">@(_isEditRowMode ? "تعديل موعد الحلقة" : "إضافة حلقة ووقت")</h3>
                        <p class="dialog-subtitle">اختر المعلم، ثم اختر الحلقة التابعة له وحدد وقت البداية والنهاية.</p>
                    </div>
                    <button class="dialog-close" type="button" @onclick="CloseRowDialog"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="dialog-body">
                    @if (!string.IsNullOrWhiteSpace(_dialogError)) { <div class="alert alert-danger">@_dialogError</div> }
                    <div class="form-grid">
                        <div class="form-field">
                            <label>المعلم</label>
                            <select class="moeen-control" value="@_rowForm.TeacherId" @onchange="OnTeacherChanged">
                                <option value="@Guid.Empty">اختر المعلم</option>
                                @foreach (var teacher in _teachers)
                                {
                                    <option value="@teacher.Id">@teacher.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-field full">
                            <label>الطلاب المطلوب حضورهم</label>
                            <div class="student-pick-list">
                                @if (_students.Count == 0)
                                {
                                    <div class="text-muted">لا يوجد طلاب متاحون للاختيار.</div>
                                }
                                else
                                {
                                    @foreach (var student in _students.OrderBy(s => s.Name))
                                    {
                                        <label class="student-pick-item">
                                            <input type="checkbox" checked="@_rowForm.StudentIds.Contains(student.Id)" @onchange="args => ToggleStudent(student.Id, args.Value)" />
                                            <span>@student.Name</span>
                                            <small>@Display(student.HalqaName) @(string.IsNullOrWhiteSpace(student.FoujName) ? string.Empty : $"- {student.FoujName}")</small>
                                        </label>
                                    }
                                }
                            </div>
                        </div>
                        <div class="form-field">
                            <label>وقت البداية</label>
                            <input class="moeen-control" @bind="_rowForm.StartTimeText" placeholder="10:00" />
                        </div>
                        <div class="form-field">
                            <label>وقت النهاية</label>
                            <input class="moeen-control" @bind="_rowForm.EndTimeText" placeholder="12:00" />
                        </div>
                    </div>
                </div>
                <div class="dialog-footer">
                    <button class="btn-moeen-primary" type="button" @onclick="ApplyRowDialogAsync" disabled="@_isSaving"><i class="bi bi-check2-circle"></i><span>حفظ</span></button>
                    <button class="btn-moeen-light" type="button" @onclick="CloseRowDialog" disabled="@_isSaving"><i class="bi bi-x-lg"></i><span>إلغاء</span></button>
                </div>
            </div>
        </div>
    }

    <MemberDetailsDialog IsOpen="@_isDetailsOpen" Model="@_detailsModel" OnClose="CloseDetailsDialog" />
</section>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    private readonly List<WeeklyLessonManagementDto> _lessons = new();
    private List<TeacherDto> _teachers = new();
    private List<StudentDto> _students = new();
    private WeeklyLessonForm _lessonForm = new();
    private WeeklyLessonRowForm _rowForm = new();
    private MemberDetailsDialogModel _detailsModel = new();

    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isLessonDialogOpen;
    private bool _isRowDialogOpen;
    private bool _isEditLessonMode;
    private bool _isEditRowMode;
    private bool _isDetailsOpen;
    private string _searchText = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _dialogError;

    private List<WeeklyLessonManagementDto> FilteredLessons => string.IsNullOrWhiteSpace(_searchText)
        ? _lessons
        : _lessons.Where(l =>
            (l.Title ?? string.Empty).Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
            (l.Description ?? string.Empty).Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
            l.Assignments.Any(a =>
                (a.TeacherName ?? string.Empty).Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
                (a.StudentNames ?? string.Empty).Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase)))
            .ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAllAsync();
        StateHasChanged();
    }

    private async Task LoadAllAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            await LoadTeachersAsync();
            await LoadStudentsAsync();
            var lessons = await WeeklyLessonService.GetWeeklyLessonsAsync();
            _lessons.Clear();
            _lessons.AddRange(lessons.OrderBy(l => l.Title));
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر تحميل الدروس الأسبوعية: {ex.Message}";
            _lessons.Clear();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadTeachersAsync()
    {
        try
        {
            var response = await EnrollmentService.GetAllTeachersAsync(new GetAllTeachersRequest { PageNumber = 1, PageSize = 500 });
            var json = JsonSerializer.Serialize(response.Data);
            _teachers = response.Success ? JsonSerializer.Deserialize<List<TeacherDto>>(json, JsonOptions) ?? new() : new();
        }
        catch { _teachers = new(); }
    }

    private async Task LoadStudentsAsync()
    {
        try
        {
            var response = await EnrollmentService.GetAllStudentsAsync(new GetAllStudentsRequest { PageNumber = 1, PageSize = 1000, Status = 0 });
            var json = JsonSerializer.Serialize(response.Data);
            _students = response.Success ? JsonSerializer.Deserialize<List<StudentDto>>(json, JsonOptions) ?? new() : new();
        }
        catch { _students = new(); }
    }

    private void HandleSearch(ChangeEventArgs args) => _searchText = args.Value?.ToString() ?? string.Empty;

    private void OpenCreateLessonDialog()
    {
        _dialogError = null; _successMessage = null; _isEditLessonMode = false;
        _lessonForm = new WeeklyLessonForm();
        _isLessonDialogOpen = true;
    }

    private void OpenEditLessonDialog(WeeklyLessonManagementDto lesson)
    {
        _dialogError = null; _successMessage = null; _isEditLessonMode = true;
        _lessonForm = new WeeklyLessonForm { Id = lesson.Id, Title = lesson.Title, Description = lesson.Description ?? string.Empty };
        _isLessonDialogOpen = true;
    }

    private void CloseLessonDialog()
    {
        if (_isSaving) return;
        _isLessonDialogOpen = false; _dialogError = null;
    }

    private async Task ApplyLessonDialogAsync()
    {
        _isSaving = true; _dialogError = null; _successMessage = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_lessonForm.Title)) { _dialogError = "يرجى إدخال اسم الدرس."; return; }
            var response = _isEditLessonMode
                ? await WeeklyLessonService.UpdateWeeklyLessonAsync(_lessonForm.Id, new UpdateWeeklyLessonRequest { Id = _lessonForm.Id, Title = _lessonForm.Title.Trim(), Description = _lessonForm.Description?.Trim() ?? string.Empty })
                : await WeeklyLessonService.CreateWeeklyLessonAsync(new CreateWeeklyLessonRequest { Title = _lessonForm.Title.Trim(), Description = _lessonForm.Description?.Trim() ?? string.Empty });
            if (response == null || !response.Success) { _dialogError = response?.Message ?? "فشل حفظ الدرس."; return; }
            _successMessage = _isEditLessonMode ? "تم تعديل الدرس الأسبوعي بنجاح." : "تم إضافة الدرس الأسبوعي بنجاح.";
            _isLessonDialogOpen = false;
            await LoadAllAsync();
        }
        catch (Exception ex) { _dialogError = $"تعذر حفظ بيانات الدرس: {ex.Message}"; }
        finally { _isSaving = false; }
    }

    private async Task DeleteLessonAsync(WeeklyLessonManagementDto lesson)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"هل تريد حذف الدرس الأسبوعي {lesson.Title} وكل مواعيده؟");
        if (!confirmed) return;
        var response = await WeeklyLessonService.DeleteWeeklyLessonAsync(lesson.Id);
        if (response == null || !response.Success) { _errorMessage = response?.Message ?? "فشل حذف الدرس."; return; }
        _successMessage = "تم حذف الدرس الأسبوعي بنجاح.";
        await LoadAllAsync();
    }

    private void OpenCreateRowDialog(WeeklyLessonManagementDto lesson)
    {
        _dialogError = null; _successMessage = null; _isEditRowMode = false;
        _rowForm = new WeeklyLessonRowForm
        {
            WeeklyLessonId = lesson.Id,
            TeacherId = _teachers.FirstOrDefault()?.Id ?? Guid.Empty,
            StudentIds = new List<Guid>(),
            StartTimeText = "10:00",
            EndTimeText = "12:00"
        };
        _isRowDialogOpen = true;
    }

    private void OpenEditRowDialog(WeeklyLessonManagementDto lesson, WeeklyLessonAssignmentDto row)
    {
        _dialogError = null; _successMessage = null; _isEditRowMode = true;
        _rowForm = new WeeklyLessonRowForm
        {
            Id = row.Id,
            WeeklyLessonId = lesson.Id,
            TeacherId = row.TeacherId,
            StudentIds = row.StudentIds?.ToList() ?? new List<Guid>(),
            StartTimeText = FormatTime(row.StartTime),
            EndTimeText = FormatTime(row.EndTime)
        };
        _isRowDialogOpen = true;
    }

    private void CloseRowDialog()
    {
        if (_isSaving) return;
        _isRowDialogOpen = false; _dialogError = null;
    }

    private void OnTeacherChanged(ChangeEventArgs args)
    {
        _rowForm.TeacherId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : Guid.Empty;
    }

    private void ToggleStudent(Guid studentId, object? value)
    {
        var selected = value is bool checkedValue && checkedValue;
        if (selected)
        {
            if (!_rowForm.StudentIds.Contains(studentId))
                _rowForm.StudentIds.Add(studentId);
        }
        else
        {
            _rowForm.StudentIds.Remove(studentId);
        }
    }

    private async Task ApplyRowDialogAsync()
    {
        _isSaving = true; _dialogError = null; _successMessage = null;
        try
        {
            if (_rowForm.TeacherId == Guid.Empty) { _dialogError = "يرجى اختيار المعلم."; return; }
            var studentIds = _rowForm.StudentIds.Where(id => id != Guid.Empty).Distinct().ToList();
            if (studentIds.Count == 0) { _dialogError = "يرجى اختيار طالب واحد على الأقل."; return; }
            if (!TimeSpan.TryParse(_rowForm.StartTimeText, out var start) || !TimeSpan.TryParse(_rowForm.EndTimeText, out var end)) { _dialogError = "صيغة الوقت يجب أن تكون مثل 10:00."; return; }
            if (end <= start) { _dialogError = "وقت النهاية يجب أن يكون بعد وقت البداية."; return; }
            var response = _isEditRowMode
                ? await WeeklyLessonService.UpdateWeeklyLessonRowAsync(_rowForm.Id, new UpdateWeeklyLessonAssignmentRequest { Id = _rowForm.Id, WeeklyLessonId = _rowForm.WeeklyLessonId, TeacherId = _rowForm.TeacherId, StudentIds = studentIds, StartTime = start, EndTime = end })
                : await WeeklyLessonService.CreateWeeklyLessonRowAsync(_rowForm.WeeklyLessonId, new CreateWeeklyLessonAssignmentRequest { WeeklyLessonId = _rowForm.WeeklyLessonId, TeacherId = _rowForm.TeacherId, StudentIds = studentIds, StartTime = start, EndTime = end });
            if (response == null || !response.Success) { _dialogError = response?.Message ?? "فشل حفظ الموعد."; return; }
            _successMessage = _isEditRowMode ? "تم تعديل موعد الدرس بنجاح." : "تم إضافة موعد الدرس بنجاح.";
            _isRowDialogOpen = false;
            await LoadAllAsync();
        }
        catch (Exception ex) { _dialogError = $"تعذر حفظ موعد الدرس: {ex.Message}"; }
        finally { _isSaving = false; }
    }

    private async Task DeleteRowAsync(WeeklyLessonAssignmentDto row)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"هل تريد حذف موعد الدرس {row.TeacherName}؟");
        if (!confirmed) return;
        var response = await WeeklyLessonService.DeleteWeeklyLessonRowAsync(row.Id);
        if (response == null || !response.Success) { _errorMessage = response?.Message ?? "فشل حذف الموعد."; return; }
        _successMessage = "تم حذف الموعد بنجاح.";
        await LoadAllAsync();
    }

    private void OpenLessonDetails(WeeklyLessonManagementDto lesson)
    {
        _detailsModel = new MemberDetailsDialogModel { Title = lesson.Title, Subtitle = "تفاصيل الدرس الأسبوعي", Sections = new List<MemberDetailsSectionModel> { new() { Title = "البيانات", Items = new List<MemberDetailsItemModel> { DetailItem("اسم الدرس", lesson.Title), DetailItem("الوصف", lesson.Description), DetailItem("عدد المواعيد", lesson.AssignmentsCount.ToString()) } } } };
        _isDetailsOpen = true;
    }

    private void OpenRowDetails(WeeklyLessonManagementDto lesson, WeeklyLessonAssignmentDto row)
    {
        _detailsModel = new MemberDetailsDialogModel { Title = lesson.Title, Subtitle = "موعد ضمن الدرس الأسبوعي", Sections = new List<MemberDetailsSectionModel> { new() { Title = "البيانات", Items = new List<MemberDetailsItemModel> { DetailItem("المعلم", row.TeacherName), DetailItem("الطلاب", row.StudentNames), DetailItem("عدد الطلاب", row.StudentsCount.ToString()), DetailItem("الوقت", $"{FormatTime(row.StartTime)} - {FormatTime(row.EndTime)}") } } } };
        _isDetailsOpen = true;
    }

    private void CloseDetailsDialog() => _isDetailsOpen = false;
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string FormatTime(TimeSpan value) => value.ToString(@"hh\:mm");
    private static MemberDetailsItemModel DetailItem(string label, string? value) => new() { Label = label, Value = string.IsNullOrWhiteSpace(value) ? "—" : value };

    private sealed class WeeklyLessonForm { public Guid Id { get; set; } public string Title { get; set; } = string.Empty; public string Description { get; set; } = string.Empty; }
    private sealed class WeeklyLessonRowForm { public Guid Id { get; set; } public Guid WeeklyLessonId { get; set; } public Guid TeacherId { get; set; } public List<Guid> StudentIds { get; set; } = new(); public string StartTimeText { get; set; } = "10:00"; public string EndTimeText { get; set; } = "12:00"; }
}
