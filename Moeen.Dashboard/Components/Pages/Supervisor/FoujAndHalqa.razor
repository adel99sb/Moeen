@page "/supervisor/fouj-and-halqa"
@rendermode InteractiveServer
@inject NavigationManager NavManager

<h3>FoujAndHalqa</h3>
<!DOCTYPE html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة دروس السبت - النسخة المتقدمة</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <style>
        :root {
            --primary-green: #195042;
            --luxury-beige: #d6cabc;
            --absent-red: #dc3545;
            --present-green: #28a745;
            --white: #ffffff;
        }

        body {
            background-color: #f4f7f6;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* تنسيق الهيدر */
        .header-custom {
            background-color: var(--primary-green);
            color: var(--luxury-beige);
            padding: 2.5rem 0;
            border-bottom: 6px solid var(--luxury-beige);
            margin-bottom: 2rem;
        }

        .card-circle {
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        .card-header-main {
            background-color: var(--luxury-beige);
            color: var(--primary-green);
            font-weight: 800;
            border: none;
        }

        .status-btn {
            display: none; 
        }

        .btn-label {
            cursor: pointer;
            padding: 6px 15px;
            border-radius: 8px;
            border: 1px solid #ddd;
            transition: all 0.3s ease;
            display: inline-block;
            font-size: 0.9rem;
            user-select: none;
        }

        .status-btn-present:checked + .label-present {
            background-color: var(--present-green) !important;
            color: white !important;
            border-color: var(--present-green);
        }

        .status-btn-absent:checked + .label-absent {
            background-color: var(--absent-red) !important;
            color: white !important;
            border-color: var(--absent-red);
        }

        .point-input {
            width: 70px;
            border: 2px solid var(--luxury-beige);
            border-radius: 8px;
            text-align: center;
            font-weight: bold;
            color: var(--primary-green);
        }

        .lesson-dropdown {
            border: 2px solid var(--luxury-beige);
            border-radius: 10px;
        }
      
        .form-select:focus, 
        .point-input:focus {
            border-color: var(--primary-green) !important; 
            box-shadow: 0 0 0 0.25rem rgba(6, 76, 65, 0.25) !important; 
        }

        /* تنسيق سجل الدروس السابقة */
        .archive-item {
            display: flex;
            align-items: center;
            padding: 15px 20px;
            border-bottom: 1px dashed #eee;
            text-align: right; /* ضمان المحاذاة لليمين */
        }

        .icon-box {
            width: 45px;
            height: 45px;
            background: var(--luxury-beige);
            color: var(--primary-green);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 15px; /* مسافة على يسار الأيقونة لأننا في RTL */
            flex-shrink: 0;
        }

        .status-badge {
            background: #e9f5f2;
            color: var(--primary-green);
            padding: 5px 12px;
            border-radius: 8px;
            font-size: 0.8rem;
            font-weight: bold;
        }
    </style>
</head>




    <h2>إدارة الأفواج والحلقات</h2>
<div class="card">
    <h5 class="card-header">Featured</h5>
    <div class="card-body">
        <h5 class="card-title">إدارة الأفواج</h5>
        <p class="card-text">رؤية الأفواج والحلقات التابعة لها.</p>
        <a class="btn btn-accent" @onclick="viewFouj"> تفاصيل</a>
        
    </div>
</div>


    <div style="display:flex; gap:20px; flex-wrap:wrap;" >
        <div class="container mb-5">
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card card-circle bg-white">
                <div class="card-header card-header-main p-3 d-flex justify-content-between align-items-center">
                        <span>إدارة الأفواج</span>
                        <a class="btn btn-accent" @onclick="viewFouj"> تفاصيل</a>
                    </div>
                </div>
            </div>
        </div>

        </div>

        <div class="card" >
            <h3> إدارة الحلقات</h3>
            <details class="details">
					<summary class="summary">
            <button class="btn btn-primary">تفاصيل</button>
            </summary>
                <h4>قائمة الحلقات</h4>
				<table class="table">
					<thead>
						<tr>
                            <th class="table th">اسم الحلقة</th>
                            <th class="table th">الفوج التابع له </th>
                            <th class="table th">اسم معلم الحلقة</th>
                            <th class="table th">الطلاب التابعة للحلقة</th>
                            <th class="table th">حذف الحلقة</th>
                            </tr>
                            </thead>
                            <tbody>
                                <tr>
                            <td class="table td">حلقة أولى</td>
                            <td class="table td">فوج أول</td>
                            <td class="table td">آية دعبول</td>
                            <td class="table td">
                                       <details class="details">
					                    <summary class="summary">
                                         <button class="btn btn-primary"> طلاب الحلقة الأولى</button>
                                         </summary>
                                         <h4>قائمة طلاب الحلقة الأولى:</h4>
				                        <table class="table">
					                       <thead>
						                     <tr>
                                                <th class="table th">اسماء الطلاب:</th>
                                          </tr>
                                         </thead>
                                       <tbody>
                                             <tr>
                                                <td class="table td">بيان</td>
                                             </tr>
                                             <tr>
                                                <td class="table td">آية</td>
											</tr>
                                            </tbody>
                                            </table></details>
                                          
                                          
                                          
                                          </td>
							        <td class="table td"><button class="btn btn-danger">حذف </button></td>

                                </tr>


                            </tbody>
                            </table>
                            <details class="details">
		<summary class="summary">إضافة حلقة جديدة...</summary>

		<br>

		<form class="form-box">
                        <div class="form-group">
		<label class="label">اسم الحلقة:</label><br>
		<input class="input" placeholder="اكتب هنا..." type="text" name="name"><br><br>
                        </div>
                        <div class="form-group">
                        <label class="label">نوع الحلقة:</label><br>
                        <select class="select" name="halaqa">
                            <option> غيبي</option>
                            <option> حاضر</option>
                        </select>
                        </div>
                        <div class="form-group">
                        <label class="label">الفوج التابعة له الحلقة:</label><br>
                        <select class="select" name="halaqa">
                            <option> فوج أول</option>
                            <option> فوج ثاني</option>
                        </select>
                        </div>
                        <div class="form-group">
                        <label class="label">المعلم/ة التابع للحلقة:</label><br>
                        <select class="select" name="halaqa">
                            <option> ماريا العبدالسلام</option>
                            <option> آية دعبول</option>
                        </select>
                        </div>
                        <br />
						<button class="btn btn-primary">إضافة</button>
					</form>
                    </details>


                            </details>
        </div>
    </div>

@code {
    private void viewFouj()
    {
        NavManager.NavigateTo("/supervisor/fouj");
    }
}
