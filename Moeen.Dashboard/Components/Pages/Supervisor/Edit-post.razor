@page "/supervisor/edit-post"
@rendermode InteractiveServer

@inject NavigationManager NavManager
    <style>
         :root {
--primary-green: #195042;
--accent-beige: #d6cabc;
--light-beige: #f4f1ee;
--white: #ffffff;
--text-dark: #2d3436;
--status-green: #2ecc71;
--danger-red: #e74c3c;
}
body {
font-family: 'Tajawal', sans-serif;
background-color: #f9f9f9;
direction: rtl;
}
        .management-container {
background: var(--white);
margin: 20px;
padding: 30px;
border-radius: 20px;
box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}
/* العنوان */
.page-title {
color: var(--primary-green);
position: relative;
padding-bottom: 10px; /* مسافة بين النص والخط */
border-bottom: 3px solid #d6cabc; /* جعل الخط بلون البيج */
display: inline-block; /* ليصبح طول الخط على قدر الكلمة فقط */
}
/* دمج الإعدادات العامة والحاويات */
.form-container, .form-container * {
        box-sizing: border-box;
    }

.form-container {
    max-width: 900px;
    margin: 20px auto;
    background: #fff;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    border: 1px solid #eee;
    overflow: hidden;
}

.form-header {
    background: var(--accent-beige);
    color: #fff;
    padding: 20px 30px;
}
form { padding: 30px; }
/* دمج الصفوف والمجموعات */
.grid-row, .actions, .form-header h2, .save, .cancel, .input-wrapper {
    display: flex;
    align-items: center;
    gap: 20px;
    border-radius:5px;
    padding:5px;
}
.grid-row { margin-bottom: 20px; flex-wrap: wrap; gap: 20px; }
.input-group { flex: 1; min-width: 250px; }
.input-group {
    flex:1 1 45%;
    display: flex;
    flex-direction:column;
    margin-bottom: 8px;
    color: #1d3937;
    font-weight: 600;
    font-size: 14px;
}

/* تنسيق المدخلات الموحد */
.input-wrapper { position: relative; }

.input-wrapper i {
    position: absolute;
    right: 12px;
    color: #195042;
    font-size: 18px;
}

.input-wrapper input, .input-wrapper select {
    width: 100%;
    padding: 12px 40px 12px 12px;
    border: 2px solid #f0f0f0;
    border-radius: 10px;
    outline: none;
    transition: 0.3s;
    background: #fdfdfd;
    font: inherit;
    margin-right:5px;
    flex:1;
}

.input-wrapper input:focus, .input-wrapper select:focus {
    border-color: #d6cabc;
    background: #fff;
    box-shadow: 0 0 8px rgba(214, 202, 188, 0.3);
}

/* الأزرار */
.actions { margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee; }

.save, .cancel {
    padding: 12px 35px;
    border-radius: 10px;
    font-weight: bold;
    transition: 0.3s;
    cursor: pointer;
    text-decoration: none;
}

.save {
    background: linear-gradient(45deg, #195042, #1d3937);
    color: white;
    border: none;
}

.save:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(25, 80, 66, 0.3); }

.cancel { background: #f5f5f5; color: #666; }
.cancel:hover { background: #eee; color: #333; }
    </style>
<section class="management-container">

    <header class="page-header">
	<h2 class="page-title"> تعديل على منشور</h2>
</header>
<br />
    <div class="form-container">
    <div class="form-header">
        <h2><i class="bi bi-person-plus-fill"></i>  تعديل على منشور</h2>
    </div>
    <form>
        <div class="grid-row">
            <div class="input-group">
                <label>تعديل عنوان المنشور</label>
                <div class="input-wrapper">
                    <i class="bi bi-fonts"></i>
                    <input type="text" placeholder="أدخل العنوان">
                </div>
            </div>
            <div class="input-group">
                <label>تعديل محتوى المنشور</label>
                <div class="input-wrapper">
                    <i class="bi bi-pencil"></i>
                    <input type="text" placeholder="اكتب هنا">
                </div>
            </div>
          </div>
        <div class="grid-row">

          <div class="input-group">
                <label>تاريخ النشر</label>
                <div class="input-wrapper">
                    <i class="bi bi-calendar-event"></i>
                    <input type="date">
                </div>
                </div>

                <div class="input-group">
                <label>نوع المنشور</label>
                <div class="input-wrapper">
                    <i class="bi bi-text-paragraph"></i>

                    <select>
                        <option value="" disabled selected>اختر نوع المنشور</option>
                        <option value="male">عام</option>
                        <option value="female">خاص</option>
                    </select>
                </div>
                </div>
                </div>
                <div class="actions">
            <button type="submit" class="save"><i class="bi bi-check2-all"></i> إعادة النشر </button>
            <a href="/supervisor/posts" class="cancel"><i class="bi bi-x-lg"></i> إلغاء</a>
        </div>
    </form>
</div>
</section>

@code {

}
