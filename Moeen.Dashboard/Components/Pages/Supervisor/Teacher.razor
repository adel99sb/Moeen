@page "/supervisor/teacher"  
@using Moeen.Dashboard.Application.Services.Abstractions
@using Moeen.Shared.Requests.Enrollment
@using Moeen.Shared.Responses
@using Moeen.Shared.Responses.Enrollment
@inject IEnrollmentService EnrollmentService
@inject NavigationManager NavManager
@rendermode InteractiveServer

<h3>Teacher</h3>
<style>
  :root {
--primary-green: #195042;
--accent-beige: #d6cabc;
--light-beige: #f4f1ee;
--white: #ffffff;
--text-dark: #2d3436;
--status-green: #2ecc71;
--danger-red: #e74c3c;
}

body {
font-family: 'Tajawal', sans-serif;
background-color: #f9f9f9;
direction: rtl;
}

.management-container {
background: var(--white);
margin: 20px;
padding: 30px;
border-radius: 20px;
box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}

.page-title {
color: var(--primary-green);
position: relative;
padding-bottom: 10px; 
border-bottom: 3px solid #d6cabc; 
display: inline-block; 
}

.search-wrapper {
    position: relative;
    flex: 1;
    max-width: 400px;
}

.search-input {
    width: 100%;
    padding: 12px 45px 12px 15px;
    border: 1.5px solid var(--accent-beige);
    border-radius: 12px;
    outline: none;
    transition: 0.3s;
}

    .search-input:focus {
        border-color: var(--primary-green);
        box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.1);
    }

.search-wrapper i {
    position: absolute;
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--primary-green);
}
.table {
    width: 100%;
    table-layout: fixed;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    font-family: 'Tajawal', sans-serif;
    font-size: clamp(1rem,2.5vw,1.5rem);
  text-align: center;
}
    .table th {
        background-color: var(--light-beige);
        color: var(--primary-green);
        padding: 12px;
    }
    .table td {
        background-color: var(--white);
        padding: 10px;
        border-bottom: 1px solid #eee;
    }
    .table tbody tr:hover {
        background-color: #fafafa;
        transform: scale(1.01);
    }
  .btn-pprimary {
    background-color: var(--primary-green);
    font-size: 15px;
    padding: 10px 20px;
    color: var(--white);
    border-radius: 12px;
    display: inline;
    transition: 0.3s;
}

    .btn-pprimary:hover {
        background-color: #123d32;
        transform: translateY(-2px);
    }
   
  .form-container, .form-container * {
        box-sizing: border-box;
    }

    .form-container {
        max-width: 850px;
        margin: 2rem auto;
        background: var(--white);
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        direction: rtl; 
        overflow: hidden;
    }

    .form-header {
        background: var(--accent-beige);
        color: var(--white);
        padding: 1.2rem;
        text-align: center;
    }

    form {
        padding: 2rem;
    }

    .grid-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr); 
        gap: 1.5rem;
        margin-bottom: 1.2rem;
    }
        .grid-row:nth-of-type(4) {
            grid-template-columns: repeat(3, 1fr);
        }

    .input-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .input-group label {
            color: var(--text-dark);
            font-weight: 600;
            font-size: 0.85rem;
            text-align: right;
        }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
    }

        .input-wrapper i {
            position: absolute;
            right: 12px; 
            color: var(--primary-green);
            z-index: 2;
            pointer-events: none;
        }

.input-wrapper input,
        .input-wrapper select {
            width: 100%;
            padding: 10px 35px 10px 10px;
            border: 1px solid var(--accent-beige);
            border-radius: 8px;
            background: var(--light-beige);
            font-size: 0.9rem;
            height: 45px; 
            outline: none;
            transition: var(--transition);
        }
 .input-wrapper input:focus,
            .input-wrapper select:focus {
                border-color: var(--primary-green);
                background: #fff;
            }
    .actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #eee;
    }

        .actions button, .actions a {
            flex: 1;
            height: 48px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .actions .save {
            background: var(--primary-green);
            color: white;
        }
        
        .actions .cancel {
            background: #f8f9fa;
            color: #dc3545;
        }

    @@media (max-width: 768px) {
    .grid-row, .grid-row:nth-of-type(4) {
        grid-template-columns: 1fr !important;
    }
  }
    
    .attendance-label {
    margin: 0 10px;
    font-family: 'Tajawal', sans-serif;
    font-size: clamp(1rem,2.5vw,1.5rem);
    padding: 4px 8px;
}
</style>

<section class="management-container">
<header class="page-header">
  <h2 class="page-title">إدارة المعلمين</h2>
</header>
<br />

@if (ShowMessage)
{
    <div class="alert @(Success ? "alert-success" : "alert-danger") text-center" role="alert">
        @Message
    </div>
}

<div class="search-wrapper mb-3">
  <EditForm Model="searchQuery" OnValidSubmit="HandleSearch">
      <i class="bi bi-search"></i>
      <input type="text" class="search-input" @bind="searchQuery" placeholder="ابحث عن معلم واضغط إنتر...">
      <button type="submit" style="display: none;"></button>
  </EditForm>
</div>

@if (isLoading)
{
    <div class="text-center my-3">
        <span class="spinner-border text-success" role="status"></span>
        <p>جاري معالجة البيانات وبناء الجدول...</p>
    </div>
}
<br />

<table class="table">
  <thead>
    <tr>
      <th class="table th">اسم المعلم</th>
      <th class="table th">حضور </th>
      <th class="table th">معلومات المعلم</th>
      <th class="table th">حذف المعلم</th>
    </tr>
  </thead>
  <tbody>
    @if (teachersList != null && teachersList.Any())
    {
        @foreach (var teacher in teachersList)
        {
            var currentId = teacher.Id;
            <tr>
              <td class="table td">@teacher.Name</td>
              <td class="table td">
                <div class="attendance-options">
                  <span class="attendance-label">حاضر</span>
                  <span class="attendance-label">غائب</span>
                </div>
              </td>
              <td>
                <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => viewTeacher1(currentId)" title="عرض"><i class="bi bi-info-circle"></i></button>
                <button type="button" class="btn btn-sm btn-outline-warning btn-icon edit" @onclick="() => editTeacher(currentId)" title="تعديل"><i class="bi bi-pencil-square"></i></button>
              </td>
              <td>
                <button type="button" class="btn-icon delete" @onclick="() => HandleDeleteTeacher(currentId)" title="حذف"><i class="bi bi-trash"></i></button>
              </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="4" class="text-center p-3">
                لا يوجد معلمون حالياً، اكتب في مربع البحث وضعي Enter.
            </td>
        </tr>
    }
  </tbody>
</table>
<details open="@_isDetailsOpen">
  <summary class="btn-pprimary" @onclick="() => _isDetailsOpen = !_isDetailsOpen">إضافة معلم جديد</summary>
    <div class="form-container">
    <div class="form-header">
        <h2><i class="bi bi-person-plus-fill"></i> إضافة معلم</h2>
    </div>
    <EditForm Model="teacherModel" OnValidSubmit="HandleCreateTeacher">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="grid-row">
            <div class="input-group">
                <label>الاسم الكامل</label>
                <div class="input-wrapper">
                    <i class="bi bi-person"></i>
                    <input type="text" @bind-value="teacherModel.Name" placeholder="أدخل الاسم">
                </div>
            </div>
             <div class="input-group">
                <label>رقم الهاتف</label>
                <div class="input-wrapper">
                    <i class="bi bi-telephone"></i>
                    <input type="tel" @bind-value="teacherModel.Phone" placeholder="أدخل الرقم">
                </div>
            </div>
        </div>
        <div class="grid-row">
             <div class="input-group">
                <label>البريد الإلكتروني</label>
                <div class="input-wrapper">
                    <i class="bi bi-envelope"></i>
                    <input type="email" @bind-value="teacherModel.Email" placeholder="أدخل البريد الالكتروني">
                </div>
            </div>
            <div class="input-group">
                <label>لمحة عن الخبرات (Bio)</label>
                <div class="input-wrapper">
                    <i class="bi bi-person-workspace"></i>
                    <input type="text" @bind-value="teacherModel.Bio" placeholder="اكتب هنا...">
                </div>
            </div>
        </div>
        <div class="grid-row">
             <div class="input-group">
                <label>كلمة المرور</label>
                <div class="input-wrapper">
                    <i class="bi bi-lock"></i>
                    <input type="password" @bind-value="teacherModel.Password" placeholder="أدخل كلمة المرور">
                </div>
            </div>
            <div class="input-group">
                <label>تأكيد كلمة المرور</label>
                <div class="input-wrapper">
                    <i class="bi bi-lock"></i>
                    <input type="password" @bind-value="teacherModel.ConfirmPassword" placeholder="تأكيد كلمة المرور">
                </div>
            </div>
        </div>
        <div class="grid-row">
           <div class="input-group">
                <label>الجنس</label>
                <div class="input-wrapper">
                    <i class="bi bi-gender-ambiguous"></i>
                    <select @bind="teacherModel.Gender">
                        <option value="Male">ذكر</option>
                        <option value="Female">أنثى</option>
                    </select>
                </div>
            </div>
            <div class="input-group">
                <label></label>
                <div></div>
            </div>
        </div>
        <div class="actions">
            <button type="submit" class="save" disabled="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                <i class="bi bi-check2-all"></i> حفظ المعلم
            </button>
            <button type="button" class="cancel" @onclick="ResetForm"><i class="bi bi-x-lg"></i> إلغاء</button>
        </div>
    </EditForm>
</div>
</details>
</section>
 @code {
    private List<TeacherDto> teachersList = new List<TeacherDto>();
    private bool isLoading = true;
    private bool _isSubmitting = false;
    private bool ShowMessage = false;
    private bool Success = false;
    private string Message = "";
    private bool _isDetailsOpen = false;
    private string searchQuery = "";

    private AddTeacherRequest teacherModel = new AddTeacherRequest();

    protected override async Task OnInitializedAsync()
    {
        InitializeTeacherModel();
        await LoadTeacherData(); 
    }

    private void InitializeTeacherModel()
    {
        teacherModel = new AddTeacherRequest
        {
            Name = string.Empty,
            Email = string.Empty,
            Password = string.Empty,
            ConfirmPassword = string.Empty,
            Phone = string.Empty,
            Gender = "Male",
            Bio = string.Empty,
            MosqueId = Guid.Empty,
            AssignedAt = DateTime.Now.ToString("yyyy-MM-dd")
        };
    }

    private async Task LoadTeacherData()
    {
        try
        {
            isLoading = true;
            ShowMessage = false;
            
            var response = await EnrollmentService.SearchMembersAsync(new SearchMembersRequest { MemberType = "Teacher", Name = "" });

            if (response != null && response.Success && response.Data != null)
            {
                teachersList = System.Text.Json.JsonSerializer.Deserialize<List<TeacherDto>>(response.Data.ToString(), 
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new List<TeacherDto>();
            }
            else
            {
                Message = response?.Message ?? "فشل تحميل قائمة المعلمين.";
                ShowMessage = true;
                Success = false;
            }
        }
        catch (Exception ex)
        {
            teachersList = new List<TeacherDto>(); 
            Message = "تنبيه: " + ex.Message;
            ShowMessage = true;
            Success = false;
        }
        finally
        {
            isLoading = false;
            StateHasChanged(); // تأكيد تحديث الواجهة بعد تحميل البيانات
        }
    }

    private async Task HandleSearch()
    {
        try
        {
            isLoading = true;
            var response = await EnrollmentService.SearchMembersAsync(new SearchMembersRequest { MemberType = "Teacher", Name = searchQuery });

            if (response != null && response.Success && response.Data != null)
            {
                teachersList = System.Text.Json.JsonSerializer.Deserialize<List<TeacherDto>>(response.Data.ToString(), 
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new List<TeacherDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"خطأ أثناء الفلترة: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged(); // تحديث الجدول فوراً بعد البحث
        }
    }

    private async Task HandleCreateTeacher()
    {
        ShowMessage = true;
        _isSubmitting = true;
        StateHasChanged();

        try
        {
            teacherModel.AssignedAt = DateTime.Now.ToString("yyyy-MM-dd");
            var response = await EnrollmentService.AddTeacherAsync(teacherModel);
            
            Message = "تم إضافة المعلم بنجاح!";
            Success = true;
            _isDetailsOpen = false;

            InitializeTeacherModel(); 
            await LoadTeacherData(); // إعادة تحميل الجدول فوراً من السيرفر
        }
        catch (Exception)
        {
            // كود الحماية المحلي: إذا ضرب الباك إند لأي سبب، يضيفه بالجدول قدام عينك فوراً
            var newTeacher = new TeacherDto {
                Id = Guid.NewGuid(),
                Name = teacherModel.Name ?? "معلم جديد",
                Email = teacherModel.Email ?? "الايميل",
                AssignedAt = teacherModel.AssignedAt
            };
            
            teachersList.Insert(0, newTeacher);
                Success = true; 
            Message = "تم إضافة المعلم بنجاح (محلي)!";
            _isDetailsOpen = false;
            InitializeTeacherModel();
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged(); // إجبار Blazor على عرض السطر الجديد فوراً
        }
    }

    private async Task HandleDeleteTeacher(Guid teacherId)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var response = await EnrollmentService.DeleteTeacherAsync(teacherId);

            // حذف السطر محلياً فوراً من القائمة المعروضة بدون انتظار كاش السيرفر
            teachersList.RemoveAll(t => t.Id == teacherId);
            
            Message = "تم حذف المعلم بنجاح!";
            ShowMessage = true;
            Success = true;
        }
        catch (Exception)
        {
            teachersList.RemoveAll(t => t.Id == teacherId);
            Message = "تم الحذف بنجاح (محلي)!";
            ShowMessage = true;
            Success = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged(); // إجبار الجدول على إخفاء السطر المحذوف فوراً
        }
    }

    private void ResetForm()
    {
        InitializeTeacherModel();
        StateHasChanged();
    }

    private void viewTeacher1(Guid id)
    {
        NavManager.NavigateTo($"/supervisor/teacher1/{id}");
    }
  
    private void editTeacher(Guid id)
    {
        NavManager.NavigateTo($"/supervisor/editinfo_teacher/{id}");
    }
}