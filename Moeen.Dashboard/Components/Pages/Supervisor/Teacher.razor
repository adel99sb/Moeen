@page "/supervisor/teacher"  
@using Moeen.Dashboard.Application.Services.Abstractions
@using Moeen.Shared.Requests.Enrollment
@using Moeen.Shared.Responses
@inject IEnrollmentService EnrollmentService
@inject NavigationManager NavManager
@rendermode InteractiveServer

<h3>Teacher</h3>
<style>
  :root {
--primary-green: #195042;
--accent-beige: #d6cabc;
--light-beige: #f4f1ee;
--white: #ffffff;
--text-dark: #2d3436;
--status-green: #2ecc71;
--danger-red: #e74c3c;
}

body {
font-family: 'Tajawal', sans-serif;
background-color: #f9f9f9;
direction: rtl;
}

.management-container {
background: var(--white);
margin: 20px;
padding: 30px;
border-radius: 20px;
box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}

.page-title {
color: var(--primary-green);
position: relative;
padding-bottom: 10px; 
border-bottom: 3px solid #d6cabc; 
display: inline-block; 
}

.search-wrapper {
    position: relative;
    flex: 1;
    max-width: 400px;
}

.search-input {
    width: 100%;
    padding: 12px 45px 12px 15px;
    border: 1.5px solid var(--accent-beige);
    border-radius: 12px;
    outline: none;
    transition: 0.3s;
}

    .search-input:focus {
        border-color: var(--primary-green);
        box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.1);
    }

.search-wrapper i {
    position: absolute;
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--primary-green);
}
.table {
    width: 100%;
    table-layout: fixed;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    font-family: 'Tajawal', sans-serif;
    font-size: clamp(1rem,2.5vw,1.5rem);
  text-align: center;
}
    .table th {
        background-color: var(--light-beige);
        color: var(--primary-green);
        padding: 12px;
    }
    .table td {
        background-color: var(--white);
        padding: 10px;
        border-bottom: 1px solid #eee;
    }
    .table tbody tr:hover {
        background-color: #fafafa;
        transform: scale(1.01);
    }
  .btn-pprimary {
    background-color: var(--primary-green);
    font-size: 15px;
    padding: 10px 20px;
    color: var(--white);
    border-radius: 12px;
    display: inline;
    transition: 0.3s;
}

    .btn-pprimary:hover {
        background-color: #123d32;
        transform: translateY(-2px);
    }
   
  .form-container, .form-container * {
        box-sizing: border-box;
    }

    .form-container {
        max-width: 850px;
        margin: 2rem auto;
        background: var(--white);
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        direction: rtl; 
        overflow: hidden;
    }

    .form-header {
        background: var(--accent-beige);
        color: var(--white);
        padding: 1.2rem;
        text-align: center;
    }

    form {
        padding: 2rem;
    }

    .grid-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr); 
        gap: 1.5rem;
        margin-bottom: 1.2rem;
    }
        .grid-row:nth-of-type(4) {
            grid-template-columns: repeat(3, 1fr);
        }

    .input-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .input-group label {
            color: var(--text-dark);
            font-weight: 600;
            font-size: 0.85rem;
            text-align: right;
        }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
    }

        .input-wrapper i {
            position: absolute;
            right: 12px; 
            color: var(--primary-green);
            z-index: 2;
            pointer-events: none;
        }

.input-wrapper input,
        .input-wrapper select {
            width: 100%;
            padding: 10px 35px 10px 10px;
            border: 1px solid var(--accent-beige);
            border-radius: 8px;
            background: var(--light-beige);
            font-size: 0.9rem;
            height: 45px; 
            outline: none;
            transition: var(--transition);
        }
 .input-wrapper input:focus,
            .input-wrapper select:focus {
                border-color: var(--primary-green);
                background: #fff;
            }
    .actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #eee;
    }

        .actions button, .actions a {
            flex: 1;
            height: 48px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .actions .save {
            background: var(--primary-green);
            color: white;
        }
        
        .actions .cancel {
            background: #f8f9fa;
            color: #dc3545;
        }

    @@media (max-width: 768px) {
    .grid-row, .grid-row:nth-of-type(4) {
        grid-template-columns: 1fr !important;
    }
  }
    
    .attendance-options label {
    margin: 0 10px;
    cursor: pointer;
    font-family: 'Tajawal', sans-serif;
    font-size: clamp(1rem,2.5vw,1.5rem);
    padding: 4px 8px;
    border-radius: 6px;
    transition: background 0.2s;
}

.attendance-options input[type="radio"]:checked + span {
    color:var(--primary-green);
    font-weight: bold;
    padding: 4px 8px;
    border-radius: 6px;
}
  
.attendance-options input[type="radio"] {
    width: 20px; 
    height: 20px;
    margin-right: 5px;
    cursor: pointer;
}
</style>

<section class="management-container">
<header class="page-header">
  <h2 class="page-title">إدارة المعلمين</h2>
</header>
<br />

<div class="search-wrapper mb-3">
  <EditForm Model="searchModel" OnValidSubmit="HandleSearch">
      <i class="bi bi-search"></i>
      <input type="text" class="search-input" @bind="searchModel.Name" placeholder="ابحث عن معلم...">
      <button type="submit" style="display: none;"></button>
  </EditForm>
</div>

@if (isLoading)
{
    <div class="text-center my-3">
        <span class="spinner-border text-success" role="status"></span>
        <p>جاري البحث وجلب البيانات...</p>
    </div>
}
<br />

<table class="table">
  <thead>
    <tr>
      <th class="table th">اسم المعلم</th>
      <th class="table th">حضور </th>
      <th class="table th">معلومات المعلم</th>
      <th class="table th">حذف  المعلم</th>
    </tr>
  </thead>
  <tbody>
    @if (teachersList != null && teachersList.Any())
    {
        @foreach (var teacher in teachersList)
        {
            <tr>
              <td class="table td">@teacher.Name</td>
              <td class="table td">
                <div class="attendance-options">
                  <label><input type="radio" name="@($"attend_{teacher.Id}")" value="حاضر"> حاضر</label>
                  <label><input type="radio" name="@($"attend_{teacher.Id}")" value="غائب"> غائب</label>
                  <label><input type="radio" name="@($"attend_{teacher.Id}")" value="غياب مبرر"> مبرر</label>
                </div>
              </td>
              <td>
                <button type="button" @onclick="() => viewTeacher1(teacher.Id)" title="عرض"><i class="bi bi-info-circle"></i></button>
                <button type="button" class="btn-icon edit" @onclick="() => editTeacher(teacher.Id)" title="تعديل"><i class="bi bi-pencil-square"></i></button>
              </td>
              <td>
                <button type="button" class="btn-icon delete" @onclick="() => DeleteTeacher(teacher.Id)" title="حذف"><i class="bi bi-trash"></i></button>
              </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="4" class="text-center p-3">
                @(searchResponse == null ? "اضغطي Enter داخل مربع البحث لعرض قائمة المعلمين" : "لا يوجد معلمين يطابقون البحث")
            </td>
        </tr>
    }
  </tbody>
</table>
 <details>
  <summary class="btn-pprimary">إضافة معلم جديد</summary>
    <div class="form-container">
    <div class="form-header">
        <h2><i class="bi bi-person-plus-fill"></i> إضافة معلم</h2>
    </div>
    <EditForm Model="teacherModel" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="grid-row">
            <div class="input-group">
                <label>الاسم الكامل</label>
                <div class="input-wrapper">
                    <i class="bi bi-person"></i>
                    <input type="text" @bind="teacherModel.Name" placeholder="أدخل الاسم">
                </div>
            </div>
             <div class="input-group">
                <label>رقم الهاتف</label>
                <div class="input-wrapper">
                    <i class="bi bi-telephone"></i>
                    <input type="tel" @bind="teacherModel.Phone" placeholder="أدخل الرقم">
                </div>
            </div>
        </div>
        <div class="grid-row">
             <div class="input-group">
                <label>تاريخ التعيين (Assigned At)</label>
                <div class="input-wrapper">
                    <i class="bi bi-calendar-event"></i>
                    <input type="text" @bind="teacherModel.AssignedAt" placeholder="مثال: 2026-05-22">
                </div>
            </div>
            <div class="input-group">
                <label>البريد الإلكتروني</label>
                <div class="input-wrapper">
                    <i class="bi bi-envelope"></i>
                    <input type="email" @bind="teacherModel.Email" placeholder="أدخل البريد الالكتروني">
                </div>
            </div>
        </div>
        <div class="grid-row">
             <div class="input-group">
                <label>كلمة المرور</label>
                <div class="input-wrapper">
                    <i class="bi bi-lock"></i>
                    <input type="password" @bind="teacherModel.Password" placeholder="أدخل كلمة المرور">
                </div>
            </div>
            <div class="input-group">
                <label>تأكيد كلمة المرور</label>
                <div class="input-wrapper">
                    <i class="bi bi-lock"></i>
                    <input type="password" @bind="teacherModel.ConfirmPassword" placeholder="تأكيد كلمة المرور">
                </div>
            </div>
        </div>
        <div class="grid-row">
           <div class="input-group">
                <label>الجنس</label>
                <div class="input-wrapper">
                    <i class="bi bi-gender-ambiguous"></i>
                    <select @bind="teacherModel.Gender">
                        <option value="Male">ذكر</option>
                        <option value="Female">أنثى</option>
                    </select>
                </div>
            </div>
            <div class="input-group">
                <label>لمحة عن الخبرات (Bio)</label>
                <div class="input-wrapper">
                    <i class="bi bi-person-workspace"></i>
                    <input type="text" @bind="teacherModel.Bio" placeholder="اكتب هنا...">
                </div>
            </div>
        </div>
        <div class="actions">
            <button type="submit" class="save"><i class="bi bi-check2-all"></i> حفظ المعلم</button>
            <a href="/supervisor/teacher" class="cancel"><i class="bi bi-x-lg"></i> إلغاء</a>
        </div>
    </EditForm>
</div>
</details>
</section>

@code {
    // تم استخدام AddTeacherRequest بناءً على كود السيرفس
    private AddTeacherRequest teacherModel = new AddTeacherRequest { Gender = "Female", MosqueId = Guid.NewGuid() };
    private SearchMembersRequest searchModel = new SearchMembersRequest { MemberType = "Teacher", PageNumber = 1, PageSize = 20 };
    private GeneralResponse searchResponse;
    private bool isLoading = false;
    
    // استخدمنا كلاس الـ Dto المرجع من السيرفس داتا مباشرة
    private List<Moeen.Shared.Responses.Enrollment.MemberProfileDto> teachersList = new List<Moeen.Shared.Responses.Enrollment.MemberProfileDto>();

    private void viewTeacher1(Guid id)
    {
        NavManager.NavigateTo($"/supervisor/teacher1/{id}");
    }
  
    private void editTeacher(Guid id)
    {
        NavManager.NavigateTo($"/supervisor/editinfo_teacher/{id}");
    }

    private async Task HandleSearch()
    {
        isLoading = true;
        try
        {
            searchResponse = await EnrollmentService.SearchMembersAsync(searchModel);
            if (searchResponse != null && searchResponse.Success && searchResponse.Data != null)
            {
                // عمل Deserialize تلقائي للبيانات القادمة من السيرفس للـ MemberProfileDto المعتمد بالباك إند
                teachersList = System.Text.Json.JsonSerializer.Deserialize<List<Moeen.Shared.Responses.Enrollment.MemberProfileDto>>(searchResponse.Data.ToString(),
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new List<Moeen.Shared.Responses.Enrollment.MemberProfileDto>();
            }
            else
            {
                teachersList = new List<Moeen.Shared.Responses.Enrollment.MemberProfileDto>();
            }
        }
        catch (Exception)
        {
            PopulateMockData();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleSubmit()
    {
        // تم التعديل إلى الميثود الحقيقية بالباك إند AddTeacherAsync
        var response = await EnrollmentService.AddTeacherAsync(teacherModel);
        if (response != null && response.Success)
        {
            teacherModel = new AddTeacherRequest { Gender = "Female", MosqueId = Guid.NewGuid() };
            await HandleSearch();
        }
    }

    private async Task DeleteTeacher(Guid teacherId)
{
    // تعديل الريكويست ليوافق واجهة الفرونت إند الحالية التي تطلب Guid
    var response = await EnrollmentService.DeleteTeacherAsync(teacherId);
    
    if (response != null && response.Success)
    {
        await HandleSearch();
    }
    else
    {
        // في حال التجربة المحلية أو عدم الحذف الفعلي من الداتابيس
        teachersList.RemoveAll(x => x.Id == teacherId);
        StateHasChanged();
    }
}

    private void PopulateMockData()
    {
        teachersList = new List<Moeen.Shared.Responses.Enrollment.MemberProfileDto>
        {
            new Moeen.Shared.Responses.Enrollment.MemberProfileDto { Id = Guid.NewGuid(), Name = "آلاء قاسم", MemberType = "Teacher" },
            new Moeen.Shared.Responses.Enrollment.MemberProfileDto { Id = Guid.NewGuid(), Name = "ماريا العبدالسلام", MemberType = "Teacher" },
            new Moeen.Shared.Responses.Enrollment.MemberProfileDto { Id = Guid.NewGuid(), Name = "آية دعبول", MemberType = "Teacher" }
        };
    }
}