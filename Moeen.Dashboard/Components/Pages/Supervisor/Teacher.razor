@page "/supervisor/teacher"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Moeen.Dashboard.Application.Services.Abstractions
@using Moeen.Dashboard.Components.Shared
@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Requests.Enrollment
@using Moeen.Shared.Requests.Mosuq
@using Moeen.Shared.Requests.Fouj
@using Moeen.Shared.Responses.Fouj
@using Moeen.Shared.Responses.Halqa
@using Moeen.Shared.Responses.Enrollment
@using Moeen.Shared.Responses.Mosuq
@inject IEnrollmentService EnrollmentService
@inject IMosquService MosquService
@inject IFoujManagementService FoujService
@inject IHalqaManagementService HalqaService
@inject IJSRuntime JS

<style>
    .teachers-page { direction: rtl; color: #163f35; }
    .teachers-card { background: #fff; border: 1px solid rgba(25, 80, 66, 0.10); border-radius: 24px; padding: 28px; box-shadow: 0 22px 60px rgba(25, 80, 66, 0.08); }
    .teachers-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin-bottom: 26px; }
    .teachers-title { margin: 0; color: #195042; font-size: 1.65rem; font-weight: 900; letter-spacing: -0.04em; }
    .teachers-subtitle { margin: 7px 0 0; color: #7b7067; font-size: 0.95rem; }
    .teachers-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 22px; flex-wrap: wrap; }
    .search-wrapper { position: relative; width: min(100%, 430px); }
    .search-wrapper .bi { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: #195042; }
    .search-input { width: 100%; height: 48px; padding: 0 44px 0 16px; border: 1px solid #ddd5cc; border-radius: 15px; outline: none; background: #fbfaf8; color: #163f35; transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease; }
    .search-input:focus { border-color: #195042; background: #fff; box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.10); }
    .btn-moeen-primary, .btn-moeen-light { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 0 17px; border-radius: 14px; border: 0; font-weight: 800; transition: transform 0.18s ease, background 0.18s ease; }
    .btn-moeen-primary { background: #195042; color: #fff; box-shadow: 0 14px 28px rgba(25, 80, 66, 0.18); }
    .btn-moeen-primary:hover:not(:disabled) { background: #123d32; transform: translateY(-1px); }
    .btn-moeen-light { background: #f4f1e8; color: #195042; border: 1px solid #e2dbd2; }
    .teachers-table-wrap { overflow-x: auto; border: 1px solid #eee8e0; border-radius: 18px; }
    .teachers-table { width: 100%; margin: 0; border-collapse: collapse; min-width: 900px; }
    .teachers-table th { background: #f4f1e8; color: #195042; font-weight: 900; padding: 15px 18px; border-bottom: 1px solid rgba(25, 80, 66, 0.18); white-space: nowrap; text-align: center; }
    .teachers-table td { padding: 15px 18px; border-bottom: 1px solid #f1ece6; vertical-align: middle; color: #263f37; text-align: center; }
    .teachers-table tr:last-child td { border-bottom: 0; }
    .teachers-table tbody tr:hover td { background: #fbfaf8; }
    .teacher-name-cell { display: flex; align-items: center; gap: 12px; font-weight: 900; color: #163f35; text-align: right; }
    .teacher-avatar { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 14px; background: #195042; color: #fff; font-size: 1rem; }
    .teacher-bio { max-width: 260px; margin: 0 auto; color: #655d56; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .row-actions { display: flex; justify-content: center; gap: 8px; }
    .icon-btn { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid #e2dbd2; border-radius: 12px; background: #fff; color: #195042; transition: transform 0.18s ease, background 0.18s ease; }
    .icon-btn:hover { background: #f4f1e8; transform: translateY(-1px); }
    .icon-btn.info { color: #039855; }
    .icon-btn.edit { color: #2563eb; }
    .icon-btn.danger { color: #b42318; }
    .state-card { padding: 22px; border: 1px solid #eee8e0; border-radius: 18px; background: #fff; color: #195042; }
    @@media (max-width: 760px) { .teachers-card { padding: 20px; } .teachers-header { flex-direction: column; } }
</style>

<section class="teachers-page">
    <div class="teachers-card">
        <header class="teachers-header">
            <div>
                <h2 class="teachers-title">إدارة المعلمين</h2>
                <p class="teachers-subtitle">عرض المعلمين، إضافة معلم جديد، وتعديل بيانات المعلم من نفس الديالوج المشترك.</p>
            </div>
            <button class="btn-moeen-primary" type="button" @onclick="OpenCreateDialog" disabled="@_isLoading">
                <i class="bi bi-person-plus"></i>
                <span>إضافة معلم جديد</span>
            </button>
        </header>

        <div class="teachers-toolbar">
            <div class="search-wrapper">
                <i class="bi bi-search"></i>
                <input class="search-input" value="@_searchText" placeholder="ابحث باسم المعلم..." @oninput="HandleSearch" />
            </div>
            <button class="btn-moeen-light" type="button" @onclick="LoadTeachersAsync" disabled="@_isLoading">
                <i class="bi bi-arrow-clockwise"></i>
                <span>تحديث</span>
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success">@_successMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }

        @if (_isLoading)
        {
            <div class="state-card d-flex align-items-center gap-3">
                <span class="spinner-border text-success" role="status"></span>
                <span>جاري تحميل بيانات المعلمين...</span>
            </div>
        }
        else
        {
            <div class="teachers-table-wrap">
                <table class="teachers-table">
                    <thead>
                        <tr>
                            <th>اسم المعلم</th>
                            <th>البريد الإلكتروني</th>
                            <th>رقم الهاتف</th>
                            <th>المسجد</th>
                            <th>الحالة</th>
                            <th>الخبرة</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_teachers.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">لا يوجد معلمين حالياً.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var teacher in _teachers)
                            {
                                <tr>
                                    <td>
                                        <div class="teacher-name-cell">
                                            <span class="teacher-avatar"><i class="bi bi-person-workspace"></i></span>
                                            <span>@teacher.Name</span>
                                        </div>
                                    </td>
                                    <td>@teacher.Email</td>
                                    <td>@(string.IsNullOrWhiteSpace(teacher.Phone) ? "—" : teacher.Phone)</td>
                                    <td>@(string.IsNullOrWhiteSpace(teacher.MosqueName) ? "—" : teacher.MosqueName)</td>
                                    <td>@GetStatusLabel(teacher.Status)</td>
                                    <td><div class="teacher-bio" title="@teacher.Bio">@(string.IsNullOrWhiteSpace(teacher.Bio) ? "—" : teacher.Bio)</div></td>
                                    <td>
                                        <div class="row-actions">
                                            <button class="icon-btn info" type="button" title="عرض" @onclick="() => OpenDetailsDialog(teacher)">
                                                <i class="bi bi-info-circle"></i>
                                            </button>
                                            <button class="icon-btn edit" type="button" title="تعديل" @onclick="() => OpenEditDialog(teacher)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="icon-btn danger" type="button" title="حذف" @onclick="() => DeleteTeacherAsync(teacher)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <MemberManagementDialog IsOpen="@_isDialogOpen"
                            IsEditMode="@_isEditMode"
                            IsSaving="@_isSaving"
                            EntityName="معلم"
                            ErrorMessage="@_dialogError"
                            Model="@_form"
                            Mosques="@_mosques"
                            Foujs="@_foujs"
                            Halqas="@_halqas"
                            ShowMosque="true"
                            DisableMosque="@_isEditMode"
                            ShowFouj="true"
                            ShowHalqa="true"
                            ShowPassword="true"
                            ShowJoinedAt="true"
                            ShowStatus="true"
                            ShowScore="false"
                            ShowBio="true"
                            ShowAssignedAt="true"
                            OnApply="ApplyDialogAsync"
                            OnCancel="CloseDialog" />

    <MemberDetailsDialog IsOpen="@_isDetailsOpen"
                         Model="@_detailsModel"
                         OnClose="CloseDetailsDialog" />
</section>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    private readonly List<TeacherRow> _teachers = new();
    private List<MosquDto> _mosques = new();
    private List<FoujDto> _foujs = new();
    private List<HalqaDto> _halqas = new();
    private MemberManagementDialogModel _form = new();
    private MemberDetailsDialogModel _detailsModel = new();

    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isDialogOpen;
    private bool _isDetailsOpen;
    private bool _isEditMode;
    private string _searchText = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _dialogError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadInitialDataAsync();
        StateHasChanged();
    }

    private async Task LoadInitialDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            await LoadMosquesAsync();
            await LoadStructureAsync();
            await LoadTeachersAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر تحميل بيانات المعلمين: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadMosquesAsync()
    {
        try
        {
            _mosques = await MosquService.GetAllMosqus(new GetAllMosqusRequest { Page = 1, PageSize = 200 }) ?? new();
        }
        catch
        {
            _mosques = new();
        }
    }

    private async Task LoadStructureAsync()
    {
        try
        {
            var foujResponse = await FoujService.GetAllAsync(new GetAllFoujsRequest());
            _foujs = foujResponse?.Success == true
                ? JsonSerializer.Deserialize<List<FoujDto>>(JsonSerializer.Serialize(foujResponse.Data), JsonOptions) ?? new()
                : new();

            var halqaResponse = await HalqaService.GetAllAsync();
            _halqas = halqaResponse?.Success == true
                ? JsonSerializer.Deserialize<List<HalqaDto>>(JsonSerializer.Serialize(halqaResponse.Data), JsonOptions) ?? new()
                : new();
        }
        catch
        {
            _foujs = new();
            _halqas = new();
        }
    }

    private async Task LoadTeachersAsync()
    {
        _errorMessage = null;

        try
        {
            var response = await EnrollmentService.GetAllTeachersAsync(new GetAllTeachersRequest
            {
                Name = string.IsNullOrWhiteSpace(_searchText) ? null : _searchText,
                PageNumber = 1,
                PageSize = 200
            });

            if (response == null || !response.Success)
            {
                _errorMessage = response?.Message ?? "فشل تحميل المعلمين.";
                _teachers.Clear();
                return;
            }

            var json = JsonSerializer.Serialize(response.Data);
            var teachers = JsonSerializer.Deserialize<List<TeacherDto>>(json, JsonOptions) ?? new();

            _teachers.Clear();
            _teachers.AddRange(teachers.Select(TeacherRow.FromDto));
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر تحميل المعلمين: {ex.Message}";
            _teachers.Clear();
        }
    }

    private async Task HandleSearch(ChangeEventArgs args)
    {
        _searchText = args.Value?.ToString() ?? string.Empty;
        await LoadTeachersAsync();
    }

    private void OpenCreateDialog()
    {
        _successMessage = null;
        _dialogError = null;
        _isEditMode = false;
        _form = new MemberManagementDialogModel
        {
            Gender = "Male",
            JoinedAt = DateTime.Today,
            MosqueId = _mosques.FirstOrDefault()?.Id ?? Guid.Empty,
            FoujId = _foujs.FirstOrDefault()?.Id ?? Guid.Empty,
            HalqaId = _halqas.FirstOrDefault()?.Id,
            Status = 0,
            AssignedAt = DateTime.Today
        };
        _isDialogOpen = true;
    }

    private void OpenEditDialog(TeacherRow teacher)
    {
        _successMessage = null;
        _dialogError = null;
        _isEditMode = true;
        _form = new MemberManagementDialogModel
        {
            Id = teacher.Id,
            Name = teacher.Name,
            Email = teacher.Email,
            Phone = teacher.Phone,
            Gender = string.Equals(teacher.Gender, "Female", StringComparison.OrdinalIgnoreCase) ? "Female" : "Male",
            JoinedAt = teacher.JoinedAt == default ? DateTime.Today : teacher.JoinedAt,
            MosqueId = teacher.MosqueId,
            FoujId = teacher.FoujId ?? Guid.Empty,
            HalqaId = teacher.HalqaId,
            Status = teacher.Status,
            Bio = teacher.Bio,
            AssignedAt = ParseAssignedDate(teacher.AssignedAt)
        };
        _isDialogOpen = true;
    }

    private void CloseDialog()
    {
        if (_isSaving)
            return;

        _isDialogOpen = false;
        _dialogError = null;
    }

    private void OpenDetailsDialog(TeacherRow teacher)
    {
        _detailsModel = new MemberDetailsDialogModel
        {
            Title = teacher.Name,
            Subtitle = "معلومات المعلم الكاملة",
            Sections = new List<MemberDetailsSectionModel>
            {
                new()
                {
                    Title = "البيانات الأساسية",
                    Items = new List<MemberDetailsItemModel>
                    {
                        Item("الاسم الكامل", teacher.Name),
                        Item("البريد الإلكتروني", teacher.Email),
                        Item("رقم الهاتف", teacher.Phone),
                        Item("الجنس", GetGenderLabel(teacher.Gender)),
                        Item("تاريخ الانضمام", FormatDate(teacher.JoinedAt)),
                        Item("حالة الحساب", GetStatusLabel(teacher.Status)),
                        Item("المسجد", teacher.MosqueName)
                    }
                },
                new()
                {
                    Title = "الخبرة والتعيين",
                    Items = new List<MemberDetailsItemModel>
                    {
                        Item("تاريخ التعيين", FormatAssignedDateForDisplay(teacher.AssignedAt)),
                        Item("لمحة عن الخبرات", teacher.Bio, wide: true)
                    }
                },
                new()
                {
                    Title = "الحلقات والأفواج",
                    Items = new List<MemberDetailsItemModel>
                    {
                        Item("الحلقات التي يدرّس فيها", GetTeacherHalqasDisplay(teacher), wide: true),
                        Item("الأفواج الموجود فيها", GetTeacherFoujsDisplay(teacher), wide: true)
                    }
                }
            }
        };

        _isDetailsOpen = true;
    }

    private void CloseDetailsDialog()
    {
        _isDetailsOpen = false;
    }

    private async Task ApplyDialogAsync()
    {
        _isSaving = true;
        _dialogError = null;
        _successMessage = null;

        try
        {
            if (_isEditMode)
            {
                if (!string.IsNullOrWhiteSpace(_form.Password) && _form.Password.Trim().Length < 6)
                {
                    _dialogError = "كلمة المرور الجديدة يجب أن تكون 6 أحرف على الأقل.";
                    return;
                }

                var response = await EnrollmentService.UpdateMemberInfoAsync(new UpdateMemberInfoRequest
                {
                    MemberId = _form.Id.ToString(),
                    Name = _form.Name,
                    Email = _form.Email,
                    Phone = _form.Phone?.Trim() ?? string.Empty,
                    Gender = _form.Gender,
                    Bio = _form.Bio,
                    Status = _form.Status,
                    AssignedAt = FormatAssignedDateForRequest(_form.AssignedAt),
                    HalqaId = _form.HalqaId,
                    NewPassword = string.IsNullOrWhiteSpace(_form.Password) ? null : _form.Password.Trim()
                });

                if (response == null || !response.Success)
                {
                    _dialogError = response?.Message ?? "فشل تعديل بيانات المعلم.";
                    return;
                }

                _successMessage = "تم تعديل بيانات المعلم بنجاح.";
            }
            else
            {
                if (_form.MosqueId == Guid.Empty)
                {
                    _dialogError = "يرجى اختيار المسجد قبل إضافة المعلم.";
                    return;
                }

                if (string.IsNullOrWhiteSpace(_form.Password))
                {
                    _dialogError = "يرجى إدخال كلمة مرور للمعلم الجديد.";
                    return;
                }

                var response = await EnrollmentService.AddTeacherAsync(new AddTeacherRequest
                {
                    Name = _form.Name,
                    Email = _form.Email,
                    Password = _form.Password!,
                    ConfirmPassword = _form.Password!,
                    Phone = _form.Phone?.Trim() ?? string.Empty,
                    PhoneNumber = _form.Phone?.Trim() ?? string.Empty,
                    Gender = _form.Gender,
                    Status = _form.Status,
                    MosqueId = _form.MosqueId,
                    FoujId = _form.FoujId == Guid.Empty ? null : _form.FoujId,
                    HalqaId = _form.HalqaId,
                    Bio = _form.Bio ?? string.Empty,
                    AssignedAt = FormatAssignedDateForRequest(_form.AssignedAt),
                    Experiences = string.IsNullOrWhiteSpace(_form.Bio) ? null : new List<string> { _form.Bio },
                    TeachingPlaces = null
                });

                if (response == null || !response.Success)
                {
                    _dialogError = response?.Message ?? "فشل إضافة المعلم.";
                    return;
                }

                _successMessage = "تم إضافة المعلم بنجاح.";
            }

            _isDialogOpen = false;
            await LoadTeachersAsync();
        }
        catch (Exception ex)
        {
            _dialogError = $"تعذر حفظ بيانات المعلم: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteTeacherAsync(TeacherRow teacher)
    {
        _successMessage = null;
        _errorMessage = null;

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"هل تريد حذف المعلم {teacher.Name}؟");
        if (!confirmed)
            return;

        try
        {
            var response = await EnrollmentService.DeleteTeacherAsync(teacher.Id);
            if (response == null || !response.Success)
            {
                _errorMessage = response?.Message ?? "فشل حذف المعلم.";
                return;
            }

            _successMessage = "تم حذف المعلم بنجاح.";
            await LoadTeachersAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر حذف المعلم: {ex.Message}";
        }
    }

    private static MemberDetailsItemModel Item(string label, string? value, bool wide = false)
        => new()
        {
            Label = label,
            Value = string.IsNullOrWhiteSpace(value) ? "—" : value,
            Wide = wide
        };

    private static string GetGenderLabel(string? gender)
        => string.Equals(gender, "Female", StringComparison.OrdinalIgnoreCase) ? "أنثى" : "ذكر";

    private static string GetStatusLabel(int status)
        => status switch
        {
            0 => "نشط",
            1 => "متوقف",
            2 => "متخرج",
            _ => "غير محدد"
        };

    private static string FormatDate(DateTime date)
        => date == default ? "—" : date.ToString("yyyy/MM/dd");

    private static DateTime? ParseAssignedDate(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        return DateTime.TryParse(value, out var parsed) ? parsed.Date : null;
    }

    private static string FormatAssignedDateForRequest(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : string.Empty;

    private static string FormatAssignedDateForDisplay(string? value)
        => DateTime.TryParse(value, out var parsed) ? parsed.ToString("yyyy/MM/dd") : value ?? string.Empty;

    private string GetTeacherHalqasDisplay(TeacherRow teacher)
    {
        var halqaNames = _halqas
            .Where(halqa => halqa.TeacherId == teacher.Id)
            .OrderBy(halqa => halqa.Name)
            .Select(halqa => halqa.Name)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (halqaNames.Count == 0 && !string.IsNullOrWhiteSpace(teacher.HalqaName))
            halqaNames.Add(teacher.HalqaName);

        return halqaNames.Count == 0 ? "—" : string.Join("، ", halqaNames);
    }

    private string GetTeacherFoujsDisplay(TeacherRow teacher)
    {
        var foujNames = _halqas
            .Where(halqa => halqa.TeacherId == teacher.Id)
            .OrderBy(halqa => halqa.FoujName)
            .Select(halqa => !string.IsNullOrWhiteSpace(halqa.FoujName)
                ? halqa.FoujName
                : _foujs.FirstOrDefault(fouj => fouj.Id == halqa.FoujId)?.Name)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (foujNames.Count == 0 && !string.IsNullOrWhiteSpace(teacher.FoujName))
            foujNames.Add(teacher.FoujName);

        return foujNames.Count == 0 ? "—" : string.Join("، ", foujNames);
    }

    private IEnumerable<FoujDto> DialogFoujs => _form.MosqueId == Guid.Empty
        ? _foujs
        : _foujs.Where(fouj => fouj.MosqueId == _form.MosqueId);

    private IEnumerable<HalqaDto> DialogHalqas => _form.FoujId == Guid.Empty
        ? _halqas
        : _halqas.Where(halqa => halqa.FoujId == _form.FoujId);

    private sealed class TeacherRow
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Phone { get; set; }
        public string? Gender { get; set; }
        public DateTime JoinedAt { get; set; }
        public Guid MosqueId { get; set; }
        public string MosqueName { get; set; } = string.Empty;
        public Guid? FoujId { get; set; }
        public string FoujName { get; set; } = string.Empty;
        public Guid? HalqaId { get; set; }
        public string HalqaName { get; set; } = string.Empty;
        public int Status { get; set; }
        public string? Bio { get; set; }
        public string? AssignedAt { get; set; }

        public static TeacherRow FromDto(TeacherDto dto)
            => new()
            {
                Id = dto.Id,
                Name = dto.Name ?? string.Empty,
                Email = dto.Email ?? string.Empty,
                Phone = dto.Phone,
                Gender = dto.Gender,
                JoinedAt = dto.JoinedAt,
                MosqueId = dto.MosqueId,
                MosqueName = dto.MosqueName ?? string.Empty,
                FoujId = dto.FoujId,
                FoujName = dto.FoujName ?? string.Empty,
                HalqaId = dto.HalqaId,
                HalqaName = dto.HalqaName ?? string.Empty,
                Status = dto.Status,
                Bio = dto.Bio,
                AssignedAt = dto.AssignedAt
            };
    }
}
