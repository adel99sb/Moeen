@page "/supervisor/teacher"	
@rendermode InteractiveServer

@inject NavigationManager NavManager

<h3>Teacher</h3>
<style>
	/* تنسيق خيارات الحضور */


		
		.attendance-options label {
    margin: 0 10px;
    cursor: pointer;
    font-size: 25px;/* خط أكبر */
    font-weight: 500;   /* شوي ثخانة */
    padding: 4px 8px;
    border-radius: 6px;
    transition: background 0.2s;
}

	/* تغيير لون الخلفية عند اختيار الحالة */
.attendance-options input[type="radio"]:checked + span {
    color: white;
    font-weight: bold;
    padding: 4px 8px;
    border-radius: 6px;
}
	
.attendance-options input[type="radio"] {
    width: 20px; /* تكبير الدائرة */
    height: 20px;/*تكبير الدائرة */
    margin-right: 5px;
    cursor: pointer;
}


</style>
<div class="search-container">
	<input class="search-input" placeholder="ابحث هنا..." />
	<button class="btn btn-primary"> <span class="bi bi-search"> </span> </button>
</div>
<table class="table">
	<thead>
		<tr>
			<th class="table th">اسم المعلم</th>
			<th class="table th">معلومات المعلم</th>

			<th class="table th">حضور </th>
			<th class="table th ">حذف  المعلم</th>
		</tr>
	</thead>
	<tbody>
		<tr>
			
			<td class="table td"> آلاء قاسم </td>
			<td>
				<a class="btn btn-accent" @onclick="viewTeacher1"> عرض</a>
				<a class="btn btn-accent" @onclick="editTeacher"> تعديل</a>
			   
			</td>
			<td class="table td">
			
					<div class="attendance-options">
					<label><input type="radio" name="attend1" value="حاضر"> حاضر</label>
					<label><input type="radio" name="attend1" value="غائب"> غائب</label>
					<label><input type="radio" value="غياب مبرر" name="attend1"> مبرر</label>
					</div>
				
			</td>
			<td class="table td"><button class="btn btn-danger">حذف </button></td>
		</tr>
		<tr>
			
			<td class="table td">  ماريا العبدالسلام </td>
			<td>
				<a class="btn btn-accent" @onclick="viewTeacher2"> عرض</a>
				<a class="btn btn-accent" @onclick="editTeacher"> تعديل</a>
			   
			</td>
			<td class="table td">
			
				<div class="attendance-options">
					<label><input type="radio" name="attend1" value="حاضر"> حاضر</label>
					<label><input type="radio" name="attend1" value="غائب"> غائب</label>
					<label><input type="radio" value="غياب مبرر" name="attend1"> مبرر</label>
				</div>
				
			</td>
			<td class="table td"><button class="btn btn-danger">حذف </button></td>
		</tr>
		<tr>
			<td class="table td">آية دعبول </td>
			<td>
				<a class="btn btn-accent" @onclick="viewTeacher3"> عرض</a>
				<a class="btn btn-accent" @onclick="editTeacher"> تعديل</a>
			   
			</td>
			<td class="table td">
			
				<div class="attendance-options">
					<label><input type="radio" name="attend1" value="حاضر"> حاضر</label>
					<label><input type="radio" name="attend1" value="غائب"> غائب</label>
					<label><input type="radio" value="غياب مبرر" name="attend1"> مبرر</label>
				</div>
				
			</td>
			<td class="table td"><button class="btn btn-danger">حذف </button></td>
		</tr>
		</tbody>
		</table>
		<details class="details">
		<summary class="summary">إضافة معلم جديد</summary>

		<br>

		<form class="form-box">
			 <div class="form-group">
		<label class="label">اسم والكنية:</label><br>
		<input class="input" placeholder="اكتب هنا..." type="text" name="name"><br><br>
		      </div>
			   <div class="form-group">
		<label class="label">تاريخ الميلاد:</label><br>
		<input class="input" placeholder="اكتب هنا..." type="number" name="age"><br><br>
		       </div>
			   <div class="form-group">

        <label class="label">تاريخ التسجيل:</label><br>
		<input class="input" placeholder="اكتب هنا..." type="number" name="status"><br><br>
		</div>
		        <div class="form-group">
		<label class="label">البريد الالكتروني:</label><br>
		<input class="input" placeholder="اكتب هنا..." type="email" name="status"><br><br>
		        </div>
		        <div class="form-group">

		<label class="label">رقم الهاتف:</label><br>
		<input class="input" placeholder="اكتب هنا..." type="number" name="status"><br><br>
		        </div>
		        <div class="form-group">

		<label class="label">الجنس:</label><br>
		<select class="select" name="halaqa">
			<option> ذكر</option>
			<option> انثى</option>
		</select>
		</div>
		        <div class="form-group">

		<label class="label">لمحة عن الخبرات:</label><br>
		<input class="input" placeholder="اكتب هنا..." type="text" name="status"><br><br>
                </div>
		        <div class="form-group">

		<label class="label">كلمة السر:</label><br>
		<input class="input" placeholder="اكتب هنا..." type="password" name="status"><br><br>
		        </div>
		        <div class="form-group">

		<label class="label">الفوج:</label><br>
		<select class="select" name="halaqa">
			<option> فوج اول</option>
			<option> فوج ثاني</option>

		</select><br><br>
		</div>
		        <div class="form-group">

		<label class="label">رقم الحلقة:</label><br>
		<select class="select" name="halaqa">
			<option>الحلقة 1</option>
			<option>الحلقة 2</option>
			<option>الحلقة 3</option>
			<option>الحلقة 4</option>
		</select>
		<br />
		</div>
		


		<button class="btn btn-accent" type="submit">إضافة</button>

	</form>

</details>

@code {
	private void viewTeacher1()
	{
		NavManager.NavigateTo("/supervisor/teacher1");
	}
	private void viewTeacher2()
	{
		NavManager.NavigateTo("/supervisor/teacher2");
	}
	private void viewTeacher3()
	{
		NavManager.NavigateTo("/supervisor/teacher3");
	}
	private void editTeacher()
	{
		NavManager.NavigateTo("/supervisor/editinfo_teacher");
		// Logic to edit student information
	}
}
