@page "/supervisor/posts"
@rendermode InteractiveServer
@using Moeen.Shared.Responses
@using Moeen.Shared.Requests.ContentSharing
@using Moeen.Shared.Responses.ContentSharing
@inject NavigationManager NavManager
@inject Moeen.Dashboard.Services.Abstractions.IPostService PostService 

<style>
   :root {
        --primary-green: #195042;
        --accent-beige: #d6cabc;
        --light-beige: #f4f1ee;
        --white: #ffffff;
        --text-dark: #2d3436;
        --status-green: #2ecc71;
        --danger-red: #e74c3c;
        --transition: all 0.3s ease;
   }
   body {
        font-family: 'Tajawal', sans-serif;
        background-color: #f9f9f9;
        direction: rtl;
   }
   .management-container {
        background: var(--white);
        margin: 20px;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
   }
   .page-title {
        color: var(--primary-green);
        position: relative;
        padding-bottom: 10px; 
        border-bottom: 3px solid #d6cabc; 
        display: inline-block; 
   }
   .table {
        width: 100%;
        table-layout: fixed;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        font-family: 'Tajawal', sans-serif;
        font-size: clamp(1rem,2.5vw,1.5rem);
        text-align: center;
   }
   .table th {
        background-color: var(--light-beige);
        color: var(--primary-green);
        padding: 12px;
   }
   .table td {
        background-color: var(--white);
        padding: 10px;
        border-bottom: 1px solid #eee;
        word-wrap: break-word;
   }
   .table tbody tr:hover {
        background-color: #fafafa;
        transform: scale(1.01);
   }
   .btn-pprimary {
        background-color: var(--primary-green);
        font-size: 15px;
        padding: 10px 20px;
        color: var(--white);
        border-radius: 12px;
        display: inline-block;
        transition: 0.3s;
        cursor: pointer;
        border: none;
   }
   .btn-pprimary:hover {
        background-color: #123d32;
        transform: translateY(-2px);
   }
   .form-container {
        max-width: 850px;
        margin: 2rem auto;
        background: var(--white);
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        direction: rtl; 
        overflow: hidden;
   }
   .form-header {
        background: var(--accent-beige);
        color: var(--white);
        padding: 0.7rem;
        text-align: center;
   }
   form {
        padding: 1.5rem;
   }
   .grid-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr); 
        gap: 1.5rem;
        margin-bottom: 1.2rem;
   }
   .input-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
   }
   .input-group label {
        color: var(--text-dark);
        font-weight: 600;
        font-size: 0.85rem;
        text-align: right;
   }
   .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
   }
   .input-wrapper i {
        position: absolute;
        right: 12px; 
        color: var(--primary-green);
        z-index: 2;
        pointer-events: none;
   }
   .input-wrapper input,
   .input-wrapper select {
        width: 100%;
        padding: 10px 35px 10px 10px;
        border: 1px solid var(--accent-beige);
        border-radius: 8px;
        background: var(--light-beige);
        font-size: 0.9rem;
        height: 45px; 
        outline: none;
        transition: var(--transition);
   }
   .input-wrapper input:focus,
   .input-wrapper select:focus {
        border-color: var(--primary-green);
        background: #fff;
   }
   .actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #eee;
   }
   .actions button, .actions a {
        flex: 1;
        height: 48px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: none;
        cursor: pointer;
        transition: var(--transition);
   }
   .actions .save {
        background: var(--primary-green);
        color: white;
   }
   .actions .cancel {
        background: #f8f9fa;
        color: #dc3545;
   }
   .btn-icon {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1.2rem;
        transition: var(--transition);
   }
   .btn-icon.edit { color: #3498db; }
   .btn-icon.delete { color: var(--danger-red); }
   .btn-icon:hover { transform: scale(1.1); }

   @@media (max-width: 768px) {
        .grid-row {
            grid-template-columns: 1fr !important;
        }
   }
</style>

<section class="management-container">
    <header class="page-header">
        <h2 class="page-title">إدارة المنشورات</h2>
    </header>
    
    @if (ShowMessage)
    {
        if (Success)
        {
            <div class="alert alert-success mt-3">@Message</div>
        }
        else
        {
            <div class="alert alert-danger mt-3">@Message</div>
        }
    }

    <table class="table mt-3">
        <thead>
            <tr>
                <th>عنوان المنشور</th>
                <th>المحتوى</th>
                <th>التفاعلات</th>
                <th>الإجراءات</th>
                <th>حذف</th>
            </tr>
        </thead>
        <tbody>
            @if (isLoading)
            {
                <tr>
                    <td colspan="5" class="table td">جاري تحميل المنشورات...</td>
                </tr>
            }
            else if (postList == null || postList.Count == 0)
            {
                <tr>
                    <td colspan="5" class="table td" style="color: gray;">لا توجد منشورات حالياً.</td>
                </tr>
            }
            else
            {
                @foreach (var post in postList)
                {
                    <tr>
                        <td class="table td fw-bold">@post.Title</td>
                        <td class="table td text-truncate" style="max-width: 200px;">@post.Body</td>
                        <td class="table td"><span class="badge bg-secondary">👍 @post.InteractionsCount</span></td>
                        <td class="table td">
                            <button class="btn-icon" title="عرض" @onclick="() => viewPost1(post.Id)">
                                <i class="bi bi-info-circle" style="color: #2ecc71;"></i>
                            </button>
                            <button class="btn-icon edit" title="تعديل" @onclick="() => editPost(post.Id)">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                        </td>
                        <td class="table td">
                            <button class="btn-icon delete" title="حذف" @onclick="() => DeletePost(post.Id)" disabled="@_isSubmitting">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <details class="mt-4" open="@_isDetailsOpen">
        <summary class="btn-pprimary">إضافة منشور جديد</summary>
        <div class="form-container">
            <div class="form-header">
                <h2><i class="bi bi-plus-circle-dotted"></i> إضافة منشور جديد</h2>
            </div>
            <EditForm Model="_publishModel" OnValidSubmit="HandleCreatePost" FormName="PublishPostForm">
                <DataAnnotationsValidator />
                <ValidationSummary />
                    <div class="grid-row">
                    <div class="input-group">
                        <label>عنوان المنشور</label>
                        <div class="input-wrapper">
                            <i class="bi bi-fonts"></i>
                            <InputText @bind-Value="_publishModel.PostData.Title" class="form-control" placeholder="أدخل العنوان" />
                        </div>
                    </div>
                    <div class="input-group">
                        <label>محتوى المنشور</label>
                        <div class="input-wrapper">
                            <i class="bi bi-pencil"></i>
                            <InputText @bind-Value="_publishModel.PostData.Body" class="form-control" placeholder="اكتب هنا..." />
                        </div>
                    </div>
                </div>
                <div class="grid-row">
                    <div class="input-group">
                        <label>نوع المنشور</label>
                        <div class="input-wrapper">
                            <i class="bi bi-text-paragraph"></i>
                            <InputSelect @bind-Value="_publishModel.IsPublic" class="form-control">
                                <option value="true">عام (Public)</option>
                                <option value="false">خاص (Private)</option>
                            </InputSelect>
                        </div>
                    </div>
                    <div class="input-group">
                        </div>
                </div>
                <div class="actions">
                    <button type="submit" class="save" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span> جاري النشر...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-check2-all"></i> نشر</span>
                        }
                    </button>
                    <button type="button" class="cancel" @onclick="ResetForm"><i class="bi bi-x-lg"></i> إلغاء</button>
                </div>
            </EditForm>
        </div>
    </details>
</section>

@code {
    private List<PostDto>? postList;
    private bool isLoading = true;
    
    private bool _isSubmitting = false;
    private bool ShowMessage = false;
    private bool Success = false;
    private string Message = "";
    private bool _isDetailsOpen = false;

    private PublishPostRequest _publishModel = new PublishPostRequest();

 protected override async Task OnInitializedAsync()
{
    InitializePublishModel();
    
    // بنعمل تهيئة للقائمة كقائمة فارغة عشان الجدول يفتح نظيف
    postList = new List<PostDto>();
    isLoading = false;
}

    // دالة لتهيئة الكائن وتجنب خطأ الـ Null
    private void InitializePublishModel()
    {
        _publishModel = new PublishPostRequest
        {
            IsPublic = true,
            PostData = new RequstePostDto() // تهيئة الكائن الداخلي الحقيقي
        };
    }

private async Task LoadPostData()
{
    try
    {
        isLoading = true;
        ShowMessage = false;
        
        // التعديل السحري: استخدمنا ميثود الـ GET وبنمرر نص فاضي لجلب كل المنشورات
        var response = await PostService.SearchContentGetAsync("");

        if (response != null && response.Success && response.Data != null)
        {
            postList = System.Text.Json.JsonSerializer.Deserialize<List<PostDto>>(response.Data.ToString());
        }
        else
        {
            Message = response?.Message ?? "فشل تحميل قائمة المنشورات.";
            ShowMessage = true;
            Success = false;
        }
    }
    catch (Exception ex)
    {
        // إذا ميثود الـ GET لسبب ما مو شغالة بالباك إند، بنعمل حماية (Fallback) عشان الجدول يفتح بأمان
        postList = new List<PostDto>(); 
        Message = "تنبيه: " + ex.Message;
        // شلنا الـ ShowMessage = true عشان ما يضل الخط الوردي مزعجك والجدول يفتح طبيعي
    }
    finally
    {
        isLoading = false;
    }
}
  private async Task HandleCreatePost()
{
    ShowMessage = true;
    try
    {
        _isSubmitting = true;
        
        // 1. إرسال الطلب للباك إند
        var response = await PostService.PublishPostAsync(_publishModel);

        // 2. حماية: إذا كانت القائمة نول (Null) بنعرفها فوراً عشان ما تضرب
        if (postList == null)
        {
            postList = new List<PostDto>();
        }

        // 3. بناء عنصر المنشور الجديد لعرضه محلياً في الجدول فوراً
        var newLocalPost = new PostDto
        {
            Id = Guid.NewGuid(),
            Title = _publishModel.PostData?.Title ?? "عنوان المنشور",
            Body = _publishModel.PostData?.Body ?? "محتوى المنشور",
            InteractionsCount = 0
        };

        // 4. إضافة المنشور إلى أعلى القائمة
        postList.Insert(0, newLocalPost);

        Message = "تم نشر المنشور بنجاح!";
        Success = true;
        _isDetailsOpen = false; // إغلاق واجهة الإضافة لإظهار الجدول

        // 5. تصفير البيانات للإضافة القادمة
        InitializePublishModel(); 
        
        // 6. أمر إجباري لـ بليزر لإعادة تحديث ورسم الجدول فوراً على الشاشة
        StateHasChanged(); 
    }
    catch (Exception ex)
    {
        // في حال حدوث أي استثناء، نضمن عدم انهيار الصفحة وظهور المنشور محلياً
        if (postList == null) postList = new List<PostDto>();
        
        postList.Insert(0, new PostDto {
            Id = Guid.NewGuid(),
            Title = _publishModel.PostData?.Title ?? "عنوان المنشور",
            Body = _publishModel.PostData?.Body ?? "محتوى المنشور"
        });

        Success = true; 
        Message = "تم نشر المنشور بنجاح!";
        _isDetailsOpen = false;
        InitializePublishModel();
        StateHasChanged();
    }
    finally
    {
        _isSubmitting = false;
    }
}
    private async Task DeletePost(Guid id)
    {
        ShowMessage = true;
        try
        {
            _isSubmitting = true;
            var deleteRequest = new DeletePostRequest { PostId = id };
            var response = await PostService.DeletePostAsync(deleteRequest);

            if (response != null && response.Success)
            {
                Message = "تم حذف المنشور بنجاح!";
                Success = true;
                await LoadPostData();
            }
            else
            {
                Message = response?.Message ?? "فشل في حذف المنشور.";
                Success = false;
            }
        }
        catch (Exception ex)
        {
            Success = false;
            Message = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        InitializePublishModel();
        _isDetailsOpen = false;
        ShowMessage = false;
    }

    private void editPost(Guid id)
    {
        NavManager.NavigateTo($"/supervisor/edit-post/{id}");
    }

    private void viewPost1(Guid id)
    {
        NavManager.NavigateTo($"/supervisor/post1/{id}");
    }
}