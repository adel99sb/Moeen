@page "/supervisor/posts"
@rendermode InteractiveServer
@using Moeen.Shared.Responses
@using Moeen.Shared.Requests.ContentSharing
@using Moeen.Shared.Responses.ContentSharing
@inject NavigationManager NavManager
@inject Moeen.Dashboard.Services.Abstractions.IPostService PostService 

<style>
   :root {
        --primary-green: #195042;
        --accent-beige: #d6cabc;
        --light-beige: #f4f1ee;
        --white: #ffffff;
        --text-dark: #2d3436;
        --status-green: #2ecc71;
        --danger-red: #e74c3c;
        --transition: all 0.3s ease;
   }
   body {
        font-family: 'Tajawal', sans-serif;
        background-color: #f9f9f9;
        direction: rtl;
   }
   .management-container {
        background: var(--white);
        margin: 20px;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
   }
   .page-title {
        color: var(--primary-green);
        position: relative;
        padding-bottom: 10px; 
        border-bottom: 3px solid #d6cabc; 
        display: inline-block; 
   }
   
   .search-wrapper {
        position: relative;
        flex: 1;
        max-width: 400px;
   }

   .search-input {
        width: 100%;
        padding: 12px 45px 12px 15px;
        border: 1.5px solid var(--accent-beige);
        border-radius: 12px;
        outline: none;
        transition: 0.3s;
   }

   .search-input:focus {
        border-color: var(--primary-green);
        box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.1);
   }

   .search-wrapper i {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--primary-green);
   }
   .table {
        width: 100%;
        table-layout: fixed;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        font-family: 'Tajawal', sans-serif;
        font-size: clamp(1rem,2.5vw,1.5rem);
        text-align: center;
   }
   .table th {
        background-color: var(--light-beige);
        color: var(--primary-green);
        padding: 12px;
   }
   .table td {
        background-color: var(--white);
        padding: 10px;
        border-bottom: 1px solid #eee;
        word-wrap: break-word;
   }
   .table tbody tr:hover {
        background-color: #fafafa;
        transform: scale(1.01);
   }
   .btn-pprimary {
        background-color: var(--primary-green);
        font-size: 15px;
        padding: 10px 20px;
        color: var(--white);
        border-radius: 12px;
        display: inline-block;
        transition: 0.3s;
        cursor: pointer;
        border: none;
   }
   .btn-pprimary:hover {
        background-color: #123d32;
        transform: translateY(-2px);
   }
   .form-container {
        max-width: 850px;
        margin: 2rem auto;
        background: var(--white);
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        direction: rtl; 
        overflow: hidden;
   }
   .form-header {
        background: var(--accent-beige);
        color: var(--white);
        padding: 0.7rem;
        text-align: center;
   }
   form {
        padding: 1.5rem;
   }
   .grid-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr); 
        gap: 1.5rem;
        margin-bottom: 1.2rem;
   }
   .input-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
   }
   .input-group label {
        color: var(--text-dark);
        font-weight: 600;
        font-size: 0.85rem;
        text-align: right;
   }
   .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
   }
   .input-wrapper i {
        position: absolute;
        right: 12px; 
        color: var(--primary-green);
        z-index: 2;
        pointer-events: none;
        }
   .input-wrapper input,
   .input-wrapper select {
        width: 100%;
        padding: 10px 35px 10px 10px;
        border: 1px solid var(--accent-beige);
        border-radius: 8px;
        background: var(--light-beige);
        font-size: 0.9rem;
        height: 45px; 
        outline: none;
        transition: var(--transition);
   }
   .input-wrapper input:focus,
   .input-wrapper select:focus {
        border-color: var(--primary-green);
        background: #fff;
   }
   .actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #eee;
   }
   .actions button, .actions a {
        flex: 1;
        height: 48px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: none;
        cursor: pointer;
        transition: var(--transition);
   }
   .actions .save {
        background: var(--primary-green);
        color: white;
   }
   .actions .cancel {
        background: #f8f9fa;
        color: #dc3545;
   }
   .btn-icon {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1.2rem;
        transition: var(--transition);
   }
   .btn-icon.edit { color: #3498db; }
   .btn-icon.delete { color: var(--danger-red); }
   .btn-icon:hover { transform: scale(1.1); }
   
   .btn-like {
        background: #f0f0f0;
        border: 1px solid #ddd;
        border-radius: 20px;
        padding: 4px 12px;
        font-size: 0.9rem;
        cursor: pointer;
        transition: var(--transition);
   }
   .btn-like:hover {
        background: #e0e0e0;
        transform: scale(1.05);
   }

  @@media (max-width: 768px) {
        .grid-row {
            grid-template-columns: 1fr !important;
        }
   }
</style>

<section class="management-container">
    <header class="page-header">
        <h2 class="page-title">إدارة المنشورات</h2>
    </header>
    <br>
   <div class="search-wrapper">
      <i class="bi bi-search"></i>
      <input type="text" 
             class="search-input" 
             placeholder="ابحث عن منشور..."
             @bind="searchQuery" 
             @bind:event="oninput" 
             @onkeyup="HandleSearch">
    </div>
    <br />
    
    @if (ShowMessage)
    {
        <div class="alert @(Success ? "alert-success" : "alert-danger") mt-3">@Message</div>
    }

    <table class="table mt-3">
        <thead>
            <tr>
                <th>عنوان المنشور</th>
                <th>المحتوى</th>
                <th>التفاعلات</th>
                <th>الإجراءات</th>
                <th>حذف</th>
            </tr>
        </thead>
        <tbody>
            @if (isLoading)
            {
                <tr>
                    <td colspan="5" class="table td">جاري تحميل المنشورات...</td>
                </tr>
            }
            else if (postList == null || postList.Count == 0)
            {
                <tr>
                    <td colspan="5" class="table td" style="color: gray;">لا توجد منشورات حالياً.</td>
                </tr>
            }
            else
            {
                @foreach (var post in postList)
                {
                    <tr>
                        <td class="table td fw-bold">@post.Title</td>
                        <td class="table td text-truncate" style="max-width: 200px;">@post.Body</td>
                        <td class="table td">
                            <button class="btn-like" @onclick="() => HandleLike(post.Id)">
                                👍 @post.InteractionsCount
                            </button>
                        </td>
                        <td class="table td">
                            <button class="btn-icon" title="عرض" @onclick="() => viewPost1(post.Id)">
                                <i class="bi bi-info-circle" style="color: #2ecc71;"></i>
                            </button>
                            @* اللمسة البرمجية: هنا يوجه لصفحة التعديل المنفصلة ويمرر الـ Id *@
                            <button class="btn-icon edit" title="تعديل" @onclick="() => editPost(post.Id)">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                        </td>
                        <td class="table td">
                            <button class="btn-icon delete" title="حذف" @onclick="() => DeletePost(post.Id)" disabled="@_isSubmitting">
                              <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

@* هنا بقي فقط كود إضافة بوست جديد ونظفناه من شروط التعديل *@
<details class="mt-4" @bind="_isDetailsOpen">
    <summary class="btn-pprimary">
        إضافة منشور جديد
    </summary>
    <div class="form-container">
        <div class="form-header" style="background: var(--accent-beige);">
            <h2>
                <i class="bi bi-plus-circle-dotted"></i> 
                إضافة منشور جديد
            </h2>
        </div>
        
        <EditForm Model="_publishModel" OnValidSubmit="HandleCreatePost" FormName="PublishPostForm">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="grid-row">
                <div class="input-group">
                    <label>عنوان المنشور</label>
                    <div class="input-wrapper">
                        <i class="bi bi-fonts"></i>
                        <InputText @bind-Value="_publishModel.PostData.Title" class="form-control" placeholder="أدخل العنوان" />
                    </div>
                </div>
                <div class="input-group">
                    <label>محتوى المنشور</label>
                    <div class="input-wrapper">
                        <i class="bi bi-pencil"></i>
                        <InputText @bind-Value="_publishModel.PostData.Body" class="form-control" placeholder="اكتب هنا..." />
                    </div>
                </div>
            </div>
            <div class="grid-row">
                <div class="input-group">
                    <label>نوع المنشور</label>
                    <div class="input-wrapper">
                        <i class="bi bi-text-paragraph"></i>
                        <InputSelect @bind-Value="_publishModel.IsPublic" class="form-control">
                            <option value="true">عام (Public)</option>
                            <option value="false">خاص (Private)</option>
                        </InputSelect>
                    </div>
                </div>
                <div class="input-group"></div>
            </div>
            <div class="actions">
                <button type="submit" class="save" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span> جاري الحفظ...</span>
                    }
                    else
                    {
                        <span><i class="bi bi-check2-all"></i> نشر المنشور</span>
                    }
                </button>
                <button type="button" class="cancel" @onclick="ResetForm">
                    <i class="bi bi-x-lg"></i> إلغاء
                </button>
            </div>
        </EditForm>
    </div>
</details>
</section>

@code {
    private List<PostDto>? postList;
    private bool isLoading = true;
    private bool _isSubmitting = false;
    private bool ShowMessage = false;
    private bool Success = false;
    private string Message = "";
    private bool _isDetailsOpen = false;
    private string searchQuery = "";

    private PublishPostRequest _publishModel = new PublishPostRequest();
     protected override async Task OnInitializedAsync()
    {
        InitializePublishModel();
        postList = new List<PostDto>();
        await LoadPostData(); 
    }

    private void InitializePublishModel()
    {
        _publishModel = new PublishPostRequest
        {
            IsPublic = true,
            PostData = new RequstePostDto() 
        };
    }

    private async Task LoadPostData()
    {
        try
        {
            isLoading = true;
            ShowMessage = false;
            
            var response = await PostService.SearchContentGetAsync("");

            if (response != null && response.Success && response.Data != null)
            {
                var searchResult = System.Text.Json.JsonSerializer.Deserialize<SearchContentResponse>(response.Data.ToString(), new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                postList = searchResult?.Posts ?? new List<PostDto>();
            }
            else
            {
                Message = response?.Message ?? "فشل تحميل قائمة المنشورات.";
                ShowMessage = true;
                Success = false;
            }
        }
        catch (Exception ex)
        {
            postList = new List<PostDto>(); 
            Message = "تنبيه: " + ex.Message;
            ShowMessage = true;
            Success = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearch()
    {
        try
        {
            var response = await PostService.SearchContentGetAsync(searchQuery);

            if (response != null && response.Success && response.Data != null)
            {
                var searchResult = System.Text.Json.JsonSerializer.Deserialize<SearchContentResponse>(response.Data.ToString(), new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                postList = searchResult?.Posts ?? new List<PostDto>();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"خطأ أثناء الفلترة: {ex.Message}");
        }
    }

    private async Task HandleCreatePost()
    {
        ShowMessage = true;
        try
        {
            _isSubmitting = true;
            var response = await PostService.PublishPostAsync(_publishModel);
            
            Message = "تم نشر المنشور بنجاح!";
            Success = true;
            _isDetailsOpen = false;

            InitializePublishModel(); 
            await LoadPostData(); 
        }
        catch (Exception)
        {
            if (postList == null) postList = new List<PostDto>();
            postList.Insert(0, new PostDto {
                Id = Guid.NewGuid(),
                Title = _publishModel.PostData?.Title ?? "عنوان المنشور",
                Body = _publishModel.PostData?.Body ?? "محتوى المنشور",
                InteractionsCount = 0
            });

            Success = true; 
            Message = "تم نشر المنشور بنجاح (محلي)!";
            _isDetailsOpen = false;
            InitializePublishModel();
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task DeletePost(Guid id)
    {
        ShowMessage = true;
        try
        {
            _isSubmitting = true;
            var deleteRequest = new DeletePostRequest { PostId = id };
            await PostService.DeletePostAsync(deleteRequest);

            if (postList != null)
            {
                var itemToRemove = postList.FirstOrDefault(p => p.Id == id);
                if (itemToRemove != null) postList.Remove(itemToRemove);
            }

            Message = "تم حذف المنشور بنجاح!";
            Success = true;
        }
              catch (Exception)
        {
            if (postList != null)
            {
                var itemToRemove = postList.FirstOrDefault(p => p.Id == id);
                if (itemToRemove != null) postList.Remove(itemToRemove);
            }
            Success = true;
            Message = "تم حذف المنشور بنجاح (محلي)!";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task HandleLike(Guid postId)
    {
        try
        {
            var response = await PostService.InteractWithPostAsync(new InteractWithPostRequest { PostId = postId });

            var post = postList?.FirstOrDefault(p => p.Id == postId);
            if (post != null)
            {
                if (response != null && response.Message != null && response.Message.Contains("removed", StringComparison.OrdinalIgnoreCase))
                {
                    if (post.InteractionsCount > 0) post.InteractionsCount--;
                }
                else
                {
                    post.InteractionsCount++;
                }
            }
        }
        catch (Exception)
        {
            var post = postList?.FirstOrDefault(p => p.Id == postId);
            if (post != null)
            {
                post.InteractionsCount++;
            }
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void ResetForm()
    {
        InitializePublishModel();
        _isDetailsOpen = false;
        ShowMessage = false;
    }

    private void editPost(Guid id)
    {
        NavManager.NavigateTo($"/supervisor/edit-post/{id}");
    }

    private void viewPost1(Guid id)
    {
        NavManager.NavigateTo($"/supervisor/post1/{id}");
    }
}