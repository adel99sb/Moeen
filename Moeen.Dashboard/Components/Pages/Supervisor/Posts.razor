@page "/supervisor/posts"
@rendermode InteractiveServer
@using Moeen.Shared.Responses
@using Moeen.Shared.Requests.ContentSharing
@using Moeen.Shared.Responses.ContentSharing
@inject NavigationManager NavManager

<style>
   :root {
        --primary-green: #195042;
        --accent-beige: #d6cabc;
        --light-beige: #f4f1ee;
        --white: #ffffff;
        --text-dark: #2d3436;
        --status-green: #2ecc71;
        --danger-red: #e74c3c;
        --transition: all 0.3s ease;
   }
   body {
        font-family: 'Tajawal', sans-serif;
        background-color: #f9f9f9;
        direction: rtl;
   }
   .management-container {
        background: var(--white);
        margin: 20px;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
   }
   .page-title {
        color: var(--primary-green);
        position: relative;
        padding-bottom: 10px; 
        border-bottom: 3px solid #d6cabc; 
        display: inline-block; 
   }
   
   /* ستايل صندوق البحث المتناسق */
   .search-wrapper {
        position: relative;
        flex: 1;
        max-width: 400px;
   }
   .search-input {
        width: 100%;
        padding: 12px 45px 12px 15px;
        border: 1.5px solid var(--accent-beige);
        border-radius: 12px;
        outline: none;
        transition: 0.3s;
   }
   .search-input:focus {
        border-color: var(--primary-green);
        box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.1);
   }
   .search-wrapper i {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--primary-green);
   }

   .table {
        width: 100%;
        table-layout: fixed;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        font-family: 'Tajawal', sans-serif;
        font-size: clamp(1rem,2.5vw,1.5rem);
        text-align: center;
   }
   .table th {
        background-color: var(--light-beige);
        color: var(--primary-green);
        padding: 12px;
   }
   .table td {
        background-color: var(--white);
        padding: 10px;
        border-bottom: 1px solid #eee;
        word-wrap: break-word;
   }
   .table tbody tr:hover {
        background-color: #fafafa;
        transform: scale(1.01);
   }
   .btn-pprimary {
        background-color: var(--primary-green);
        font-size: 15px;
        padding: 10px 20px;
        color: var(--white);
        border-radius: 12px;
        display: inline-block;
        transition: 0.3s;
        cursor: pointer;
        border: none;
   }
   .btn-pprimary:hover {
        background-color: #123d32;
        transform: translateY(-2px);
   }
   .form-container {
        max-width: 850px;
        margin: 2rem auto;
        background: var(--white);
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        direction: rtl; 
        overflow: hidden;
   }
   .form-header {
        background: var(--accent-beige);
        color: var(--white);
        padding: 0.7rem;
        text-align: center;
   }
   form {
        padding: 1.5rem;
   }
   .grid-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr); 
        gap: 1.5rem;
        margin-bottom: 1.2rem;
   }
   .input-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
   }
   .input-group label {
        color: var(--text-dark);
        font-weight: 600;
        font-size: 0.85rem;
        text-align: right;
   }
   .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
   }
   .input-wrapper i {
        position: absolute;
        right: 12px; 
        color: var(--primary-green);
        z-index: 2;
        pointer-events: none;
   }
   .input-wrapper input,
    .input-wrapper select {
        width: 100%;
        padding: 10px 35px 10px 10px;
        border: 1px solid var(--accent-beige);
        border-radius: 8px;
        background: var(--light-beige);
        font-size: 0.9rem;
        height: 45px; 
        outline: none;
        transition: var(--transition);
   }
   .input-wrapper input:focus,
   .input-wrapper select:focus {
        border-color: var(--primary-green);
        background: #fff;
   }
   .actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #eee;
   }
   .actions button, .actions a {
        flex: 1;
        height: 48px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: none;
        cursor: pointer;
        transition: var(--transition);
   }
   .actions .save {
        background: var(--primary-green);
        color: white;
   }
   .actions .cancel {
        background: #f8f9fa;
        color: #dc3545;
   }
   .btn-icon {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1.2rem;
        transition: var(--transition);
   }
   .btn-icon.edit { color: #3498db; }
   .btn-icon.delete { color: var(--danger-red); }
   .btn-icon:hover { transform: scale(1.1); }

   @@media (max-width: 768px) {
        .grid-row {
            grid-template-columns: 1fr !important;
        }
   }
</style>

<section class="management-container">
    <header class="page-header">
        <h2 class="page-title">إدارة المنشورات</h2>
    </header>
    <br />
    
    <div class="search-wrapper">
        <i class="bi bi-search"></i>
        <input type="text" class="search-input" placeholder="ابحث عن منشور بالاسم أو المحتوى..." @oninput="HandleSearch">
    </div>
    <br />

    @if (ShowMessage)
    {
        if (Success)
        {
            <div class="alert alert-success mt-3">@Message</div>
        }
        else
        {
            <div class="alert alert-danger mt-3">@Message</div>
        }
    }

    <table class="table mt-3">
        <thead>
            <tr>
                <th>عنوان المنشور</th>
                <th>المحتوى</th>
                <th>التفاعلات</th>
                <th>الإجراءات</th>
                <th>حذف</th>
            </tr>
        </thead>
        <tbody>
            @if (isLoading)
            {
                <tr>
                    <td colspan="5" class="table td">جاري تحميل المنشورات...</td>
                </tr>
            }
            /* القراءة والعرض صاروا من القائمة المصفاة filteredPostList */
            else if (filteredPostList == null || filteredPostList.Count == 0)
            {
                <tr>
                    <td colspan="5" class="table td" style="color: gray;">لا توجد منشورات تطابق البحث حالياً.</td>
                </tr>
            }
            else
            {
                @foreach (var post in filteredPostList)
                {
                    <tr>
                        <td class="table td fw-bold">@post.Title</td>
                        <td class="table td text-truncate" style="max-width: 200px;">@post.Body</td>
                        <td class="table td"><span class="badge bg-secondary">👍 @post.InteractionsCount</span></td>
                        <td class="table td">
                            <button class="btn-icon" title="عرض" @onclick="() => viewPost1(post.Id)">
                                <i class="bi bi-info-circle" style="color: #2ecc71;"></i>
                            </button>
                            <button class="btn-icon edit" title="تعديل" @onclick="() => EnableEditMode(post)">
                                <i class="bi bi-pencil-square"></i>
 </button>
                        </td>
                        <td class="table td">
                            <button class="btn-icon delete" title="حذف" @onclick="() => DeletePost(post.Id)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <details class="mt-4" open="@_isDetailsOpen">
        <summary class="btn-pprimary">
            @(isEditMode ? "تعديل المنشور الحالي" : "إضافة منشور جديد")
        </summary>
        <div class="form-container">
            <div class="form-header">
                <h2>
                    <i class="@(isEditMode ? "bi bi-pencil-square" : "bi bi-plus-circle-dotted")"></i> 
                    @(isEditMode ? "تعديل المنشور" : "إضافة منشور جديد")
                </h2>
            </div>
            <EditForm Model="_publishModel" OnValidSubmit="HandleSubmit" FormName="PublishPostForm">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="grid-row">
                    <div class="input-group">
                        <label>عنوان المنشور</label>
                        <div class="input-wrapper">
                            <i class="bi bi-fonts"></i>
                            <InputText @bind-Value="_publishModel.PostData.Title" class="form-control" placeholder="أدخل العنوان" />
                        </div>
                    </div>
                    <div class="input-group">
                        <label>محتوى المنشور</label>
                        <div class="input-wrapper">
                            <i class="bi bi-pencil"></i>
                            <InputText @bind-Value="_publishModel.PostData.Body" class="form-control" placeholder="اكتب هنا..." />
                        </div>
                    </div>
                </div>
                <div class="grid-row">
                    <div class="input-group">
                        <label>نوع المنشور</label>
                        <div class="input-wrapper">
                            <i class="bi bi-text-paragraph"></i>
                            <InputSelect @bind-Value="_publishModel.IsPublic" class="form-control">
                                <option value="true">عام (Public)</option>
                                <option value="false">خاص (Private)</option>
                            </InputSelect>
                        </div>
                    </div>
                    <div class="input-group"></div>
                </div>
                <div class="actions">
                    <button type="submit" class="save">
                        <span>
                            <i class="bi bi-check2-all"></i> 
                            @(isEditMode ? "حفظ التعديلات" : "نشر")
                        </span>
                    </button>
                    <button type="button" class="cancel" @onclick="ResetForm"><i class="bi bi-x-lg"></i> إلغاء</button>
                </div>
            </EditForm>
        </div>
    </details>
</section>

@code {
    // فصل القوائم ليدعم نظام التصفية والبحث الكفؤ
    private List<PostDto> masterPostList = new();
    private List<PostDto> filteredPostList = new();
    
    private bool isLoading = true;
    private bool ShowMessage = false;
    private bool Success = false;
    private string Message = "";
    private bool _isDetailsOpen = false;

    private bool isEditMode = false;
    private Guid selectedPostId;
    private string searchQuery = "";

    private PublishPostRequest _publishModel = new PublishPostRequest();

    protected override async Task OnInitializedAsync()
    {
        InitializePublishModel();
 // تثبيت المنشورات الأساسية في القائمة الأصلية
        masterPostList = new List<PostDto>
        {
            new PostDto { Id = Guid.NewGuid(), Title = "أهمية القراءة", Body = "تعليم وتثقيف المجتمع", InteractionsCount = 5 },
            new PostDto { Id = Guid.NewGuid(), Title = "منشور تجريبي", Body = "محتوى المنشور التجريبي لإدارة النظام", InteractionsCount = 0 }
        };
        
        // شحن القائمة المصفاة في البداية بكامل البيانات
        ApplyFilter();
        isLoading = false;
    }

    private void InitializePublishModel()
    {
        _publishModel = new PublishPostRequest
        {
            IsPublic = true,
            PostData = new RequstePostDto() 
        };
    }

    private void HandleSubmit()
    {
        if (isEditMode)
        {
            HandleUpdatePost();
        }
        else
        {
            HandleCreatePost();
        }
    }

    // 1. الإضافة المحلية مع دعم التحديث الفوري للبحث
    private void HandleCreatePost()
    {
        ShowMessage = true;

        var newPost = new PostDto
        {
            Id = Guid.NewGuid(),
            Title = string.IsNullOrEmpty(_publishModel.PostData?.Title) ? "عنوان افتراضي" : _publishModel.PostData.Title,
            Body = string.IsNullOrEmpty(_publishModel.PostData?.Body) ? "محتوى افتراضي" : _publishModel.PostData.Body,
            InteractionsCount = 0
        };
        
        masterPostList.Insert(0, newPost);

        Message = "تم نشر المنشور بنجاح!";
        Success = true;
        _isDetailsOpen = false;
        
        InitializePublishModel();
        ApplyFilter(); // تحديث البحث ليعكس الإضافة فوراً
        StateHasChanged();
    }

    private void EnableEditMode(PostDto post)
    {
        isEditMode = true;
        selectedPostId = post.Id;
        
        _publishModel.PostData.Title = post.Title;
        _publishModel.PostData.Body = post.Body;
        
        _isDetailsOpen = true; 
        ShowMessage = false;
        StateHasChanged();
    }

    // 2. التعديل المحلي مع دعم التحديث الفوري للبحث
    private void HandleUpdatePost()
    {
        ShowMessage = true;
        
        var postToUpdate = masterPostList.FirstOrDefault(p => p.Id == selectedPostId);
        if (postToUpdate != null)
        {
            postToUpdate.Title = _publishModel.PostData.Title;
            postToUpdate.Body = _publishModel.PostData.Body;
            
            Message = "تم تعديل المنشور بنجاح!";
            Success = true;
        }

        ResetForm(); 
        ApplyFilter(); // تحديث البحث ليعكس التعديل فوراً
        StateHasChanged();
    }

    // 3. الحذف المحلي مع دعم التحديث الفوري للبحث
    private void DeletePost(Guid id)
    {
        ShowMessage = true;
        var postToRemove = masterPostList.FirstOrDefault(p => p.Id == id);
        if (postToRemove != null)
        {
            masterPostList.Remove(postToRemove);
            Message = "تم حذف المنشور بنجاح!";
            Success = true;
        }
        
        if(isEditMode && selectedPostId == id) ResetForm(); 
        ApplyFilter(); // تحديث البحث ليعكس الحذف فوراً
        StateHasChanged();
    }

    // 4. ميثود معالجة إدخال نص البحث أثناء الكتابة
    private void HandleSearch(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        ApplyFilter();
    }

    // 5. ميثود الفلترة والتصفية الذكية
    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredPostList = new List<PostDto>(masterPostList);
        }
        else
        {
            filteredPostList = masterPostList
                .Where(p => (p.Title != null && p.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) || 
                            (p.Body != null && p.Body.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }
    }

    private void ResetForm()
    {
        InitializePublishModel();
        isEditMode = false;
        _isDetailsOpen = false;
        ShowMessage = false;
    }
 private void viewPost1(Guid id)
    {
        NavManager.NavigateTo($"/supervisor/post1/{id}");
    }
}