@page "/supervisor/posts"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Moeen.Dashboard.Components.Shared
@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Requests.ContentSharing
@using Moeen.Shared.Responses.ContentSharing
@inject IPostService PostService
@inject IJSRuntime JS

<style>
    .management-page { direction: rtl; color: #163f35; }
    .management-card { background: #fff; border: 1px solid rgba(25, 80, 66, 0.10); border-radius: 24px; padding: 28px; box-shadow: 0 22px 60px rgba(25, 80, 66, 0.08); }
    .management-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin-bottom: 24px; }
    .management-title { margin: 0; color: #195042; font-size: 1.65rem; font-weight: 900; letter-spacing: -0.04em; }
    .management-subtitle { margin: 7px 0 0; color: #7b7067; font-size: 0.95rem; }
    .management-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 22px; flex-wrap: wrap; }
    .search-wrapper { position: relative; width: min(100%, 450px); }
    .search-wrapper .bi { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: #195042; }
    .search-input { width: 100%; height: 48px; padding: 0 44px 0 16px; border: 1px solid #ddd5cc; border-radius: 15px; outline: none; background: #fbfaf8; color: #163f35; transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease; }
    .search-input:focus { border-color: #195042; background: #fff; box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.10); }
    .toolbar-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .btn-moeen-primary, .btn-moeen-light { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 0 17px; border-radius: 14px; border: 0; font-weight: 800; transition: transform 0.18s ease, background 0.18s ease; }
    .btn-moeen-primary { background: #195042; color: #fff; box-shadow: 0 14px 28px rgba(25, 80, 66, 0.18); }
    .btn-moeen-primary:hover:not(:disabled) { background: #123d32; transform: translateY(-1px); }
    .btn-moeen-light { background: #f4f1e8; color: #195042; border: 1px solid #e2dbd2; }
    .management-table-wrap { overflow-x: auto; border: 1px solid #eee8e0; border-radius: 18px; }
    .management-table { width: 100%; margin: 0; border-collapse: collapse; min-width: 1050px; }
    .management-table th { background: #f4f1e8; color: #195042; font-weight: 900; padding: 15px 18px; border-bottom: 1px solid rgba(25, 80, 66, 0.18); white-space: nowrap; text-align: center; }
    .management-table td { padding: 15px 18px; border-bottom: 1px solid #f1ece6; vertical-align: middle; color: #263f37; text-align: center; }
    .management-table tr:last-child td { border-bottom: 0; }
    .management-table tbody tr:hover td { background: #fbfaf8; }
    .name-cell { display: flex; align-items: center; gap: 12px; font-weight: 900; color: #163f35; text-align: right; }
    .entity-avatar { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 14px; background: #195042; color: #fff; font-size: 1rem; }
    .content-cell { max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .status-pill { display: inline-flex; align-items: center; justify-content: center; min-width: 72px; padding: 6px 10px; border-radius: 999px; font-weight: 900; }
    .status-pill.public { background: #e9f7ef; color: #027a48; }
    .status-pill.private { background: #eef4ff; color: #1849a9; }
    .row-actions { display: flex; justify-content: center; gap: 8px; }
    .icon-btn { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid #e2dbd2; border-radius: 12px; background: #fff; color: #195042; transition: transform 0.18s ease, background 0.18s ease; }
    .icon-btn:hover { background: #f4f1e8; transform: translateY(-1px); }
    .icon-btn.info { color: #039855; }
    .icon-btn.edit { color: #2563eb; }
    .icon-btn.danger { color: #b42318; }
    .state-card { padding: 22px; border: 1px solid #eee8e0; border-radius: 18px; background: #fff; color: #195042; }
    .dialog-backdrop { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 28px; background: rgba(9, 30, 24, 0.42); backdrop-filter: blur(7px); direction: rtl; }
    .dialog-panel { width: min(100%, 900px); max-height: calc(100vh - 56px); overflow: hidden; display: flex; flex-direction: column; border-radius: 26px; background: #fff; box-shadow: 0 30px 90px rgba(0, 0, 0, 0.24); }
    .dialog-header { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 24px 28px; border-bottom: 1px solid #eee8e0; background: linear-gradient(135deg, #f7f3ed 0%, #fff 100%); }
    .dialog-title { margin: 0; color: #195042; font-size: 1.25rem; font-weight: 900; }
    .dialog-subtitle { margin: 6px 0 0; color: #7b7067; font-size: 0.9rem; }
    .dialog-close { width: 42px; height: 42px; border: 0; border-radius: 14px; background: #f4f1e8; color: #195042; }
    .dialog-body { overflow-y: auto; padding: 26px 28px; }
    .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .form-field { display: flex; flex-direction: column; gap: 8px; }
    .form-field.full { grid-column: 1 / -1; }
    .form-field label { color: #195042; font-weight: 900; font-size: 0.9rem; }
    .form-control-moeen { width: 100%; min-height: 46px; border: 1px solid #ddd5cc; border-radius: 14px; padding: 0 14px; background: #fbfaf8; color: #163f35; outline: none; font-weight: 700; }
    textarea.form-control-moeen { min-height: 130px; padding-top: 12px; resize: vertical; }
    .form-control-moeen:focus { border-color: #195042; background: #fff; box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.10); }
    .dialog-footer { display: flex; justify-content: flex-start; gap: 12px; padding: 20px 28px 24px; border-top: 1px solid #eee8e0; }
    .dialog-error { margin-bottom: 16px; }
    @@media (max-width: 760px) { .management-card { padding: 20px; } .management-header { flex-direction: column; } .form-grid { grid-template-columns: 1fr; } .form-field.full { grid-column: auto; } .dialog-backdrop { padding: 12px; } }
</style>

<section class="management-page">
    <div class="management-card">
        <header class="management-header">
            <div>
                <h2 class="management-title">إدارة المنشورات</h2>
                <p class="management-subtitle">إنشاء وتعديل منشورات المسجد العامة أو منشورات الحلقات الخاصة.</p>
            </div>
            <button class="btn-moeen-primary" type="button" @onclick="OpenCreateDialogAsync" disabled="@_isLoading">
                <i class="bi bi-plus-circle"></i>
                <span>إضافة منشور جديد</span>
            </button>
        </header>

        <div class="management-toolbar">
            <div class="search-wrapper">
                <i class="bi bi-search"></i>
                <input class="search-input" value="@_searchText" placeholder="ابحث بالعنوان أو المحتوى أو الحلقة..." @oninput="HandleSearch" />
            </div>
            <div class="toolbar-actions">
                <button class="btn-moeen-light" type="button" @onclick="LoadPostsAsync" disabled="@_isLoading">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>تحديث</span>
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success">@_successMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }

        @if (_isLoading)
        {
            <div class="state-card d-flex align-items-center gap-3">
                <span class="spinner-border text-success" role="status"></span>
                <span>جاري تحميل المنشورات...</span>
            </div>
        }
        else
        {
            <div class="management-table-wrap">
                <table class="management-table">
                    <thead>
                        <tr>
                            <th>عنوان المنشور</th>
                            <th>المحتوى</th>
                            <th>النطاق</th>
                            <th>الحلقة</th>
                            <th>التفاعلات</th>
                            <th>تاريخ النشر</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredPosts.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">لا يوجد منشورات حالياً.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var post in FilteredPosts)
                            {
                                <tr>
                                    <td>
                                        <div class="name-cell">
                                            <span class="entity-avatar"><i class="bi bi-megaphone"></i></span>
                                            <span>@post.Title</span>
                                        </div>
                                    </td>
                                    <td class="content-cell" title="@post.Body">@Display(post.Body)</td>
                                    <td>
                                        @if (post.HalqaId.HasValue)
                                        {
                                            <span class="status-pill private">خاص</span>
                                        }
                                        else
                                        {
                                            <span class="status-pill public">عام</span>
                                        }
                                    </td>
                                    <td>@Display(post.HalqaName)</td>
                                    <td><span class="badge bg-secondary">👍 @post.InteractionsCount</span></td>
                                    <td>@(post.CreatedAt == default ? "—" : post.CreatedAt.ToString("yyyy-MM-dd"))</td>
                                    <td>
                                        <div class="row-actions">
                                            <button class="icon-btn info" type="button" title="عرض" @onclick="() => OpenDetailsDialog(post)">
                                                <i class="bi bi-info-circle"></i>
                                            </button>
                                            <button class="icon-btn edit" type="button" title="تعديل" @onclick="() => OpenEditDialog(post)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="icon-btn danger" type="button" title="حذف" @onclick="() => DeletePostAsync(post)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (_isDialogOpen)
    {
        <div class="dialog-backdrop" @onclick="CloseDialog">
            <div class="dialog-panel" @onclick:stopPropagation="true">
                <div class="dialog-header">
                    <div>
                        <h3 class="dialog-title">@(_isEditMode ? "تعديل المنشور" : "إضافة منشور جديد")</h3>
                        <p class="dialog-subtitle">أدخل العنوان والمحتوى وحدد النطاق، ثم اضغط حفظ.</p>
                    </div>
                    <button class="dialog-close" type="button" @onclick="CloseDialog"><i class="bi bi-x-lg"></i></button>
                </div>

                <div class="dialog-body">
                    @if (!string.IsNullOrWhiteSpace(_dialogError))
                    {
                        <div class="alert alert-danger dialog-error">@_dialogError</div>
                    }

                    <div class="form-grid">
                        <div class="form-field">
                            <label>عنوان المنشور</label>
                            <input class="form-control-moeen" @bind="_form.Title" placeholder="مثلاً: إعلان هام" />
                        </div>
                        <div class="form-field">
                            <label>رابط الصورة</label>
                            <input class="form-control-moeen" @bind="_form.ImageUrl" placeholder="اختياري" />
                        </div>

                        @if (!_isEditMode)
                        {
                            <div class="form-field">
                                <label>نوع المنشور</label>
                                <select class="form-control-moeen" @bind="_form.IsPublic">
                                    <option value="true">عام</option>
                                    <option value="false">خاص بحلقة</option>
                                </select>
                            </div>

                            @if (!_form.IsPublic)
                            {
                                <div class="form-field">
                                    <label>الحلقة</label>
                                    <select class="form-control-moeen" @bind="_form.HalqaId">
                                        <option value="">اختر الحلقة</option>
                                        @foreach (var halqa in _halqas)
                                        {
                                            <option value="@halqa.Id">@halqa.Name @(string.IsNullOrWhiteSpace(halqa.FoujName) ? string.Empty : $"- {halqa.FoujName}")</option>
                                        }
                                    </select>
                                </div>
                            }
                            else
                            {
                                <div class="form-field"></div>
                            }
                        }

                        <div class="form-field full">
                            <label>محتوى المنشور</label>
                            <textarea class="form-control-moeen" @bind="_form.Body" placeholder="اكتب محتوى المنشور هنا"></textarea>
                        </div>
                    </div>
                </div>

                <div class="dialog-footer">
                    <button class="btn-moeen-primary" type="button" @onclick="ApplyDialogAsync" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle"></i>
                        }
                        <span>حفظ</span>
                    </button>
                    <button class="btn-moeen-light" type="button" @onclick="CloseDialog" disabled="@_isSaving">
                        <i class="bi bi-x-lg"></i>
                        <span>إلغاء</span>
                    </button>
                </div>
            </div>
        </div>
    }

    <MemberDetailsDialog IsOpen="@_isDetailsOpen" Model="@_detailsModel" OnClose="CloseDetailsDialog" />
</section>

@code {
    private readonly List<PostDto> _posts = new();
    private List<HalqaBriefDto> _halqas = new();
    private PostFormModel _form = new();
    private MemberDetailsDialogModel _detailsModel = new();

    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isDialogOpen;
    private bool _isEditMode;
    private bool _isDetailsOpen;
    private string _searchText = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _dialogError;

    private List<PostDto> FilteredPosts => string.IsNullOrWhiteSpace(_searchText)
        ? _posts
        : _posts.Where(p =>
            (p.Title ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            (p.Body ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            (p.HalqaName ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            (p.MosqueName ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadPostsAsync();
        _isLoading = false;
        StateHasChanged();
    }

    private async Task LoadPostsAsync()
    {
        _errorMessage = null;

        try
        {
            var posts = await PostService.GetAllPostsAsync();
            _posts.Clear();
            _posts.AddRange(posts.OrderByDescending(p => p.CreatedAt));
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر تحميل المنشورات: {ex.Message}";
            _posts.Clear();
        }
    }

    private async Task LoadHalqasAsync()
    {
        try
        {
            _halqas = await PostService.GetHalqasBriefAsync();
        }
        catch
        {
            _halqas = new();
        }
    }

    private void HandleSearch(ChangeEventArgs args)
        => _searchText = args.Value?.ToString() ?? string.Empty;

    private async Task OpenCreateDialogAsync()
    {
        _successMessage = null;
        _dialogError = null;
        _isEditMode = false;
        _form = new PostFormModel { IsPublic = true };

        if (_halqas.Count == 0)
            await LoadHalqasAsync();

        _isDialogOpen = true;
    }

    private void OpenEditDialog(PostDto post)
    {
        _successMessage = null;
        _dialogError = null;
        _isEditMode = true;
        _form = new PostFormModel
        {
            Id = post.Id,
            Title = post.Title,
            Body = post.Body,
            ImageUrl = post.ImageUrl,
            IsPublic = !post.HalqaId.HasValue,
            HalqaId = post.HalqaId
        };
        _isDialogOpen = true;
    }

    private void CloseDialog()
    {
        if (_isSaving)
            return;

        _isDialogOpen = false;
        _dialogError = null;
    }

    private async Task ApplyDialogAsync()
    {
        _isSaving = true;
        _dialogError = null;
        _successMessage = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_form.Title))
            {
                _dialogError = "يرجى إدخال عنوان المنشور.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_form.Body))
            {
                _dialogError = "يرجى إدخال محتوى المنشور.";
                return;
            }

            if (!_isEditMode && !_form.IsPublic && !_form.HalqaId.HasValue)
            {
                _dialogError = "يرجى اختيار الحلقة عند إنشاء منشور خاص.";
                return;
            }

            if (_isEditMode)
            {
                await PostService.UpdatePostAsync(new UpdatePostRequest
                {
                    PostId = _form.Id,
                    Title = _form.Title.Trim(),
                    Body = _form.Body.Trim(),
                    ImageUrl = string.IsNullOrWhiteSpace(_form.ImageUrl) ? null : _form.ImageUrl.Trim()
                });
            }
            else
            {
                await PostService.PublishPostAsync(new PublishPostRequest
                {
                    IsPublic = _form.IsPublic,
                    PostData = new RequstePostDto
                    {
                        Title = _form.Title.Trim(),
                        Body = _form.Body.Trim(),
                        ImageUrl = string.IsNullOrWhiteSpace(_form.ImageUrl) ? null : _form.ImageUrl.Trim(),
                        HalqaId = _form.IsPublic ? null : _form.HalqaId
                    }
                });
            }

            _successMessage = _isEditMode ? "تم تعديل المنشور بنجاح." : "تم نشر المنشور بنجاح.";
            _isDialogOpen = false;
            await LoadPostsAsync();
        }
        catch (Exception ex)
        {
            _dialogError = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeletePostAsync(PostDto post)
    {
        _successMessage = null;
        _errorMessage = null;

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"هل تريد حذف المنشور {post.Title}؟");
        if (!confirmed)
            return;

        try
        {
            await PostService.DeletePostAsync(new DeletePostRequest { PostId = post.Id });
            _successMessage = "تم حذف المنشور بنجاح.";
            await LoadPostsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void OpenDetailsDialog(PostDto post)
    {
        _detailsModel = new MemberDetailsDialogModel
        {
            Title = post.Title,
            Subtitle = post.HalqaId.HasValue ? "منشور خاص بحلقة" : "منشور عام",
            Sections = new List<MemberDetailsSectionModel>
            {
                new()
                {
                    Title = "بيانات المنشور",
                    Items = new List<MemberDetailsItemModel>
                    {
                        Item("العنوان", post.Title),
                        Item("النطاق", post.HalqaId.HasValue ? "خاص" : "عام"),
                        Item("المسجد", post.MosqueName),
                        Item("الحلقة", post.HalqaName),
                        Item("التفاعلات", post.InteractionsCount.ToString()),
                        Item("تاريخ النشر", post.CreatedAt == default ? null : post.CreatedAt.ToString("yyyy-MM-dd HH:mm")),
                        Item("رابط الصورة", post.ImageUrl)
                    }
                },
                new()
                {
                    Title = "المحتوى",
                    Items = new List<MemberDetailsItemModel>
                    {
                        Item("النص", post.Body)
                    }
                }
            }
        };

        _isDetailsOpen = true;
    }

    private void CloseDetailsDialog()
        => _isDetailsOpen = false;

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static MemberDetailsItemModel Item(string label, string? value)
        => new()
        {
            Label = label,
            Value = string.IsNullOrWhiteSpace(value) ? "—" : value
        };

    private sealed class PostFormModel
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Body { get; set; } = string.Empty;
        public string? ImageUrl { get; set; }
        public bool IsPublic { get; set; } = true;
        public Guid? HalqaId { get; set; }
    }
}
