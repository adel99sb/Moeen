            </div>
        </div>
    </div>

    @* Progress Summary Section *@
    <div class="progress-section">
        <div class="progress-section-header">
            <h5><i class="bi bi-graph-up ms-1"></i> ملخص ديسمبر 2024</h5>
        </div>
        <div class="progress-grid">
            <div class="progress-row">
                <div class="progress-row-header">
                    <span class="progress-row-label">نسبة إنجاز التسميع</span>
                    <span class="progress-row-value">85%</span>
                </div>
                <div class="progress-row-bar">
                    <div class="progress-row-bar-fill" style="width:85%;background:var(--primary)"></div>
                </div>
            </div>
            <div class="progress-row">
                <div class="progress-row-header">
                    <span class="progress-row-label">نسبة إنجاز المراجعة</span>
                    <span class="progress-row-value">92%</span>
                </div>
                <div class="progress-row-bar">
                    <div class="progress-row-bar-fill" style="width:92%;background:var(--primary)"></div>
                </div>
            </div>
            <div class="progress-row">
                <div class="progress-row-header">
                    <span class="progress-row-label">متوسط التقدير</span>
