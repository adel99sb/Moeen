                        <div class="record-item"><span class="record-label">الدرجة</span><span class="record-value success">95/100</span></div>
                        <div class="record-item"><span class="record-label">التقدير</span><span class="record-value success"><span class="badge excellent">ممتاز</span></span></div>
                        <div class="record-item"><span class="record-label">النقاط</span><span class="record-value success">+25</span></div>
                    </div>
                </div>

                @* Record: Memorization *@
                <div class="timeline-item" data-type="memorization" data-date="2024-12-08">
