<summary class="btn-pprimary">إضافة حلقة جديدة</summary>
 <div class="form-container">
    <div class="form-header">
        <h2><i class="bi bi-plus-circle-dotted"></i> إضافة حلقة</h2>
    </div>
                <form>
        <div class="grid-row">
            <div class="input-group">
         <label>اسم الحلقة </label>
                <div class="input-wrapper">
                    <i class="bi bi-fonts"></i>
                    <input type="text" placeholder="أدخل الاسم">
                </div>
                </div>
        <div class="input-group">
         <label>اسم معلم الحلقة </label>
