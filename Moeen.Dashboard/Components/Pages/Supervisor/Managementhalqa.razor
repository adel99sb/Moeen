@page "/supervisor/managementhalqa"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Moeen.Dashboard.Application.Services.Abstractions
@using Moeen.Dashboard.Components.Shared
@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Requests.Enrollment
@using Moeen.Shared.Requests.Fouj
@using Moeen.Shared.Requests.Halqa
@using Moeen.Shared.Responses.Enrollment
@using Moeen.Shared.Responses.Fouj
@using Moeen.Shared.Responses.Halqa
@inject IHalqaManagementService HalqaService
@inject IFoujManagementService FoujService
@inject IEnrollmentService EnrollmentService
@inject IJSRuntime JS

<style>
    .management-page { direction: rtl; color: #163f35; }
    .management-card { background: #fff; border: 1px solid rgba(25, 80, 66, 0.10); border-radius: 24px; padding: 28px; box-shadow: 0 22px 60px rgba(25, 80, 66, 0.08); }
    .management-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin-bottom: 24px; }
    .management-title { margin: 0; color: #195042; font-size: 1.65rem; font-weight: 900; letter-spacing: -0.04em; }
    .management-subtitle { margin: 7px 0 0; color: #7b7067; font-size: 0.95rem; }
    .tabs-navigation { display: flex; gap: 10px; margin-bottom: 24px; border-bottom: 2px solid #f4f1e8; }
    .tab-item { padding: 12px 22px; border: 0; background: transparent; color: #64746f; text-decoration: none; font-weight: 800; border-radius: 14px 14px 0 0; transition: 0.18s ease; }
    .tab-item.active { background: #195042; color: #fff; }
    .tab-item:hover:not(.active) { background: #f4f1e8; color: #195042; }
    .management-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 22px; flex-wrap: wrap; }
    .search-wrapper { position: relative; width: min(100%, 430px); }
    .search-wrapper .bi { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: #195042; }
    .search-input { width: 100%; height: 48px; padding: 0 44px 0 16px; border: 1px solid #ddd5cc; border-radius: 15px; outline: none; background: #fbfaf8; color: #163f35; transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease; }
    .search-input:focus { border-color: #195042; background: #fff; box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.10); }
    .toolbar-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .btn-moeen-primary, .btn-moeen-light { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 0 17px; border-radius: 14px; border: 0; font-weight: 800; transition: transform 0.18s ease, background 0.18s ease; }
    .btn-moeen-primary { background: #195042; color: #fff; box-shadow: 0 14px 28px rgba(25, 80, 66, 0.18); }
    .btn-moeen-primary:hover:not(:disabled) { background: #123d32; transform: translateY(-1px); }
    .btn-moeen-light { background: #f4f1e8; color: #195042; border: 1px solid #e2dbd2; }
    .management-table-wrap { overflow-x: auto; border: 1px solid #eee8e0; border-radius: 18px; }
    .management-table { width: 100%; margin: 0; border-collapse: collapse; min-width: 950px; }
    .management-table th { background: #f4f1e8; color: #195042; font-weight: 900; padding: 15px 18px; border-bottom: 1px solid rgba(25, 80, 66, 0.18); white-space: nowrap; text-align: center; }
    .management-table td { padding: 15px 18px; border-bottom: 1px solid #f1ece6; vertical-align: middle; color: #263f37; text-align: center; }
    .management-table tr:last-child td { border-bottom: 0; }
    .management-table tbody tr:hover td { background: #fbfaf8; }
    .name-cell { display: flex; align-items: center; gap: 12px; font-weight: 900; color: #163f35; text-align: right; }
    .entity-avatar { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 14px; background: #195042; color: #fff; font-size: 1rem; }
    .count-pill, .type-pill { display: inline-flex; align-items: center; justify-content: center; min-width: 42px; padding: 6px 10px; border-radius: 999px; background: #f4f1e8; color: #195042; font-weight: 900; }
    .type-pill { min-width: 70px; }
    .row-actions { display: flex; justify-content: center; gap: 8px; }
    .icon-btn { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid #e2dbd2; border-radius: 12px; background: #fff; color: #195042; transition: transform 0.18s ease, background 0.18s ease; }
    .icon-btn:hover { background: #f4f1e8; transform: translateY(-1px); }
    .icon-btn.info { color: #039855; }
    .icon-btn.edit { color: #2563eb; }
    .icon-btn.danger { color: #b42318; }
    .state-card { padding: 22px; border: 1px solid #eee8e0; border-radius: 18px; background: #fff; color: #195042; }
    .dialog-backdrop { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 28px; background: rgba(9, 30, 24, 0.42); backdrop-filter: blur(7px); direction: rtl; }
    .dialog-panel { width: min(100%, 760px); max-height: calc(100vh - 56px); overflow: hidden; display: flex; flex-direction: column; border-radius: 26px; background: #fff; box-shadow: 0 30px 90px rgba(0, 0, 0, 0.24); }
    .dialog-header { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 24px 28px; border-bottom: 1px solid #eee8e0; background: linear-gradient(135deg, #f7f3ed 0%, #fff 100%); }
    .dialog-title { margin: 0; color: #195042; font-size: 1.25rem; font-weight: 900; }
    .dialog-subtitle { margin: 6px 0 0; color: #7b7067; font-size: 0.9rem; }
    .dialog-close { width: 42px; height: 42px; border: 0; border-radius: 14px; background: #f4f1e8; color: #195042; }
    .dialog-body { overflow-y: auto; padding: 26px 28px; }
    .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .form-field { display: flex; flex-direction: column; gap: 8px; }
    .form-field-full { grid-column: 1 / -1; }
    .form-field label { color: #195042; font-weight: 900; font-size: 0.9rem; }
    .form-control-moeen { width: 100%; min-height: 46px; border: 1px solid #ddd5cc; border-radius: 14px; padding: 0 14px; background: #fbfaf8; color: #163f35; outline: none; font-weight: 700; }
    .form-control-moeen:focus { border-color: #195042; background: #fff; box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.10); }
    .student-selector { border: 1px solid #e2dbd2; border-radius: 18px; background: #fbfaf8; padding: 16px; display: flex; flex-direction: column; gap: 14px; }
    .student-selector-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .student-selector-toolbar .form-control-moeen { flex: 1 1 260px; }
    .selection-summary { color: #7b7067; font-size: 0.88rem; font-weight: 800; }
    .selected-chips { display: flex; flex-wrap: wrap; gap: 10px; }
    .selected-chip { display: inline-flex; align-items: center; gap: 8px; max-width: 100%; padding: 8px 12px; border-radius: 999px; background: #eef6f3; color: #195042; font-weight: 800; }
    .selected-chip button { width: 26px; height: 26px; border: 0; border-radius: 999px; background: #dcece7; color: #195042; }
    .student-list { max-height: 260px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding-left: 2px; }
    .student-option { display: flex; align-items: flex-start; gap: 12px; padding: 12px 14px; border: 1px solid #e8e1d7; border-radius: 14px; background: #fff; cursor: pointer; transition: border-color 0.18s ease, background 0.18s ease; }
    .student-option:hover { border-color: #c6d9d2; background: #fdfcf9; }
    .student-option input { margin-top: 4px; accent-color: #195042; }
    .student-option.disabled { opacity: 0.7; cursor: default; }
    .student-option-body { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .student-option-name { color: #163f35; font-weight: 900; }
    .student-option-meta { color: #7b7067; font-size: 0.88rem; overflow-wrap: anywhere; }
    .student-selector-state { padding: 18px; border: 1px dashed #d8d0c7; border-radius: 14px; background: #fff; color: #7b7067; text-align: center; }
    .dialog-footer { display: flex; justify-content: flex-start; gap: 12px; padding: 20px 28px 24px; border-top: 1px solid #eee8e0; }
    .dialog-error { margin-bottom: 16px; }
    @@media (max-width: 760px) { .management-card { padding: 20px; } .management-header { flex-direction: column; } .form-grid { grid-template-columns: 1fr; } .dialog-backdrop { padding: 12px; } .student-selector-toolbar { align-items: stretch; } }
</style>

<section class="management-page">
    <div class="management-card">
        <header class="management-header">
            <div>
                <h2 class="management-title">إدارة الأفواج والحلقات</h2>
                <p class="management-subtitle">إدارة الحلقات وربطها بالفوج والمعلم والطلاب من نفس الصفحة.</p>
            </div>
            <button class="btn-moeen-primary" type="button" @onclick="OpenCreateDialogAsync" disabled="@_isLoading">
                <i class="bi bi-plus-circle"></i>
                <span>إضافة حلقة جديدة</span>
            </button>
        </header>

        <nav class="tabs-navigation">
            <NavLink class="tab-item" href="/supervisor/managementfouj">إدارة الأفواج</NavLink>
            <NavLink class="tab-item" href="/supervisor/managementhalqa">إدارة الحلقات</NavLink>
        </nav>

        <div class="management-toolbar">
            <div class="search-wrapper">
                <i class="bi bi-search"></i>
                <input class="search-input" value="@_searchText" placeholder="ابحث باسم الحلقة أو الفوج أو المعلم..." @oninput="HandleSearch" />
            </div>
            <div class="toolbar-actions">
                <button class="btn-moeen-light" type="button" @onclick="LoadHalqasAsync" disabled="@_isLoading">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>تحديث</span>
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success">@_successMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }

        @if (_isLoading)
        {
            <div class="state-card d-flex align-items-center gap-3">
                <span class="spinner-border text-success" role="status"></span>
                <span>جار تحميل بيانات الحلقات...</span>
            </div>
        }
        else
        {
            <div class="management-table-wrap">
                <table class="management-table">
                    <thead>
                        <tr>
                            <th>اسم الحلقة</th>
                            <th>الفوج</th>
                            <th>المعلم</th>
                            <th>نوع الحلقة</th>
                            <th>عدد الطلاب</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredHalqas.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">لا يوجد حلقات حالياً.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var halqa in FilteredHalqas)
                            {
                                <tr>
                                    <td>
                                        <div class="name-cell">
                                            <span class="entity-avatar"><i class="bi bi-collection"></i></span>
                                            <span>@halqa.Name</span>
                                        </div>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(halqa.FoujName) ? GetFoujName(halqa.FoujId) : halqa.FoujName)</td>
                                    <td>@(string.IsNullOrWhiteSpace(halqa.TeacherName) ? GetTeacherName(halqa.TeacherId) : halqa.TeacherName)</td>
                                    <td><span class="type-pill">@(string.IsNullOrWhiteSpace(halqa.Type) ? "—" : halqa.Type)</span></td>
                                    <td><span class="count-pill">@halqa.StudentsCount</span></td>
                                    <td>
                                        <div class="row-actions">
                                            <button class="icon-btn info" type="button" title="عرض" @onclick="() => OpenDetailsDialog(halqa)">
                                                <i class="bi bi-info-circle"></i>
                                            </button>
                                            <button class="icon-btn edit" type="button" title="تعديل" @onclick="() => OpenEditDialogAsync(halqa)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="icon-btn danger" type="button" title="حذف" @onclick="() => DeleteHalqaAsync(halqa)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (_isDialogOpen)
    {
        <div class="dialog-backdrop" @onclick="CloseDialog">
            <div class="dialog-panel" @onclick:stopPropagation="true">
                <div class="dialog-header">
                    <div>
                        <h3 class="dialog-title">@(_isEditMode ? "تعديل بيانات الحلقة" : "إضافة حلقة جديدة")</h3>
                        <p class="dialog-subtitle">حدد الفوج والمعلم ونوع الحلقة، ثم اختر الطلاب واضغط حفظ.</p>
                    </div>
                    <button class="dialog-close" type="button" @onclick="CloseDialog"><i class="bi bi-x-lg"></i></button>
                </div>

                <div class="dialog-body">
                    @if (!string.IsNullOrWhiteSpace(_dialogError))
                    {
                        <div class="alert alert-danger dialog-error">@_dialogError</div>
                    }

                    <div class="form-grid">
                        <div class="form-field">
                            <label>اسم الحلقة</label>
                            <input class="form-control-moeen" @bind="_form.Name" placeholder="مثلاً: الحلقة الأولى" />
                        </div>
                        <div class="form-field">
                            <label>الفوج</label>
                            <select class="form-control-moeen" @bind="_form.FoujId">
                                <option value="@Guid.Empty">اختر الفوج</option>
                                @foreach (var fouj in _foujs)
                                {
                                    <option value="@fouj.Id">@fouj.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label>معلم الحلقة</label>
                            <select class="form-control-moeen" @bind="_form.TeacherId">
                                <option value="@Guid.Empty">اختر المعلم</option>
                                @foreach (var teacher in _teachers)
                                {
                                    <option value="@teacher.Id">@teacher.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label>نوع الحلقة</label>
                            <select class="form-control-moeen" @bind="_form.Type">
                                @foreach (var type in HalqaTypes)
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                        </div>
                        <div class="form-field form-field-full">
                            <label>الطلاب</label>
                            <div class="student-selector">
                                <div class="student-selector-toolbar">
                                    <input class="form-control-moeen" value="@_studentSearchText" placeholder="ابحث باسم الطالب أو بريده الإلكتروني" @oninput="HandleStudentSearch" />
                                    <span class="selection-summary">المحددون: @_form.SelectedStudentIds.Count طالب</span>
                                </div>

                                @if (_isStudentsLoading)
                                {
                                    <div class="student-selector-state d-flex align-items-center justify-content-center gap-3">
                                        <span class="spinner-border spinner-border-sm text-success" role="status"></span>
                                        <span>جار تحميل الطلاب...</span>
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(_studentLoadError))
                                {
                                    <div class="alert alert-warning mb-0">@_studentLoadError</div>
                                }
                                else if (_assignmentStudents.Count == 0)
                                {
                                    <div class="student-selector-state">لا يوجد طلاب متاحون لإسنادهم إلى هذه الحلقة حالياً.</div>
                                }
                                else
                                {
                                    @if (SelectedStudents.Count > 0)
                                    {
                                        <div class="selected-chips">
                                            @foreach (var student in SelectedStudents)
                                            {
                                                <span class="selected-chip">
                                                    <span>@student.Name</span>
                                                    <button type="button" @onclick="() => RemoveStudentSelection(student.Id)" disabled="@_isSaving">
                                                        <i class="bi bi-x"></i>
                                                    </button>
                                                </span>
                                            }
                                        </div>
                                    }

                                    <div class="student-list">
                                        @if (FilteredAssignmentStudents.Count == 0)
                                        {
                                            <div class="student-selector-state">لا توجد نتائج مطابقة للبحث.</div>
                                        }
                                        else
                                        {
                                            @foreach (var student in FilteredAssignmentStudents)
                                            {
                                                <label class="student-option">
                                                    <input type="checkbox"
                                                           checked="@_form.SelectedStudentIds.Contains(student.Id)"
                                                           @onchange="args => ToggleStudentSelection(student.Id, args.Value)"
                                                           disabled="@_isSaving" />
                                                    <div class="student-option-body">
                                                        <span class="student-option-name">@student.Name</span>
                                                        <span class="student-option-meta">@GetStudentSecondaryText(student)</span>
                                                    </div>
                                                </label>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="dialog-footer">
                    <button class="btn-moeen-primary" type="button" @onclick="ApplyDialogAsync" disabled="@(_isSaving || _isStudentsLoading)">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle"></i>
                        }
                        <span>حفظ</span>
                    </button>
                    <button class="btn-moeen-light" type="button" @onclick="CloseDialog" disabled="@_isSaving">
                        <i class="bi bi-x-lg"></i>
                        <span>إلغاء</span>
                    </button>
                </div>
            </div>
        </div>
    }

    <MemberDetailsDialog IsOpen="@_isDetailsOpen" Model="@_detailsModel" OnClose="CloseDetailsDialog" />
</section>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };
    private static readonly string[] HalqaTypes = ["غيبي", "حاضر", "مراجعة", "تلقين"];

    private readonly List<HalqaDto> _halqas = new();
    private List<FoujDto> _foujs = new();
    private List<TeacherDto> _teachers = new();
    private List<HalqaAssignmentStudentOptionDto> _assignmentStudents = new();
    private HalqaFormModel _form = new();
    private MemberDetailsDialogModel _detailsModel = new();

    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isDialogOpen;
    private bool _isEditMode;
    private bool _isDetailsOpen;
    private bool _isStudentsLoading;
    private string _searchText = string.Empty;
    private string _studentSearchText = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _dialogError;
    private string? _studentLoadError;

    private List<HalqaDto> FilteredHalqas => string.IsNullOrWhiteSpace(_searchText)
        ? _halqas
        : _halqas.Where(h =>
            (h.Name ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            (h.FoujName ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            (h.TeacherName ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            GetFoujName(h.FoujId).Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            GetTeacherName(h.TeacherId).Contains(_searchText, StringComparison.OrdinalIgnoreCase)).ToList();

    private List<HalqaAssignmentStudentOptionDto> FilteredAssignmentStudents => string.IsNullOrWhiteSpace(_studentSearchText)
        ? _assignmentStudents
        : _assignmentStudents.Where(student =>
            (student.Name ?? string.Empty).Contains(_studentSearchText, StringComparison.OrdinalIgnoreCase) ||
            (student.Email ?? string.Empty).Contains(_studentSearchText, StringComparison.OrdinalIgnoreCase)).ToList();

    private List<HalqaAssignmentStudentOptionDto> SelectedStudents => _assignmentStudents
        .Where(student => _form.SelectedStudentIds.Contains(student.Id))
        .OrderBy(student => student.Name)
        .ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadInitialDataAsync();
        StateHasChanged();
    }

    private async Task LoadInitialDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            await LoadFoujsAsync();
            await LoadTeachersAsync();
            await LoadHalqasAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadFoujsAsync()
    {
        try
        {
            var response = await FoujService.GetAllAsync(new GetAllFoujsRequest());
            if (response == null || !response.Success)
            {
                _foujs = new();
                return;
            }

            var json = JsonSerializer.Serialize(response.Data);
            _foujs = JsonSerializer.Deserialize<List<FoujDto>>(json, JsonOptions) ?? new();
        }
        catch
        {
            _foujs = new();
        }
    }

    private async Task LoadTeachersAsync()
    {
        try
        {
            var response = await EnrollmentService.GetAllTeachersAsync(new GetAllTeachersRequest
            {
                PageNumber = 1,
                PageSize = 300
            });

            if (response == null || !response.Success)
            {
                _teachers = new();
                return;
            }

            var json = JsonSerializer.Serialize(response.Data);
            _teachers = JsonSerializer.Deserialize<List<TeacherDto>>(json, JsonOptions) ?? new();
        }
        catch
        {
            _teachers = new();
        }
    }

    private async Task LoadHalqasAsync()
    {
        _errorMessage = null;

        try
        {
            var response = await HalqaService.GetAllAsync();
            if (response == null || !response.Success)
            {
                _errorMessage = response?.Message ?? "فشل تحميل الحلقات.";
                _halqas.Clear();
                return;
            }

            var json = JsonSerializer.Serialize(response.Data);
            var halqas = JsonSerializer.Deserialize<List<HalqaDto>>(json, JsonOptions) ?? new();

            _halqas.Clear();
            _halqas.AddRange(halqas.OrderBy(h => h.FoujName).ThenBy(h => h.Name));
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر تحميل الحلقات: {ex.Message}";
            _halqas.Clear();
        }
    }

    private async Task LoadAssignmentStudentsAsync(Guid? halqaId)
    {
        _isStudentsLoading = true;
        _studentLoadError = null;
        _studentSearchText = string.Empty;
        _assignmentStudents = new();
        _form.SelectedStudentIds.Clear();

        try
        {
            var response = await HalqaService.GetAssignmentStudentsAsync(halqaId);
            if (response == null || !response.Success)
            {
                _studentLoadError = response?.Message ?? "تعذر تحميل الطلاب المتاحين.";
                return;
            }

            var json = JsonSerializer.Serialize(response.Data);
            _assignmentStudents = JsonSerializer.Deserialize<List<HalqaAssignmentStudentOptionDto>>(json, JsonOptions) ?? new();

            foreach (var student in _assignmentStudents.Where(student => student.IsSelected))
                _form.SelectedStudentIds.Add(student.Id);
        }
        catch (Exception ex)
        {
            _studentLoadError = $"تعذر تحميل الطلاب: {ex.Message}";
        }
        finally
        {
            _isStudentsLoading = false;
        }
    }

    private void HandleSearch(ChangeEventArgs args)
    {
        _searchText = args.Value?.ToString() ?? string.Empty;
    }

    private void HandleStudentSearch(ChangeEventArgs args)
    {
        _studentSearchText = args.Value?.ToString() ?? string.Empty;
    }

    private async Task OpenCreateDialogAsync()
    {
        _successMessage = null;
        _dialogError = null;
        _isEditMode = false;
        _form = new HalqaFormModel
        {
            FoujId = _foujs.FirstOrDefault()?.Id ?? Guid.Empty,
            TeacherId = _teachers.FirstOrDefault()?.Id ?? Guid.Empty,
            Type = HalqaTypes.First()
        };
        _isDialogOpen = true;
        await LoadAssignmentStudentsAsync(null);
    }

    private async Task OpenEditDialogAsync(HalqaDto halqa)
    {
        _successMessage = null;
        _dialogError = null;
        _isEditMode = true;
        _form = new HalqaFormModel
        {
            Id = halqa.Id,
            Name = halqa.Name,
            FoujId = halqa.FoujId,
            TeacherId = halqa.TeacherId,
            Type = string.IsNullOrWhiteSpace(halqa.Type) ? HalqaTypes.First() : halqa.Type
        };
        _isDialogOpen = true;
        await LoadAssignmentStudentsAsync(halqa.Id);
    }

    private void CloseDialog()
    {
        if (_isSaving)
            return;

        _isDialogOpen = false;
        _dialogError = null;
        _studentLoadError = null;
        _studentSearchText = string.Empty;
    }

    private void ToggleStudentSelection(Guid studentId, object? value)
    {
        var isSelected = value is bool selected && selected;

        if (isSelected)
            _form.SelectedStudentIds.Add(studentId);
        else
            _form.SelectedStudentIds.Remove(studentId);
    }

    private void RemoveStudentSelection(Guid studentId)
    {
        _form.SelectedStudentIds.Remove(studentId);
    }

    private async Task ApplyDialogAsync()
    {
        _isSaving = true;
        _dialogError = null;
        _successMessage = null;

        try
        {
            if (_isStudentsLoading)
            {
                _dialogError = "يرجى الانتظار حتى يكتمل تحميل الطلاب.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_form.Name))
            {
                _dialogError = "يرجى إدخال اسم الحلقة.";
                return;
            }

            if (_form.FoujId == Guid.Empty)
            {
                _dialogError = "يرجى اختيار الفوج.";
                return;
            }

            if (_form.TeacherId == Guid.Empty)
            {
                _dialogError = "يرجى اختيار معلم الحلقة.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_form.Type))
            {
                _dialogError = "يرجى اختيار نوع الحلقة.";
                return;
            }

            var selectedStudentIds = _form.SelectedStudentIds.ToList();

            var response = _isEditMode
                ? await HalqaService.UpdateAsync(new UpdateHalqaRequest
                {
                    HalqaId = _form.Id,
                    Name = _form.Name,
                    FoujId = _form.FoujId,
                    TeacherId = _form.TeacherId,
                    Type = _form.Type,
                    StudentIds = selectedStudentIds
                })
                : await HalqaService.CreateAsync(new CreateHalqaRequest
                {
                    Name = _form.Name,
                    FoujId = _form.FoujId,
                    TeacherId = _form.TeacherId,
                    Type = _form.Type,
                    StudentIds = selectedStudentIds
                });

            if (response == null || !response.Success)
            {
                _dialogError = response?.Message ?? "فشل حفظ بيانات الحلقة.";
                return;
            }

            _successMessage = _isEditMode ? "تم تعديل بيانات الحلقة بنجاح." : "تم إضافة الحلقة بنجاح.";
            _isDialogOpen = false;
            await LoadHalqasAsync();
        }
        catch (Exception ex)
        {
            _dialogError = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteHalqaAsync(HalqaDto halqa)
    {
        _successMessage = null;
        _errorMessage = null;

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"هل تريد حذف الحلقة {halqa.Name}؟");
        if (!confirmed)
            return;

        try
        {
            var response = await HalqaService.DeleteAsync(new DeleteHalqaRequest { HalqaId = halqa.Id });
            if (response == null || !response.Success)
            {
                _errorMessage = response?.Message ?? "فشل حذف الحلقة.";
                return;
            }

            _successMessage = "تم حذف الحلقة بنجاح.";
            await LoadHalqasAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void OpenDetailsDialog(HalqaDto halqa)
    {
        var foujName = string.IsNullOrWhiteSpace(halqa.FoujName) ? GetFoujName(halqa.FoujId) : halqa.FoujName;
        var teacherName = string.IsNullOrWhiteSpace(halqa.TeacherName) ? GetTeacherName(halqa.TeacherId) : halqa.TeacherName;

        _detailsModel = new MemberDetailsDialogModel
        {
            Title = halqa.Name,
            Subtitle = "معلومات الحلقة",
            Sections = new List<MemberDetailsSectionModel>
            {
                new()
                {
                    Title = "البيانات الأساسية",
                    Items = new List<MemberDetailsItemModel>
                    {
                        Item("اسم الحلقة", halqa.Name),
                        Item("الفوج", foujName),
                        Item("المعلم", teacherName),
                        Item("نوع الحلقة", halqa.Type),
                        Item("عدد الطلاب", halqa.StudentsCount.ToString())
                    }
                }
            }
        };

        _isDetailsOpen = true;
    }

    private void CloseDetailsDialog()
        => _isDetailsOpen = false;

    private string GetFoujName(Guid foujId)
        => _foujs.FirstOrDefault(f => f.Id == foujId)?.Name ?? "—";

    private string GetTeacherName(Guid teacherId)
        => _teachers.FirstOrDefault(t => t.Id == teacherId)?.Name ?? "—";

    private static string GetStudentSecondaryText(HalqaAssignmentStudentOptionDto student)
    {
        if (!string.IsNullOrWhiteSpace(student.Email))
            return student.Email;

        return "لا يوجد بريد إلكتروني";
    }

    private static MemberDetailsItemModel Item(string label, string? value)
        => new()
        {
            Label = label,
            Value = string.IsNullOrWhiteSpace(value) ? "—" : value
        };

    private sealed class HalqaFormModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public Guid FoujId { get; set; }
        public Guid TeacherId { get; set; }
        public string Type { get; set; } = "غيبي";
        public HashSet<Guid> SelectedStudentIds { get; set; } = new();
    }
}
