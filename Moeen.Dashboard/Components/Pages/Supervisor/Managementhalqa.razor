@page "/supervisor/managementhalqa"
@inject NavigationManager NavManager
@rendermode InteractiveServer
<style>
           

            /* الكاردات */
            .card-container{
                display:flex;
                gap:20px;
                flex-wrap:wrap;

            }
           .card {
               flex:1 1 calc(50%-20px);
   
    grid-template-columns: repeat(2,1fr);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    padding: 20px;
    background-color: #efebe9;
    transition: var(--transition);
    align-content:center;
}

    .card:hover {
        transform: translateY(-5px);
            border-color: #195042;
    }
                /* اسم الفوج */
                .card h3 {
                    margin-bottom: 10px;
                    padding-right:10px;
                }

            /* الحلقات */
            .sessions {
                width:100%;
                margin-right:20px;
                padding-right:30px;
                background: #d6cabc;
                padding: 8px;
                font-size:20px;
                border-radius: 10px;
        border-color: #195042;
                margin-bottom: 3px;
            }
            .azrar{
                padding-right:30px;
            }
            .student-table{
                width:100%;
                border-collapse:collapse;
                margin-top:10px;
            }
            .student-table th{
                 background-color: var(--light-beige);
        color: var(--primary-green);
        padding: 12px;
        text-align: center;
        font-size: 30px;
            } 
            .student-table td{
        background-color: var(--white);

                border-bottom:1px solid #ccc;
                padding:8px;
                text-align:center;
                 font-family: 'Cairo', sans-serif;
        font-size: 25px;
            }
            
            .student-table tr:hover{
                  background-color: #fafafa;
        transform: scale(1.01);
            }
            .form-label{
                display:block;
                margin-bottom:5px;
                font-weight:bold;
            }
            .halqat-container{
                background:white;
            display:flex;
                flex-wrap:wrap;
                gap:10px;
                align-items:center;
            }
            .checkbox-item{
                display:flex;
                align-items:center;
                gap:5px;
                padding:5px 10px;
                border-radius:8px;
                cursor:pointer;
                font-size:20px;
            }
    </style>

<h3>Managementhalqa</h3>
