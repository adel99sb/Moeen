@page "/supervisor/edit/{Id}"
@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Requests.Identity
@inject NavigationManager NavManager
@rendermode InteractiveServer

<style>
    :root {
--primary-green: #195042;
--accent-beige: #d6cabc;
--light-beige: #f4f1ee;
--white: #ffffff;
--text-dark: #2d3436;
--status-green: #2ecc71;
--danger-red: #e74c3c;
}
body {
font-family: 'Tajawal', sans-serif;
background-color: #f9f9f9;
direction: rtl;
}
        .management-container {
background: var(--white);
margin: 20px;
padding: 30px;
border-radius: 20px;
box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}
/* العنوان */
.page-title {
color: var(--primary-green);
position: relative;
padding-bottom: 10px; 
border-bottom: 3px solid #d6cabc; 
display: inline-block; 
}
 
  .form-container, .form-container * {
        box-sizing: border-box;
    }

    .form-container {
        max-width: 850px;
        margin: 2rem auto;
        background: var(--white);
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        direction: rtl; 
        overflow: hidden;
    }

    .form-header {
        background: var(--accent-beige);
        color: var(--white);
        padding: 1.2rem;
        text-align: center;
    }

    form {
        padding: 2rem;
    }

    .grid-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr); 
        gap: 1.5rem;
        margin-bottom: 1.2rem;
    }
        .grid-row:nth-of-type(4) {
            grid-template-columns: repeat(3, 1fr);
        }

    .input-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .input-group label {
            color: var(--text-dark);
            font-weight: 600;
            font-size: 0.85rem;
            text-align: right;
        }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
    }

        .input-wrapper i {
            position: absolute;
            right: 12px; 
            color: var(--primary-green);
            z-index: 2;
            pointer-events: none;
        }

        .input-wrapper input,
        .input-wrapper select {
            width: 100%;
            padding: 10px 35px 10px 10px;
            border: 1px solid var(--accent-beige);
            border-radius: 8px;
            background: var(--light-beige);
            font-size: 0.9rem;
            height: 45px; 
            outline: none;
            transition: var(--transition);
        }

            .input-wrapper input:focus,
            .input-wrapper select:focus {
                border-color: var(--primary-green);
                background: #fff;
            }
    .actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #eee;
    }

        .actions button, .actions a {
            flex: 1;
            height: 48px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .actions .save {
            background: var(--primary-green);
            color: white;
        }
         .actions .parent {
            background: var(--accent-beige);
            color: white;
        }

        .actions .cancel {
            background: #f8f9fa;
            color: #dc3545;
        }

    @@media (max-width: 768px) {
    .grid-row, .grid-row:nth-of-type(4) {
        grid-template-columns: 1fr !important;
    }
  }
</style>

<section class="management-container">
    <header class="page-header">
      <h2 class="page-title">تعديل معلومات طالب</h2>
    </header>
   
    <div class="form-container">
        <div class="form-header">
            <h2><i class="bi bi-pencil"></i> تعديل المعلومات</h2>
        </div>
        
        <EditForm Model="editModel" OnValidSubmit="HandleUpdate">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="grid-row">
                <div class="input-group">
                    <label>الاسم الكامل</label>
                    <div class="input-wrapper">
                        <i class="bi bi-person"></i>
                        <input type="text" @bind="editModel.Name" placeholder="أدخل الاسم">
                    </div>
                </div>
                <div class="input-group">
                    <label>رقم الهاتف</label>
                    <div class="input-wrapper">
                        <i class="bi bi-telephone"></i>
                        <input type="tel" @bind="editModel.PhoneNumber" placeholder="أدخل رقم الهاتف">
                    </div>
                </div>
            </div>

            <div class="grid-row">
                <div class="input-group">
                    <label>تاريخ التسجيل</label>
                    <div class="input-wrapper">
                        <i class="bi bi-calendar-event"></i>
                        <input type="date" @bind="editModel.Date" placeholder="أدخل تاريخ التسجيل">
                    </div>
                </div>
                <div class="input-group">
                    <label>تاريخ الميلاد</label>
                    <div class="input-wrapper">
                        <i class="bi bi-calendar-event"></i>
                        <input type="date" @bind="editModel.Birthday" placeholder="أدخل تاريخ الميلاد">
                    </div>
                </div> 
            </div>

            <div class="grid-row">
                <div class="input-group">
                    <label>العنوان</label>
                    <div class="input-wrapper">
                        <i class="bi bi-alphabet"></i>
                        <input type="text" @bind="editModel.Address" placeholder="أدخل العنوان">
                    </div>
                </div>
                <div class="input-group">
                    <label>البريد الإلكتروني</label>
                    <div class="input-wrapper">
                        <i class="bi bi-envelope"></i>
                        <input type="email" @bind="editModel.Email" placeholder="أدخل البريد الالكتروني">
                    </div>
                </div>
            </div>

            <div class="grid-row">
                <div class="input-group">
                    <label>الجامع التابع له</label>
                    <div class="input-wrapper">
                        <i class="bi bi-houses"></i>
                        <input type="text" @bind="editModel.Musqe" placeholder="أدخل اسم الجامع">
                    </div>
                </div>
                <div class="input-group">
                    <label>الجنس</label>
                    <div class="input-wrapper">
                        <i class="bi bi-gender-ambiguous"></i>
                        <select @bind="editModel.Gender">
                            <option value="" disabled>اختر الجنس</option>
                            <option value="male">ذكر</option>
                            <option value="female">أنثى</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="grid-row">
                <div class="input-group">
                    <label>اسم ولي الأمر</label>
                    <div class="input-wrapper">
                        <i class="bi bi-person"></i>
                        <input type="text" @bind="editModel.NameParent" placeholder="أدخل الاسم">
                </div>
                </div>
                <div class="input-group">
                    <label>رقم ولي الأمر</label>
                    <div class="input-wrapper">
                        <i class="bi bi-telephone"></i>
                        <input type="tel" @bind="editModel.PhoneNumberParent" placeholder="أدخل رقم ولي الامر">
                    </div>
                </div>
            </div>

            <div class="grid-row">
                <div class="input-group">
                    <label>الفوج</label>
                    <div class="input-wrapper">
                        <i class="bi bi-layers"></i>
                        <select @bind="editModel.Fouj">
                            <option value="الفوج الأول">الفوج الأول</option>
                            <option value="الفوج الثاني">الفوج الثاني</option>
                        </select>
                    </div>
                </div>
                <div class="input-group">
                    <label>الحلقة</label>
                    <div class="input-wrapper">
                        <i class="bi bi-layers"></i>
                        <select @bind="editModel.Halaqa">
                            <option value="الحلقة الاولى">الحلقة الاولى</option>
                            <option value="الحلقة الثانية">الحلقة الثانية</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="grid-row">
                <div class="input-group">
                    <label>حالة الحساب</label>
                    <div class="input-wrapper">
                        <i class="bi bi-check-circle"></i>
                        <select @bind="editModel.HaltHesab">
                            <option value="active">نشط</option>
                            <option value="inactive">متوقف</option>
                        </select>
                    </div>
                </div>
                <div class="input-group">
                    <label>كلمة المرور جديدة (اختياري)</label>
                    <div class="input-wrapper">
                        <i class="bi bi-lock"></i>
                        <input type="password" @bind="editModel.Password" placeholder="أدخل كلمة مرور جديدة إذا أردت تغييرها">
                    </div>
                </div>
            </div>

            <div class="actions">
                <button type="submit" class="save"><i class="bi bi-check2-all"></i> حفظ التعديلات</button>
                <button type="button" class="parent"><i class="bi bi-link-45deg"></i> ربط بولي الأمر</button>
                <a href="/supervisor/student" class="cancel"><i class="bi bi-x-lg"></i> إلغاء</a>
            </div>
        </EditForm>
    </div>
</section>

@code {
    [Parameter] public string Id { get; set; }
    
    // نستخدم نفس كلاس الـ RegisterRequest أو كلاس مخصص للتعديل إذا كان موجوداً لديكِ (مثل UpdateStudentRequest)
    private RegisterRequest editModel = new RegisterRequest();

    protected override async Task OnInitializedAsync()
    {
        // هنا نقوم بجلب بيانات الطالب الحالية من الباك إند باستخدام المعرف (Id)
        if (!string.IsNullOrEmpty(Id))
        {
            Console.WriteLine($"تحميل بيانات الطالب صاحب المعرف: {Id}");
            // مثال للربط الحقيقي:
            // var response = await UserService.GetStudentById(Id);
            // if(response.Success) editModel = response.Data;
        }
    }

    private async Task HandleUpdate()
    {
        Console.WriteLine($"تحديث بيانات الطالب الحالية للمعرف: {Id}");
        // هنا نقوم باستدعاء خدمة التعديل من الباك إند
        // var response = await UserService.UpdateStudent(Id, editModel);
        // if(response.Success) NavManager.NavigateTo("/supervisor/student");
        
        NavManager.NavigateTo("/supervisor/student"); // العودة للقائمة بعد الحفظ
    }
}
