@page "/supervisor/book"
<h3>Book</h3>
<style>
	.btn-pprimary {
		background-color: var(--primary-green);
		font-size: 15px;
		padding: 10px 20px;
		color: var(--white);
		border-radius: 12px;
		transition: 0.3s;
	}

		.btn-pprimary:hover {
			background-color: #123d32;
			transform: translateY(-2px);
		}
</style>
<header class="page-header">
	<h2 class="page-title">إدارة الكتب</h2>
</header>
<br />
<div class="search-wrapper">
	<i class="bi bi-search"></i>
	<input type="text" class="search-input" placeholder="ابحث عن كتاب...">
</div>
<br>
<table class="table">
	<thead>
		<tr>
			<th class="table th">اسم الكتاب</th>
			<th class="table th">وصف</th>
			<th class="table th">رابط التحميل </th>
		</tr>
	</thead>
	<br />

	<tbody>
		<tr>
			<td class="table td">كتاب التجويد </td>
			<td class="table td">كتاب لتعلم قواعد التجويد </td>
			<td class="table td">
				<a href="https://example.com/tafsir.pdf" target="_blank" title="تحميل"><i class="bi bi-save"></i></a>

			</td>
		</tr>
		<br />
		<tr>
			<td class="table td">كتاب التفسير </td>
			<td class="table td">كتاب لتعلم تفسير القرآن الكريم </td>
			<td class="table td">
				<a href="https://example.com/tafsir.pdf" target="_blank" title="تحميل"><i class="bi bi-save"></i></a>
			</td>
		</tr>
		</tbody>
		</table>
		<br />
		<details class="details">
	<summary class="btn-pprimary">إضافة كتاب جديد</summary>

		<br>

		<form class="form-box">
			<div class="form-group">
<label class="label">اسم الكتاب:</label><br>
<input class="input" placeholder="اكتب هنا..." type="text" name="name"><br><br>
	    	</div>
			<div class="form-group">
<label class="label">وصف الكتاب :</label><br>
<input class="input" placeholder="اكتب هنا..." type="text" name="name"><br><br>
             </div>
			 <div class="form-group">
<label class="label">رابط لتحميل الكتاب :</label><br>
<input class="input" placeholder="اكتب هنا..." type="text" name="name">
              </div>
		
		<br />
		<button class="btn-pprimary" type="submit"> <i class="bi bi-upload"></i></button>
</form>
</details>


@code {

}
