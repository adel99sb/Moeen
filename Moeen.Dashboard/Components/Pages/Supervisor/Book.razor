@page "/supervisor/book"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Moeen.Dashboard.Components.Shared
@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Requests.Library
@using Moeen.Shared.Responses.Library
@inject ILibraryManagementService LibraryService
@inject IJSRuntime JS

<style>
    .management-page { direction: rtl; color: #163f35; }
    .management-card { background: #fff; border: 1px solid rgba(25, 80, 66, 0.10); border-radius: 24px; padding: 28px; box-shadow: 0 22px 60px rgba(25, 80, 66, 0.08); }
    .management-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin-bottom: 24px; }
    .management-title { margin: 0; color: #195042; font-size: 1.65rem; font-weight: 900; letter-spacing: -0.04em; }
    .management-subtitle { margin: 7px 0 0; color: #7b7067; font-size: 0.95rem; }
    .management-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 22px; flex-wrap: wrap; }
    .search-wrapper { position: relative; width: min(100%, 430px); }
    .search-wrapper .bi { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: #195042; }
    .search-input { width: 100%; height: 48px; padding: 0 44px 0 16px; border: 1px solid #ddd5cc; border-radius: 15px; outline: none; background: #fbfaf8; color: #163f35; transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease; }
    .search-input:focus { border-color: #195042; background: #fff; box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.10); }
    .toolbar-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .btn-moeen-primary, .btn-moeen-light { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 0 17px; border-radius: 14px; border: 0; font-weight: 800; transition: transform 0.18s ease, background 0.18s ease; }
    .btn-moeen-primary { background: #195042; color: #fff; box-shadow: 0 14px 28px rgba(25, 80, 66, 0.18); }
    .btn-moeen-primary:hover:not(:disabled) { background: #123d32; transform: translateY(-1px); }
    .btn-moeen-light { background: #f4f1e8; color: #195042; border: 1px solid #e2dbd2; }
    .management-table-wrap { overflow-x: auto; border: 1px solid #eee8e0; border-radius: 18px; }
    .management-table { width: 100%; margin: 0; border-collapse: collapse; min-width: 980px; }
    .management-table th { background: #f4f1e8; color: #195042; font-weight: 900; padding: 15px 18px; border-bottom: 1px solid rgba(25, 80, 66, 0.18); white-space: nowrap; text-align: center; }
    .management-table td { padding: 15px 18px; border-bottom: 1px solid #f1ece6; vertical-align: middle; color: #263f37; text-align: center; }
    .management-table tr:last-child td { border-bottom: 0; }
    .management-table tbody tr:hover td { background: #fbfaf8; }
    .name-cell { display: flex; align-items: center; gap: 12px; font-weight: 900; color: #163f35; text-align: right; }
    .entity-avatar { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 14px; background: #195042; color: #fff; font-size: 1rem; }
    .link-pill { display: inline-flex; align-items: center; justify-content: center; gap: 7px; padding: 7px 12px; border-radius: 999px; background: #f4f1e8; color: #195042; text-decoration: none; font-weight: 900; }
    .link-pill:hover { color: #123d32; background: #eee7dd; }
    .description-cell { max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .row-actions { display: flex; justify-content: center; gap: 8px; }
    .icon-btn { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid #e2dbd2; border-radius: 12px; background: #fff; color: #195042; transition: transform 0.18s ease, background 0.18s ease; }
    .icon-btn:hover { background: #f4f1e8; transform: translateY(-1px); }
    .icon-btn.info { color: #039855; }
    .icon-btn.edit { color: #2563eb; }
    .icon-btn.danger { color: #b42318; }
    .state-card { padding: 22px; border: 1px solid #eee8e0; border-radius: 18px; background: #fff; color: #195042; }
    .dialog-backdrop { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 28px; background: rgba(9, 30, 24, 0.42); backdrop-filter: blur(7px); direction: rtl; }
    .dialog-panel { width: min(100%, 840px); max-height: calc(100vh - 56px); overflow: hidden; display: flex; flex-direction: column; border-radius: 26px; background: #fff; box-shadow: 0 30px 90px rgba(0, 0, 0, 0.24); }
    .dialog-header { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 24px 28px; border-bottom: 1px solid #eee8e0; background: linear-gradient(135deg, #f7f3ed 0%, #fff 100%); }
    .dialog-title { margin: 0; color: #195042; font-size: 1.25rem; font-weight: 900; }
    .dialog-subtitle { margin: 6px 0 0; color: #7b7067; font-size: 0.9rem; }
    .dialog-close { width: 42px; height: 42px; border: 0; border-radius: 14px; background: #f4f1e8; color: #195042; }
    .dialog-body { overflow-y: auto; padding: 26px 28px; }
    .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .form-field { display: flex; flex-direction: column; gap: 8px; }
    .form-field.full { grid-column: 1 / -1; }
    .form-field label { color: #195042; font-weight: 900; font-size: 0.9rem; }
    .form-control-moeen { width: 100%; min-height: 46px; border: 1px solid #ddd5cc; border-radius: 14px; padding: 0 14px; background: #fbfaf8; color: #163f35; outline: none; font-weight: 700; }
    textarea.form-control-moeen { min-height: 96px; padding-top: 12px; resize: vertical; }
    .form-control-moeen:focus { border-color: #195042; background: #fff; box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.10); }
    .dialog-footer { display: flex; justify-content: flex-start; gap: 12px; padding: 20px 28px 24px; border-top: 1px solid #eee8e0; }
    .dialog-error { margin-bottom: 16px; }
    @@media (max-width: 760px) { .management-card { padding: 20px; } .management-header { flex-direction: column; } .form-grid { grid-template-columns: 1fr; } .form-field.full { grid-column: auto; } .dialog-backdrop { padding: 12px; } }
</style>

<section class="management-page">
    <div class="management-card">
        <header class="management-header">
            <div>
                <h2 class="management-title">إدارة الكتب</h2>
                <p class="management-subtitle">إدارة كتب المكتبة وروابط التحميل بشكل منظم من نفس الصفحة.</p>
            </div>
            <button class="btn-moeen-primary" type="button" @onclick="OpenCreateDialog" disabled="@_isLoading">
                <i class="bi bi-plus-circle"></i>
                <span>إضافة كتاب جديد</span>
            </button>
        </header>

        <div class="management-toolbar">
            <div class="search-wrapper">
                <i class="bi bi-search"></i>
                <input class="search-input" value="@_searchText" placeholder="ابحث باسم الكتاب أو المؤلف..." @oninput="HandleSearch" />
            </div>
            <div class="toolbar-actions">
                <button class="btn-moeen-light" type="button" @onclick="LoadBooksAsync" disabled="@_isLoading">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>تحديث</span>
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success">@_successMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }

        @if (_isLoading)
        {
            <div class="state-card d-flex align-items-center gap-3">
                <span class="spinner-border text-success" role="status"></span>
                <span>جاري تحميل بيانات الكتب...</span>
            </div>
        }
        else
        {
            <div class="management-table-wrap">
                <table class="management-table">
                    <thead>
                        <tr>
                            <th>اسم الكتاب</th>
                            <th>المؤلف/الرافع</th>
                            <th>الوصف</th>
                            <th>سنة النشر</th>
                            <th>الرابط</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredBooks.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">لا يوجد كتب حالياً.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var book in FilteredBooks)
                            {
                                <tr>
                                    <td>
                                        <div class="name-cell">
                                            <span class="entity-avatar"><i class="bi bi-book"></i></span>
                                            <span>@book.Title</span>
                                        </div>
                                    </td>
                                    <td>@Display(book.Author)</td>
                                    <td class="description-cell" title="@book.Description">@Display(book.Description)</td>
                                    <td>@(book.PublicationYear?.ToString() ?? "—")</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(book.CoverImageUrl))
                                        {
                                            <a class="link-pill" href="@book.CoverImageUrl" target="_blank" rel="noopener noreferrer">
                                                <i class="bi bi-box-arrow-up-left"></i>
                                                <span>فتح</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="row-actions">
                                            <button class="icon-btn info" type="button" title="عرض" @onclick="() => OpenDetailsDialog(book)">
                                                <i class="bi bi-info-circle"></i>
                                            </button>
                                            <button class="icon-btn edit" type="button" title="تعديل" @onclick="() => OpenEditDialog(book)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="icon-btn danger" type="button" title="حذف" @onclick="() => DeleteBookAsync(book)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (_isDialogOpen)
    {
        <div class="dialog-backdrop" @onclick="CloseDialog">
            <div class="dialog-panel" @onclick:stopPropagation="true">
                <div class="dialog-header">
                    <div>
                        <h3 class="dialog-title">@(_isEditMode ? "تعديل بيانات الكتاب" : "إضافة كتاب جديد")</h3>
                        <p class="dialog-subtitle">أدخل بيانات الكتاب ورابط التحميل، ثم اضغط حفظ.</p>
                    </div>
                    <button class="dialog-close" type="button" @onclick="CloseDialog"><i class="bi bi-x-lg"></i></button>
                </div>

                <div class="dialog-body">
                    @if (!string.IsNullOrWhiteSpace(_dialogError))
                    {
                        <div class="alert alert-danger dialog-error">@_dialogError</div>
                    }

                    <div class="form-grid">
                        <div class="form-field">
                            <label>اسم الكتاب</label>
                            <input class="form-control-moeen" @bind="_form.Title" placeholder="مثلاً: كتاب التجويد" />
                        </div>
                        <div class="form-field">
                            <label>المؤلف/الرافع</label>
                            <input class="form-control-moeen" @bind="_form.Author" placeholder="اسم المؤلف أو الرافع" />
                        </div>
                        <div class="form-field">
                            <label>الناشر</label>
                            <input class="form-control-moeen" @bind="_form.Publisher" placeholder="اختياري" />
                        </div>
                        <div class="form-field">
                            <label>سنة النشر</label>
                            <input class="form-control-moeen" @bind="_form.PublicationYearText" placeholder="مثلاً: 2024" />
                        </div>
                        <div class="form-field">
                            <label>ISBN</label>
                            <input class="form-control-moeen" @bind="_form.ISBN" placeholder="اختياري" />
                        </div>
                        <div class="form-field">
                            <label>رابط الكتاب</label>
                            <input class="form-control-moeen" @bind="_form.Link" placeholder="https://example.com/book.pdf" />
                        </div>
                        <div class="form-field full">
                            <label>الوصف</label>
                            <textarea class="form-control-moeen" @bind="_form.Description" placeholder="وصف مختصر للكتاب"></textarea>
                        </div>
                    </div>
                </div>

                <div class="dialog-footer">
                    <button class="btn-moeen-primary" type="button" @onclick="ApplyDialogAsync" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle"></i>
                        }
                        <span>حفظ</span>
                    </button>
                    <button class="btn-moeen-light" type="button" @onclick="CloseDialog" disabled="@_isSaving">
                        <i class="bi bi-x-lg"></i>
                        <span>إلغاء</span>
                    </button>
                </div>
            </div>
        </div>
    }

    <MemberDetailsDialog IsOpen="@_isDetailsOpen" Model="@_detailsModel" OnClose="CloseDetailsDialog" />
</section>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    private readonly List<BookResponseDto> _books = new();
    private BookFormModel _form = new();
    private MemberDetailsDialogModel _detailsModel = new();

    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isDialogOpen;
    private bool _isEditMode;
    private bool _isDetailsOpen;
    private string _searchText = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _dialogError;

    private List<BookResponseDto> FilteredBooks => string.IsNullOrWhiteSpace(_searchText)
        ? _books
        : _books.Where(b =>
            (b.Title ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            (b.Author ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            (b.Description ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadBooksAsync();
        _isLoading = false;
        StateHasChanged();
    }

    private async Task LoadBooksAsync()
    {
        _errorMessage = null;

        try
        {
            var response = await LibraryService.GetAllBooksAsync(new GetAllBooksRequest
            {
                PageNumber = 1,
                PageSize = 500
            });

            if (response == null || !response.Success)
            {
                _errorMessage = response?.Message ?? "فشل تحميل الكتب.";
                _books.Clear();
                return;
            }

            var json = JsonSerializer.Serialize(response.Data);
            var books = JsonSerializer.Deserialize<List<BookResponseDto>>(json, JsonOptions) ?? new();

            _books.Clear();
            _books.AddRange(books.OrderByDescending(b => b.CreatedAt));
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر تحميل الكتب: {ex.Message}";
            _books.Clear();
        }
    }

    private void HandleSearch(ChangeEventArgs args)
        => _searchText = args.Value?.ToString() ?? string.Empty;

    private void OpenCreateDialog()
    {
        _successMessage = null;
        _dialogError = null;
        _isEditMode = false;
        _form = new BookFormModel();
        _isDialogOpen = true;
    }

    private void OpenEditDialog(BookResponseDto book)
    {
        _successMessage = null;
        _dialogError = null;
        _isEditMode = true;
        _form = new BookFormModel
        {
            Id = book.Id,
            Title = book.Title,
            Author = book.Author,
            ISBN = book.ISBN,
            Publisher = book.Publisher,
            PublicationYearText = book.PublicationYear?.ToString() ?? string.Empty,
            Description = book.Description,
            Link = book.CoverImageUrl
        };
        _isDialogOpen = true;
    }

    private void CloseDialog()
    {
        if (_isSaving)
            return;

        _isDialogOpen = false;
        _dialogError = null;
    }

    private async Task ApplyDialogAsync()
    {
        _isSaving = true;
        _dialogError = null;
        _successMessage = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_form.Title))
            {
                _dialogError = "يرجى إدخال اسم الكتاب.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_form.Author))
            {
                _dialogError = "يرجى إدخال اسم المؤلف أو الرافع.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_form.Description))
            {
                _dialogError = "يرجى إدخال وصف الكتاب.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_form.Link))
            {
                _dialogError = "يرجى إدخال رابط الكتاب.";
                return;
            }

            int? publicationYear = null;
            if (!string.IsNullOrWhiteSpace(_form.PublicationYearText))
            {
                if (!int.TryParse(_form.PublicationYearText, out var parsedYear))
                {
                    _dialogError = "سنة النشر يجب أن تكون رقماً صحيحاً.";
                    return;
                }

                publicationYear = parsedYear;
            }

            var bookData = new BookDto
            {
                Title = _form.Title.Trim(),
                Author = _form.Author.Trim(),
                ISBN = _form.ISBN?.Trim() ?? string.Empty,
                Publisher = _form.Publisher?.Trim() ?? string.Empty,
                PublicationYear = publicationYear,
                Description = _form.Description.Trim(),
                CoverImageUrl = _form.Link.Trim(),
                DownloadUrl = _form.Link.Trim()
            };

            var response = _isEditMode
                ? await LibraryService.UpdateBookAsync(new UpdateBookRequest
                {
                    Id = _form.Id,
                    BookData = bookData
                })
                : await LibraryService.AddBookAsync(new AddBookRequest
                {
                    BookData = bookData,
                    BookFile = Array.Empty<byte>()
                });

            if (response == null || !response.Success)
            {
                _dialogError = response?.Message ?? "فشل حفظ بيانات الكتاب.";
                return;
            }

            _successMessage = _isEditMode ? "تم تعديل بيانات الكتاب بنجاح." : "تم إضافة الكتاب بنجاح.";
            _isDialogOpen = false;
            await LoadBooksAsync();
        }
        catch (Exception ex)
        {
            _dialogError = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteBookAsync(BookResponseDto book)
    {
        _successMessage = null;
        _errorMessage = null;

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"هل تريد حذف الكتاب {book.Title}؟");
        if (!confirmed)
            return;

        try
        {
            var response = await LibraryService.DeleteBookAsync(book.Id);
            if (response == null || !response.Success)
            {
                _errorMessage = response?.Message ?? "فشل حذف الكتاب.";
                return;
            }

            _successMessage = "تم حذف الكتاب بنجاح.";
            await LoadBooksAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void OpenDetailsDialog(BookResponseDto book)
    {
        _detailsModel = new MemberDetailsDialogModel
        {
            Title = book.Title,
            Subtitle = "معلومات الكتاب",
            Sections = new List<MemberDetailsSectionModel>
            {
                new()
                {
                    Title = "البيانات الأساسية",
                    Items = new List<MemberDetailsItemModel>
                    {
                        Item("اسم الكتاب", book.Title),
                        Item("المؤلف/الرافع", book.Author),
                        Item("الناشر", book.Publisher),
                        Item("ISBN", book.ISBN),
                        Item("سنة النشر", book.PublicationYear?.ToString()),
                        Item("رابط الكتاب", book.CoverImageUrl),
                        Item("تاريخ الإضافة", book.CreatedAt == default ? null : book.CreatedAt.ToString("yyyy-MM-dd"))
                    }
                },
                new()
                {
                    Title = "الوصف",
                    Items = new List<MemberDetailsItemModel>
                    {
                        Item("وصف الكتاب", book.Description)
                    }
                }
            }
        };

        _isDetailsOpen = true;
    }

    private void CloseDetailsDialog()
        => _isDetailsOpen = false;

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static MemberDetailsItemModel Item(string label, string? value)
        => new()
        {
            Label = label,
            Value = string.IsNullOrWhiteSpace(value) ? "—" : value
        };

    private sealed class BookFormModel
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Author { get; set; } = string.Empty;
        public string ISBN { get; set; } = string.Empty;
        public string Publisher { get; set; } = string.Empty;
        public string PublicationYearText { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Link { get; set; } = string.Empty;
    }
}
