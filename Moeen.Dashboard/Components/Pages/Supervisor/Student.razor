@page "/supervisor/student"
@rendermode InteractiveServer

@inject NavigationManager NavManager
<h3>Student</h3>
<style>
	.btn-pprimary {
    background-color: var(--primary-green);
    font-size: 15px;
    padding: 10px 20px;
    color: var(--white);
    border-radius: 12px;
    display: inline;
    transition: 0.3s;
}

    .btn-pprimary:hover {
        background-color: #123d32;
        transform: translateY(-2px);
    }
	
	.form-container {
    max-width: 900px;
    margin: 20px auto;
    background: #fff;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    border: 1px solid #eee;
    overflow: hidden;
}	
.form-header {
    background: #195042;
    color: #fff;
    padding: 20px 30px;
}

form { padding: 30px; }

/* دمج الصفوف والمجموعات */
.grid-row, .actions, .form-header h2, .save, .cancel, .input-wrapper {
    display: flex;
    align-items: center;
    gap: 20px;
    border-radius:5px;
    padding:5px;
}

.grid-row { margin-bottom: 20px; flex-wrap: wrap; gap: 20px; }
.input-group { flex: 1; min-width: 250px; }

.input-group {
    flex:1 1 45%;
    display: flex;
    flex-direction:column;
    margin-bottom: 8px;
    color: #1d3937;
    font-weight: 600;
    font-size: 14px;
}

/* تنسيق المدخلات الموحد */
.input-wrapper { position: relative; }

.input-wrapper i {
    position: absolute;
    right: 12px;
    color: #195042;
    font-size: 18px;
}

.input-wrapper input, .input-wrapper select {
    width: 100%;
    padding: 12px 40px 12px 12px;
    border: 2px solid #f0f0f0;
    border-radius: 10px;
    outline: none;
    transition: 0.3s;
    background: #fdfdfd;
    font: inherit;
    margin-right:5px;
    flex:1;
}

.input-wrapper input:focus, .input-wrapper select:focus {
    border-color: #d6cabc;
    background: #fff;
    box-shadow: 0 0 8px rgba(214, 202, 188, 0.3);
}

</style>
 <header class="page-header">
        <h2 class="page-title">إدارة الطلاب</h2>
    </header>
<br />
	
<div class="search-wrapper">
	<i class="bi bi-search"></i>
	<input type="text" class="search-input" placeholder="ابحث عن طالب...">
</div>
<br />
<table class="table">
	<thead>
		<tr>
			<th class="table th">اسم الطالب</th>
			<th class="table th">أداء الطالب</th>
			<th class="table th">حذف الطالب</th>
		</tr>
	</thead>
	<br />
	<tbody>
		<tr>
			<td class="table td">آلاء قاسم </td>
			<td >
				<a @onclick="viewStudent1"><button title="عرض"><i class="bi bi-info-circle"></i></button></a>
                <a @onclick="editStudent"> <button class="btn-icon edit" title="تعديل"><i class="bi bi-pencil-square"></i></button></a>
				</td>
			<td class="table td">
				  <button class="btn-icon delete" title="حذف"><i class="bi bi-trash"></i></button>

			</td>
		</tr>
		<br />
		<tr>
			<td class="table td">ماريا العبد السلام </td>
			<td>
				<a @onclick="viewStudent2"><button title="عرض"><i class="bi bi-info-circle"></i></button></a>
                <a @onclick="editStudent"> <button class="btn-icon edit" title="تعديل"><i class="bi bi-pencil-square"></i></button></a>

	               
			</td>
			<td class="table td">
			 <button class="btn-icon delete" title="حذف"><i class="bi bi-trash"></i></button>

			</td>
		</tr>
		<br />
		<tr>
			<td class="table td">آية دعبول </td>
			<td>
				<a @onclick="viewStudent3"><button title="عرض"><i class="bi bi-info-circle"></i></button></a>
                <a @onclick="editStudent"> <button class="btn-icon edit" title="تعديل"><i class="bi bi-pencil-square"></i></button></a>

	               
			</td>
			<td class="table td">
			 <button class="btn-icon delete" title="حذف"><i class="bi bi-trash"></i></button>

			</td>
		</tr>
		
			
		
	</tbody>
	</table>

	<br />
	<details class="details">
		<summary class="btn-pprimary">إضافة طالب جديد</summary>

		<br>

		<form class="form-box" >
		
		<div>
			<label class="label">اسم والكنية:</label><br>
		<input class="input" placeholder="اكتب هنا..." type ="text" name="name"><br><br>
		     </div>
			<div>
		<label class="label">تاريخ الميلاد:</label><br>
			<input class="input" placeholder="اكتب هنا..."  type="date" name="age"><br><br>
			 </div>
			 <div>
		<label class="label">العنوان:</label><br>

		<input class="input" placeholder="اكتب هنا..."  type="text" name="status"><br><br>
		       </div>
			  
			      <div>
           
		<label class="label">حالة الطالب:</label><br>
		<input class="input" placeholder="اكتب هنا..."  type="text" name="s"><br><br>
		   </div>
		   <div>
		<label class="label">تاريخ التسجيل:</label><br>
		<input class="input" placeholder="اكتب هنا..." type ="number" name="date"><br><br>
		      </div> 
			   <div>
		<label class="label">البريد الالكتروني:</label><br>
		<input class="input" placeholder="اكتب هنا..."  type="email" name="email"><br><br>
		       </div>
			  
			   <div>
		<label class="label">اسم المسجد:</label><br>
		<input class="input" placeholder="اكتب هنا..."  type="text" name="namemesqwe"><br><br>
		       </div>
			   <div class="form-group">
		<label class="label">رقم الهاتف:</label><br>
		<input class="input" placeholder="اكتب هنا..." type ="number" name="phone"><br><br>
		        </div>
				<div class="form-group">
		<label class="label">اسم ولي الامر:</label><br>
		<input class="input" placeholder="اكتب هنا..."  type="text" name="name parent"><br><br>
		        </div>
				<div class="form-group">
		<label class="label">رقم ولي الامر:</label><br>
		<input class="input" placeholder="اكتب هنا..." type ="number" name="phone parent"><br><br>
		        </div>
				<div class="form-group">
		<label class="label">الجنس:</label><br>
		<select class="select" name="gender">
			<option> ذكر</option>
			<option> انثى</option>
			
		</select> 
		        </div>
				<div class="form-group">
		<label class="label">كلمة السر:</label><br>
		<input class="input" placeholder="اكتب هنا..." type ="password" name="password"><br><br>
		         </div>
				 <div class="form-group">
		<label class="label">الفوج:</label><br>
		<select class="select" name="fouj">
			<option> فوج اول</option>
			<option> فوج ثاني</option>

		</select><br><br> 
		         </div>
				 <div class="form-group">
		<label class="label">رقم الحلقة:</label><br>
		<select class="select" name="halaqa">
			<option>الحلقة 1</option>
			<option>الحلقة 2</option>
			<option>الحلقة 3</option>
			<option>الحلقة 4</option>
		</select>
		      </div>
		<br><br>
		<br />
		<br />

		<button class="btn-pprimary"  type="button">ربط بولي الامر</button>
		<button class="btn-pprimary" type="button">حفظ</button>
		</form>
	
	</details>

	

@code {
	private void editStudent()
	{
		NavManager.NavigateTo("/supervisor/edit");
		Console.WriteLine("////====///");
		// Logic to edit student information
	}
	private void viewStudent1()
	{
		NavManager.NavigateTo("/supervisor/alaa_info");
		// Logic to edit student information
	}
	private void viewStudent2()
	{
		NavManager.NavigateTo("/supervisor/maria-info");
	}
	private void viewStudent3()
	{
		NavManager.NavigateTo("/supervisor/aya-info");
	}

	
}
