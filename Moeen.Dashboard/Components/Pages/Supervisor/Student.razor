@page "/supervisor/student"
@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Requests.Identity
@inject IAuthService AuthService
@inject NavigationManager NavManager
@rendermode InteractiveServer

<h3>Student</h3>
<style>
	:root {
--primary-green: #195042;
--accent-beige: #d6cabc;
--light-beige: #f4f1ee;
--white: #ffffff;
--text-dark: #2d3436;
--status-green: #2ecc71;
--danger-red: #e74c3c;
        --transition: all 0.3s ease;

}

body {
font-family: 'Tajawal', sans-serif;
background-color: #f9f9f9;
direction: rtl;
}

.management-container {
background: var(--white);
margin: 20px;
padding: 30px;
border-radius: 20px;
box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}
/* العنوان */
.page-title {
color: var(--primary-green);
position: relative;
padding-bottom: 10px; /* مسافة بين النص والخط */
border-bottom: 3px solid #d6cabc; /* جعل الخط بلون البيج */
display: inline-block; /* ليصبح طول الخط على قدر الكلمة فقط */
}

.search-wrapper {
    position: relative;
    flex: 1;
    max-width: 400px;
}

.search-input {
    width: 100%;
    padding: 12px 45px 12px 15px;
    border: 1.5px solid var(--accent-beige);
    border-radius: 12px;
    outline: none;
    transition: 0.3s;
}

    .search-input:focus {
        border-color: var(--primary-green);
        box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.1);
    }

.search-wrapper i {
    position: absolute;
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--primary-green);
}
.table {
    width: 100%;
    table-layout: fixed;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
     font-family: 'Tajawal', sans-serif;
        font-size: clamp(0.95rem,2.5vw,1.5rem);
        text-align: center;
}
    .table th {
        background-color: var(--light-beige);
        color: var(--primary-green);
        padding: 12px;
    }
    .table td {
        background-color: var(--white);
        padding: 10px;
        border-bottom: 1px solid #eee;

    }
    .table tbody tr:hover {
        background-color: #fafafa;
        transform: scale(1.01);
    }
	.table-wrapper{
		overflow-x: auto;
		width: 100%;
		border-radius: var(--radius-md);
	}

	.btn-pprimary {
    background-color: var(--primary-green);
    font-size: 15px;
    padding: 10px 20px;
    color: var(--white);
    border-radius: 12px;
    display: inline;
    transition: 0.3s;
}

    .btn-pprimary:hover {
        background-color: #123d32;
        transform: translateY(-2px);
    }
   
  .form-container, .form-container * {
        box-sizing: border-box;
    }

    
    .form-container {
        max-width: 850px;
        margin: 2rem auto;
        background: var(--white);
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        direction: rtl; 
        overflow: hidden;
    }

    .form-header {
        background: var(--accent-beige);
        color: var(--white);
        padding: 1.2rem;
        text-align: center;
    }

    form {
        padding: 2rem;
    }

    .grid-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr); 
        gap: 1.5rem;
        margin-bottom: 1.2rem;
    }
        .grid-row:nth-of-type(4) {
            grid-template-columns: repeat(3, 1fr);
        }

    .input-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .input-group label {
            color: var(--text-dark);
            font-weight: 600;
            font-size: 0.85rem;
            text-align: right;
        }

    /* حل مشكلة الأيقونات والمحاذاة */
    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
    }

        .input-wrapper i {
            position: absolute;
            right: 12px; /* تثبيت الأيقونة جهة اليمين */
            color: var(--primary-green);
            z-index: 2;
            pointer-events: none;
        }

        .input-wrapper input,
        .input-wrapper select {
            width: 100%;
            padding: 10px 35px 10px 10px;
            border: 1px solid var(--accent-beige);
            border-radius: 8px;
            background: var(--light-beige);
            font-size: 0.9rem;
            height: 45px; 
            outline: none;
            transition: var(--transition);
        }

            .input-wrapper input:focus,
            .input-wrapper select:focus {
                border-color: var(--primary-green);
                background: #fff;
            }
    .actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #eee;
    }

        .actions button, .actions a {
            flex: 1;
            height: 48px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .actions .save {
            background: var(--primary-green);
            color: white;
        }
         .actions .parent {
            background: var(--accent-beige);
            color: white;
        }

        .actions .cancel {
            background: #f8f9fa;
            color: #dc3545;
        }

    
    @@media (max-width: 768px) {
    .grid-row, .grid-row:nth-of-type(4) {
        grid-template-columns: 1fr !important;
    }
	}
</style>
<section class="management-container">
<header class="page-header mb-3">
  <h2 class="page-title">إدارة الطلاب</h2>
</header>
<br />
<div class="search-wrapper mb-3">
	<i class="bi bi-search"></i>
	<input type="text" class="search-input" placeholder="ابحث عن طالب...">
</div>
<div class="table-wrapper">
<div class="table-responsive">
<table class="table">
	<thead>
		<tr>
			<th class="table th">اسم الطالب</th>
			<th class="table th">أداء الطالب</th>
			<th class="table th">حذف الطالب</th>
		</tr>
	</thead>
	<tbody>
		<tr>
			<td class="table td">آلاء قاسم </td>
			<td >
				<a @onclick="viewStudent1"><button title="عرض"><i class="bi bi-info-circle"></i></button></a>
                <a @onclick="editStudent"> <button class="btn-icon edit" title="تعديل"><i class="bi bi-pencil-square"></i></button></a>
				</td>
			<td class="table td">
				  <button class="btn-icon delete" title="حذف"><i class="bi bi-trash"></i></button>
			</td>
		</tr>
		<tr>
			<td class="table td">ماريا العبد السلام </td>
			<td>
				<a @onclick="viewStudent1"><button title="عرض"><i class="bi bi-info-circle"></i></button></a>
                <a @onclick="editStudent"> <button class="btn-icon edit" title="تعديل"><i class="bi bi-pencil-square"></i></button></a>     
			</td>
			<td class="table td">
			 <button class="btn-icon delete" title="حذف"><i class="bi bi-trash"></i></button>
			</td>
		</tr>
		<tr>
			<td class="table td">آية دعبول </td>
			<td>
				<a @onclick="viewStudent1"><button title="عرض"><i class="bi bi-info-circle"></i></button></a>
                <a @onclick="editStudent"> <button class="btn-icon edit" title="تعديل"><i class="bi bi-pencil-square"></i></button></a>     
			</td>
			<td class="table td">
			 <button class="btn-icon delete" title="حذف"><i class="bi bi-trash"></i></button>
			</td>
		</tr>
	</tbody>
	</table>
	</div></div>
	<br />
	<details>
		<summary class="btn-pprimary">إضافة طالب جديد</summary>
		<div class="form-container">
    <div class="form-header">
        <h2><i class="bi bi-person-plus-fill"></i> إضافة طالب</h2>
    </div>
  <EditForm Model="studentModel" OnValidSubmit="HandleSubmit">
      <DataAnnotationsValidator /> @* هاد السطر ضروري جداً *@
    <ValidationSummary /> @* وهاد بيطبعلك الأخطاء إذا نسيتي حقل *@
        <div class="grid-row">
            <div class="input-group">
                <label>الاسم الكامل</label>
                <div class="input-wrapper">
                    <i class="bi bi-person"></i>
                  <input type="text" @bind="studentModel.Name" placeholder="أدخل الاسم" />
                </div>
            </div>
             <div class="input-group">
                <label>رقم الهاتف</label>
                <div class="input-wrapper">
                    <i class="bi bi-telephone"></i>
                    <input type="tel" @bind="studentModel.PhoneNumber" placeholder="أدخل رقم الهاتف">
                </div>
            </div>
            </div>
	    <div class="grid-row">
             <div class="input-group">
                <label>تاريخ التسجيل</label>
                <div class="input-wrapper">
                    <i class="bi bi-calendar-event"></i>
                    <input type="date" @bind="studentModel.Date" placeholder="أدخل تاريخ التسجيل">
                </div>
            </div>
               <div class="input-group">
                <label>تاريخ الميلاد</label>
                <div class="input-wrapper">
                    <i class="bi bi-calendar-event"></i>
                    <input type="date" @bind="studentModel.Birthday" placeholder="أدخل تاريخ الميلاد">
                </div>
            </div> 
        </div>
	    <div class="grid-row">
		 <div class="input-group">
                <label>العنوان</label>
                <div class="input-wrapper">
                    <i class="bi bi-alphabet"></i>
                    <input type="text" @bind="studentModel.Address" placeholder="أدخل العنوان">
                </div>
            </div>
             <div class="input-group">
                <label>البريد الإلكتروني</label>
                <div class="input-wrapper">
                    <i class="bi bi-envelope"></i>
                    <input type="email" @bind="studentModel.Email" placeholder="أدخل البرييد الالكتروني">
                </div>
            </div>
        </div>
         <div class="grid-row">
			   <div class="input-group">
                <label>الجامع التابع له</label>
                <div class="input-wrapper">
                    <i class="bi bi-houses"></i>
                    <input type="text" @bind="studentModel.Musqe" placeholder="أدخل الجامع">
                </div>
            </div>
             <div class="input-group">
                <label>الجنس</label>
                <div class="input-wrapper">
                    <i class="bi bi-gender-ambiguous"></i>
                    <select @bind="studentModel.Gender">
                        <option value="" disabled selected>اختر الجنس</option>
                        <option value="male">ذكر</option>
                        <option value="female">أنثى</option>
                    </select>
                </div>
            </div>
            </div>
             <div class="grid-row">
                     <div class="input-group">
                <label>اسم ولي الامر </label>
                <div class="input-wrapper">
                    <i class="bi bi-person"></i>
                    <input type="text" @bind="studentModel.NameParent" placeholder="أدخل الاسم">
                </div>
            </div>
                  <div class="input-group">
                <label>رقم ولي الامر</label>
                <div class="input-wrapper">
                    <i class="bi bi-telephone"></i>
                    <input type="tel" @bind="studentModel.PhoneNumberParent" placeholder="أدخل الرقم">
                </div>
            </div>
		        </div>
                 <div class="grid-row">
            <div class="input-group">
                <label>الفوج</label>
                <div class="input-wrapper">
                    <i class="bi bi-layers"></i>
                    <select @bind="studentModel.Fouj">
                        <option>الفوج الأول</option>
                        <option>الفوج الثاني</option>
                    </select>
                </div>
            </div>
				 <div class="input-group">
                <label>الحلقة</label>
                <div class="input-wrapper">
                    <i class="bi bi-layers"></i>
                    <select @bind="studentModel.Halaqa">
                        <option>الحلقة الاولى</option>
                        <option>الحلقة الثانية</option>
                    </select>
                </div>
                </div>
                </div>
				 <div class="grid-row">
              <div class="input-group">
                <label>حالة الحساب</label>
                <div class="input-wrapper">
                    <i class="bi bi-check-circle"></i>
                    <select @bind="studentModel.HaltHesab">
                        <option value="active">نشط</option>
                        <option value="inactive">متوقف</option>
                    </select>
                </div>
            </div>
            <div class="input-group">
                <label>كلمة المرور</label>
                <div class="input-wrapper">
                    <i class="bi bi-lock"></i>
                    <input type="password" @bind="studentModel.Password" placeholder="أدخل كلمة المرور">
                </div>
            </div>
        </div>
		 <div class="actions">
            <button type="submit" class="save"><i class="bi bi-check2-all"></i> حفظ الطالب</button>
            <button type="submit" class="parent"><i class="bi bi-check2-all"></i> ربط بولي الامر </button>
            <a href="/supervisor/student" class="cancel"><i class="bi bi-x-lg"></i> إلغاء</a>
        </div>
		</EditForm>
                </div>
	</details>
	</section>
@code {
	private void editStudent()
	{
		NavManager.NavigateTo("/supervisor/edit");
		// Logic to edit student information
	}
	private void viewStudent1()
	{
		NavManager.NavigateTo("/supervisor/alaa_info");
		// Logic to edit student information
	}
RegisterRequest studentModel = new RegisterRequest();

  

    // 2. وهون بنعمل الميثود اللي رح تنادي الـ Service لما نضغط الزر
    private async Task HandleSubmit()
    {
        var response = await AuthService.Register(studentModel);
        
        if (response.Success) 
        {
            Console.WriteLine("تم تسجيل الطالب بنجاح!");
            // كود للتوجيه لصفحة تانية أو إظهار رسالة نجاح
        }else
        {
            Console.WriteLine("فشل تسجيل الطالب: " + response.Message);
            // كود لإظهار رسالة خطأ للمستخدم   
        }
    }
	
}
