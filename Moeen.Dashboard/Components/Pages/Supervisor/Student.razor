@page "/supervisor/student"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using Moeen.Dashboard.Application.Services.Abstractions
@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Requests.Enrollment
@using Moeen.Shared.Requests.Mosuq
@using Moeen.Shared.Responses.Enrollment
@using Moeen.Shared.Responses.Mosuq
@inject IEnrollmentService EnrollmentService
@inject IMosquService MosquService
@inject IJSRuntime JS

<style>
    .students-page {
        direction: rtl;
        font-family: inherit;
        color: #163f35;
    }

    .students-card {
        background: #fff;
        border: 1px solid rgba(25, 80, 66, 0.10);
        border-radius: 24px;
        padding: 28px;
        box-shadow: 0 22px 60px rgba(25, 80, 66, 0.08);
    }

    .students-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 26px;
    }

    .students-title {
        margin: 0;
        color: #195042;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.04em;
    }

    .students-subtitle {
        margin: 7px 0 0;
        color: #7b7067;
        font-size: 0.95rem;
    }

    .students-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .search-wrapper {
        position: relative;
        width: min(100%, 430px);
    }

    .search-wrapper .bi {
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #195042;
    }

    .search-input {
        width: 100%;
        height: 48px;
        padding: 0 44px 0 16px;
        border: 1px solid #ddd5cc;
        border-radius: 15px;
        outline: none;
        background: #fbfaf8;
        color: #163f35;
        transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    }

    .search-input:focus {
        border-color: #195042;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.10);
    }

    .btn-moeen-primary,
    .btn-moeen-light,
    .btn-moeen-danger {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 0 17px;
        border-radius: 14px;
        border: 0;
        font-weight: 800;
        transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    }

    .btn-moeen-primary {
        background: #195042;
        color: #fff;
        box-shadow: 0 14px 28px rgba(25, 80, 66, 0.18);
    }

    .btn-moeen-primary:hover:not(:disabled) {
        background: #123d32;
        transform: translateY(-1px);
    }

    .btn-moeen-light {
        background: #f4f1e8;
        color: #195042;
        border: 1px solid #e2dbd2;
    }

    .btn-moeen-danger {
        background: #fff3f1;
        color: #b42318;
        border: 1px solid rgba(180, 35, 24, 0.18);
    }

    .btn-moeen-primary:disabled,
    .btn-moeen-light:disabled,
    .btn-moeen-danger:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .students-table-wrap {
        overflow-x: auto;
        border: 1px solid #eee8e0;
        border-radius: 18px;
    }

    .students-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
        min-width: 860px;
    }

    .students-table th {
        background: #f4f1e8;
        color: #195042;
        font-weight: 900;
        padding: 15px 18px;
        border-bottom: 1px solid rgba(25, 80, 66, 0.18);
        white-space: nowrap;
    }

    .students-table td {
        padding: 15px 18px;
        border-bottom: 1px solid #f1ece6;
        vertical-align: middle;
        color: #263f37;
    }

    .students-table tr:last-child td {
        border-bottom: 0;
    }

    .students-table tbody tr:hover td {
        background: #fbfaf8;
    }

    .student-name-cell {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 900;
        color: #163f35;
    }

    .student-avatar {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 14px;
        background: #195042;
        color: #fff;
        font-size: 1rem;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 30px;
        padding: 0 11px;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 800;
    }

    .status-active { background: #ecfdf3; color: #027a48; }
    .status-inactive { background: #fff3f1; color: #b42318; }
    .status-graduated { background: #eef4ff; color: #3538cd; }

    .row-actions {
        display: flex;
        justify-content: center;
        gap: 8px;
    }

    .icon-btn {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e2dbd2;
        border-radius: 12px;
        background: #fff;
        color: #195042;
        transition: transform 0.18s ease, background 0.18s ease;
    }

    .icon-btn:hover {
        background: #f4f1e8;
        transform: translateY(-1px);
    }

    .icon-btn.danger {
        color: #b42318;
    }

    .dialog-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 28px;
        background: rgba(9, 30, 24, 0.42);
        backdrop-filter: blur(7px);
    }

    .student-dialog {
        width: min(100%, 820px);
        max-height: calc(100vh - 56px);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        border-radius: 26px;
        background: #fff;
        box-shadow: 0 30px 90px rgba(0, 0, 0, 0.24);
    }

    .student-dialog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 24px 28px;
        border-bottom: 1px solid #eee8e0;
        background: linear-gradient(135deg, #f7f3ed 0%, #fff 100%);
    }

    .student-dialog-title {
        margin: 0;
        color: #195042;
        font-size: 1.35rem;
        font-weight: 900;
    }

    .student-dialog-subtitle {
        margin: 6px 0 0;
        color: #7b7067;
        font-size: 0.92rem;
    }

    .dialog-close-btn {
        width: 42px;
        height: 42px;
        border: 0;
        border-radius: 14px;
        background: #f4f1e8;
        color: #195042;
        font-size: 1.15rem;
    }

    .student-dialog-body {
        overflow-y: auto;
        padding: 26px 28px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .form-field label {
        display: block;
        margin-bottom: 9px;
        color: #263f37;
        font-weight: 800;
        font-size: 0.92rem;
    }

    .form-control.moeen-control,
    .moeen-control {
        min-height: 48px;
        border: 1px solid #ddd5cc;
        border-radius: 13px;
        background-color: #fbfaf8;
        color: #163f35;
    }

    .moeen-control:focus {
        border-color: #195042;
        box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.10);
        background-color: #fff;
    }

    .validation-message {
        display: block;
        margin-top: 7px;
        color: #b42318;
        font-size: 0.82rem;
    }

    .student-dialog-footer {
        display: flex;
        justify-content: flex-start;
        gap: 12px;
        padding: 20px 28px 24px;
        border-top: 1px solid #eee8e0;
        background: #fff;
    }

    .state-card {
        padding: 22px;
        border: 1px solid #eee8e0;
        border-radius: 18px;
        background: #fff;
        color: #195042;
    }

    @@media (max-width: 760px) {
        .students-card { padding: 20px; }
        .students-header { flex-direction: column; }
        .form-grid { grid-template-columns: 1fr; }
        .dialog-backdrop { padding: 12px; }
        .student-dialog-header,
        .student-dialog-body,
        .student-dialog-footer { padding-left: 18px; padding-right: 18px; }
    }
</style>

<section class="students-page">
    <div class="students-card">
        <header class="students-header">
            <div>
                <h2 class="students-title">إدارة الطلاب</h2>
                <p class="students-subtitle">عرض الطلاب، إضافة طالب جديد، وتعديل البيانات مباشرة من لوحة المشرف.</p>
            </div>
            <button class="btn-moeen-primary" type="button" @onclick="OpenCreateDialog" disabled="@_isLoading">
                <i class="bi bi-person-plus"></i>
                <span>إضافة طالب جديد</span>
            </button>
        </header>

        <div class="students-toolbar">
            <div class="search-wrapper">
                <i class="bi bi-search"></i>
                <input class="search-input"
                       value="@_searchText"
                       placeholder="ابحث بالاسم أو البريد أو الرقم..."
                       @oninput="HandleSearch" />
            </div>
            <button class="btn-moeen-light" type="button" @onclick="LoadStudentsAsync" disabled="@_isLoading">
                <i class="bi bi-arrow-clockwise"></i>
                <span>تحديث</span>
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success">@_successMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }

        @if (_isLoading)
        {
            <div class="state-card d-flex align-items-center gap-3">
                <span class="spinner-border text-success" role="status"></span>
                <span>جاري تحميل بيانات الطلاب...</span>
            </div>
        }
        else
        {
            <div class="students-table-wrap">
                <table class="students-table">
                    <thead>
                        <tr>
                            <th>اسم الطالب</th>
                            <th>البريد الإلكتروني</th>
                            <th>رقم الهاتف</th>
                            <th>العمر</th>
                            <th>المسجد</th>
                            <th>النقاط</th>
                            <th>الحالة</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_students.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">لا يوجد طلاب حالياً.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var student in _students)
                            {
                                <tr>
                                    <td>
                                        <div class="student-name-cell">
                                            <span class="student-avatar"><i class="bi bi-person"></i></span>
                                            <span>@student.Name</span>
                                        </div>
                                    </td>
                                    <td>@student.Email</td>
                                    <td>@(string.IsNullOrWhiteSpace(student.Phone) ? "—" : student.Phone)</td>
                                    <td>@student.Age</td>
                                    <td>@Display(student.MosqueName)</td>
                                    <td>@student.Score</td>
                                    <td><span class="status-pill @GetStatusClass(student.Status)">@GetStatusLabel(student.Status)</span></td>
                                    <td>
                                        <div class="row-actions">
                                            <button class="icon-btn" type="button" title="عرض التفاصيل" @onclick="() => OpenDetailsDialog(student)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="icon-btn" type="button" title="تعديل" @onclick="() => OpenEditDialog(student)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="icon-btn danger" type="button" title="حذف" @onclick="() => DeleteStudentAsync(student)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (_isDialogOpen)
    {
        <div class="dialog-backdrop" @onclick="CloseDialog">
            <div class="student-dialog" @onclick:stopPropagation="true">
                <div class="student-dialog-header">
                    <div>
                        <h3 class="student-dialog-title">
                            <i class="@(_isViewMode ? "bi bi-eye" : _isEditMode ? "bi bi-pencil-square" : "bi bi-person-plus")"></i>
                            @(_isViewMode ? "تفاصيل الطالب" : _isEditMode ? "تعديل بيانات الطالب" : "إضافة طالب جديد")
                        </h3>
                        <p class="student-dialog-subtitle">@(_isViewMode ? "عرض بيانات الطالب بدون تعديل." : "املأ البيانات ثم اضغط تطبيق، سيتم تحديث الجدول تلقائياً بعد الحفظ.")</p>
                    </div>
                    <button class="dialog-close-btn" type="button" @onclick="CloseDialog" disabled="@_isSaving">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <EditForm Model="_form" OnValidSubmit="ApplyDialogAsync">
                    <DataAnnotationsValidator />
                    <div class="student-dialog-body">
                        @if (!string.IsNullOrWhiteSpace(_dialogError))
                        {
                            <div class="alert alert-danger">@_dialogError</div>
                        }

                        <div class="form-grid">
                            <div class="form-field">
                                <label>الاسم الكامل</label>
                                <InputText class="form-control moeen-control" @bind-Value="_form.Name" placeholder="مثال: أحمد محمد" disabled="@_isViewMode" />
                                <ValidationMessage For="@(() => _form.Name)" />
                            </div>
                            <div class="form-field">
                                <label>البريد الإلكتروني</label>
                                <InputText class="form-control moeen-control" @bind-Value="_form.Email" placeholder="name@example.com" disabled="@_isViewMode" />
                                <ValidationMessage For="@(() => _form.Email)" />
                            </div>
                            <div class="form-field">
                                <label>رقم الهاتف</label>
                                <InputText class="form-control moeen-control" @bind-Value="_form.Phone" placeholder="اختياري" disabled="@_isViewMode" />
                                <ValidationMessage For="@(() => _form.Phone)" />
                            </div>
                            <div class="form-field">
                                <label>الجنس</label>
                                <InputSelect class="form-control moeen-control" @bind-Value="_form.Gender" disabled="@_isViewMode">
                                    <option value="Male">ذكر</option>
                                    <option value="Female">أنثى</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => _form.Gender)" />
                            </div>
                            <div class="form-field">
                                <label>العمر</label>
                                <InputNumber class="form-control moeen-control" @bind-Value="_form.Age" disabled="@_isViewMode" />
                                <ValidationMessage For="@(() => _form.Age)" />
                            </div>
                            <div class="form-field">
                                <label>تاريخ التسجيل</label>
                                <InputDate class="form-control moeen-control" @bind-Value="_form.EnrollmentDate" disabled="@_isViewMode" />
                                <ValidationMessage For="@(() => _form.EnrollmentDate)" />
                            </div>
                            <div class="form-field">
                                <label>حالة الحساب</label>
                                <InputSelect class="form-control moeen-control" @bind-Value="_form.Status" disabled="@_isViewMode">
                                    <option value="0">نشط</option>
                                    <option value="1">متوقف</option>
                                    <option value="2">متخرج</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => _form.Status)" />
                            </div>
                            <div class="form-field">
                                <label>النقاط</label>
                                <InputNumber class="form-control moeen-control" @bind-Value="_form.Score" disabled="@_isViewMode" />
                                <ValidationMessage For="@(() => _form.Score)" />
                            </div>
                            @if (!_isEditMode && !_isViewMode)
                            {
                                <div class="form-field">
                                    <label>المسجد</label>
                                    <InputSelect class="form-control moeen-control" @bind-Value="_form.MosqueId">
                                        <option value="@Guid.Empty">اختر المسجد</option>
                                        @foreach (var mosque in _mosques)
                                        {
                                            <option value="@mosque.Id">@mosque.name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => _form.MosqueId)" />
                                </div>
                                <div class="form-field">
                                    <label>كلمة المرور</label>
                                    <InputText type="password" class="form-control moeen-control" @bind-Value="_form.Password" placeholder="كلمة مرور الطالب" />
                                    <ValidationMessage For="@(() => _form.Password)" />
                                </div>
                            }
                        </div>
                    </div>

                    <div class="student-dialog-footer">
                        @if (!_isViewMode)
                        {
                            <button class="btn-moeen-primary" type="submit" disabled="@_isSaving">
                                @if (_isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                    <span>جاري التطبيق...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle"></i>
                                    <span>تطبيق</span>
                                }
                            </button>
                        }
                        <button class="btn-moeen-light" type="button" @onclick="CloseDialog" disabled="@_isSaving">
                            <i class="bi bi-x-circle"></i>
                            <span>@(_isViewMode ? "إغلاق" : "إلغاء")</span>
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</section>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    private readonly List<StudentRow> _students = new();
    private List<MosquDto> _mosques = new();
    private StudentDialogModel _form = new();

    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isDialogOpen;
    private bool _isEditMode;
    private bool _isViewMode;
    private string _searchText = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _dialogError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadInitialDataAsync();
        StateHasChanged();
    }

    private async Task LoadInitialDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            await LoadMosquesAsync();
            await LoadStudentsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر تحميل بيانات الطلاب: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadMosquesAsync()
    {
        try
        {
            _mosques = await MosquService.GetAllMosqus(new GetAllMosqusRequest { Page = 1, PageSize = 200 }) ?? new();
        }
        catch
        {
            _mosques = new();
        }
    }

    private async Task LoadStudentsAsync()
    {
        _errorMessage = null;

        try
        {
            var response = await EnrollmentService.GetAllStudentsAsync(new GetAllStudentsRequest
            {
                Name = string.IsNullOrWhiteSpace(_searchText) ? null : _searchText,
                PageNumber = 1,
                PageSize = 200
            });

            if (response == null || !response.Success)
            {
                _errorMessage = response?.Message ?? "فشل تحميل الطلاب.";
                _students.Clear();
                return;
            }

            var json = JsonSerializer.Serialize(response.Data);
            var members = JsonSerializer.Deserialize<List<MemberProfileDto>>(json, JsonOptions) ?? new();

            _students.Clear();
            _students.AddRange(members.Select(StudentRow.FromMember));
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر تحميل الطلاب: {ex.Message}";
            _students.Clear();
        }
    }

    private async Task HandleSearch(ChangeEventArgs args)
    {
        _searchText = args.Value?.ToString() ?? string.Empty;
        await LoadStudentsAsync();
    }

    private void OpenCreateDialog()
    {
        _successMessage = null;
        _dialogError = null;
        _isEditMode = false;
        _isViewMode = false;
        _form = new StudentDialogModel
        {
            EnrollmentDate = DateTime.Today,
            MosqueId = _mosques.FirstOrDefault()?.Id ?? Guid.Empty
        };
        _isDialogOpen = true;
    }

    private void OpenEditDialog(StudentRow student)
    {
        _successMessage = null;
        _dialogError = null;
        _isEditMode = true;
        _isViewMode = false;
        _form = new StudentDialogModel
        {
            Id = student.Id,
            Name = student.Name,
            Email = student.Email,
            Phone = student.Phone,
            Gender = string.Equals(student.Gender, "Female", StringComparison.OrdinalIgnoreCase) ? "Female" : "Male",
            Age = student.Age <= 0 ? 12 : student.Age,
            EnrollmentDate = student.EnrollmentDate == default ? DateTime.Today : student.EnrollmentDate,
            Status = student.Status,
            Score = student.Score,
            MosqueId = student.MosqueId
        };
        _isDialogOpen = true;
    }

    private void OpenDetailsDialog(StudentRow student)
    {
        _successMessage = null;
        _dialogError = null;
        _isEditMode = true;
        _isViewMode = true;
        _form = new StudentDialogModel
        {
            Id = student.Id,
            Name = student.Name,
            Email = student.Email,
            Phone = student.Phone,
            Gender = string.Equals(student.Gender, "Female", StringComparison.OrdinalIgnoreCase) ? "Female" : "Male",
            Age = student.Age <= 0 ? 12 : student.Age,
            EnrollmentDate = student.EnrollmentDate == default ? DateTime.Today : student.EnrollmentDate,
            Status = student.Status,
            Score = student.Score,
            MosqueId = student.MosqueId
        };
        _isDialogOpen = true;
    }

    private void CloseDialog()
    {
        if (_isSaving)
            return;

        _isDialogOpen = false;
        _isViewMode = false;
        _dialogError = null;
    }

    private async Task ApplyDialogAsync()
    {
        if (_isViewMode)
            return;

        _isSaving = true;
        _dialogError = null;
        _successMessage = null;

        try
        {
            if (_isEditMode)
            {
                var response = await EnrollmentService.UpdateMemberInfoAsync(new UpdateMemberInfoRequest
                {
                    MemberId = _form.Id.ToString(),
                    Name = _form.Name,
                    Email = _form.Email,
                    Phone = _form.Phone?.Trim() ?? string.Empty,
                    Gender = _form.Gender,
                    Age = _form.Age,
                    Status = _form.Status,
                    Score = _form.Score
                });

                if (response == null || !response.Success)
                {
                    _dialogError = response?.Message ?? "فشل تعديل بيانات الطالب.";
                    return;
                }

                _successMessage = "تم تعديل بيانات الطالب بنجاح.";
            }
            else
            {
                if (_form.MosqueId == Guid.Empty)
                {
                    _dialogError = "يرجى اختيار المسجد قبل إضافة الطالب.";
                    return;
                }

                if (string.IsNullOrWhiteSpace(_form.Password))
                {
                    _dialogError = "كلمة المرور مطلوبة عند إضافة طالب جديد.";
                    return;
                }

                var response = await EnrollmentService.RegisterStudentAsync(new RegisterStudentRequest
                {
                    Name = _form.Name,
                    Email = _form.Email,
                    Password = _form.Password,
                    ConfirmPassword = _form.Password,
                    Phone = _form.Phone?.Trim() ?? string.Empty,
                    Gender = _form.Gender,
                    Age = _form.Age,
                    EnrollmentDate = _form.EnrollmentDate,
                    Status = _form.Status,
                    Score = _form.Score,
                    MosqueId = _form.MosqueId
                });

                if (response == null || !response.Success)
                {
                    _dialogError = response?.Message ?? "فشل إضافة الطالب.";
                    return;
                }

                _successMessage = "تم إضافة الطالب بنجاح.";
            }

            _isDialogOpen = false;
            await LoadStudentsAsync();
        }
        catch (Exception ex)
        {
            _dialogError = $"تعذر حفظ بيانات الطالب: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteStudentAsync(StudentRow student)
    {
        _successMessage = null;
        _errorMessage = null;

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"هل تريد حذف الطالب {student.Name}؟");
        if (!confirmed)
            return;

        try
        {
            var response = await EnrollmentService.DeleteStudentAsync(student.Id);
            if (response == null || !response.Success)
            {
                _errorMessage = response?.Message ?? "فشل حذف الطالب.";
                return;
            }

            _successMessage = "تم حذف الطالب بنجاح.";
            await LoadStudentsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر حذف الطالب: {ex.Message}";
        }
    }

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string GetStatusLabel(int status)
        => status switch
        {
            0 => "نشط",
            1 => "متوقف",
            2 => "متخرج",
            _ => "غير معروف"
        };

    private static string GetStatusClass(int status)
        => status switch
        {
            0 => "status-active",
            1 => "status-inactive",
            2 => "status-graduated",
            _ => "status-inactive"
        };

    private sealed class StudentRow
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Phone { get; set; }
        public string? Gender { get; set; }
        public int Age { get; set; }
        public DateTime EnrollmentDate { get; set; }
        public int Status { get; set; }
        public int Score { get; set; }
        public Guid MosqueId { get; set; }
        public string MosqueName { get; set; } = string.Empty;

        public static StudentRow FromMember(MemberProfileDto member)
            => new()
            {
                Id = member.Id,
                Name = member.Name ?? string.Empty,
                Email = member.Email ?? string.Empty,
                Phone = member.Phone,
                Gender = member.Gender,
                Age = member.StudentDetails?.Age ?? 0,
                EnrollmentDate = member.StudentDetails?.EnrollmentDate ?? member.JoinedAt,
                Status = member.Status,
                Score = member.StudentDetails?.Score ?? 0,
                MosqueId = member.MosqueId ?? Guid.Empty,
                MosqueName = member.MosqueName ?? string.Empty
            };
    }

    private sealed class StudentDialogModel
    {
        public Guid Id { get; set; }

        [Required(ErrorMessage = "اسم الطالب مطلوب")]
        [StringLength(100, MinimumLength = 2, ErrorMessage = "اسم الطالب يجب أن يكون بين 2 و 100 حرف")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "البريد الإلكتروني مطلوب")]
        [EmailAddress(ErrorMessage = "البريد الإلكتروني غير صالح")]
        public string Email { get; set; } = string.Empty;

        [Phone(ErrorMessage = "رقم الهاتف غير صالح")]
        public string? Phone { get; set; }

        [Required(ErrorMessage = "الجنس مطلوب")]
        public string Gender { get; set; } = "Male";

        [Range(1, 100, ErrorMessage = "العمر يجب أن يكون بين 1 و 100")]
        public int Age { get; set; } = 12;

        public DateTime EnrollmentDate { get; set; } = DateTime.Today;

        [Range(0, 2, ErrorMessage = "حالة الحساب غير صالحة")]
        public int Status { get; set; }

        [Range(0, 100, ErrorMessage = "النقاط يجب أن تكون بين 0 و 100")]
        public int Score { get; set; }

        public Guid MosqueId { get; set; }

        [StringLength(100, MinimumLength = 6, ErrorMessage = "كلمة المرور يجب أن تكون 6 أحرف على الأقل")]
        public string? Password { get; set; }
    }
