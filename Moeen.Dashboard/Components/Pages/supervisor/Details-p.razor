@page "/details-p" 
@inject NavigationManager mgr

<style>
    :root {
        --primary-green: #195042;
        --primary-green-dark: #123d32;
        --accent-beige: #d6cabc;
        --light-beige: #f4f1ee;
        --white: #ffffff;
        --text-dark: #2d3436;
        --border-gray: #f1f1f1;
        --bg-row-hover: #fafafa;
        --font-main: 'Tajawal', sans-serif;
    }

    /* تنسيق كرت التفاصيل */
    .details-card-container {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        overflow: hidden;
        max-width: 500px;
        margin: 20px auto;
        border: 1px solid var(--accent-beige);
        font-family: var(--font-main);
    }

    .details-header {
        background-color: var(--primary-green);
        color: white;
        padding: 20px;
        text-align: center;
    }

    .person-icon {
        font-size: 2.5rem;
        display: block;
        margin-bottom: 10px;
        color: var(--accent-beige);
    }

    .details-body {
        padding: 25px;
        direction: rtl;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .info-item {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

        .info-item.full-width {
            grid-column: span 2;
        }

        .info-item label {
            font-size: 0.85rem;
            color: #91855a;
            margin-bottom: 5px;
            font-weight: bold;
        }

        .info-item .value {
            font-size: 1rem;
            color: var(--primary-green);
            background: #fcfbf9;
            padding: 8px 12px;
            border-radius: 8px;
            width: 100%;
            border-right: 3px solid var(--accent-beige);
        }

    /* تنسيق الجدول الموحد */
    .management-container {
        max-width: 500px; /* جعل الجدول بنفس عرض الكرت للتناسق */
        margin: 0 auto 2rem;
        padding: 0 10px;
        direction: rtl;
        font-family: var(--font-main);
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 8px;
    }

        .data-table th {
            background-color: var(--light-beige);
            color: var(--primary-green);
            padding: 12px 15px;
            text-align: right;
        }

        .data-table tbody tr {
            background-color: var(--white);
            transition: 0.3s;
        }

            .data-table tbody tr td {
                padding: 12px 15px;
                border-top: 1px solid var(--border-gray);
                border-bottom: 1px solid var(--border-gray);
            }

            .data-table tbody tr:hover {
                background-color: var(--bg-row-hover);
            }

    /* أيقونة العرض */
    .actions-cell {
        text-align: center;
    }

    .btn-icon.info {
        background: none;
        border: none;
        color: var(--primary-green);
        font-size: 1.2rem;
        cursor: pointer;
        transition: 0.3s;
    }

        .btn-icon.info:hover {
            transform: scale(1.2);
        }

</style>

<div class="details-card-container">
    <div class="details-header">
        <i class="bi bi-person-badge-fill person-icon"></i>
        <h4>تفاصيل ولي الأمر</h4>
    </div>
    
    <div class="details-body">
        <div class="info-grid">
            <div class="info-item">
                <label>الاسم الكامل</label>
                <div class="value">مصطفى محمد المحمد</div>
            </div>

            <div class="info-item">
                <label>المهنة / الوظيفة</label>
                <div class="value">مهندس برمجيات</div>
            </div>

            <div class="info-item">
                <label>البريد الإلكتروني</label>
                <div class="value">mostafa@example.com</div>
            </div>

            <div class="info-item full-width">
                <label>العنوان</label>
                <div class="value">سوريا - حلب - الحي المرديان</div>
            </div>
        </div>
    </div>
</div>

<section class="management-container">
    <h3 style="color: var(--primary-green); margin-bottom: 10px; font-size: 1.2rem;">الأبناء المسجلون</h3>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>اسم الابن</th>
                    <th class="text-center">الإجراء</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>عمر العلي</td>
                    <td class="actions-cell">
                        <button class="btn-icon info" title="عرض التفاصيل"><i class="bi bi-info-circle"></i></button>
                    </td>
                </tr>
                <tr>
                    <td>أحمد العلي</td>
                    <td class="actions-cell">
                        <button class="btn-icon info" title="عرض التفاصيل"><i class="bi bi-info-circle"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

