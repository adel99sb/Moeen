@page "/parents"
@page "/supervisor/parents"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Moeen.Dashboard.Application.Services.Abstractions
@using Moeen.Dashboard.Components.Shared
@using Moeen.Shared.Requests.Enrollment
@using Moeen.Shared.Responses.Enrollment
@inject IEnrollmentService EnrollmentService
@inject IJSRuntime JS

<style>
    .management-page { direction: rtl; color: #163f35; }
    .management-card { background: #fff; border: 1px solid rgba(25, 80, 66, 0.10); border-radius: 24px; padding: 28px; box-shadow: 0 22px 60px rgba(25, 80, 66, 0.08); }
    .management-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin-bottom: 24px; }
    .management-title { margin: 0; color: #195042; font-size: 1.65rem; font-weight: 900; letter-spacing: -0.04em; }
    .management-subtitle { margin: 7px 0 0; color: #7b7067; font-size: 0.95rem; }
    .management-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 22px; flex-wrap: wrap; }
    .search-wrapper { position: relative; width: min(100%, 430px); }
    .search-wrapper .bi { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: #195042; }
    .search-input { width: 100%; height: 48px; padding: 0 44px 0 16px; border: 1px solid #ddd5cc; border-radius: 15px; outline: none; background: #fbfaf8; color: #163f35; transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease; }
    .search-input:focus { border-color: #195042; background: #fff; box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.10); }
    .toolbar-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .btn-moeen-primary, .btn-moeen-light { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 0 17px; border-radius: 14px; border: 0; font-weight: 800; transition: transform 0.18s ease, background 0.18s ease; }
    .btn-moeen-primary { background: #195042; color: #fff; box-shadow: 0 14px 28px rgba(25, 80, 66, 0.18); }
    .btn-moeen-primary:hover:not(:disabled) { background: #123d32; transform: translateY(-1px); }
    .btn-moeen-light { background: #f4f1e8; color: #195042; border: 1px solid #e2dbd2; }
    .management-table-wrap { overflow-x: auto; border: 1px solid #eee8e0; border-radius: 18px; }
    .management-table { width: 100%; margin: 0; border-collapse: collapse; min-width: 980px; }
    .management-table th { background: #f4f1e8; color: #195042; font-weight: 900; padding: 15px 18px; border-bottom: 1px solid rgba(25, 80, 66, 0.18); white-space: nowrap; text-align: center; }
    .management-table td { padding: 15px 18px; border-bottom: 1px solid #f1ece6; vertical-align: middle; color: #263f37; text-align: center; }
    .management-table tr:last-child td { border-bottom: 0; }
    .management-table tbody tr:hover td { background: #fbfaf8; }
    .name-cell { display: flex; align-items: center; gap: 12px; font-weight: 900; color: #163f35; text-align: right; }
    .entity-avatar { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 14px; background: #195042; color: #fff; font-size: 1rem; }
    .relationship-pill { display: inline-flex; align-items: center; justify-content: center; min-width: 72px; padding: 6px 10px; border-radius: 999px; background: #f4f1e8; color: #195042; font-weight: 900; }
    .row-actions { display: flex; justify-content: center; gap: 8px; }
    .icon-btn { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid #e2dbd2; border-radius: 12px; background: #fff; color: #195042; transition: transform 0.18s ease, background 0.18s ease; }
    .icon-btn:hover { background: #f4f1e8; transform: translateY(-1px); }
    .icon-btn.info { color: #039855; }
    .icon-btn.edit { color: #2563eb; }
    .icon-btn.danger { color: #b42318; }
    .state-card { padding: 22px; border: 1px solid #eee8e0; border-radius: 18px; background: #fff; color: #195042; }
    .dialog-backdrop { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 28px; background: rgba(9, 30, 24, 0.42); backdrop-filter: blur(7px); direction: rtl; }
    .dialog-panel { width: min(100%, 860px); max-height: calc(100vh - 56px); overflow: hidden; display: flex; flex-direction: column; border-radius: 26px; background: #fff; box-shadow: 0 30px 90px rgba(0, 0, 0, 0.24); }
    .dialog-header { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 24px 28px; border-bottom: 1px solid #eee8e0; background: linear-gradient(135deg, #f7f3ed 0%, #fff 100%); }
    .dialog-title { margin: 0; color: #195042; font-size: 1.25rem; font-weight: 900; }
    .dialog-subtitle { margin: 6px 0 0; color: #7b7067; font-size: 0.9rem; }
    .dialog-close { width: 42px; height: 42px; border: 0; border-radius: 14px; background: #f4f1e8; color: #195042; }
    .dialog-body { overflow-y: auto; padding: 26px 28px; }
    .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .form-field { display: flex; flex-direction: column; gap: 8px; }
    .form-field label { color: #195042; font-weight: 900; font-size: 0.9rem; }
    .form-control-moeen { width: 100%; min-height: 46px; border: 1px solid #ddd5cc; border-radius: 14px; padding: 0 14px; background: #fbfaf8; color: #163f35; outline: none; font-weight: 700; }
    .form-control-moeen:focus { border-color: #195042; background: #fff; box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.10); }
    .dialog-footer { display: flex; justify-content: flex-start; gap: 12px; padding: 20px 28px 24px; border-top: 1px solid #eee8e0; }
    .dialog-error { margin-bottom: 16px; }
    @@media (max-width: 760px) { .management-card { padding: 20px; } .management-header { flex-direction: column; } .form-grid { grid-template-columns: 1fr; } .dialog-backdrop { padding: 12px; } }
</style>

<section class="management-page">
    <div class="management-card">
        <header class="management-header">
            <div>
                <h2 class="management-title">إدارة الأهالي</h2>
                <p class="management-subtitle">إدارة أولياء الأمور وربط كل ولي أمر بالطالب المناسب من نفس الصفحة.</p>
            </div>
            <button class="btn-moeen-primary" type="button" @onclick="OpenCreateDialog" disabled="@_isLoading">
                <i class="bi bi-plus-circle"></i>
                <span>إضافة ولي أمر جديد</span>
            </button>
        </header>

        <div class="management-toolbar">
            <div class="search-wrapper">
                <i class="bi bi-search"></i>
                <input class="search-input" value="@_searchText" placeholder="ابحث باسم ولي الأمر أو الهاتف أو الطالب..." @oninput="HandleSearch" />
            </div>
            <div class="toolbar-actions">
                <button class="btn-moeen-light" type="button" @onclick="LoadParentsAsync" disabled="@_isLoading">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>تحديث</span>
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success">@_successMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }

        @if (_isLoading)
        {
            <div class="state-card d-flex align-items-center gap-3">
                <span class="spinner-border text-success" role="status"></span>
                <span>جاري تحميل بيانات الأهالي...</span>
            </div>
        }
        else
        {
            <div class="management-table-wrap">
                <table class="management-table">
                    <thead>
                        <tr>
                            <th>الاسم</th>
                            <th>الهاتف</th>
                            <th>البريد الإلكتروني</th>
                            <th>الطالب المرتبط</th>
                            <th>صلة القرابة</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredParents.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">لا يوجد أهالي حالياً.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var parent in FilteredParents)
                            {
                                <tr>
                                    <td>
                                        <div class="name-cell">
                                            <span class="entity-avatar"><i class="bi bi-people"></i></span>
                                            <span>@parent.Name</span>
                                        </div>
                                    </td>
                                    <td>@Display(parent.Phone)</td>
                                    <td>@Display(parent.Email)</td>
                                    <td>@Display(parent.StudentName)</td>
                                    <td><span class="relationship-pill">@Display(parent.Relationship)</span></td>
                                    <td>
                                        <div class="row-actions">
                                            <button class="icon-btn info" type="button" title="عرض" @onclick="() => OpenDetailsDialog(parent)">
                                                <i class="bi bi-info-circle"></i>
                                            </button>
                                            <button class="icon-btn edit" type="button" title="تعديل" @onclick="() => OpenEditDialog(parent)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="icon-btn danger" type="button" title="حذف" @onclick="() => DeleteParentAsync(parent)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (_isDialogOpen)
    {
        <div class="dialog-backdrop" @onclick="CloseDialog">
            <div class="dialog-panel" @onclick:stopPropagation="true">
                <div class="dialog-header">
                    <div>
                        <h3 class="dialog-title">@(_isEditMode ? "تعديل بيانات ولي الأمر" : "إضافة ولي أمر جديد")</h3>
                        <p class="dialog-subtitle">أدخل بيانات ولي الأمر وحدد الطالب المرتبط، ثم اضغط حفظ.</p>
                    </div>
                    <button class="dialog-close" type="button" @onclick="CloseDialog"><i class="bi bi-x-lg"></i></button>
                </div>

                <div class="dialog-body">
                    @if (!string.IsNullOrWhiteSpace(_dialogError))
                    {
                        <div class="alert alert-danger dialog-error">@_dialogError</div>
                    }

                    <div class="form-grid">
                        <div class="form-field">
                            <label>اسم ولي الأمر</label>
                            <input class="form-control-moeen" @bind="_form.Name" placeholder="الاسم الكامل" />
                        </div>
                        <div class="form-field">
                            <label>البريد الإلكتروني</label>
                            <input class="form-control-moeen" @bind="_form.Email" placeholder="example@email.com" />
                        </div>
                        <div class="form-field">
                            <label>رقم الهاتف</label>
                            <input class="form-control-moeen" @bind="_form.Phone" placeholder="09xxxxxxxx" />
                        </div>
                        <div class="form-field">
                            <label>الجنس</label>
                            <select class="form-control-moeen" @bind="_form.Gender">
                                <option value="Male">ذكر</option>
                                <option value="Female">أنثى</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label>الطالب المرتبط</label>
                            <select class="form-control-moeen" @bind="_form.StudentId">
                                <option value="@Guid.Empty">اختر الطالب</option>
                                @foreach (var student in _students)
                                {
                                    <option value="@student.Id">@student.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label>صلة القرابة</label>
                            <select class="form-control-moeen" @bind="_form.Relationship">
                                <option value="أب">أب</option>
                                <option value="أم">أم</option>
                                <option value="ولي أمر">ولي أمر</option>
                                <option value="قريب">قريب</option>
                            </select>
                        </div>
                        @if (!_isEditMode)
                        {
                            <div class="form-field">
                                <label>كلمة المرور</label>
                                <input class="form-control-moeen" type="password" @bind="_form.Password" placeholder="6 أحرف على الأقل" />
                            </div>
                            <div class="form-field">
                                <label>تأكيد كلمة المرور</label>
                                <input class="form-control-moeen" type="password" @bind="_form.ConfirmPassword" placeholder="أعد إدخال كلمة المرور" />
                            </div>
                        }
                    </div>
                </div>

                <div class="dialog-footer">
                    <button class="btn-moeen-primary" type="button" @onclick="ApplyDialogAsync" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle"></i>
                        }
                        <span>حفظ</span>
                    </button>
                    <button class="btn-moeen-light" type="button" @onclick="CloseDialog" disabled="@_isSaving">
                        <i class="bi bi-x-lg"></i>
                        <span>إلغاء</span>
                    </button>
                </div>
            </div>
        </div>
    }

    <MemberDetailsDialog IsOpen="@_isDetailsOpen" Model="@_detailsModel" OnClose="CloseDetailsDialog" />
</section>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    private readonly List<ParentDto> _parents = new();
    private List<StudentDto> _students = new();
    private ParentFormModel _form = new();
    private MemberDetailsDialogModel _detailsModel = new();

    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isDialogOpen;
    private bool _isEditMode;
    private bool _isDetailsOpen;
    private string _searchText = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _dialogError;

    private List<ParentDto> FilteredParents => string.IsNullOrWhiteSpace(_searchText)
        ? _parents
        : _parents.Where(p =>
            (p.Name ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            (p.Phone ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            (p.Email ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            (p.StudentName ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            (p.Relationship ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadInitialDataAsync();
        StateHasChanged();
    }

    private async Task LoadInitialDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            await LoadStudentsAsync();
            await LoadParentsAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadStudentsAsync()
    {
        try
        {
            var response = await EnrollmentService.GetAllStudentsAsync(new GetAllStudentsRequest
            {
                PageNumber = 1,
                PageSize = 500
            });

            if (response == null || !response.Success)
            {
                _students = new();
                return;
            }

            var json = JsonSerializer.Serialize(response.Data);
            _students = JsonSerializer.Deserialize<List<StudentDto>>(json, JsonOptions) ?? new();
        }
        catch
        {
            _students = new();
        }
    }

    private async Task LoadParentsAsync()
    {
        _errorMessage = null;

        try
        {
            var response = await EnrollmentService.GetAllParentsAsync(new GetAllParentsRequest
            {
                PageNumber = 1,
                PageSize = 500
            });

            if (response == null || !response.Success)
            {
                _errorMessage = response?.Message ?? "فشل تحميل الأهالي.";
                _parents.Clear();
                return;
            }

            var json = JsonSerializer.Serialize(response.Data);
            var parents = JsonSerializer.Deserialize<List<ParentDto>>(json, JsonOptions) ?? new();

            _parents.Clear();
            _parents.AddRange(parents.OrderBy(p => p.Name));
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر تحميل الأهالي: {ex.Message}";
            _parents.Clear();
        }
    }

    private void HandleSearch(ChangeEventArgs args)
        => _searchText = args.Value?.ToString() ?? string.Empty;

    private void OpenCreateDialog()
    {
        _successMessage = null;
        _dialogError = null;
        _isEditMode = false;
        _form = new ParentFormModel
        {
            Gender = "Male",
            Relationship = "أب",
            StudentId = _students.FirstOrDefault()?.Id ?? Guid.Empty
        };
        _isDialogOpen = true;
    }

    private void OpenEditDialog(ParentDto parent)
    {
        _successMessage = null;
        _dialogError = null;
        _isEditMode = true;
        _form = new ParentFormModel
        {
            Id = parent.Id,
            Name = parent.Name,
            Email = parent.Email,
            Phone = parent.Phone,
            Gender = string.IsNullOrWhiteSpace(parent.Gender) ? "Male" : parent.Gender,
            StudentId = parent.StudentId,
            Relationship = string.IsNullOrWhiteSpace(parent.Relationship) ? "أب" : parent.Relationship
        };
        _isDialogOpen = true;
    }

    private void CloseDialog()
    {
        if (_isSaving)
            return;

        _isDialogOpen = false;
        _dialogError = null;
    }

    private async Task ApplyDialogAsync()
    {
        _isSaving = true;
        _dialogError = null;
        _successMessage = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_form.Name))
            {
                _dialogError = "يرجى إدخال اسم ولي الأمر.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_form.Email))
            {
                _dialogError = "يرجى إدخال البريد الإلكتروني.";
                return;
            }

            if (_form.StudentId == Guid.Empty)
            {
                _dialogError = "يرجى اختيار الطالب المرتبط بولي الأمر.";
                return;
            }

            GeneralResponse response;

            if (_isEditMode)
            {
                response = await EnrollmentService.UpdateMemberInfoAsync(new UpdateMemberInfoRequest
                {
                    MemberId = _form.Id.ToString(),
                    Name = _form.Name.Trim(),
                    Email = _form.Email.Trim(),
                    Phone = _form.Phone?.Trim() ?? string.Empty,
                    Gender = _form.Gender,
                    StudentId = _form.StudentId,
                    Relationship = _form.Relationship
                });
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_form.Password) || _form.Password.Length < 6)
                {
                    _dialogError = "كلمة المرور مطلوبة ويجب أن تكون 6 أحرف على الأقل.";
                    return;
                }

                if (!string.Equals(_form.Password, _form.ConfirmPassword, StringComparison.Ordinal))
                {
                    _dialogError = "تأكيد كلمة المرور غير مطابق.";
                    return;
                }

                response = await EnrollmentService.RegisterParentAsync(new RegisterParentRequest
                {
                    Name = _form.Name.Trim(),
                    Email = _form.Email.Trim(),
                    Password = _form.Password,
                    ConfirmPassword = _form.ConfirmPassword,
                    Phone = _form.Phone?.Trim() ?? string.Empty,
                    Gender = _form.Gender,
                    StudentId = _form.StudentId,
                    Relationship = _form.Relationship
                });
            }

            if (response == null || !response.Success)
            {
                _dialogError = response?.Message ?? "فشل حفظ بيانات ولي الأمر.";
                return;
            }

            _successMessage = _isEditMode ? "تم تعديل بيانات ولي الأمر بنجاح." : "تم إضافة ولي الأمر بنجاح.";
            _isDialogOpen = false;
            await LoadParentsAsync();
        }
        catch (Exception ex)
        {
            _dialogError = $"تعذر حفظ بيانات ولي الأمر: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteParentAsync(ParentDto parent)
    {
        _successMessage = null;
        _errorMessage = null;

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"هل تريد حذف ولي الأمر {parent.Name}؟");
        if (!confirmed)
            return;

        try
        {
            var response = await EnrollmentService.DeleteParentAsync(parent.Id);
            if (response == null || !response.Success)
            {
                _errorMessage = response?.Message ?? "فشل حذف ولي الأمر.";
                return;
            }

            _successMessage = "تم حذف ولي الأمر بنجاح.";
            await LoadParentsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر حذف ولي الأمر: {ex.Message}";
        }
    }

    private void OpenDetailsDialog(ParentDto parent)
    {
        _detailsModel = new MemberDetailsDialogModel
        {
            Title = parent.Name,
            Subtitle = "معلومات ولي الأمر",
            Sections = new List<MemberDetailsSectionModel>
            {
                new()
                {
                    Title = "البيانات الأساسية",
                    Items = new List<MemberDetailsItemModel>
                    {
                        Item("الاسم", parent.Name),
                        Item("الهاتف", parent.Phone),
                        Item("البريد الإلكتروني", parent.Email),
                        Item("الجنس", ToArabicGender(parent.Gender)),
                        Item("صلة القرابة", parent.Relationship)
                    }
                },
                new()
                {
                    Title = "الطالب المرتبط",
                    Items = new List<MemberDetailsItemModel>
                    {
                        Item("اسم الطالب", parent.StudentName),
                        Item("معرف الطالب", parent.StudentId == Guid.Empty ? null : parent.StudentId.ToString())
                    }
                }
            }
        };

        _isDetailsOpen = true;
    }

    private void CloseDetailsDialog()
        => _isDetailsOpen = false;

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string ToArabicGender(string? gender)
        => string.Equals(gender, "Female", StringComparison.OrdinalIgnoreCase) ? "أنثى" :
           string.Equals(gender, "Male", StringComparison.OrdinalIgnoreCase) ? "ذكر" :
           Display(gender);

    private static MemberDetailsItemModel Item(string label, string? value)
        => new()
        {
            Label = label,
            Value = string.IsNullOrWhiteSpace(value) ? "—" : value
        };

    private sealed class ParentFormModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Gender { get; set; } = "Male";
        public Guid StudentId { get; set; }
        public string Relationship { get; set; } = "أب";
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
