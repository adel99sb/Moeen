@page "/parents" 
@rendermode InteractiveServer
@inject NavigationManager mgr

<h3>parents</h3>
<section class="management-container">
    <header class="page-header">
        <h2 class="page-title">إدارة أولياء الأمور </h2>
    </header>
    <div class="action-bar">
        <div class="search-wrapper">
            <i class="bi bi-search"></i>
            <input type="text" class="search-input" placeholder="ابحث عن ولي أمر...">
        </div>
    </div>
<div class="table-responsive">
    <table class="data-table">
        <thead>
            <tr>
                <th>الاسم</th>
                <th class="text-center">الإجراءات</th>
            </tr>
        </thead>
        <tbody>
                
            <tr>
                <td>مصطفى المحمد</td>
                <td class="actions-cell">
                        <button class="btn-icon edit" title="عرض" @onclick="moveTopage2"><i class="bi bi-info-circle"></i></button>
                        <button class="btn-icon edit" title="تعديل" @onclick="moveTopage"><i class="bi bi-pencil-square"></i></button>
                        <button class="btn-icon delete" title="حذف"><i class="bi bi-trash"></i></button>
                </td>
            </tr>
            <tr>
                <td>محمد العلي</td>
                <td class="actions-cell">
                        <button class="btn-icon edit" title="عرض" @onclick="moveTopage2"><i class="bi bi-info-circle"></i></button>
                        <button class="btn-icon edit" title="تعديل" @onclick="moveTopage"><i class="bi bi-pencil-square"></i></button>
                    <button class="btn-icon delete" title="حذف"><i class="bi bi-trash"></i></button>
                </td>
            </tr>
        </tbody>
    </table>
</div>
</section>
@code {
    private void moveTopage()
    {
        mgr.NavigateTo("/form-p");
    }
    private void moveTopage2()
    {
        mgr.NavigateTo("/details-p");
    }
}
