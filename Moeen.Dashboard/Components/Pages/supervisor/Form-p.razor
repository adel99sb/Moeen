@page "/form-p"
@inject NavigationManager mgr
<style> 
    .form-container, .form-container * {
        box-sizing: border-box;
    }

    :root {
        --primary-green: #195042;
        --accent-beige: #d6cabc;
        --light-beige: #f4f1ee;
        --white: #ffffff;
        --text-dark: #2d3436;
        --transition: all 0.3s ease;
    }

    .form-container {
        max-width: 850px;
        margin: 2rem auto;
        background: var(--white);
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        direction: rtl; 
        overflow: hidden;
    }

    .form-header {
        background: var(--primary-green);
        color: var(--white);
        padding: 1.2rem;
        text-align: center;
    }

    form {
        padding: 2rem;
    }

    .grid-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr); 
        gap: 1.5rem;
        margin-bottom: 1.2rem;
    }
        .grid-row:nth-of-type(4) {
            grid-template-columns: repeat(3, 1fr);
        }

    .input-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .input-group label {
            color: var(--text-dark);
            font-weight: 600;
            font-size: 0.85rem;
            text-align: right;
        }

    /* حل مشكلة الأيقونات والمحاذاة */
    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
    }

        .input-wrapper i {
            position: absolute;
            right: 12px; /* تثبيت الأيقونة جهة اليمين */
            color: var(--primary-green);
            z-index: 2;
            pointer-events: none;
        }

        .input-wrapper input,
        .input-wrapper select {
            width: 100%;
            padding: 10px 35px 10px 10px;
            border: 1px solid var(--accent-beige);
            border-radius: 8px;
            background: var(--light-beige);
            font-size: 0.9rem;
            height: 45px; 
            outline: none;
            transition: var(--transition);
        }

            .input-wrapper input:focus,
            .input-wrapper select:focus {
                border-color: var(--primary-green);
                background: #fff;
            }
    .actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #eee;
    }

        .actions button, .actions a {
            flex: 1;
            height: 48px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .actions .save {
            background: var(--primary-green);
            color: white;
        }

        .actions .cancel {
            background: #f8f9fa;
            color: #dc3545;
        }

    /* حل مشكلة الميديا كويري في Razor */
    @@media (max-width: 768px) {
        .grid-row, .grid-row:nth-of-type(4) {
            grid-template-columns: 1fr !important;
        }
    }
    /* تنسيق زر إضافة ابن المخصص */
.btn-add-son {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: var(--primary-green); /* نفس لون النموذج */
    color: white;
    padding: 8px 20px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: var(--transition);
    border: none;
    margin: 1rem 0; /* مسافة بسيطة من الأعلى والأسفل */
    width: fit-content; /* جعل الحجم على مقاس النص */
}

.btn-add-son:hover {
    background-color: #123d32; /* درجة أغمق قليلاً عند الحوم */
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
}
</style>
<div class="form-container">
    <div class="form-header">
        <h2><i class="bi bi-person-plus-fill"></i> إضافة / تعديل بيانات</h2>
    </div>

    <form>
        <div class="grid-row">
            <div class="input-group">
                <label>الاسم الكامل</label>
                <div class="input-wrapper">
                    <i class="bi bi-person"></i>
                    <input type="text" placeholder="أدخل الاسم">
                </div>
            </div>
            <div class="input-group">
                <label>رقم الهاتف</label>
                <div class="input-wrapper">
                    <i class="bi bi-telephone"></i>
                    <input type="tel">
                </div>
            </div>
        </div>

        <div class="grid-row">
            <div class="input-group">
                <label>البريد الإلكتروني</label>
                <div class="input-wrapper">
                    <i class="bi bi-envelope"></i>
                    <input type="email">
                </div>
            </div>
            <div class="input-group">
                <label>كلمة المرور</label>
                <div class="input-wrapper">
                    <i class="bi bi-lock"></i>
                    <input type="password">
                </div>
            </div>
        </div>

        <div class="actions">
            <button type="submit" class="save"><i class="bi bi-check2-all"></i> حفظ البيانات</button>
            <a href="/owner/AccountManagement" class="cancel"><i class="bi bi-x-lg"></i> إلغاء</a>
        </div>
    </form>
</div>
<section class="management-container">
    <div class="table-responsive">
    <table class="data-table">
        <thead>
            <tr>
                <th>اسم الابن</th>
                <th class="text-center">الإجراء</th>
            </tr>
        </thead>
        <tbody>
                
            <tr>
                <td>عمر العلي</td>
                <td class="actions-cell">
                        <button class="btn-icon delete" title="حذف"><i class="bi bi-trash"></i></button>
                </td>
            </tr>
            <tr>
                <td>أحمد العلي</td>
                <td class="actions-cell">
                    <button class="btn-icon delete" title="حذف"><i class="bi bi-trash"></i></button>
                </td>
            </tr>
        </tbody>
    </table>
</div>
 <a href="owner/Form" class="btn btn-primary btn-add-son btn-add-son">
            <i class="bi bi-plus-lg"></i> إضافة ابن
        </a>
    </section>
@code {

