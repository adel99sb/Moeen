@page "/"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject IAuthApiService AuthApiService

<PageTitle>Login</PageTitle>

<style>
    :root {
        --primary-green: #195042;
        --primary-green-dark: #123d32;
        --accent-beige: #d6cabc;
        --light-beige: #f4f1ee;
        --white: #ffffff;
        --text-dark: #2d3436;
        --danger-red: #e74c3c;
    }

    body {
        direction: rtl;
        background: #f9f9f9;
        font-family: 'Tajawal', sans-serif;
    }

    .auth-shell {
ا        max-width: 920px;
        margin: 24px auto;
        padding: 24px;
        background: linear-gradient(180deg, #fff 0%, #fbfaf8 100%);
        border-radius: 24px;
        box-shadow: 0 14px 40px rgba(0,0,0,0.08);
    }

    .hero {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 24px;
        align-items: start;
    }

    .panel {
        background: var(--white);
        border: 1px solid #eee;
        border-radius: 18px;
        padding: 24px;
    }

    .title {
        color: var(--primary-green);
        margin-bottom: 16px;
        font-weight: 700;
    }

    .input {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #ddd;
        border-radius: 10px;
        outline: none;
        margin-top: 8px;
        margin-bottom: 14px;
    }

    .btn-primary {
        background: var(--primary-green);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 12px 18px;
        font-weight: 600;
        transition: .2s;
    }

    .btn-primary:hover { background: var(--primary-green-dark); }
    .btn-secondary {
        background: var(--light-beige);
        color: var(--primary-green);
        border: none;
        border-radius: 10px;
        padding: 12px 18px;
        font-weight: 600;
    }

    .muted-link {
        color: var(--primary-green);
        cursor: pointer;
        text-decoration: underline;
    }

    .alert-box {
        margin-top: 12px;
        padding: 12px 14px;
        border-radius: 10px;
        background: #f4f7f4;
        border: 1px solid #e3ece3;
    }

    .alert-box.error {
        background: #fff4f4;
        border-color: #f0cccc;
        color: var(--danger-red);
    }

    .status-note {
        background: #f7f3ef;
        padding: 12px 14px;
        border-radius: 12px;
        margin-bottom: 14px;
    }

    .token-box {
        margin-top: 12px;
        padding: 12px 14px;
        border-radius: 12px;
        background: #f6fbf8;
        border: 1px solid #dcefe3;
        word-break: break-all;
        font-size: 0.85rem;
        direction: ltr;
        text-align: left;
        max-height: 220px;
        overflow: auto;
    }

    @@media (max-width: 900px) {
        .hero { grid-template-columns: 1fr; }
    }
</style>

<div class="auth-shell">
    <div class="hero">
        <div class="panel">
            <h3 class="title">تسجيل الدخول</h3>

            <EditForm Model="LoginModel" OnValidSubmit="LoginAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <label>البريد الإلكتروني</label>
                <InputText class="input" @bind-Value="LoginModel.email" />

                <label>كلمة المرور</label>
                <InputText class="input" type="password" @bind-Value="LoginModel.password" />

                <div class="d-flex gap-2 flex-wrap mt-3">
                    <button class="btn-primary" type="submit" disabled="@IsBusy">
                        @(IsBusy ? "جاري تسجيل الدخول..." : "تسجيل الدخول")
                    </button>
                    <button class="btn-secondary" type="button" @onclick="GoToRegister">
                        إنشاء حساب
                    </button>
                </div>
            </EditForm>

            @if (!string.IsNullOrWhiteSpace(LoginMessage))
            {
                <div class="alert-box @(LoginSuccess ? string.Empty : "error")">@LoginMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(AccessToken))
            {
                <div class="status-note">
                    <div class="mb-2"><strong>Access Token</strong></div>
                    <div class="token-box">@AccessToken</div>
                </div>
            }

            @if (ShowConfirmNotice)
            {
                <div class="status-note">
                    هذا الحساب غير مؤكد. أدخل كود التحقق لإكمال التفعيل.
                </div>
            }

            @if (ShowResetNotice)
            {
                <div class="status-note">
                    يمكن إعادة تعيين كلمة المرور من الأسفل.
                </div>
            }
        </div>

        <div class="panel">
            <h3 class="title">تأكيد البريد</h3>
            <EditForm Model="VerifyModel" OnValidSubmit="VerifyEmailAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <label>البريد الإلكتروني</label>
                <InputText class="input" @bind-Value="VerifyModel.email" />
                <label>كود التحقق</label>
                <InputText class="input" @bind-Value="VerifyModel.verificationCode" />
                <div class="d-flex gap-2 flex-wrap mt-2">
                    <button class="btn-primary" type="submit" disabled="@IsVerifyBusy">
                        @(IsVerifyBusy ? "جاري التأكيد..." : "تأكيد الآن")
                    </button>
                    <button class="btn-secondary" type="button" @onclick="SendVerifyCodeAsync" disabled="@IsVerifyBusy">
                        إرسال الكود
                    </button>
                </div>
            </EditForm>

            <hr class="my-4" />

            <h3 class="title">إعادة تعيين كلمة المرور</h3>
            <EditForm Model="ResetModel" OnValidSubmit="ResetPasswordAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <label>معرّف المستخدم</label>
                <InputText class="input" @bind-Value="ResetUserIdText" />
                <label>كلمة المرور الجديدة</label>
                <InputText class="input" type="password" @bind-Value="ResetModel.NewPassword" />
                <button class="btn-primary mt-2" type="submit" disabled="@IsResetBusy">
                    @(IsResetBusy ? "جاري التحديث..." : "تحديث كلمة المرور")
                </button>
            </EditForm>

            @if (!string.IsNullOrWhiteSpace(VerifyMessage))
            {
                <div class="alert-box @(VerifySuccess ? string.Empty : "error")">@VerifyMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(ResetMessage))
            {
                <div class="alert-box @(ResetSuccess ? string.Empty : "error")">@ResetMessage</div>
            }
        </div>
    </div>
</div>

@code {
    private LoginRequest LoginModel { get; set; } = new();
    private VerifyEmailRequest VerifyModel { get; set; } = new();
    private ResetPasswordRequest ResetModel { get; set; } = new();
    private string ResetUserIdText { get; set; } = string.Empty;

    private string? LoginMessage;
    private string? AccessToken;
    private bool LoginSuccess;
    private bool IsBusy;
    private bool IsVerifyBusy;
    private bool IsResetBusy;
    private bool ShowConfirmNotice;
    private bool ShowResetNotice;
    private string? VerifyMessage;
    private bool VerifySuccess;
    private string? ResetMessage;
    private bool ResetSuccess;

    private async Task LoginAsync()
    {
        try
        {
            IsBusy = true;
            var result = await AuthApiService.LoginAsync(LoginModel);
            LoginSuccess = result.Success;
            LoginMessage = result.Message;

            if (result.Success && !string.IsNullOrWhiteSpace(result.Data?.AccessToken))
            {
                AccessToken = result.Data.AccessToken;
                var claims = JwtHelper.ReadClaims(result.Data.AccessToken);
                ShowConfirmNotice = claims.EmailConfirmed is false;
                ShowResetNotice = false;
                if (claims.EmailConfirmed is false)
                {
                    VerifyModel.email = LoginModel.email;
                }
            }
        }
        catch (Exception ex)
        {
            LoginSuccess = false;
            LoginMessage = $"فشل تسجيل الدخول: {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task VerifyEmailAsync()
    {
        try
        {
            IsVerifyBusy = true;
            var result = await AuthApiService.VerifyEmailAsync(VerifyModel);
            VerifySuccess = result.Success;
            VerifyMessage = result.Message;
            ShowConfirmNotice = !result.Success;
            if (result.Success)
            {
                AccessToken = AccessToken;
                ShowConfirmNotice = false;
            }
        }
        catch (Exception ex)
        {
            VerifySuccess = false;
            VerifyMessage = $"فشل التحقق: {ex.Message}";
        }
        finally
        {
            IsVerifyBusy = false;
        }
    }

    private async Task SendVerifyCodeAsync()
    {
        try
        {
            IsVerifyBusy = true;
            var result = await AuthApiService.SendVerifyCodeAsync(new SendVerifyEmailCodeRequest
            {
                email = string.IsNullOrWhiteSpace(VerifyModel.email) ? LoginModel.email : VerifyModel.email
            });
            VerifySuccess = result.Success;
            VerifyMessage = result.Message;
        }
        catch (Exception ex)
        {
            VerifySuccess = false;
            VerifyMessage = $"فشل إرسال كود التحقق: {ex.Message}";
        }
        finally
        {
            IsVerifyBusy = false;
        }
    }

    private async Task ResetPasswordAsync()
    {
        try
        {
            IsResetBusy = true;
            if (!Guid.TryParse(ResetUserIdText, out var uid))
            {
                ResetSuccess = false;
                ResetMessage = "معرّف المستخدم غير صالح.";
                return;
            }

            ResetModel.Uid = uid;
            var result = await AuthApiService.ResetPasswordAsync(ResetModel);
            ResetSuccess = result.Success;
            ResetMessage = result.Message;
        }
        catch (Exception ex)
        {
            ResetSuccess = false;
            ResetMessage = $"فشل إعادة تعيين كلمة المرور: {ex.Message}";
        }
        finally
        {
            IsResetBusy = false;
        }
    }

    private void GoToRegister() => Nav.NavigateTo("/register");

    private sealed class JwtHelper
    {
        public static JwtClaims ReadClaims(string token)
        {
            var parts = token.Split('.');
            if (parts.Length < 2)
            {
                return new JwtClaims();
            }

            var payload = parts[1];
            payload = payload.PadRight(payload.Length + (4 - payload.Length % 4) % 4, '=').Replace('-', '+').Replace('_', '/');
            var json = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload));
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;

            return new JwtClaims
            {
                EmailConfirmed = ParseBool(root, "EmailConfirmed"),
                Role = ParseString(root, "http://schemas.microsoft.com/ws/2008/06/identity/claims/role"),
                UserIdentifier = ParseString(root, "UserIdentifier")
            };
        }

        private static bool ParseBool(System.Text.Json.JsonElement root, string key)
        {
            return root.TryGetProperty(key, out var prop) &&
                   bool.TryParse(prop.GetString(), out var value) &&
                   value;
        }

        private static string? ParseString(System.Text.Json.JsonElement root, string key)
            => root.TryGetProperty(key, out var prop) ? prop.GetString() : null;
    }

    private sealed class JwtClaims
    {
        public bool EmailConfirmed { get; set; }
        public string? Role { get; set; }
        public string? UserIdentifier { get; set; }
    }
}
