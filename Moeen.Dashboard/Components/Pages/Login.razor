@page "/"
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Login</PageTitle>

<h3 class="mb-4">Login</h3>

<form>

    <!-- Email -->
    <div class="mb-3">
        <label class="form-label">Email</label>
    </div>

    <!-- Password -->
    <div class="mb-3">
        <label class="form-label">Password</label>
<input />
    </div>


    <!-- Submit -->
    <div class="d-flex align-items-center mt-3">
        <button class="btn btn-primary" type="button">
                <span class="spinner-border spinner-border-sm"></span>
                <span class="ms-2">Logging in...</span>
                <span>Login</span>
        </button>

        <button class="btn btn-link ms-3" type="button">
        </button>
    </div>
</form>
    <div class="card mt-4 border-success">
        <div class="card-body">
            <h5 class="card-title text-success">تأكيد الحساب</h5>
            <p class="small text-muted">يرجى إدخال الكود الذي وصلك على الإيميل:</p>
            
            <div class="input-group mb-3">
                <input type="text" class="form-control" placeholder="000000"/>
                <button class="btn btn-success" type="button">
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>تأكيد الآن</span>
                </button>
            </div>
            
                <div class="alert "alert-success" py-1 small">
                    VerifyStatusMessage
                </div>
        </div>
    </div>

    <div class="alert "alert-success" mt-3">
        VerificationMessage
    </div>

@code {

    }