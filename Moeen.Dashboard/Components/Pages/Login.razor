@page "/"
@layout Moeen.Dashboard.Components.Layout.LoginLayout

@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Requests.Identity
@inject IAuthService AuthService
@inject ITokenService TokenService
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>تسجيل الدخول - لوحة معين</PageTitle>

<div class="moeen-login-page" dir="rtl">
    <header class="moeen-login-header">
        <div class="moeen-login-brand">معين</div>
    </header>

    <main class="moeen-login-main">
        <section class="moeen-login-card" aria-labelledby="login-title">
            <div class="moeen-login-logo" aria-hidden="true">
                <img src="/images/moeen-logo.svg" alt="" />
            </div>

            <h1 id="login-title">تسجيل الدخول</h1>
            <p class="moeen-login-subtitle">
                أدخل بيانات حسابك للوصول إلى لوحة التحكم وإدارة مهامك حسب صلاحياتك.
            </p>

            <EditForm Model="_model" OnValidSubmit="HandleLogin" class="moeen-login-form">
                <DataAnnotationsValidator />
                <DashboardValidationSummary />

                <div class="moeen-field">
                    <label for="email">البريد الإلكتروني</label>
                    <InputText id="email"
                               @bind-Value="_model.Email"
                               type="email"
                               class="moeen-input"
                               placeholder="name@example.com" />
                    <ValidationMessage For="@(() => _model.Email)" />
                </div>

                <div class="moeen-field">
                    <label for="password">كلمة المرور</label>
                    <InputText id="password"
                               @bind-Value="_model.Password"
                               type="password"
                               class="moeen-input"
                               placeholder="********" />
                    <ValidationMessage For="@(() => _model.Password)" />
                </div>

                @if (ShowMessage && !string.IsNullOrWhiteSpace(Message))
                {
                    <div class="moeen-login-alert" role="alert">
                        @Message
                    </div>
                }

                <button class="moeen-login-button" type="submit" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        <span>جاري تسجيل الدخول...</span>
                    }
                    else
                    {
                        <span>دخول</span>
                    }
                </button>
            </EditForm>
        </section>
    </main>
</div>

<style>
    .moeen-login-page {
        min-height: 100vh;
        background:
            radial-gradient(circle at 22% 18%, rgba(25, 80, 66, 0.10), transparent 32%),
            linear-gradient(135deg, #f7f3ed 0%, #f2ede5 52%, #eee7dd 100%);
        color: #163f35;
        font-family: inherit;
    }

    .moeen-login-header {
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        padding: 0 48px;
        border-bottom: 1px solid rgba(25, 80, 66, 0.10);
        background: rgba(255, 255, 255, 0.56);
        backdrop-filter: blur(12px);
    }

    .moeen-login-brand {
        font-size: 1.65rem;
        font-weight: 800;
        letter-spacing: -0.04em;
        color: #195042;
    }

    .moeen-login-main {
        min-height: calc(100vh - 72px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px 20px;
    }

    .moeen-login-card {
        width: min(100%, 520px);
        padding: 42px 42px 36px;
        border: 1px solid rgba(25, 80, 66, 0.12);
        border-radius: 28px;
        background: rgba(255, 255, 255, 0.92);
        box-shadow: 0 26px 80px rgba(25, 80, 66, 0.14);
    }

    .moeen-login-logo {
        width: 92px;
        height: 88px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
    }

    .moeen-login-logo img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: contain;
    }

    .moeen-login-card h1 {
        margin: 0;
        text-align: center;
        font-size: 2rem;
        font-weight: 800;
        color: #195042;
    }

    .moeen-login-subtitle {
        max-width: 360px;
        margin: 12px auto 34px;
        text-align: center;
        color: #7b7067;
        line-height: 1.8;
    }

    .moeen-login-form {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .moeen-field label {
        display: block;
        margin-bottom: 10px;
        color: #263f37;
        font-weight: 700;
    }

    .moeen-input {
        width: 100%;
        height: 54px;
        padding: 0 16px;
        border: 1px solid #ddd5cc;
        border-radius: 13px;
        background: #fff;
        color: #173f35;
        font-size: 1rem;
        outline: none;
        transition: border-color 0.18s ease, box-shadow 0.18s ease;
    }

    .moeen-input:focus {
        border-color: #195042;
        box-shadow: 0 0 0 4px rgba(25, 80, 66, 0.12);
    }

    .moeen-input::placeholder {
        color: #aaa19a;
    }

    .validation-message {
        display: block;
        margin-top: 8px;
        color: #b42318;
        font-size: 0.875rem;
    }

    .moeen-login-alert {
        padding: 12px 14px;
        border: 1px solid rgba(180, 35, 24, 0.20);
        border-radius: 13px;
        background: #fff3f1;
        color: #9b1c13;
        font-size: 0.95rem;
    }

    .moeen-login-button {
        height: 56px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: 0;
        border-radius: 14px;
        background: #195042;
        color: #fff;
        font-size: 1.05rem;
        font-weight: 800;
        cursor: pointer;
        box-shadow: 0 16px 32px rgba(25, 80, 66, 0.22);
        transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    }

    .moeen-login-button:hover:not(:disabled) {
        background: #123d32;
        transform: translateY(-1px);
        box-shadow: 0 18px 38px rgba(25, 80, 66, 0.26);
    }

    .moeen-login-button:disabled {
        opacity: 0.72;
        cursor: not-allowed;
    }

    @@media (max-width: 640px) {
        .moeen-login-header {
            padding: 0 22px;
        }

        .moeen-login-card {
            padding: 34px 22px 28px;
            border-radius: 22px;
        }
    }
</style>

@code {
    private LoginRequest _model = new();

    private bool _isLoading;
    private bool ShowMessage;
    private string? Message;

    private async Task HandleLogin()
    {
        ShowMessage = false;
        Message = null;

        try
        {
            _isLoading = true;
            var result = await AuthService.Login(_model);
            if (result != null && !string.IsNullOrWhiteSpace(result.Token))
            {
                await TokenService.Save(result.Token);
                var session = await TokenService.GetSession();
                Nav.NavigateTo(session.HomeRoute, replace: true);
                return;
            }

            ShowMessage = true;
            Message = "فشل تسجيل الدخول. تأكد من البريد الإلكتروني وكلمة المرور.";
        }
        catch (Exception ex)
        {
            ShowMessage = true;
            Message = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
