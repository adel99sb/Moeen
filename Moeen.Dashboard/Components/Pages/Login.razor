@page "/"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject IAuthApiService AuthApiService
@inject IAuthSessionService AuthSession

<PageTitle>Login</PageTitle>

<style>
    :root {
        --primary-green: #195042;
        --primary-green-dark: #123d32;
        --accent-beige: #d6cabc;
        --light-beige: #f4f1ee;
        --white: #ffffff;
        --text-dark: #2d3436;
        --danger-red: #e74c3c;
    }

    body {
        direction: rtl;
        background: #f9f9f9;
        font-family: 'Tajawal', sans-serif;
    }

    .auth-shell {
        max-width: 980px;
        margin: 24px auto;
        padding: 24px;
        background: linear-gradient(180deg, #fff 0%, #fbfaf8 100%);
        border-radius: 24px;
        box-shadow: 0 14px 40px rgba(0,0,0,0.08);
    }

    .hero {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 24px;
        align-items: start;
    }

    .panel {
        background: var(--white);
        border: 1px solid #eee;
        border-radius: 18px;
        padding: 24px;
    }

    .title {
        color: var(--primary-green);
        margin-bottom: 16px;
        font-weight: 700;
    }

    .input {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #ddd;
        border-radius: 10px;
        outline: none;
        margin-top: 8px;
        margin-bottom: 14px;
    }

    .btn-primary {
        background: var(--primary-green);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 12px 18px;
        font-weight: 600;
        transition: .2s;
    }

    .btn-primary:hover { background: var(--primary-green-dark); }
    .btn-secondary {
        background: var(--light-beige);
        color: var(--primary-green);
        border: none;
        border-radius: 10px;
        padding: 12px 18px;
        font-weight: 600;
    }

    .alert-box {
        margin-top: 12px;
        padding: 12px 14px;
        border-radius: 10px;
        background: #f4f7f4;
        border: 1px solid #e3ece3;
    }

    .alert-box.error {
        background: #fff4f4;
        border-color: #f0cccc;
        color: var(--danger-red);
    }

    .status-note {
        background: #f7f3ef;
        padding: 12px 14px;
        border-radius: 12px;
        margin-top: 14px;
    }

    .token-box {
        margin-top: 12px;
        padding: 12px 14px;
        border-radius: 12px;
        background: #f6fbf8;
        border: 1px solid #dcefe3;
        word-break: break-all;
        font-size: 0.85rem;
        direction: ltr;
        text-align: left;
        max-height: 220px;
        overflow: auto;
    }

    @@media (max-width: 900px) {
        .hero { grid-template-columns: 1fr; }
    }
</style>

<div class="auth-shell">
    <div class="hero">
        <div class="panel">
            <h3 class="title">تسجيل الدخول</h3>

            <EditForm Model="LoginModel" OnValidSubmit="LoginAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <label>البريد الإلكتروني</label>
                <InputText class="input" @bind-Value="LoginModel.email" />

                <label>كلمة المرور</label>
                <InputText class="input" type="password" @bind-Value="LoginModel.password" />

                <div class="d-flex gap-2 flex-wrap mt-3">
                    <button class="btn-primary" type="submit" disabled="@IsBusy">
                        @(IsBusy ? "جاري تسجيل الدخول..." : "تسجيل الدخول")
                    </button>
                    <button class="btn-secondary" type="button" @onclick="GoToRegister">إنشاء حساب</button>
                    <button class="btn-secondary" type="button" @onclick="GoToVerifyEmail">تأكيد البريد</button>
                    <button class="btn-secondary" type="button" @onclick="GoToResetPassword">إعادة التعيين</button>
                </div>
            </EditForm>

            @if (!string.IsNullOrWhiteSpace(LoginMessage))
            {
                <div class="alert-box @(LoginSuccess ? string.Empty : "error")">@LoginMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(AccessToken))
            {
                <div class="status-note">
                    <strong>Access Token</strong>
                    <div class="token-box">@AccessToken</div>
                </div>
            }

            @if (ShowConfirmNotice)
            {
                <div class="status-note">
                    هذا الحساب غير مؤكد. انتقل إلى صفحة تأكيد البريد لإدخال الكود.
                </div>
            }
        </div>

        <div class="panel">
            <h3 class="title">ملاحظات</h3>
            <div class="status-note">
                بعد نجاح تسجيل الدخول يتم حفظ التوكن في المتصفح لاستخدامه لاحقًا في الاختبار.
            </div>
            <div class="status-note">
                إذا كان الحساب غير مؤكد، استخدم صفحة تأكيد البريد لإدخال الكود المرسل.
            </div>
        </div>
    </div>
</div>

@code {
    private LoginRequest LoginModel { get; set; } = new();
    private string? LoginMessage;
    private string? AccessToken;
    private bool LoginSuccess;
    private bool IsBusy;
    private bool ShowConfirmNotice;

    private async Task LoginAsync()
    {
        try
        {
            IsBusy = true;
            var result = await AuthApiService.LoginAsync(LoginModel);
            LoginSuccess = result.Success;
            LoginMessage = result.Message;

            if (result.Success && !string.IsNullOrWhiteSpace(result.Data?.AccessToken))
            {
                AccessToken = result.Data.AccessToken;
                await AuthSession.SetTokenAsync(AccessToken);

                var claims = JwtHelper.ReadClaims(result.Data.AccessToken);
                ShowConfirmNotice = !claims.EmailConfirmed;

                if (!ShowConfirmNotice)
                {
                    NavigateByRole(AuthSession.Role);
                }
            }
        }
        catch (Exception ex)
        {
            LoginSuccess = false;
            LoginMessage = $"فشل تسجيل الدخول: {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void GoToRegister() => Nav.NavigateTo("/register");
    private void GoToVerifyEmail() => Nav.NavigateTo("/verify-email");
    private void GoToResetPassword() => Nav.NavigateTo("/reset-password");

    private void NavigateByRole(string? role)
    {
        switch (role?.ToLowerInvariant())
        {
            case "owner":
                Nav.NavigateTo("/owner/AccountManagement");
                break;
            case "supervisor":
                Nav.NavigateTo("/supervisor/SupervisorDashboard");
                break;
            case "teacher":
                Nav.NavigateTo("/Teacher/TeacherDashboard");
                break;
            case "examer":
                Nav.NavigateTo("/Examer/Dashboard");
                break;
            default:
                Nav.NavigateTo("/");
                break;
        }
    }

    private sealed class JwtHelper
    {
        public static JwtClaims ReadClaims(string token)
        {
            var parts = token.Split('.');
            if (parts.Length < 2) return new JwtClaims();

            var payload = parts[1].PadRight(parts[1].Length + (4 - parts[1].Length % 4) % 4, '=')
                                  .Replace('-', '+')
                                  .Replace('_', '/');
            var json = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload));
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;

            return new JwtClaims
            {
                EmailConfirmed = ParseBool(root, "EmailConfirmed")
            };
        }

        private static bool ParseBool(System.Text.Json.JsonElement root, string key)
        {
            return root.TryGetProperty(key, out var prop) &&
                   bool.TryParse(prop.GetString(), out var value) &&
                   value;
        }
    }

    private sealed class JwtClaims
    {
        public bool EmailConfirmed { get; set; }
    }
}
