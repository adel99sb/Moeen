@page "/"

@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Requests.Identity
@inject IAuthService AuthService
@inject ITokenService TokenService
@inject NavigationManager Nav
@inject ILogger<Login> Logger
@rendermode InteractiveServer

<PageTitle>Login</PageTitle>

<h3 class="mb-4">Login</h3>

<EditForm Model="_model">

    <DataAnnotationsValidator />
    <ValidationSummary />

    <!-- Email -->
    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText @bind-Value="_model.Email" class="form-control" />
        <ValidationMessage For="@(() => _model.Email)" />
    </div>

    <!-- Password -->
    <div class="mb-3">
        <label class="form-label">Password</label>
        <InputText @bind-Value="_model.Password"
                   type="password"
                   class="form-control" />
        <ValidationMessage For="@(() => _model.Password)" />
    </div>

    <!-- Error Message -->
    @if (ShowMessage)
    {
        <div class="alert alert-danger">
            @Message
        </div>
    }

    <!-- Submit -->
    <div class="d-flex align-items-center mt-3">
        <button class="btn btn-primary" type="button"
                @onclick="HandleLogin"
                disabled="@_isLoading">
            @if (_isLoading)
            {
                <span class="spinner-border spinner-border-sm"></span>
                <span class="ms-2">Logging in...</span>
            }
            else
            {
                <span>Login</span>
            }
        </button>

        <button class="btn btn-link ms-3" type="button"
                @onclick="HandleSendVerificationCode"
                disabled="@(_isLoading || _isSendingCode)">
            إرسال كود التفعيل؟
        </button>
    </div>
</EditForm>
@if (IsVerificationSuccess)
{
    <div class="card mt-4 border-success">
        <div class="card-body">
            <h5 class="card-title text-success">تأكيد الحساب</h5>
            <p class="small text-muted">يرجى إدخال الكود الذي وصلك على الإيميل:</p>
            
            <div class="input-group mb-3">
                <input type="text" class="form-control" placeholder="000000" @bind="_verifyModel.Code" />
                <button class="btn btn-success" type="button" @onclick="HandleVerifyEmail" disabled="_isVerifying">
                    @if (_isVerifying)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <span>تأكيد الآن</span>
                    }
                </button>
            </div>
            
            @if (!string.IsNullOrEmpty(VerifyStatusMessage))
            {
                <div class="alert @(IsVerifyError ? "alert-danger" : "alert-success") py-1 small">
                    @VerifyStatusMessage
                </div>
            }
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(VerificationMessage) && !IsVerificationSuccess)
{
    <div class="alert @(IsVerificationSuccess ? "alert-success" : "alert-warning") mt-3">
        @VerificationMessage
    </div>
}

@code {

    private LoginRequest _model = new();

    private bool _isLoading = false;
    private bool ShowMessage;
    private string Message;

    private async Task HandleLogin()
    {
        ShowMessage = true;
        try
        {
            _isLoading = true;
            var result = await AuthService.Login(_model);
            if (result != null)
            {
                await TokenService.Save(result.Token);
                Message = "Login successful";
                Nav.NavigateTo("/counter");
            }
            else
            {
                Message = "Login failed. Please check your credentials.";
            }

        }
        catch (Exception ex)
        {
            Message = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
