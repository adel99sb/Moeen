@page "/settings"
<h3>Settings</h3>
 <!-- كارد النسخ الاحتياطي -->
    
    <div class="card" style="width:250px;">
        <h3>لنسخ الاحتياطي </h3>
        <p>آخر نسخ احتياطي :أبدا</p>
        <p>قم بعمل نسخة احتياطية لبياناتك هنا.</p>
        
        <button class="btn btn-primary">نسخ احتياطي</button>
    </div>
<hr>
    <!-- كارد المظهر -->
    <div>
        <h2>المظهر</h2>

        <!-- تغيير السمة -->
         <div class="card" style="width:250px;">
        <label class="label">تغيير السمة:</label>
         <select class="select">
            <option value="light">فاتح</option>
            <option value="dark">داكن</option>
        </select>
        </div>
        
        <!-- حجم الخط -->
        <div class="card" style="width:250px;">
        <label class="label">حجم الخط:</label>
        <select class="select">
            <option value="large">كبير</option>
            <option value="medium">وسط</option>
            <option value="small">صغير</option>
        </select>
         </div>
    </div>
<hr>

<div class="main">
    <!-- كارد الشكاوي -->
    <div>
        <h3>الشكاوي </h3>
           <table class="table">
            <thead>
                <tr>
                    <th>الشكوى</th>
                    <th>حالة الشكوى</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>بطء في التحميل</td>
                    <td>
                        <button class="btn btn-accent">تم الحل</button>
                        <button class="btn btn-accent">قيد الحل</button>
                        <button class="btn btn-danger">حذف</button>
                    </td>
                </tr>
                <tr>
                    <td>وجود مشاكل في تسجيل الدخول</td>
                    <td>
                        <button class="btn btn-accent">تم الحل</button>
                        <button class="btn btn-accent">قيد الحل</button>
                        <button class="btn btn-danger">حذف</button>
                    </td>
                </tr>
			</tbody>
            </table>
    </div>
</div>
