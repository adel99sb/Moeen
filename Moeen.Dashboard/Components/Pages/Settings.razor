@page "/settings"
@using Moeen.Frontend.Services.Abstractions
@using Moeen.Shared.Requests.Feedback
@using Moeen.Shared.Requests
@inject IFeedbackService FeedbackService
@rendermode InteractiveServer
    <style>
         :root {
--primary-green: #195042;
--accent-beige: #d6cabc;
--light-beige: #f4f1ee;
--white: #ffffff;
--text-dark: #2d3436;
--status-green: #2ecc71;
--danger-red: #e74c3c;
        --transition: all 0.3s ease;
    --shadow-md: 0 6px 15px rgba(0,0,0,0.12);


}
body {
font-family: 'Tajawal', sans-serif;
background-color: #f9f9f9;
direction: rtl;
}
.management-container {
background: var(--white);
margin: 20px;
padding: 30px;
border-radius: 20px;
box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}
/* العنوان */
.page-title {
color: var(--primary-green);
position: relative;
padding-bottom: 10px; /* مسافة بين النص والخط */
border-bottom: 3px solid #d6cabc; /* جعل الخط بلون البيج */
display: inline-block; /* ليصبح طول الخط على قدر الكلمة فقط */
}
     /* الكاردات */
             .card-container{
                display:flex;
                gap:20px;
                flex-wrap:wrap;
             }
           .card {
               flex:1 1 calc(50%-20px);
    grid-template-columns: repeat(2,1fr);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    padding: 20px;
    background-color: #efebe9;
    transition: var(--transition);
    align-content:center;
}

    .card:hover {
        transform: translateY(-5px);
            border-color: #195042;
    }
                /* اسم الفوج */
                .card h3 {
                    margin-bottom: 10px;
                    padding-right:10px;
                }

            /* الحلقات */
            .sessions {
                width:auto;
                margin-right:20px;
                padding-right:30px;
                background: #d6cabc;
                padding: 8px;
                font-size:20px;
                border-radius: 10px;
        border-color: #195042;
                margin-bottom: 3px;
            }
              .btn-pprimary {
    background-color: var(--primary-green);
    font-size: 15px;
    padding: 10px 20px;
    color: var(--white);
    border-radius: 12px;
    display: inline;
    transition: 0.3s;
}

    .btn-pprimary:hover {
        background-color: #123d32;
        transform: translateY(-2px);
    }
     .table th {
        background-color: var(--light-beige);
        color: var(--primary-green);
        padding: 12px;
    }
    .table td {
        background-color: var(--white);
        padding: 10px;
        border-bottom: 1px solid #eee;

    }
    .table tbody tr:hover {
        background-color: #fafafa;
        transform: scale(1.01);
    }
    .table-wrapper{
		overflow-x: auto;
		width: 100%;
		border-radius: var(--radius-md);
	}
    .actions-cell {
        text-align: center; /* توسيط المحتوى داخل الخلية */
        min-width: 100px; /* نضمن مساحة كافية للأيقونات */
    }

    .btn-icon.edit {
        color: var(--primary-green);
    }

    .btn-icon.delete {
        color: var(--danger-red);
    }

    .btn-icon:hover {
        transform: scale(1.2);
    }

    </style>
    <div class="management-container">
         <header class="page-header">
        <h2 class="page-title">الإعدادات</h2>
    </header>
 <!-- كارد النسخ الاحتياطي -->
    <div class="card-container">
    <div class="card">
        <h3>لنسخ الاحتياطي </h3>
        <br />
        <p>آخر نسخ احتياطي :أبدا</p>
        <br />
        <p>قم بعمل نسخة احتياطية لبياناتك هنا.</p>
        <br />
        
        <button class="btn-pprimary">نسخ احتياطي</button>
    </div>
<hr>
    <!-- كارد المظهر -->
    <div class="card">
        <h3>المظهر</h3>
        <br />
        <!-- تغيير السمة -->
         <div class="card">
        <label class="label">تغيير السمة:</label>
         <select class="select">
            <option value="light">فاتح</option>
            <option value="dark">داكن</option>
        </select>
        </div>
        <br />
        <!-- حجم الخط -->
        <div class="card">
        <label class="label">حجم الخط:</label>
        <select class="select">
            <option value="large">كبير</option>
            <option value="medium">وسط</option>
            <option value="small">صغير</option>
        </select>
         </div>
    </div>
    </div>



<hr>

<div >
    <!-- كارد الشكاوي -->
    <div>
        <h3>الشكاوي </h3>
        <button class="btn-pprimary" @onclick="LoadComplaintsAsync">عرض الشكاوي</button>
           <table class="table">
            <thead>
                <tr>
                    <th>الشكوى</th>
                    <th>حالة الشكوى</th>
                </tr>
            </thead>
            <tbody>
                @if (complaints.Count == 0)
                {
                    <tr>
                        <td colspan="2">لا توجد شكاوى</td>
                    </tr>
                }
                else
                {
                    @foreach (var complaint in complaints)
                    {
                        <tr>
                            <td>@complaint.Content</td>
                            <td class="actions-cell">غير متاح</td>
                        </tr>
                    }
                }
			</tbody>
            </table>
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <p>@errorMessage</p>
            }
    </div>
</div>
    </div>

@code {
    private List<ComplaintDto> complaints = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadComplaintsAsync();
    }

    private async Task LoadComplaintsAsync()
    {
        try
        {
            errorMessage = null;
            complaints = await FeedbackService.GetComplaintsAsync(new PaginationRequest
            {
                Page = 1,
                PageSize = 10
            });
        }
        catch (Exception ex)
        {
            complaints = new();
            errorMessage = ex.Message;
        }
    }

}
