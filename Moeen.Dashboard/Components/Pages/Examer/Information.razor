@page "/examer/information"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using Moeen.Dashboard.Application.Services.Abstractions
@using Moeen.Shared.Requests.Enrollment
@using Moeen.Shared.Requests.ExamQuery
@using Moeen.Shared.Responses.Enrollment
@using Moeen.Shared.Responses.ExamCommand
@using Moeen.Shared.Responses.ExamQuery
@inject IEnrollmentService EnrollmentService
@inject IExamQueryService ExamQueryService

<PageTitle>تفاصيل اختبارات الطالب</PageTitle>

<style>
    .info-page {
        direction: rtl;
        min-height: calc(100vh - 70px);
        background: #faf7f0;
        color: #163f35;
        padding: 24px;
    }

    .hero {
        background: linear-gradient(135deg, #195042, #26735f);
        color: #fff;
        border-radius: 26px;
        padding: 28px;
        box-shadow: 0 18px 45px rgba(25, 80, 66, .18);
        margin-bottom: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .hero h1 {
        margin: 0 0 8px;
        font-weight: 900;
    }

    .hero p {
        margin: 0;
        opacity: .88;
    }

    .hero-icon {
        width: 86px;
        height: 86px;
        border-radius: 28px;
        background: rgba(255,255,255,.16);
        border: 1px solid rgba(255,255,255,.22);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.4rem;
    }

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 18px;
    }

    .metric-card,
    .content-card,
    .exam-card {
        background: #fff;
        border: 1px solid #e4eee9;
        border-radius: 22px;
        box-shadow: 0 10px 28px rgba(25, 80, 66, .06);
    }

    .metric-card {
        padding: 18px;
    }

    .metric-card small {
        display: block;
        color: #7b7067;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .metric-card strong {
        color: #195042;
        font-size: 1.7rem;
        font-weight: 950;
    }

    .content-grid {
        display: grid;
        grid-template-columns: .85fr 1.15fr;
        gap: 16px;
        align-items: start;
    }

    .content-card {
        padding: 20px;
    }

    .card-title {
        margin: 0 0 14px;
        color: #195042;
        font-size: 1.15rem;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .info-row {
        border: 1px solid #edf1ee;
        background: #fbfdfa;
        border-radius: 16px;
        padding: 13px 14px;
        margin-bottom: 10px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .label {
        color: #6b7280;
        font-weight: 800;
    }

    .value {
        color: #195042;
        font-weight: 900;
    }

    .exam-card {
        padding: 16px;
        margin-bottom: 12px;
    }

    .exam-header {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
        margin-bottom: 12px;
    }

    .exam-title {
        color: #195042;
        font-weight: 950;
        margin: 0;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 6px 10px;
        background: #eef7f3;
        color: #195042;
        font-size: .82rem;
        font-weight: 900;
    }

    .exam-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
    }

    .exam-field {
        background: #fbfdfa;
        border: 1px solid #edf1ee;
        border-radius: 14px;
        padding: 10px;
    }

    .notes {
        margin-top: 10px;
        background: #f7f2ea;
        border-radius: 14px;
        padding: 10px 12px;
        color: #5f5348;
        line-height: 1.7;
    }

    .state-box {
        background: #fff;
        border: 1px dashed #d6cabc;
        border-radius: 18px;
        padding: 28px;
        text-align: center;
        color: #667085;
    }

    .error-box {
        background: #fff1f1;
        border: 1px solid #f3c4c4;
        color: #b42318;
        border-radius: 16px;
        padding: 14px 16px;
        margin-bottom: 18px;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 12px;
        padding: 10px 14px;
        background: #f4f1ee;
        color: #195042;
        font-weight: 900;
        text-decoration: none;
        margin-bottom: 16px;
    }

    @@media (max-width: 1100px) {
        .metrics-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .content-grid { grid-template-columns: 1fr; }
        .exam-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @@media (max-width: 640px) {
        .info-page { padding: 14px; }
        .metrics-grid, .exam-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="info-page">
    <a class="btn-back" href="/examer/exam"><i class="bi bi-arrow-right"></i> رجوع لقائمة الطلاب</a>

    <section class="hero">
        <div>
            <h1>تفاصيل اختبارات الطالب</h1>
            <p>عرض بيانات الطالب وسجل الاختبارات المسجلة له.</p>
        </div>
        <div class="hero-icon"><i class="bi bi-clipboard-data"></i></div>
    </section>

    @if (_isLoading)
    {
        <div class="state-box">
            <span class="spinner-border text-success" role="status"></span>
            <div class="mt-3">جاري تحميل تفاصيل الطالب...</div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="error-box">@_errorMessage</div>
        }

        @if (_selectedStudent is null)
        {
            <div class="state-box">لم يتم العثور على بيانات الطالب.</div>
        }
        else
        {
            <section class="metrics-grid">
                <div class="metric-card"><small>عدد الاختبارات</small><strong>@_exams.Count</strong></div>
                <div class="metric-card"><small>متوسط العلامة</small><strong>@FormatNumber(AverageScore)</strong></div>
                <div class="metric-card"><small>أعلى علامة</small><strong>@(_exams.Count == 0 ? 0 : _exams.Max(exam => exam.Score))</strong></div>
                <div class="metric-card"><small>نقاط الطالب</small><strong>@_selectedStudent.Score</strong></div>
            </section>

            <section class="content-grid">
                <aside class="content-card">
                    <h2 class="card-title"><i class="bi bi-person"></i> بيانات الطالب</h2>
                    <div class="info-row"><span class="label">الاسم</span><span class="value">@Display(_selectedStudent.Name)</span></div>
                    <div class="info-row"><span class="label">الإيميل</span><span class="value">@Display(_selectedStudent.Email)</span></div>
                    <div class="info-row"><span class="label">العمر</span><span class="value">@_selectedStudent.Age</span></div>
                    <div class="info-row"><span class="label">المسجد</span><span class="value">@Display(_selectedStudent.MosqueName)</span></div>
                    <div class="info-row"><span class="label">الحلقة</span><span class="value">@Display(_selectedStudent.SaturdayHalqeName)</span></div>
                    <div class="info-row"><span class="label">تاريخ الانضمام</span><span class="value">@FormatDate(_selectedStudent.JoinedAt)</span></div>
                </aside>

                <main class="content-card">
                    <h2 class="card-title"><i class="bi bi-clock-history"></i> سجل الاختبارات</h2>

                    @if (_exams.Count == 0)
                    {
                        <div class="state-box">لا توجد اختبارات مسجلة لهذا الطالب حالياً.</div>
                    }
                    else
                    {
                        @foreach (var exam in _exams.OrderByDescending(exam => exam.Date))
                        {
                            <article class="exam-card">
                                <div class="exam-header">
                                    <h3 class="exam-title">اختبار الأجزاء @exam.JuzFrom - @exam.JuzTo</h3>
                                    <span class="pill"><i class="bi bi-calendar3"></i>@FormatDate(exam.Date)</span>
                                </div>

                                <div class="exam-grid">
                                    <div class="exam-field"><span class="label">معلم الحلقة</span><div class="value">@Display(exam.HalqaTeacherName)</div></div>
                                    <div class="exam-field"><span class="label">المختبر</span><div class="value">@Display(exam.ExaminerName)</div></div>
                                    <div class="exam-field"><span class="label">العلامة</span><div class="value">@exam.Score / 100</div></div>
                                    <div class="exam-field"><span class="label">الدرجة</span><div class="value">@exam.Mark</div></div>
                                    <div class="exam-field"><span class="label">التقدير</span><div class="value">@Display(exam.Grade)</div></div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(exam.Notes))
                                {
                                    <div class="notes"><strong>ملاحظات:</strong> @exam.Notes</div>
                                }
                            </article>
                        }
                    }
                </main>
            </section>
        }
    }
</div>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    [SupplyParameterFromQuery(Name = "studentId")]
    public Guid? StudentId { get; set; }

    private readonly List<StudentDto> _students = new();
    private readonly List<ExamResultDto> _exams = new();
    private StudentDto? _selectedStudent;
    private bool _isLoading = true;
    private string? _errorMessage;

    private double AverageScore => _exams.Count == 0 ? 0 : _exams.Average(exam => exam.Score);

    protected override async Task OnInitializedAsync()
    {
        await LoadDetailsAsync();
    }

    private async Task LoadDetailsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            if (!StudentId.HasValue || StudentId.Value == Guid.Empty)
            {
                _errorMessage = "لم يتم تحديد الطالب.";
                return;
            }

            await LoadStudentAsync(StudentId.Value);
            await LoadStudentExamsAsync(StudentId.Value);
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر تحميل تفاصيل الطالب: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadStudentAsync(Guid studentId)
    {
        var response = await EnrollmentService.GetAllStudentsAsync(new GetAllStudentsRequest { PageNumber = 1, PageSize = 500 });
        if (response == null || !response.Success)
            throw new InvalidOperationException(response?.Message ?? "تعذر تحميل بيانات الطالب.");

        _students.Clear();
        _students.AddRange(DeserializeData<List<StudentDto>>(response.Data) ?? new List<StudentDto>());
        _selectedStudent = _students.FirstOrDefault(student => student.Id == studentId);
    }

    private async Task LoadStudentExamsAsync(Guid studentId)
    {
        var response = await ExamQueryService.GetStudentExamsAsync(new GetStudentExamsRequest { StudentId = studentId });
        if (response == null || !response.Success)
            throw new InvalidOperationException(response?.Message ?? "تعذر تحميل اختبارات الطالب.");

        _exams.Clear();
        _exams.AddRange(ExtractExamList(response.Data));
    }

    private static List<ExamResultDto> ExtractExamList(object? data)
    {
        var dto = DeserializeData<GetStudentExamsResponse>(data);
        if (dto?.Exams is not null)
            return dto.Exams;

        return DeserializeData<List<ExamResultDto>>(data) ?? new List<ExamResultDto>();
    }

    private static T? DeserializeData<T>(object? data)
    {
        if (data == null)
            return default;

        if (data is T typed)
            return typed;

        if (data is JsonElement element)
            return element.Deserialize<T>(JsonOptions);

        var json = JsonSerializer.Serialize(data, JsonOptions);
        return JsonSerializer.Deserialize<T>(json, JsonOptions);
    }

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "غير متوفر" : value;

    private static string FormatDate(DateTime value)
        => value == default ? "غير متوفر" : value.ToLocalTime().ToString("yyyy/MM/dd");

    private static string FormatNumber(double value)
        => value.ToString("0.##");
}
