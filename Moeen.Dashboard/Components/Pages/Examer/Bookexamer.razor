@page "/examer/bookexamer"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Moeen.Dashboard.Infrastructure.Http
@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Requests.Library
@using Moeen.Shared.Responses.Library
@inject ILibraryManagementService LibraryService

<PageTitle>مكتبة الفاحص</PageTitle>

<style>
    .library-wrapper {
        direction: rtl;
        text-align: right;
        background-color: #f4f7f6;
        padding-bottom: 42px;
        min-height: calc(100vh - 70px);
    }

    .header-custom {
        background-color: #195042;
        color: #d6cabc;
        padding: 42px 0;
        border-bottom: 6px solid #d6cabc;
        margin-bottom: 42px;
    }

    .toolbar-card {
        background: #fff;
        border: 1px solid rgba(25, 80, 66, .1);
        border-radius: 20px;
        padding: 16px;
        margin-bottom: 22px;
        box-shadow: 0 10px 25px rgba(25, 80, 66, .06);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .search-input {
        border: 1.5px solid #d6cabc;
        border-radius: 12px;
        padding: 10px 12px;
        min-width: 260px;
        outline: none;
    }

    .book-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
        overflow: hidden;
        transition: transform .3s ease, box-shadow .3s ease;
        height: 100%;
        border: none;
        display: flex;
        flex-direction: column;
    }

    .book-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 35px rgba(0,0,0,.12);
    }

    .book-cover {
        background: linear-gradient(135deg, #195042 0%, #246b59 100%);
        height: 160px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .book-cover::after {
        content: '';
        position: absolute;
        width: 140px;
        height: 140px;
        background: rgba(214,202,188,.15);
        border-radius: 50%;
        top: -30px;
        right: -30px;
        pointer-events: none;
    }

    .book-icon {
        font-size: 3.5rem;
        color: #d6cabc;
        z-index: 1;
    }

    .book-content {
        padding: 24px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .book-title {
        color: #195042;
        font-weight: 900;
        font-size: 1.25rem;
        margin-bottom: 10px;
    }

    .book-desc {
        color: #5a6c7d;
        font-size: .92rem;
        line-height: 1.65;
        margin-bottom: 16px;
        flex-grow: 1;
    }

    .book-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 16px;
        border-top: 2px solid #d6cabc;
        margin-top: auto;
        flex-wrap: wrap;
        gap: 10px;
    }

    .book-meta,
    .book-date {
        font-size: .88rem;
        color: #195042;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .book-date {
        font-size: .82rem;
        color: #5a6c7d;
        font-weight: 500;
    }

    .btn-download {
        background-color: #246b59;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 8px 14px;
        font-size: .82rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        white-space: nowrap;
    }

    .btn-download:hover {
        background-color: #195042;
        color: #d6cabc;
    }

    .state-box {
        background: #fff;
        border: 1px dashed #d6cabc;
        border-radius: 18px;
        padding: 28px;
        text-align: center;
        color: #667085;
    }

    .error-box {
        background: #fff1f1;
        border: 1px solid #f3c4c4;
        color: #b42318;
        border-radius: 16px;
        padding: 14px 16px;
        margin-bottom: 18px;
    }
</style>

<div class="library-wrapper">
    <div class="header-custom">
        <div class="container">
            <h1 class="fw-bold mb-2">مكتبة الفاحص</h1>
            <p class="mb-0">استعرض الكتب والملفات المتاحة للقراءة والتحميل.</p>
        </div>
    </div>

    <div class="container">
        <div class="toolbar-card">
            <div>
                <h5 class="fw-bold text-success mb-1">الكتب المتاحة</h5>
                <small class="text-muted">عدد الكتب: @_books.Count</small>
            </div>
            <input class="search-input" placeholder="ابحث باسم الكتاب أو المؤلف..." @bind="_search" @bind:event="oninput" />
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="error-box">@_errorMessage</div>
        }

        @if (_isLoading)
        {
            <div class="state-box">
                <span class="spinner-border text-success" role="status"></span>
                <div class="mt-3">جاري تحميل الكتب...</div>
            </div>
        }
        else if (!FilteredBooks.Any())
        {
            <div class="state-box">
                <i class="bi bi-book fs-1 d-block mb-2"></i>
                لا توجد كتب مطابقة حالياً.
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var book in FilteredBooks)
                {
                    <div class="col-lg-6">
                        <div class="book-card">
                            <div class="book-cover"><i class="bi bi-book book-icon"></i></div>
                            <div class="book-content">
                                <h3 class="book-title">@Display(book.Title)</h3>
                                <p class="book-desc">@Display(book.Description)</p>
                                <div class="book-footer">
                                    <div style="display: flex; flex-direction: column; gap: 4px;">
                                        <span class="book-meta"><i class="bi bi-person"></i>@Display(book.Author)</span>
                                        <span class="book-date"><i class="bi bi-calendar3"></i>نشر: @(book.PublicationYear?.ToString() ?? book.CreatedAt.ToLocalTime().Year.ToString())</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(book.CoverImageUrl))
                                    {
                                        <a class="btn-download" href="@ResolveBookUrl(book.CoverImageUrl)" target="_blank" rel="noopener">
                                            <i class="bi bi-download"></i> تحميل
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };
    private readonly List<BookResponseDto> _books = new();
    private bool _isLoading = true;
    private string? _errorMessage;
    private string _search = string.Empty;

    private IEnumerable<BookResponseDto> FilteredBooks => string.IsNullOrWhiteSpace(_search)
        ? _books
        : _books.Where(book => Display(book.Title).Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || Display(book.Description).Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || Display(book.Author).Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadBooksAsync();
        StateHasChanged();
    }

    private async Task LoadBooksAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await LibraryService.GetAllBooksAsync(new GetAllBooksRequest { PageNumber = 1, PageSize = 100 });
            if (response == null || !response.Success)
            {
                _errorMessage = response?.Message ?? "تعذر تحميل الكتب.";
                return;
            }

            _books.Clear();
            var books = DeserializeData<List<BookResponseDto>>(response.Data) ?? new List<BookResponseDto>();
            _books.AddRange(books.OrderBy(book => book.Title));
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر تحميل الكتب: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static T? DeserializeData<T>(object? data)
    {
        if (data == null) return default;
        if (data is T typed) return typed;
        var json = JsonSerializer.Serialize(data, JsonOptions);
        return JsonSerializer.Deserialize<T>(json, JsonOptions);
    }

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "غير متوفر" : value;

    private static string ResolveBookUrl(string url)
    {
        if (Uri.TryCreate(url, UriKind.Absolute, out _))
            return url;

        var baseUrl = ApiRoutes.BaseUrl.TrimEnd('/');
        var relative = url.TrimStart('/');
        return $"{baseUrl}/{relative}";
    }
}
