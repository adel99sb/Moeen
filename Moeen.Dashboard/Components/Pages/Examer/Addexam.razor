@page "/examer/addexam"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using Moeen.Dashboard.Application.Services.Abstractions
@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Requests.Enrollment
@using Moeen.Shared.Requests.ExamCommand
@using Moeen.Shared.Responses.Enrollment
@inject IEnrollmentService EnrollmentService
@inject IExamCommandService ExamCommandService
@inject NavigationManager Navigation

<PageTitle>إضافة اختبار</PageTitle>

<style>
    .exam-form-page {
        direction: rtl;
        min-height: calc(100vh - 70px);
        background: #faf7f0;
        color: #163f35;
        padding: 24px;
    }

    .hero {
        background: linear-gradient(135deg, #195042, #26735f);
        color: #fff;
        border-radius: 26px;
        padding: 28px;
        box-shadow: 0 18px 45px rgba(25, 80, 66, .18);
        margin-bottom: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .hero h1 {
        margin: 0 0 8px;
        font-weight: 900;
    }

    .hero p {
        margin: 0;
        opacity: .88;
    }

    .hero-icon {
        width: 86px;
        height: 86px;
        border-radius: 28px;
        background: rgba(255,255,255,.16);
        border: 1px solid rgba(255,255,255,.22);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.4rem;
    }

    .content-grid {
        display: grid;
        grid-template-columns: .85fr 1.15fr;
        gap: 16px;
        align-items: start;
    }

    .card {
        background: #fff;
        border: 1px solid #e4eee9;
        border-radius: 22px;
        box-shadow: 0 10px 28px rgba(25, 80, 66, .06);
        padding: 20px;
    }

    .card-title {
        margin: 0 0 14px;
        color: #195042;
        font-size: 1.15rem;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .info-row {
        border: 1px solid #edf1ee;
        background: #fbfdfa;
        border-radius: 16px;
        padding: 13px 14px;
        margin-bottom: 10px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .label {
        color: #6b7280;
        font-weight: 800;
    }

    .value {
        color: #195042;
        font-weight: 900;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .form-field label {
        display: block;
        margin-bottom: 7px;
        color: #31443e;
        font-weight: 900;
        font-size: .9rem;
    }

    .form-control-clean,
    .form-select-clean {
        width: 100%;
        border: 1.5px solid #d6cabc;
        border-radius: 12px;
        padding: 10px 12px;
        min-height: 45px;
        background: #fbfaf8;
        outline: none;
        color: #163f35;
    }

    textarea.form-control-clean {
        min-height: 105px;
        resize: vertical;
    }

    .full {
        grid-column: 1 / -1;
    }

    .actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 18px;
        flex-wrap: wrap;
    }

    .btn-save,
    .btn-cancel {
        border: 0;
        border-radius: 12px;
        padding: 11px 16px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .btn-save {
        background: #195042;
        color: #fff;
    }

    .btn-cancel {
        background: #f4f1ee;
        color: #195042;
    }

    .state-box {
        background: #fff;
        border: 1px dashed #d6cabc;
        border-radius: 18px;
        padding: 28px;
        text-align: center;
        color: #667085;
    }

    .error-box,
    .success-box {
        border-radius: 16px;
        padding: 14px 16px;
        margin-bottom: 18px;
    }

    .error-box {
        background: #fff1f1;
        border: 1px solid #f3c4c4;
        color: #b42318;
    }

    .success-box {
        background: #eaf8f0;
        border: 1px solid #bde6cc;
        color: #14723a;
    }

    @@media (max-width: 1000px) {
        .content-grid { grid-template-columns: 1fr; }
    }

    @@media (max-width: 640px) {
        .exam-form-page { padding: 14px; }
        .form-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="exam-form-page">
    <section class="hero">
        <div>
            <h1>إضافة اختبار</h1>
            <p>سجّل نتيجة اختبار للطالب المختار مع تحديد المعلم المسؤول ونطاق الأجزاء.</p>
        </div>
        <div class="hero-icon"><i class="bi bi-clipboard-plus"></i></div>
    </section>

    @if (_isLoading)
    {
        <div class="state-box">
            <span class="spinner-border text-success" role="status"></span>
            <div class="mt-3">جاري تحميل بيانات النموذج...</div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="error-box">@_errorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="success-box">@_successMessage</div>
        }

        <div class="content-grid">
            <aside class="card">
                <h2 class="card-title"><i class="bi bi-person"></i> الطالب المختار</h2>
                @if (_selectedStudent is null)
                {
                    <div class="state-box">لم يتم العثور على الطالب. ارجع لقائمة الطلاب واختر طالباً من جديد.</div>
                }
                else
                {
                    <div class="info-row"><span class="label">الاسم</span><span class="value">@Display(_selectedStudent.Name)</span></div>
                    <div class="info-row"><span class="label">الإيميل</span><span class="value">@Display(_selectedStudent.Email)</span></div>
                    <div class="info-row"><span class="label">المسجد</span><span class="value">@Display(_selectedStudent.MosqueName)</span></div>
                    <div class="info-row"><span class="label">الحلقة</span><span class="value">@Display(_selectedStudent.SaturdayHalqeName)</span></div>
                    <div class="info-row"><span class="label">النقاط</span><span class="value">@_selectedStudent.Score</span></div>
                }
            </aside>

            <main class="card">
                <h2 class="card-title"><i class="bi bi-pencil-square"></i> بيانات الاختبار</h2>
                <div class="form-grid">
                    <div class="form-field">
                        <label>المختبر</label>
                        <select class="form-select-clean" @bind="_form.TeacherId">
                            <option value="@Guid.Empty">اختر المختبر</option>
                            @foreach (var teacher in _teachers)
                            {
                                <option value="@teacher.Id">@Display(teacher.Name) - @Display(teacher.MosqueName)</option>
                            }
                        </select>
                    </div>

                    <div class="form-field">
                        <label>العلامة</label>
                        <input type="number" min="0" max="100" class="form-control-clean" @bind="_form.Score" />
                    </div>

                    <div class="form-field">
                        <label>من جزء</label>
                        <input type="number" min="1" max="30" class="form-control-clean" @bind="_form.JuzFrom" />
                    </div>

                    <div class="form-field">
                        <label>إلى جزء</label>
                        <input type="number" min="1" max="30" class="form-control-clean" @bind="_form.JuzTo" />
                    </div>

                    <div class="form-field full">
                        <label>ملاحظات المختبر</label>
                        <textarea class="form-control-clean" maxlength="500" @bind="_form.Notes" placeholder="اكتب ملاحظات مختصرة عن أداء الطالب..."></textarea>
                    </div>
                </div>

                <div class="actions">
                    <button type="button" class="btn-save" disabled="@(_isSaving || _selectedStudent is null)" @onclick="SaveExamAsync">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm"></span><span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2-all"></i><span>حفظ الاختبار</span>
                        }
                    </button>
                    <a class="btn-cancel" href="/examer/exam"><i class="bi bi-arrow-right"></i> رجوع</a>
                </div>
            </main>
        </div>
    }
</div>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    [SupplyParameterFromQuery(Name = "studentId")]
    public Guid? StudentId { get; set; }

    private readonly List<StudentDto> _students = new();
    private readonly List<TeacherDto> _teachers = new();
    private StudentDto? _selectedStudent;
    private ExamForm _form = new();
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadFormDataAsync();
    }

    private async Task LoadFormDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            if (!StudentId.HasValue || StudentId.Value == Guid.Empty)
            {
                _errorMessage = "لم يتم تحديد الطالب.";
                return;
            }

            await LoadStudentsAsync();
            await LoadTeachersAsync();

            _selectedStudent = _students.FirstOrDefault(student => student.Id == StudentId.Value);
            if (_selectedStudent is null)
            {
                _errorMessage = "تعذر العثور على الطالب المحدد.";
                return;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر تحميل بيانات النموذج: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadStudentsAsync()
    {
        var response = await EnrollmentService.GetAllStudentsAsync(new GetAllStudentsRequest { PageNumber = 1, PageSize = 500 });
        if (response == null || !response.Success)
            throw new InvalidOperationException(response?.Message ?? "تعذر تحميل الطلاب.");

        _students.Clear();
        _students.AddRange(DeserializeData<List<StudentDto>>(response.Data) ?? new List<StudentDto>());
    }

    private async Task LoadTeachersAsync()
    {
        var response = await EnrollmentService.GetAllTeachersAsync(new GetAllTeachersRequest { PageNumber = 1, PageSize = 500, Status = 0 });
        if (response == null || !response.Success)
            throw new InvalidOperationException(response?.Message ?? "تعذر تحميل المعلمين.");

        _teachers.Clear();
        var teachers = DeserializeData<List<TeacherDto>>(response.Data) ?? new List<TeacherDto>();
        _teachers.AddRange(teachers.OrderBy(teacher => teacher.Name));
    }

    private async Task SaveExamAsync()
    {
        _errorMessage = null;
        _successMessage = null;

        if (_selectedStudent is null)
        {
            _errorMessage = "اختر الطالب أولاً.";
            return;
        }

        var validation = ValidateForm();
        if (!string.IsNullOrWhiteSpace(validation))
        {
            _errorMessage = validation;
            return;
        }

        _isSaving = true;

        try
        {
            var response = await ExamCommandService.RegisterExamAsync(new RegisterExamRequest
            {
                StudentId = _selectedStudent.Id,
                TeacherId = _form.TeacherId,
                JuzFrom = _form.JuzFrom,
                JuzTo = _form.JuzTo,
                Score = Math.Clamp(_form.Score, 0, 100),
                Mark = Math.Clamp(_form.Score, 0, 100),
                Notes = string.IsNullOrWhiteSpace(_form.Notes) ? string.Empty : _form.Notes.Trim()
            });

            _successMessage = string.IsNullOrWhiteSpace(response.Message) ? "تم حفظ الاختبار بنجاح." : response.Message;
            _form = new ExamForm();
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر حفظ الاختبار: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private string? ValidateForm()
    {
        if (_form.TeacherId == Guid.Empty)
            return "اختر المختبر المسؤول عن الاختبار.";

        if (_form.JuzFrom < 1 || _form.JuzFrom > 30)
            return "جزء البداية يجب أن يكون بين 1 و 30.";

        if (_form.JuzTo < 1 || _form.JuzTo > 30)
            return "جزء النهاية يجب أن يكون بين 1 و 30.";

        if (_form.JuzFrom > _form.JuzTo)
            return "جزء البداية يجب أن يكون قبل أو يساوي جزء النهاية.";

        if (_form.Score < 0 || _form.Score > 100)
            return "العلامة يجب أن تكون بين 0 و 100.";

        if (_form.Notes?.Length > 500)
            return "الملاحظات يجب ألا تتجاوز 500 حرف.";

        return null;
    }

    private static T? DeserializeData<T>(object? data)
    {
        if (data == null)
            return default;

        if (data is T typed)
            return typed;

        if (data is JsonElement element)
            return element.Deserialize<T>(JsonOptions);

        var json = JsonSerializer.Serialize(data, JsonOptions);
        return JsonSerializer.Deserialize<T>(json, JsonOptions);
    }

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "غير متوفر" : value;

    private sealed class ExamForm
    {
        public Guid TeacherId { get; set; }
        public int JuzFrom { get; set; } = 1;
        public int JuzTo { get; set; } = 1;
        public int Score { get; set; }
        public string? Notes { get; set; }
    }
}
