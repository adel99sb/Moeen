@page "/examer/addexam"
@rendermode InteractiveServer
@inject NavigationManager NavManager
<style>  
   :root {  
--primary-green: #195042;  
--accent-beige: #d6cabc;  
--light-beige: #f4f1ee;  
--white: #ffffff;  
--text-dark: #2d3436;  
--status-green: #2ecc71;  
--danger-red: #e74c3c;  
--radius-md: 12px;  
 --shadow-sm: 0 3px 8px rgba(0,0,0,0.08);  
}  
body {  
font-family: 'Tajawal', sans-serif;  
background-color: #f9f9f9;  
direction: rtl;  
}  
.management-container {  
background: var(--white);  
margin: 20px;  
padding: 30px;  
border-radius: 20px;  
box-shadow: 0 10px 30px rgba(0,0,0,0.05);  
}  
/* العنوان */  
.page-title {  
color: var(--primary-green);  
position: relative;  
padding-bottom: 10px; /* مسافة بين النص والخط */  
border-bottom: 3px solid #d6cabc; /* جعل الخط بلون البيج */  
display: inline-block; /* ليصبح طول الخط على قدر الكلمة فقط */  
margin-top:15px;  
}  
.table {  
    width: 100%;  
    table-layout: fixed;  
    border-radius: var(--radius-md);  
    overflow: hidden;  
    box-shadow: var(--shadow-sm);  
     font-family: 'Tajawal', sans-serif;  
        font-size: clamp(0.95rem,2.5vw,1.5rem);  
        text-align: center;  
}  
    .table th {  
        background-color: var(--light-beige);  
        color: var(--primary-green);  
        padding: 12px;  
    }  
    .table td {  
        background-color: var(--white);  
        padding: 10px;  
        border-bottom: 1px solid #eee;  
  
    }  
    .table tbody tr:hover {  
        background-color: #fafafa;  
        transform: scale(1.01);  
    }  
  .table-wrapper{  
    overflow-x: auto;  
    width: 100%;  
    border-radius: var(--radius-md);  
  }  
  .select {  
  padding: 5px;  
  border-radius: 7px;  
  border: 1px solid #ccc;  
  font-family: 'Tajawal', sans-serif;  
  background-color: var(--white);  
  font-size: 1rem;  
  transition: border-color 0.3s ease;  }  
والأزرار */  
    .action-bar {  
        display: flex;  
        justify-content: space-between;  
        align-items: center;  
        margin-bottom: 25px;  
        flex-wrap: wrap;  
        gap: 15px;  
    }  
            /* الكاردات */  
             .card-container{  
                display:flex;  
                gap:20px;  
                flex-wrap:wrap;  
             }  
           .card {  
               flex:1 1 calc(50%-20px);  
    grid-template-columns: repeat(2,1fr);  
    border-radius: var(--radius-md);  
    box-shadow: var(--shadow-md);  
    padding: 20px;  
    background-color: #efebe9;  
    transition: var(--transition);  
    align-content:center;  
}  
  
    .card:hover {  
        transform: translateY(-5px);  
            border-color: #195042;  
    }  
                /* اسم الفوج */  
                .card h3 {  
                    margin-bottom: 10px;  
                    padding-right:10px;  
                }  
  
            /* الحلقات */  
            .sessions {  
                width:auto;  
                margin-right:20px;  
                padding-right:30px;  
                background: #d6cabc;  
                padding: 8px;  
                font-size:20px;  
                border-radius: 10px;  
        border-color: #195042;  
                margin-bottom: 3px;  
            }  
            .azrar{  
                padding-right:30px;  
            }  
  </style>
  <div class="management-container">

  <h2 class="page-title">إضافة اختبار</h2>

  <div class="card-container">

    <div class="card">
      <h3>بيانات الاختبار</h3>

      <input class="select" type="text" placeholder="اسم الطالب"><br><br>

      <select class="select">
        <option>اختر الحلقة</option>
      </select><br><br>

      <select class="select">
        <option>اختر المرحلة</option>
      </select><br><br>

      <input class="select" type="number" placeholder="العلامة"><br><br>

      <textarea class="select" placeholder="ملاحظات"></textarea><br><br>

      <button class="btn">حفظ</button>

    </div>

  </div>

</div>

