@page "/examer/postexamer"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Responses.ContentSharing
@inject IPostService PostService

<PageTitle>منشورات الفاحص</PageTitle>

<style>
    .posts-wrapper { direction: rtl; text-align: right; background-color: #f4f7f6; padding-bottom: 42px; min-height: calc(100vh - 70px); }
    .header-custom { background-color: #195042; color: #d6cabc; padding: 42px 0; border-bottom: 6px solid #d6cabc; margin-bottom: 42px; }
    .toolbar-card { background: #fff; border: 1px solid rgba(25, 80, 66, .1); border-radius: 20px; padding: 16px; margin-bottom: 22px; box-shadow: 0 10px 25px rgba(25, 80, 66, .06); display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
    .search-input { border: 1.5px solid #d6cabc; border-radius: 12px; padding: 10px 12px; min-width: 260px; outline: none; }
    .post-card { background: #fff; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,.08); overflow: hidden; height: 100%; border: none; display: flex; flex-direction: column; }
    .post-cover { background: linear-gradient(135deg, #195042 0%, #246b59 100%); min-height: 130px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .post-cover img { width: 100%; height: 180px; object-fit: cover; }
    .post-icon { font-size: 3.3rem; color: #d6cabc; }
    .post-content { padding: 24px; flex-grow: 1; display: flex; flex-direction: column; }
    .post-title { color: #195042; font-weight: 900; font-size: 1.25rem; margin-bottom: 10px; }
    .post-body { color: #5a6c7d; font-size: .94rem; line-height: 1.7; margin-bottom: 16px; flex-grow: 1; white-space: pre-line; }
    .post-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 16px; border-top: 2px solid #d6cabc; margin-top: auto; flex-wrap: wrap; gap: 10px; }
    .post-meta { font-size: .86rem; color: #195042; font-weight: 800; display: flex; align-items: center; gap: 6px; }
    .scope-pill { display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; padding: 7px 12px; font-weight: 900; font-size: .8rem; background: #f4f1ee; color: #195042; }
    .scope-pill.private { background: #eef6f3; }
    .state-box { background: #fff; border: 1px dashed #d6cabc; border-radius: 18px; padding: 28px; text-align: center; color: #667085; }
    .error-box { background: #fff1f1; border: 1px solid #f3c4c4; color: #b42318; border-radius: 16px; padding: 14px 16px; margin-bottom: 18px; }
</style>

<div class="posts-wrapper">
    <div class="header-custom">
        <div class="container">
            <h1 class="fw-bold mb-2">منشورات الفاحص</h1>
            <p class="mb-0">استعرض منشورات المسجد والحلقات المتاحة للمتابعة.</p>
        </div>
    </div>

    <div class="container">
        <div class="toolbar-card">
            <div>
                <h5 class="fw-bold text-success mb-1">المنشورات المتاحة</h5>
                <small class="text-muted">عدد المنشورات: @_posts.Count</small>
            </div>
            <input class="search-input" placeholder="ابحث بالعنوان أو المحتوى أو الحلقة..." @bind="_search" @bind:event="oninput" />
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="error-box">@_errorMessage</div>
        }

        @if (_isLoading)
        {
            <div class="state-box">
                <span class="spinner-border text-success" role="status"></span>
                <div class="mt-3">جاري تحميل المنشورات...</div>
            </div>
        }
        else if (!FilteredPosts.Any())
        {
            <div class="state-box">
                <i class="bi bi-megaphone fs-1 d-block mb-2"></i>
                لا توجد منشورات مطابقة حالياً.
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var post in FilteredPosts)
                {
                    <div class="col-lg-6">
                        <article class="post-card">
                            <div class="post-cover">
                                @if (!string.IsNullOrWhiteSpace(post.ImageUrl))
                                {
                                    <img src="@post.ImageUrl" alt="@post.Title" />
                                }
                                else
                                {
                                    <i class="bi bi-megaphone post-icon"></i>
                                }
                            </div>
                            <div class="post-content">
                                <h3 class="post-title">@Display(post.Title)</h3>
                                <p class="post-body">@Display(post.Body)</p>
                                <div class="post-footer">
                                    <div style="display: flex; flex-direction: column; gap: 5px;">
                                        <span class="post-meta"><i class="bi bi-calendar3"></i>@FormatDate(post.CreatedAt)</span>
                                        <span class="post-meta"><i class="bi bi-hand-thumbs-up"></i>@post.InteractionsCount تفاعل</span>
                                    </div>
                                    <span class="scope-pill @(post.HalqaId.HasValue ? "private" : string.Empty)">
                                        <i class="bi @(post.HalqaId.HasValue ? "bi-lock" : "bi-globe2")"></i>
                                        @(post.HalqaId.HasValue ? Display(post.HalqaName) : "عام")
                                    </span>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private readonly List<PostDto> _posts = new();
    private bool _isLoading = true;
    private string? _errorMessage;
    private string _search = string.Empty;

    private IEnumerable<PostDto> FilteredPosts => string.IsNullOrWhiteSpace(_search)
        ? _posts
        : _posts.Where(post => Display(post.Title).Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || Display(post.Body).Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || Display(post.HalqaName).Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || Display(post.MosqueName).Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadPostsAsync();
    }

    private async Task LoadPostsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var posts = await PostService.GetAllPostsAsync();
            _posts.Clear();
            _posts.AddRange(posts.OrderByDescending(post => post.CreatedAt));
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر تحميل المنشورات: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "غير متوفر" : value;

    private static string FormatDate(DateTime value)
        => value == default ? "غير متوفر" : value.ToString("yyyy-MM-dd");
}
