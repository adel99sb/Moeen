@page "/examer/profileexamer"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Moeen.Dashboard.Application.Services.Abstractions
@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Requests.ExamQuery
@using Moeen.Shared.Responses.ExamQuery
@inject ITokenService TokenService
@inject IExamQueryService ExamQueryService

<PageTitle>ملف الفاحص</PageTitle>

<style>
    .profile-page {
        direction: rtl;
        min-height: calc(100vh - 70px);
        background: #faf7f0;
        color: #163f35;
        padding: 24px;
    }

    .profile-hero {
        background: linear-gradient(135deg, #195042, #26735f);
        color: #fff;
        border-radius: 26px;
        padding: 28px;
        box-shadow: 0 18px 45px rgba(25, 80, 66, .18);
        margin-bottom: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .profile-hero h1 {
        margin: 0 0 8px;
        font-weight: 900;
    }

    .profile-hero p {
        margin: 0;
        opacity: .88;
    }

    .hero-avatar {
        width: 86px;
        height: 86px;
        border-radius: 28px;
        background: rgba(255,255,255,.16);
        border: 1px solid rgba(255,255,255,.22);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
    }

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 18px;
    }

    .metric-card,
    .content-card {
        background: #fff;
        border: 1px solid #e4eee9;
        border-radius: 22px;
        box-shadow: 0 10px 28px rgba(25, 80, 66, .06);
    }

    .metric-card {
        padding: 18px;
    }

    .metric-card small {
        display: block;
        color: #7b7067;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .metric-card strong {
        color: #195042;
        font-size: 1.7rem;
        font-weight: 950;
    }

    .content-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        align-items: start;
    }

    .content-card {
        padding: 20px;
    }

    .card-title {
        margin: 0 0 14px;
        color: #195042;
        font-size: 1.15rem;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .info-row,
    .action-row {
        border: 1px solid #edf1ee;
        background: #fbfdfa;
        border-radius: 16px;
        padding: 13px 14px;
        margin-bottom: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .label {
        color: #6b7280;
        font-weight: 800;
    }

    .value {
        color: #195042;
        font-weight: 900;
    }

    .route-link {
        color: #195042;
        font-weight: 900;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .route-link:hover {
        color: #26735f;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 6px 10px;
        background: #eef7f3;
        color: #195042;
        font-size: .82rem;
        font-weight: 900;
    }

    .state-box {
        background: #fff;
        border: 1px dashed #d6cabc;
        border-radius: 18px;
        padding: 28px;
        text-align: center;
        color: #667085;
    }

    .error-box {
        background: #fff1f1;
        border: 1px solid #f3c4c4;
        color: #b42318;
        border-radius: 16px;
        padding: 14px 16px;
        margin-bottom: 18px;
    }

    @@media (max-width: 1100px) {
        .metrics-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .content-grid { grid-template-columns: 1fr; }
    }

    @@media (max-width: 640px) {
        .profile-page { padding: 14px; }
        .metrics-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="profile-page">
    @if (_isLoading)
    {
        <div class="state-box">
            <span class="spinner-border text-success" role="status"></span>
            <div class="mt-3">جاري تحميل ملف الفاحص...</div>
        </div>
    }
    else
    {
        <section class="profile-hero">
            <div>
                <h1>ملف الفاحص</h1>
                <p>صفحة تعريفية مبنية على صلاحيات الحساب وإحصائيات الاختبارات المتاحة.</p>
            </div>
            <div class="hero-avatar"><i class="bi bi-person-check"></i></div>
        </section>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="error-box">@_errorMessage</div>
        }

        <section class="metrics-grid">
            <div class="metric-card"><small>الدور الحالي</small><strong>@DisplayRole(_session?.PrimaryRole)</strong></div>
            <div class="metric-card"><small>عدد الاختبارات</small><strong>@(_statistics?.TotalExams ?? 0)</strong></div>
            <div class="metric-card"><small>متوسط العلامة</small><strong>@FormatNumber(_statistics?.AverageScore ?? 0)</strong></div>
            <div class="metric-card"><small>نسبة النجاح</small><strong>@FormatPercent(_statistics?.PassRate ?? 0)</strong></div>
        </section>

        <section class="content-grid">
            <div class="content-card">
                <h2 class="card-title"><i class="bi bi-person-badge"></i> بيانات الحساب</h2>
                <div class="info-row"><span class="label">حالة الدخول</span><span class="value">@(_session?.IsAuthenticated == true ? "مسجل دخول" : "غير مسجل")</span></div>
                <div class="info-row"><span class="label">الدور الأساسي</span><span class="value">@DisplayRole(_session?.PrimaryRole)</span></div>
                <div class="info-row"><span class="label">الأدوار</span><span class="value">@DisplayRoles()</span></div>
                <div class="info-row"><span class="label">المسار الرئيسي</span><span class="value">@(_session?.HomeRoute ?? "/Examer/Dashboard")</span></div>

                <h2 class="card-title mt-4"><i class="bi bi-clipboard-data"></i> ملخص الاختبارات</h2>
                <div class="info-row"><span class="label">أعلى علامة</span><span class="value">@FormatNumber(_statistics?.HighestScore ?? 0)</span></div>
                <div class="info-row"><span class="label">أدنى علامة</span><span class="value">@FormatNumber(_statistics?.LowestScore ?? 0)</span></div>
                <div class="info-row"><span class="label">الناجحون</span><span class="value">@(_statistics?.PassCount ?? 0)</span></div>
                <div class="info-row"><span class="label">الراسبون</span><span class="value">@(_statistics?.FailedCount ?? 0)</span></div>
            </div>

            <div class="content-card">
                <h2 class="card-title"><i class="bi bi-list-check"></i> مهام الفاحص</h2>
                <div class="info-row"><span class="label">تسجيل نتائج الاختبارات</span><span class="pill"><i class="bi bi-check2-circle"></i> متاح</span></div>
                <div class="info-row"><span class="label">متابعة إحصائيات الاختبارات</span><span class="pill"><i class="bi bi-check2-circle"></i> متاح</span></div>
                <div class="info-row"><span class="label">استعراض الكتب</span><span class="pill"><i class="bi bi-eye"></i> قراءة فقط</span></div>
                <div class="info-row"><span class="label">استعراض المنشورات</span><span class="pill"><i class="bi bi-eye"></i> قراءة فقط</span></div>

                <h2 class="card-title mt-4"><i class="bi bi-compass"></i> روابط سريعة</h2>
                <div class="action-row"><a class="route-link" href="/Examer/Dashboard"><i class="bi bi-speedometer2"></i> لوحة الفاحص</a></div>
                <div class="action-row"><a class="route-link" href="/examer/exam"><i class="bi bi-clipboard-check"></i> إدارة الاختبارات</a></div>
                <div class="action-row"><a class="route-link" href="/examer/bookexamer"><i class="bi bi-book"></i> مكتبة الفاحص</a></div>
                <div class="action-row"><a class="route-link" href="/examer/postexamer"><i class="bi bi-megaphone"></i> منشورات الفاحص</a></div>
            </div>
        </section>
    }
</div>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };
    private DashboardAuthSession? _session;
    private ExamStatisticsDto? _statistics;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _session = await TokenService.GetSession();
            var response = await ExamQueryService.GetExamStatisticsAsync(new GetExamStatisticsRequest());

            if (response == null || !response.Success)
            {
                _statistics = null;
                _errorMessage = response?.Message ?? "تعذر تحميل إحصائيات الفاحص.";
                return;
            }

            _statistics = DeserializeData<ExamStatisticsDto>(response.Data);
        }
        catch (Exception ex)
        {
            _statistics = null;
            _errorMessage = $"تعذر تحميل ملف الفاحص: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static T? DeserializeData<T>(object? data)
    {
        if (data == null)
            return default;

        if (data is T typed)
            return typed;

        if (data is JsonElement element)
            return element.Deserialize<T>(JsonOptions);

        var json = JsonSerializer.Serialize(data, JsonOptions);
        return JsonSerializer.Deserialize<T>(json, JsonOptions);
    }

    private string DisplayRoles()
    {
        if (_session?.Roles == null || _session.Roles.Count == 0)
            return "غير محدد";

        return string.Join("، ", _session.Roles.Select(DisplayRole));
    }

    private static string DisplayRole(string? role)
    {
        if (string.IsNullOrWhiteSpace(role))
            return "غير محدد";

        return role.Trim().ToLowerInvariant() switch
        {
            "examer" => "فاحص",
            "teacher" => "معلم",
            "supervisor" => "مشرف",
            "owner" => "مالك النظام",
            _ => role
        };
    }

    private static string FormatNumber(double value)
        => value.ToString("0.##");

    private static string FormatPercent(double value)
        => $"{value:0.##}%";
}
