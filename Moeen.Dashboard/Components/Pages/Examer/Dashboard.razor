@page "/Examer/Dashboard"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Moeen.Dashboard.Application.Services.Abstractions
@using Moeen.Shared.Requests.ExamQuery
@using Moeen.Shared.Responses.ExamQuery
@inject IExamQueryService ExamQueryService

<PageTitle>لوحة المختبر</PageTitle>

<style>
    .dashboard-page {
        direction: rtl;
        min-height: calc(100vh - 70px);
        background: #faf7f0;
        color: #163f35;
        padding: 24px;
    }

    .hero {
        background: linear-gradient(135deg, #195042, #26735f);
        color: #fff;
        border-radius: 26px;
        padding: 28px;
        box-shadow: 0 18px 45px rgba(25, 80, 66, .18);
        margin-bottom: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .hero h1 {
        margin: 0 0 8px;
        font-weight: 900;
    }

    .hero p {
        margin: 0;
        opacity: .88;
    }

    .hero-icon {
        width: 86px;
        height: 86px;
        border-radius: 28px;
        background: rgba(255,255,255,.16);
        border: 1px solid rgba(255,255,255,.22);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
    }

    .toolbar-card,
    .metric-card,
    .content-card {
        background: #fff;
        border: 1px solid #e4eee9;
        border-radius: 22px;
        box-shadow: 0 10px 28px rgba(25, 80, 66, .06);
    }

    .toolbar-card {
        padding: 16px;
        margin-bottom: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .date-control {
        border: 1.5px solid #d6cabc;
        border-radius: 12px;
        padding: 10px 12px;
        background: #fbfaf8;
        color: #195042;
        outline: none;
    }

    .btn-refresh {
        border: 0;
        border-radius: 12px;
        padding: 10px 16px;
        background: #195042;
        color: #fff;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 18px;
    }

    .metric-card {
        padding: 18px;
    }

    .metric-card small {
        display: block;
        color: #7b7067;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .metric-card strong {
        color: #195042;
        font-size: 1.7rem;
        font-weight: 950;
    }

    .content-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        align-items: start;
    }

    .content-card {
        padding: 20px;
    }

    .card-title {
        margin: 0 0 14px;
        color: #195042;
        font-size: 1.15rem;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .info-row {
        border: 1px solid #edf1ee;
        background: #fbfdfa;
        border-radius: 16px;
        padding: 13px 14px;
        margin-bottom: 10px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .label {
        color: #6b7280;
        font-weight: 800;
    }

    .value {
        color: #195042;
        font-weight: 900;
    }

    .state-box {
        background: #fff;
        border: 1px dashed #d6cabc;
        border-radius: 18px;
        padding: 28px;
        text-align: center;
        color: #667085;
    }

    .error-box {
        background: #fff1f1;
        border: 1px solid #f3c4c4;
        color: #b42318;
        border-radius: 16px;
        padding: 14px 16px;
        margin-bottom: 18px;
    }

    @@media (max-width: 1100px) {
        .metrics-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .content-grid { grid-template-columns: 1fr; }
    }

    @@media (max-width: 640px) {
        .dashboard-page { padding: 14px; }
        .metrics-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="dashboard-page">
    <section class="hero">
        <div>
            <h1>لوحة المختبر</h1>
            <p>ملخص سريع لإحصائيات الاختبارات ونتائج الطلاب ضمن النظام.</p>
        </div>
        <div class="hero-icon"><i class="bi bi-clipboard-check"></i></div>
    </section>

    <section class="toolbar-card">
        <div>
            <strong class="value">نطاق الإحصائيات</strong>
            <div class="text-muted small">اترك التاريخ فارغاً لعرض كامل البيانات المتاحة.</div>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <input type="date" class="date-control" @bind="_fromDate" />
            <input type="date" class="date-control" @bind="_toDate" />
            <button type="button" class="btn-refresh" @onclick="LoadDashboardAsync" disabled="@_isLoading">
                <i class="bi bi-arrow-clockwise"></i>
                تحديث
            </button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="error-box">@_errorMessage</div>
    }

    @if (_isLoading)
    {
        <div class="state-box">
            <span class="spinner-border text-success" role="status"></span>
            <div class="mt-3">جاري تحميل إحصائيات الاختبارات...</div>
        </div>
    }
    else if (_statistics is null)
    {
        <div class="state-box">لا توجد إحصائيات اختبارات متاحة حالياً.</div>
    }
    else
    {
        <section class="metrics-grid">
            <div class="metric-card"><small>عدد الاختبارات</small><strong>@_statistics.TotalExams</strong></div>
            <div class="metric-card"><small>متوسط العلامة</small><strong>@FormatNumber(_statistics.AverageScore)</strong></div>
            <div class="metric-card"><small>نسبة النجاح</small><strong>@FormatPercent(_statistics.PassRate)</strong></div>
            <div class="metric-card"><small>الناجحون</small><strong>@_statistics.PassCount</strong></div>
        </section>

        <section class="content-grid">
            <div class="content-card">
                <h2 class="card-title"><i class="bi bi-bar-chart"></i> تفاصيل العلامات</h2>
                <div class="info-row"><span class="label">أعلى علامة</span><span class="value">@FormatNumber(_statistics.HighestScore)</span></div>
                <div class="info-row"><span class="label">أدنى علامة</span><span class="value">@FormatNumber(_statistics.LowestScore)</span></div>
                <div class="info-row"><span class="label">متوسط العلامة</span><span class="value">@FormatNumber(_statistics.AverageScore)</span></div>
            </div>

            <div class="content-card">
                <h2 class="card-title"><i class="bi bi-pie-chart"></i> حالة النتائج</h2>
                <div class="info-row"><span class="label">الطلاب الناجحون</span><span class="value">@_statistics.PassCount</span></div>
                <div class="info-row"><span class="label">الطلاب الراسبون</span><span class="value">@_statistics.FailedCount</span></div>
                <div class="info-row"><span class="label">نسبة النجاح</span><span class="value">@FormatPercent(_statistics.PassRate)</span></div>
            </div>
        </section>
    }
</div>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };
    private ExamStatisticsDto? _statistics;
    private bool _isLoading = true;
    private string? _errorMessage;
    private DateTime? _fromDate;
    private DateTime? _toDate;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await ExamQueryService.GetExamStatisticsAsync(new GetExamStatisticsRequest
            {
                FromDate = _fromDate,
                ToDate = _toDate
            });

            if (response == null || !response.Success)
            {
                _statistics = null;
                _errorMessage = response?.Message ?? "تعذر تحميل إحصائيات الاختبارات.";
                return;
            }

            _statistics = DeserializeData<ExamStatisticsDto>(response.Data);
        }
        catch (Exception ex)
        {
            _statistics = null;
            _errorMessage = $"تعذر تحميل إحصائيات الاختبارات: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static T? DeserializeData<T>(object? data)
    {
        if (data == null)
            return default;

        if (data is T typed)
            return typed;

        if (data is JsonElement element)
            return element.Deserialize<T>(JsonOptions);

        var json = JsonSerializer.Serialize(data, JsonOptions);
        return JsonSerializer.Deserialize<T>(json, JsonOptions);
    }

    private static string FormatNumber(double value)
        => value.ToString("0.##");

    private static string FormatPercent(double value)
        => $"{value:0.##}%";
}
