@page "/examer/exam"
@rendermode InteractiveServer
@inject NavigationManager NavManager
<style>
   :root {
--primary-green: #195042;
--accent-beige: #d6cabc;
--light-beige: #f4f1ee;
--white: #ffffff;
--text-dark: #2d3436;
--status-green: #2ecc71;
--danger-red: #e74c3c;
--radius-md: 12px;
 --shadow-sm: 0 3px 8px rgba(0,0,0,0.08);
}
body {
font-family: 'Tajawal', sans-serif;
background-color: #f9f9f9;
direction: rtl;
}
.management-container {
background: var(--white);
margin: 20px;
padding: 30px;
border-radius: 20px;
box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}
/* العنوان */
.page-title {
color: var(--primary-green);
position: relative;
padding-bottom: 10px; /* مسافة بين النص والخط */
border-bottom: 3px solid #d6cabc; /* جعل الخط بلون البيج */
display: inline-block; /* ليصبح طول الخط على قدر الكلمة فقط */
margin-top:15px;
}
.table {
    width: 100%;
    table-layout: fixed;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
     font-family: 'Tajawal', sans-serif;
        font-size: clamp(0.95rem,2.5vw,1.5rem);
        text-align: center;
}
    .table th {
        background-color: var(--light-beige);
        color: var(--primary-green);
        padding: 12px;
    }
    .table td {
        background-color: var(--white);
        padding: 10px;
        border-bottom: 1px solid #eee;

    }
    .table tbody tr:hover {
        background-color: #fafafa;
        transform: scale(1.01);
    }
	.table-wrapper{
		overflow-x: auto;
		width: 100%;
		border-radius: var(--radius-md);
	}
	.select {
	padding: 5px;
	border-radius: 7px;
	border: 1px solid #ccc;
	font-family: 'Tajawal', sans-serif;
	background-color: var(--white);
	font-size: 1rem;
	transition: border-color 0.3s ease;	}
	</style>
<div class="management-container">

    <h2 class="page-title">الطلاب</h2>

    <!-- شريط العمليات -->
    <div class="action-bar">
        <input class="select" type="text" placeholder="🔍 ابحث عن طالب...">
        <button class="btn">+ إضافة طالب</button>
    </div>

    <!-- الجدول -->
    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>الاسم</th>
                    <th>الحلقة</th>
                    <th>الفوج</th>
                    <th>العمر</th>
                    <th>إجراءات</th>
                </tr>
            </thead>

            <tbody>

                <tr>
                    <td>محمد أحمد</td>
                    <td>حلقة النور</td>
                    <td>الفوج الأول</td>
                    <td>14</td>
                    <td>
                  	<a @onclick="AddExam"><button title="عرض"><i class="bi bi-info-circle"></i></button></a>

                  	<a @onclick="DetailsExam"><button title="تفاصيل"><i class="bi bi-info-circle"></i></button></a>
                    
                        <button class="btn" style="background:var(--danger-red)">حذف</button>
                    </td>
                </tr>

                <tr>
                    <td>علي حسن</td>
                    <td>حلقة الفرقان</td>
                    <td>الفوج الثاني</td>
                    <td>15</td>
                    <td>
                        <button class="btn">تفاصيل</button>
                        <button class="btn">تعديل</button>
                        <button class="btn" style="background:var(--danger-red)">حذف</button>
                    </td>
                </tr>

            </tbody>
        </table>
    </div>

</div>
@code {
    private void AddExam()
	{
		NavManager.NavigateTo("/examer/addexam");
	}
      private void DetailsExam()
	{
		NavManager.NavigateTo("/examer/detailsexam");
	}
}
