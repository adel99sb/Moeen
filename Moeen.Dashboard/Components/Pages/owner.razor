@page"/owner"
<style>
    
    #main-dashboard {
        background-color: #f8faf9; 
        padding: 30px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        min-height: 100vh;
        direction: rtl;
    }

    
    .head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

        .head h3 {
            color: #004d40; 
            font-weight: bold;
        }

        .head input[type="search"] {
            padding: 10px 20px;
            border-radius: 12px;
            border: 1px solid #e0e0e0;
            background-color: #ffffff;
            width: 250px;
            outline: none;
            transition: 0.3s;
        }

            .head input[type="search"]:focus {
                border-color: #004d40;
                box-shadow: 0 0 5px rgba(0, 77, 64, 0.2);
            }

    
    .data-info {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .box {
        background-color: #ffffff;
        padding: 25px;
        border-radius: 20px; 
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05); 
        border: 1px solid rgba(0,0,0,0.02);
    }

        .box:hover {
            transform: translateY(-5px); 
        }

        .box .data p {
            color: #757575;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .box .data span {
            color: #004d40;
            font-size: 28px;
            font-weight: bold;
            display: block;
        }

   
    .table-section {
        background-color: #ffffff;
        padding: 25px;
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

    th {
        text-align: right;
        color: #9e9e9e;
        font-weight: 500;
        padding: 15px;
        border-bottom: 1px solid #f0f0f0;
    }

    td {
        padding: 15px;
        color: #333;
        border-bottom: 1px solid #f9f9f9;
    }

    tr:hover {
        background-color: #fcfcfc;
    }

    
    td:first-child {
        font-weight: 600;
        color: #004d40;
    }
</style>
<h3>owner</h3>
<div id="main-dashboard">

    <div class="head">
        <h3>مالك التطبيق</h3>
        <input type="search" placeholder="بحث..." />
    </div>


    <div class="data-info">
        <div class="box">
            <div class="data">
                <p>عدد المشرفين الإجمالي</p>
                <span>10</span>
            </div>
        </div>

        <div class="box">
            <div class="data">
                <p>عدد الجوامع الإجمالي</p>
                <span>10</span>
            </div>
        </div>

        <div class="box">
            <div class="data">
                <p>عدد المعلمين الإجمالي</p>
                <span>90</span>
            </div>
        </div>

        <div class="box">
            <div class="data">
                <p>عدد الطلاب الإجمالي</p>
                <span>90</span>
            </div>
        </div>
    </div>


    <div class="table-section">
        <table>
            <thead>
                <tr>
                    <th>اسم الجامع</th>
                    <th>اسم المشرف</th>
                    <th>عدد الطلاب</th>
                    <th>عدد المعلمين</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>جامع الهدى</td>
                    <td>محمد</td>
                    <td>200</td>
                    <td>12</td>
                </tr>
                <tr>
                    <td>جامع العبدالله</td>
                    <td>محمد</td>
                    <td>40</td>
                    <td>12</td>
                </tr>
                <tr>
                    <td>جامع النور</td>
                    <td>محمد</td>
                    <td>200</td>
                    <td>12</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

