@page "/management/mosques-management"
@rendermode InteractiveServer
@inject NavigationManager mgr
<style>
    :root {
        --color-primary: #195042;
        --color-secondary: #1d3937;
        --color-accent: #91855a;
        --color-bg: #fcfbf9;
        --color-beige: #d6cabc;
        --color-white: #ffffff;
        --radius-md: 12px;
        --shadow-sm: 0 3px 8px rgba(0,0,0,0.08);
        --shadow-md: 0 6px 15px rgba(0,0,0,0.12);
        --transition: all 0.3s ease;
    }

    /* الصفحة */
    body {
        background: var(--color-bg);
        font-family: Arial;
    }

    /* البحث */
    .search-box {
        position: relative;
           width: 300px;
    }

    .search-container {
        display: flex;
        justify-content: space-between; /* لوضع الزر في جهة والبحث في جهة */
        align-items: center;
        padding: 20px;
        width: 100%;
    }

        .search-box input {
            width: 100%;
            padding: 12px 45px 12px 15px;
            border: 2px solid var(--color-beige);
            border-radius: var(--radius-md);
            background: var(--color-white);
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
            font-size: 14px;
        }

            .search-box input:focus {
                outline: none;
                border-color: var(--color-primary);
                box-shadow: var(--shadow-md);
            }

        .search-box .icon {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--color-accent);
            font-size: 18px;
            cursor: pointer;
            transition: var(--transition);
        }

            .search-box .icon:hover {
                color: var(--color-primary);
            }

    /* زر إضافة جامع */
    .custom-outline-btn {
        position: fixed;
        top: 20px;
        left: 20px;
        background-color: var(--color-beige);
        border: 2px solid var(--color-beige);
        color: var(--color-primary);
        transition: var(--transition);
    }

        .custom-outline-btn:focus,
        .custom-outline-btn:active {
            outline: none !important;
            box-shadow: none !important;
        }

        .custom-outline-btn:hover {
            background-color: var(--color-beige);
            color: var(--color-secondary);
            box-shadow: 0 4px 10px rgba(29, 57, 55, 0.25);
    }
    
    .btn-m {
        background: #d6cabc;
        color: var(--color-primary);
    }

        .btn-m:hover {
        background-color: var(--color-beige);
        color: var(--color-secondary);
        box-shadow: 0 4px 10px rgba(29, 57, 55, 0.25);
        }
        /* أيقونة الحذف */

    .delete-icon {
        position: absolute;
        top: 5px;
        left: 5px;
        color: #195042;
        font-size: 20px;
        transition: color 0.3s ease;
    }

        .delete-icon:hover {
            color: #C0392B;
        }

</style>

<!-- البحث -->
<div class="search-container">
<div class="search-box">
    <input type="text" placeholder=" البحث عن جامع..." />
    <span class="icon"><i class="bi bi-search"></i></span>
</div>

<!-- زر إضافة جامع -->
<button type="button" class="btn custom-outline-btn" @onclick="moveTopage2">إضافة جامع</button>
</div>
<!-- الكاردات -->
<div class="container mt-5 pt-5 d-flex flex-column align-items-center">
    <div class="row justify-content-center w-100" >
        <!-- الكارد 1 -->
        <div style="position: relative; width:20rem; margin:20px;">

            <div class="card text-center mb-3">
                <a href="#" class="delete-icon">
                    <i class="bi bi-trash3-fill"></i>
                </a>
                <div class="card-body">
                    <h5 class="card-title">جامع التوحيد</h5><br />
                    <p class="card-text">
                        . العنوان <br />
                        . رقم التواصل <br />
                        . الوصف <br />
                    </p>

                    <div class="d-flex justify-content-center align-items-center gap-2 mt-3">
                        <button class="btn btn-m px-3" @onclick="moveTopage">عرض</button>
                        <button class="btn btn-m px-3" @onclick="moveTopage2">تعديل</button>
                    </div>
                </div>
            </div>

        </div> 
        <div style="position: relative; width:20rem; margin:20px;">

            <div class="card text-center mb-3">
                <a href="#" class="delete-icon">
                    <i class="bi bi-trash3-fill"></i>
                </a>
                <div class="card-body">
                    <h5 class="card-title">جامع التوحيد</h5><br />
                    <p class="card-text">
                        . العنوان <br />
                        . رقم التواصل <br />
                        . الوصف <br />
                    </p>

                    <div class="d-flex justify-content-center align-items-center gap-2 mt-3">
                        <button class="btn btn-m px-3" @onclick="moveTopage">عرض</button>
                        <button class="btn btn-m px-3" @onclick="moveTopage2">تعديل</button>
                   </div>
                </div>
            </div>

        </div>
        <!-- الكارد 3 -->
        <div style="position: relative; width:20rem; margin:20px;">

            <div class="card text-center mb-3">
                <a href="#" class="delete-icon">
                    <i class="bi bi-trash3-fill"></i>
                </a>
                <div class="card-body">
                    <h5 class="card-title">جامع التوحيد</h5><br />
                    <p class="card-text">
                        . العنوان <br />
                        . رقم التواصل <br />
                        . الوصف <br />
                    </p>

                    <div class="d-flex justify-content-center align-items-center gap-2 mt-3">
                        <button class="btn btn-m px-3" @onclick="moveTopage">عرض</button>
                        <button class="btn btn-m px-3" @onclick="moveTopage2">تعديل</button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private void moveTopage()
    {
        mgr.NavigateTo("/details");
    }
    private void moveTopage2()
    {
        mgr.NavigateTo("/mend-m");
    }
}