@page "/details"
@inject NavigationManager mgr
<style>
    /* زر تعيين مشرف  */
    .custom-outline-btn {
        position: fixed;
        top: 20px;
        left: 20px;
        background-color: var(--color-beige);
        color: var(--color-primary);
        transition: var(--transition);
    }

        .custom-outline-btn:focus,
        .custom-outline-btn:active {
            outline: none !important;
            box-shadow: none !important;
        }

        .custom-outline-btn:hover {
            background-color: var(--color-beige);
            color: var(--color-secondary);
            box-shadow: 0 4px 10px rgba(29, 57, 55, 0.25);
        }
    
    .btn-m {
        background: #d6cabc;
        color: var(--color-primary);
    }

        .btn-m:hover {
            background-color: var(--color-beige);
            color: var(--color-secondary);
            box-shadow: 0 4px 10px rgba(29, 57, 55, 0.25);
        }
    /* رأس الجدول */
    .table th {
        background-color: var(--color-beige); /* بيج غامق */
        color: #195042; /* أخضر داكن */
        text-align: center;
    }

    /* الصفوف (تلوين بالتناوب) */
    .table tr:nth-child(odd) td {
        background-color: #efebe9; /* بيج فاتح */
    }

    .table tr:nth-child(even) td {
        background-color: var(--color-bg); /* أفتح شوي */
    }

    /* تحسين الشكل العام */
    .table td {
        text-align: center;
        vertical-align: middle;
    }
    /* زر الحذف */
    .delete-button {
        color: #195042;
        background-color: #C0392B;
    }

</style>
<!-- زر تعيين مشرف -->
<button type="button" class="btn custom-outline-btn">تعيين مشرف</button>

