@page "/CU"

@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Requests.Identity
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject ILogger<Login> Logger
@rendermode InteractiveServer

<PageTitle>CU</PageTitle>

<h3 class="mb-4">Login</h3>

<EditForm Model="_model">

    <DataAnnotationsValidator />
    <ValidationSummary />
    <!-- name -->
    <div class="mb-3">
        <label class="form-label">UN</label>
        <InputText @bind-Value="_model.Name" class="form-control" />
        <ValidationMessage For="@(() => _model.Name)" />
    </div>
    <!-- Email -->
    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText @bind-Value="_model.Email" class="form-control" />
        <ValidationMessage For="@(() => _model.Email)" />
    </div>

    <!-- Password -->
    <div class="mb-3">
        <label class="form-label">Password</label>
        <InputText @bind-Value="_model.Password"
                   type="password"
                   class="form-control" />
        <ValidationMessage For="@(() => _model.Password)" />
    </div>

    <!-- phon -->
    <div class="mb-3">
        <label class="form-label">phone</label>
        <InputText @bind-Value="_model.PhoneNumber" class="form-control" />
        <ValidationMessage For="@(() => _model.PhoneNumber)" />
    </div>
    <!-- Gender -->
    <div class="mb-3">
        <label class="form-label">Gender</label>
        <InputText @bind-Value="_model.Gender" class="form-control" />
        <ValidationMessage For="@(() => _model.Gender)" />
    </div>
    <!-- Error Message -->
    @if (ShowMessage)
    {
        if (Succees)
        {
            <div class="alert alert-success">
                @Message
            </div>
        }
        else
        {
            <div class="alert alert-danger">
                @Message
            </div>
        }
    }

    <!-- Submit -->
    <button class="btn btn-primary" type="button"
            @onclick="HandleCreateUser"
            disabled="@_isLoading">
        @if (_isLoading)
        {
            <span class="spinner-border spinner-border-sm"></span>
            <span class="ms-2">Logging in...</span>
        }
        else
        {
            <span>Login</span>
        }
    </button>

</EditForm>

@code {

    private RegisterRequest _model = new();

    private bool _isLoading = false;
    private bool ShowMessage;
    private bool Succees = false;
    private string Message;

    private async Task HandleCreateUser()
    {
        ShowMessage = true;
        try
        {
            _isLoading = true;
            await AuthService.Register(_model);

            Message = "Register successful";
            Succees = true;
            Nav.NavigateTo("/counter");

        }
        catch (Exception ex)
        {
            Succees = false;
            Message = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}