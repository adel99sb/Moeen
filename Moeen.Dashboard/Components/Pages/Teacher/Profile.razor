@page "/Teacher/Profile"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Moeen.Dashboard.Infrastructure.Http.Clients
@using Moeen.Shared.Responses.TeacherDashboard
@inject InstructorHomeApiClient TeacherApiClient

<PageTitle>ملف المعلم</PageTitle>

<style>
    .profile-page {
        direction: rtl;
        min-height: calc(100vh - 70px);
        background: #faf7f0;
        color: #163f35;
        padding: 24px;
    }

    .profile-hero {
        background: linear-gradient(135deg, #195042, #26735f);
        color: #fff;
        border-radius: 26px;
        padding: 28px;
        box-shadow: 0 18px 45px rgba(25, 80, 66, .18);
        margin-bottom: 22px;
        display: flex;
        justify-content: space-between;
        gap: 18px;
        flex-wrap: wrap;
        align-items: center;
    }

    .profile-hero h1 {
        margin: 0 0 8px;
        font-weight: 900;
    }

    .profile-hero p {
        margin: 0;
        opacity: .88;
    }

    .hero-avatar {
        width: 86px;
        height: 86px;
        border-radius: 28px;
        background: rgba(255,255,255,.16);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.4rem;
        font-weight: 900;
        border: 1px solid rgba(255,255,255,.22);
    }

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 18px;
    }

    .metric-card,
    .content-card {
        background: #fff;
        border: 1px solid #e4eee9;
        border-radius: 22px;
        box-shadow: 0 10px 28px rgba(25, 80, 66, .06);
    }

    .metric-card {
        padding: 18px;
    }

    .metric-card small {
        display: block;
        color: #7b7067;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .metric-card strong {
        color: #195042;
        font-size: 1.7rem;
        font-weight: 950;
    }

    .content-grid {
        display: grid;
        grid-template-columns: 1.15fr .85fr;
        gap: 16px;
        align-items: start;
    }

    .content-card {
        padding: 20px;
    }

    .card-title {
        margin: 0 0 14px;
        color: #195042;
        font-size: 1.15rem;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .info-row,
    .halaqa-row,
    .student-row,
    .alert-row {
        border: 1px solid #edf1ee;
        background: #fbfdfa;
        border-radius: 16px;
        padding: 13px 14px;
        margin-bottom: 10px;
    }

    .info-row {
        display: grid;
        grid-template-columns: 170px 1fr;
        gap: 10px;
    }

    .label {
        color: #6b7280;
        font-weight: 800;
    }

    .value {
        color: #195042;
        font-weight: 900;
    }

    .halaqa-row-header,
    .student-row,
    .alert-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 6px 10px;
        background: #eef7f3;
        color: #195042;
        font-size: .82rem;
        font-weight: 900;
    }

    .muted {
        color: #7b7067;
        font-size: .88rem;
    }

    .state-box {
        background: #fff;
        border: 1px dashed #d6cabc;
        border-radius: 18px;
        padding: 28px;
        text-align: center;
        color: #667085;
    }

    .error-box {
        background: #fff1f1;
        border: 1px solid #f3c4c4;
        color: #b42318;
        border-radius: 16px;
        padding: 14px 16px;
        margin-bottom: 18px;
    }

    @@media (max-width: 1100px) {
        .metrics-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .content-grid { grid-template-columns: 1fr; }
    }

    @@media (max-width: 640px) {
        .profile-page { padding: 14px; }
        .metrics-grid { grid-template-columns: 1fr; }
        .info-row { grid-template-columns: 1fr; }
    }
</style>

<div class="profile-page">
    @if (_isLoading)
    {
        <div class="state-box">
            <span class="spinner-border text-success" role="status"></span>
            <div class="mt-3">جاري تحميل ملف المعلم...</div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="error-box">@_errorMessage</div>
    }
    else if (_dashboard is null)
    {
        <div class="state-box">لا توجد بيانات متاحة لملف المعلم حالياً.</div>
    }
    else
    {
        <section class="profile-hero">
            <div>
                <h1>@Display(_dashboard.TeacherName)</h1>
                <p>ملف تعريفي مختصر مبني على بيانات الحلقات والطلاب المرتبطين بحسابك.</p>
            </div>
            <div class="hero-avatar">@Initial(_dashboard.TeacherName)</div>
        </section>

        <section class="metrics-grid">
            <div class="metric-card"><small>الحلقات المسندة</small><strong>@_dashboard.TotalHalaqas</strong></div>
            <div class="metric-card"><small>عدد الطلاب</small><strong>@_dashboard.TotalStudents</strong></div>
            <div class="metric-card"><small>حضور اليوم</small><strong>@_dashboard.AttendanceTodayPercent%</strong></div>
            <div class="metric-card"><small>نقاط التميز</small><strong>@_dashboard.ExcellencePoints</strong></div>
        </section>

        <section class="content-grid">
            <div class="content-card">
                <h2 class="card-title"><i class="bi bi-person-badge"></i> البيانات العامة</h2>
                <div class="info-row"><span class="label">اسم المعلم</span><span class="value">@Display(_dashboard.TeacherName)</span></div>
                <div class="info-row"><span class="label">المسجد</span><span class="value">@Display(_dashboard.MosqueName)</span></div>
                <div class="info-row"><span class="label">إجمالي الصفحات المحفوظة</span><span class="value">@_dashboard.TotalMemorizedPages صفحة</span></div>
                <div class="info-row"><span class="label">تنبيهات المتابعة</span><span class="value">@_dashboard.FollowUpAlerts تنبيه</span></div>

                <h2 class="card-title mt-4"><i class="bi bi-diagram-3"></i> الحلقات المسندة</h2>
                @if (_dashboard.Halaqas.Count == 0)
                {
                    <div class="state-box">لا توجد حلقات مسندة حالياً.</div>
                }
                else
                {
                    @foreach (var halaqa in _dashboard.Halaqas)
                    {
                        <div class="halaqa-row">
                            <div class="halaqa-row-header">
                                <div>
                                    <strong class="value">@Display(halaqa.HalqaName)</strong>
                                    <div class="muted">@Display(halaqa.HalqaType)</div>
                                </div>
                                <span class="pill"><i class="bi bi-people"></i>@halaqa.StudentsCount طالب</span>
                            </div>
                            <div class="mt-2 muted">
                                الحضور: @halaqa.AttendanceRatePercent% | متوسط المستوى: @halaqa.AverageLevelScore | إدخالات هذا الشهر: @halaqa.ProgressEntriesThisMonth
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="content-card">
                <h2 class="card-title"><i class="bi bi-stars"></i> الطلاب المتقدمون</h2>
                @if (_dashboard.TopStudents.Count == 0)
                {
                    <div class="state-box">لا توجد بيانات طلاب متقدمين حالياً.</div>
                }
                else
                {
                    @foreach (var student in _dashboard.TopStudents)
                    {
                        <div class="student-row">
                            <div>
                                <strong class="value">@Display(student.StudentName)</strong>
                                <div class="muted">@Display(student.HalqaName)</div>
                            </div>
                            <span class="pill"><i class="bi bi-star"></i>@student.LevelScore</span>
                        </div>
                    }
                }

                <h2 class="card-title mt-4"><i class="bi bi-bell"></i> يحتاجون متابعة</h2>
                @if (_dashboard.FollowUpStudents.Count == 0)
                {
                    <div class="state-box">لا توجد تنبيهات متابعة حالياً.</div>
                }
                else
                {
                    @foreach (var alert in _dashboard.FollowUpStudents)
                    {
                        <div class="alert-row">
                            <div>
                                <strong class="value">@Display(alert.StudentName)</strong>
                                <div class="muted">@Display(alert.HalqaName)</div>
                                <div class="muted">@Display(alert.Reason)</div>
                            </div>
                            <span class="pill"><i class="bi bi-exclamation-circle"></i>@alert.Count</span>
                        </div>
                    }
                }
            </div>
        </section>
    }
</div>

@code {
    private TeacherDashboardOverviewResponse? _dashboard;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadProfileAsync();
        StateHasChanged();
    }

    private async Task LoadProfileAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _dashboard = await TeacherApiClient.GetOverviewAsync();
            if (_dashboard is null)
                _errorMessage = "تعذر تحميل ملف المعلم.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر تحميل ملف المعلم: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "غير محدد" : value;

    private static string Initial(string? value)
        => string.IsNullOrWhiteSpace(value) ? "م" : value.Trim()[0].ToString();
}
