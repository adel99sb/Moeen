@page "/Teacher/Halaka"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Moeen.Dashboard.Infrastructure.Http.Clients
@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Constants
@using Moeen.Shared.Requests.Goal
@using Moeen.Shared.Responses.TeacherDashboard
@inject InstructorHomeApiClient TeacherApiClient
@inject IGoalService GoalService
@inject NavigationManager Navigation

<PageTitle>تقييم حلقتي</PageTitle>

<style>
    .halaka-page { direction: rtl; min-height: calc(100vh - 70px); background: #faf7f0; color: #163f35; padding: 20px; }
    .halaka-header { background: linear-gradient(135deg, #195042, #246a58); color: #fff; border-radius: 24px; padding: 24px; margin-bottom: 18px; box-shadow: 0 18px 45px rgba(25, 80, 66, .16); }
    .halaka-header h1 { margin: 0 0 8px; font-weight: 900; }
    .halaka-header p { margin: 0; opacity: .88; }
    .halaka-shell { display: grid; grid-template-columns: 310px minmax(0, 1fr); gap: 18px; align-items: start; }
    .students-panel, .entry-panel { background: #fff; border: 1px solid #e4eee9; border-radius: 22px; box-shadow: 0 10px 28px rgba(25, 80, 66, .06); overflow: hidden; }
    .panel-head { padding: 16px 18px; border-bottom: 1px solid #edf3f0; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .panel-head strong { color: #195042; }
    .student-search { margin: 14px; width: calc(100% - 28px); border: 1.5px solid #d6cabc; border-radius: 14px; padding: 11px 14px; outline: none; background: #fbfaf8; }
    .student-search:focus, .form-control-clean:focus, .form-select-clean:focus { border-color: #195042; box-shadow: 0 0 0 4px rgba(25, 80, 66, .08); background: #fff; }
    .student-list { max-height: 650px; overflow: auto; padding: 0 14px 14px; display: grid; gap: 10px; }
    .student-button { border: 1px solid #edf1ee; background: #fbfdfa; color: #163f35; border-radius: 16px; padding: 12px; text-align: right; transition: .2s ease; width: 100%; }
    .student-button:hover, .student-button.active { background: #195042; color: #fff; border-color: #195042; transform: translateY(-1px); }
    .student-button small { display: block; opacity: .78; margin-top: 4px; }
    .student-meta-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; padding: 16px 18px; background: #fbfdfa; border-bottom: 1px solid #edf3f0; }
    .meta-card { background: #fff; border: 1px solid #edf1ee; border-radius: 14px; padding: 12px; }
    .meta-card small { color: #6b7280; font-weight: 800; display: block; margin-bottom: 4px; }
    .meta-card strong { color: #195042; font-size: 1.1rem; }
    .entry-body { padding: 18px; }
    .entry-tabs { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 16px; }
    .entry-tab { border: 1px solid #dfece7; background: #fff; color: #195042; border-radius: 14px; padding: 11px 16px; font-weight: 900; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
    .entry-tab.active { background: #195042; color: #fff; border-color: #195042; }
    .entry-section { border: 1px solid #e4eee9; border-radius: 18px; padding: 16px; margin-bottom: 14px; background: #fff; }
    .section-title { display: flex; align-items: center; justify-content: space-between; gap: 10px; color: #195042; font-weight: 900; margin-bottom: 12px; }
    .entry-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .entry-grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .form-field label { font-size: .86rem; font-weight: 800; margin-bottom: 6px; color: #31443e; display: block; }
    .form-control-clean, .form-select-clean { width: 100%; border: 1.5px solid #d6cabc; border-radius: 12px; padding: 10px 12px; outline: none; min-height: 44px; background: #fbfaf8; color: #1c332d; }
    textarea.form-control-clean { min-height: 92px; resize: vertical; }
    .attendance-row { display: flex; flex-wrap: wrap; gap: 10px; }
    .attendance-pill { border: 1px solid #dfece7; border-radius: 999px; padding: 10px 18px; cursor: pointer; font-weight: 900; background: #fff; color: #195042; }
    .attendance-pill.active { background: #195042; color: #fff; }
    .attendance-pill input { display: none; }
    .actions-row { display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: center; margin-top: 18px; }
    .btn-save, .btn-light-clean { border: 0; border-radius: 14px; padding: 12px 18px; font-weight: 900; display: inline-flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; }
    .btn-save { background: #195042; color: #fff; }
    .btn-light-clean { background: #f4f1ee; color: #195042; }
    .btn-save:disabled, .btn-light-clean:disabled { opacity: .65; cursor: not-allowed; }
    .status-box { border-radius: 16px; padding: 14px 16px; margin-bottom: 14px; border: 1px solid transparent; }
    .status-success { background: #eaf8f0; color: #14723a; border-color: #bde6cc; }
    .status-error { background: #fff1f1; color: #b42318; border-color: #f3c4c4; }
    .empty-state, .loading-state { border: 1px dashed #d6cabc; border-radius: 18px; padding: 28px; text-align: center; color: #667085; background: #fffdfb; }
    @@media (max-width: 1100px) { .halaka-shell { grid-template-columns: 1fr; } .student-meta-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @@media (max-width: 700px) { .halaka-page { padding: 12px; } .entry-grid, .entry-grid.two, .student-meta-grid, .actions-row { grid-template-columns: 1fr; } }
</style>

<div class="halaka-page">
    <header class="halaka-header">
        <h1>تقييم حلقتي</h1>
        <p>اختر طالباً من الطلاب التابعين للحلقات المسندة لك، ثم أدخل بيانات اليوم واحفظها.</p>
    </header>

    @if (_isLoading)
    {
        <div class="loading-state">
            <span class="spinner-border text-success" role="status"></span>
            <div class="mt-3">جاري تحميل طلاب حلقاتك...</div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="status-box status-error">@_loadError</div>
    }
    else
    {
        <div class="halaka-shell">
            <aside class="students-panel">
                <div class="panel-head">
                    <strong><i class="bi bi-people ms-1"></i> طلاب حلقاتي</strong>
                    <span>@_students.Count</span>
                </div>
                <input class="student-search" @bind="_studentSearch" @bind:event="oninput" placeholder="ابحث عن طالب..." />
                <div class="student-list">
                    @if (!FilteredStudents.Any())
                    {
                        <div class="empty-state">لا يوجد طلاب مطابقون.</div>
                    }
                    else
                    {
                        @foreach (var student in FilteredStudents)
                        {
                            <button type="button" class="@GetStudentButtonClass(student.StudentId)" @onclick="() => SelectStudent(student.StudentId)">
                                <strong>@Display(student.StudentName)</strong>
                                <small>@Display(student.HalqaName)</small>
                            </button>
                        }
                    }
                </div>
            </aside>

            <main class="entry-panel">
                <div class="panel-head">
                    <strong><i class="bi bi-journal-check ms-1"></i> إدخال بيانات اليوم</strong>
                    <span>@_entry.Date.ToString("yyyy/MM/dd")</span>
                </div>

                @if (SelectedStudent is null)
                {
                    <div class="entry-body">
                        <div class="empty-state">اختر طالباً من القائمة حتى تظهر استمارة التقييم.</div>
                    </div>
                }
                else
                {
                    <div class="student-meta-grid">
                        <div class="meta-card"><small>الطالب</small><strong>@SelectedStudent.StudentName</strong></div>
                        <div class="meta-card"><small>الحلقة</small><strong>@SelectedStudent.HalqaName</strong></div>
                        <div class="meta-card"><small>آخر صفحة</small><strong>@SelectedStudent.LatestPageNumber</strong></div>
                        <div class="meta-card"><small>آخر سجل</small><strong>@FormatDate(SelectedStudent.LastProgressDate)</strong></div>
                    </div>

                    <div class="entry-body">
                        @if (!string.IsNullOrWhiteSpace(_successMessage))
                        {
                            <div class="status-box status-success"><i class="bi bi-check-circle ms-1"></i>@_successMessage</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_errorMessage))
                        {
                            <div class="status-box status-error"><i class="bi bi-exclamation-triangle ms-1"></i>@_errorMessage</div>
                        }

                        <div class="entry-tabs">
                            <button type="button" class="entry-tab active"><i class="bi bi-pencil-square"></i> إدخال بيانات اليوم</button>
                            <button type="button" class="entry-tab" disabled="@_isSaving" @onclick="OpenSelectedStudentHistory"><i class="bi bi-clock-history"></i> السجل السابق</button>
                        </div>

                        <div class="entry-section">
                            <div class="section-title"><span><i class="bi bi-calendar-event ms-1"></i> التاريخ والحضور</span></div>
                            <div class="entry-grid two">
                                <div class="form-field">
                                    <label>تاريخ الإدخال</label>
                                    <input type="date" class="form-control-clean" @bind="_entry.Date" />
                                </div>
                                <div class="form-field">
                                    <label>الحضور</label>
                                    <div class="attendance-row">
                                        <label class="@GetAttendanceClass(AttendanceStatus.Present)"><input type="radio" name="attendance" @onchange="() => _entry.AttendanceStatus = AttendanceStatus.Present" /> حاضر</label>
                                        <label class="@GetAttendanceClass(AttendanceStatus.Absent)"><input type="radio" name="attendance" @onchange="() => _entry.AttendanceStatus = AttendanceStatus.Absent" /> غائب</label>
                                        <label class="@GetAttendanceClass(AttendanceStatus.Late)"><input type="radio" name="attendance" @onchange="() => _entry.AttendanceStatus = AttendanceStatus.Late" /> متأخر</label>
                                        <label class="@GetAttendanceClass(AttendanceStatus.Excused)"><input type="radio" name="attendance" @onchange="() => _entry.AttendanceStatus = AttendanceStatus.Excused" /> معذور</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="entry-section">
                            <div class="section-title"><span><i class="bi bi-book ms-1"></i> تسميع اليوم</span><small>اختياري</small></div>
                            <div class="entry-grid">
                                <div class="form-field"><label>الجزء</label><input type="number" min="1" max="30" class="form-control-clean" @bind="_entry.MemorizationJuz" /></div>
                                <div class="form-field"><label>من صفحة</label><input type="number" min="1" max="604" class="form-control-clean" @bind="_entry.MemorizationFromPage" /></div>
                                <div class="form-field"><label>إلى صفحة</label><input type="number" min="1" max="604" class="form-control-clean" @bind="_entry.MemorizationToPage" /></div>
                                <div class="form-field"><label>التقدير</label><select class="form-select-clean" @bind="_entry.MemorizationGrade">@GradeOptions()</select></div>
                            </div>
                        </div>

                        <div class="entry-section">
                            <div class="section-title"><span><i class="bi bi-arrow-repeat ms-1"></i> المراجعة اليومية</span><small>اختياري</small></div>
                            <div class="entry-grid">
                                <div class="form-field"><label>الجزء</label><input type="number" min="1" max="30" class="form-control-clean" @bind="_entry.ReviewJuz" /></div>
                                <div class="form-field"><label>من صفحة</label><input type="number" min="1" max="604" class="form-control-clean" @bind="_entry.ReviewFromPage" /></div>
                                <div class="form-field"><label>إلى صفحة</label><input type="number" min="1" max="604" class="form-control-clean" @bind="_entry.ReviewToPage" /></div>
                                <div class="form-field"><label>التقدير</label><select class="form-select-clean" @bind="_entry.ReviewGrade">@GradeOptions()</select></div>
                            </div>
                        </div>

                        <div class="entry-section">
                            <div class="section-title"><span><i class="bi bi-clipboard-check ms-1"></i> اختبار سريع</span><small>اختياري</small></div>
                            <div class="entry-grid">
                                <div class="form-field"><label>من جزء</label><input type="number" min="1" max="30" class="form-control-clean" @bind="_entry.ExamJuzFrom" /></div>
                                <div class="form-field"><label>إلى جزء</label><input type="number" min="1" max="30" class="form-control-clean" @bind="_entry.ExamJuzTo" /></div>
                                <div class="form-field"><label>العلامة</label><input type="number" min="0" max="100" class="form-control-clean" @bind="_entry.ExamScore" /></div>
                            </div>
                        </div>

                        <div class="entry-section">
                            <div class="section-title"><span><i class="bi bi-star ms-1"></i> النقاط والملاحظات</span></div>
                            <div class="entry-grid two">
                                <div class="form-field"><label>نقاط إضافية</label><input type="number" min="0" max="100" class="form-control-clean" @bind="_entry.ExtraPoints" /></div>
                                <div class="form-field"><label>ملاحظات المعلم</label><textarea class="form-control-clean" @bind="_entry.TeacherNotes" placeholder="اكتب ملاحظاتك حول أداء الطالب اليوم..."></textarea></div>
                            </div>
                        </div>

                        <div class="actions-row">
                            <button type="button" class="btn-save" disabled="@_isSaving" @onclick="SaveDailyEntryAsync">
                                @if (_isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm"></span><span>جاري الحفظ...</span>
                                }
                                else
                                {
                                    <i class="bi bi-cloud-arrow-up"></i><span>حفظ بيانات الطالب</span>
                                }
                            </button>
                            <button type="button" class="btn-light-clean" disabled="@_isSaving" @onclick="() => ResetEntryForm()"><i class="bi bi-arrow-counterclockwise"></i> تفريغ النموذج</button>
                        </div>
                    </div>
                }
            </main>
        </div>
    }
</div>

@code {
    private TeacherHalaqaProgressResponse? _progress;
    private readonly List<SelectableStudent> _students = new();
    private DailyEntryForm _entry = new();
    private Guid? SelectedStudentId { get; set; }
    private string _studentSearch = string.Empty;
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _loadError;
    private string? _errorMessage;
    private string? _successMessage;

    private SelectableStudent? SelectedStudent => SelectedStudentId.HasValue ? _students.FirstOrDefault(s => s.StudentId == SelectedStudentId.Value) : null;
    private IEnumerable<SelectableStudent> FilteredStudents => string.IsNullOrWhiteSpace(_studentSearch)
        ? _students
        : _students.Where(s => s.StudentName.Contains(_studentSearch.Trim(), StringComparison.OrdinalIgnoreCase) || s.HalqaName.Contains(_studentSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadTeacherStudentsAsync();
        StateHasChanged();
    }

    private async Task LoadTeacherStudentsAsync(bool preserveSelection = false)
    {
        _isLoading = !preserveSelection;
        _loadError = null;
        try
        {
            var currentSelection = SelectedStudentId;
            _progress = await TeacherApiClient.GetMyHalaqasProgressAsync();
            _students.Clear();
            if (_progress is not null)
            {
                _students.AddRange(_progress.Halaqas.SelectMany(h => h.Students.Select(s => new SelectableStudent
                {
                    StudentId = s.StudentId,
                    StudentName = s.StudentName,
                    HalqaId = h.HalqaId,
                    HalqaName = h.HalqaName,
                    Points = s.Points,
                    LatestPageNumber = s.LatestPageNumber,
                    MemorizationPercent = s.MemorizationPercent,
                    AttendanceRatePercent = s.AttendanceRatePercent,
                    LastProgressDate = s.LastProgressDate
                })).OrderBy(s => s.HalqaName).ThenBy(s => s.StudentName));
            }

            if (preserveSelection && currentSelection.HasValue && _students.Any(s => s.StudentId == currentSelection.Value))
                SelectedStudentId = currentSelection;
            else
                SelectedStudentId = _students.FirstOrDefault()?.StudentId;
        }
        catch (Exception ex)
        {
            _loadError = $"تعذر تحميل طلاب الحلقات المرتبطة بحسابك: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SelectStudent(Guid studentId)
    {
        SelectedStudentId = studentId;
        _successMessage = null;
        _errorMessage = null;
    }

    private async Task SaveDailyEntryAsync()
    {
        if (!SelectedStudentId.HasValue)
        {
            _errorMessage = "اختر الطالب أولاً.";
            return;
        }

        _isSaving = true;
        _successMessage = null;
        _errorMessage = null;

        try
        {
            var validation = ValidateEntry();
            if (!string.IsNullOrWhiteSpace(validation))
            {
                _errorMessage = validation;
                return;
            }

            var request = new RecordDailyEntryRequest
            {
                StudentId = SelectedStudentId.Value,
                Date = _entry.Date.Date,
                AttendanceStatus = _entry.AttendanceStatus,
                ExtraPoints = Math.Clamp(_entry.ExtraPoints, 0, 100),
                TeacherNotes = string.IsNullOrWhiteSpace(_entry.TeacherNotes) ? null : _entry.TeacherNotes.Trim()
            };

            if (HasRange(_entry.MemorizationJuz, _entry.MemorizationFromPage, _entry.MemorizationToPage))
            {
                request.Memorization = new MemorizationEntryDto
                {
                    JuzNumber = _entry.MemorizationJuz,
                    FromPage = _entry.MemorizationFromPage,
                    ToPage = _entry.MemorizationToPage,
                    Grade = _entry.MemorizationGrade
                };
            }

            if (HasRange(_entry.ReviewJuz, _entry.ReviewFromPage, _entry.ReviewToPage))
            {
                request.Review = new ReviewEntryDto
                {
                    JuzNumber = _entry.ReviewJuz,
                    FromPage = _entry.ReviewFromPage,
                    ToPage = _entry.ReviewToPage,
                    Grade = _entry.ReviewGrade
                };
            }

            if (_entry.ExamJuzFrom > 0 || _entry.ExamJuzTo > 0 || _entry.ExamScore > 0)
            {
                request.Exam = new ExamEntryDto
                {
                    JuzFrom = Math.Clamp(_entry.ExamJuzFrom, 1, 30),
                    JuzTo = Math.Clamp(_entry.ExamJuzTo <= 0 ? _entry.ExamJuzFrom : _entry.ExamJuzTo, 1, 30),
                    Score = Math.Clamp(_entry.ExamScore, 0, 100),
                    Mark = Math.Clamp(_entry.ExamScore, 0, 100),
                    Notes = request.TeacherNotes
                };
            }

            var response = await GoalService.RecordDailyEntryAsync(request);
            if (response == null || !response.Success)
            {
                _errorMessage = string.IsNullOrWhiteSpace(response?.Message) ? "فشل حفظ بيانات الطالب." : response.Message;
                return;
            }

            _successMessage = string.IsNullOrWhiteSpace(response.Message) ? "تم حفظ بيانات الطالب." : response.Message;
            ResetEntryForm(keepMessages: true);
            await LoadTeacherStudentsAsync(preserveSelection: true);
        }
        catch (Exception ex)
        {
            _errorMessage = $"حدث خطأ أثناء حفظ بيانات الطالب: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private string? ValidateEntry()
    {
        if (_entry.Date == default)
            return "تاريخ الإدخال مطلوب.";

        if (IsPartialRange(_entry.MemorizationJuz, _entry.MemorizationFromPage, _entry.MemorizationToPage))
            return "أكمل حقول تسميع اليوم: الجزء، من صفحة، إلى صفحة.";

        if (IsPartialRange(_entry.ReviewJuz, _entry.ReviewFromPage, _entry.ReviewToPage))
            return "أكمل حقول المراجعة اليومية: الجزء، من صفحة، إلى صفحة.";

        if (HasRange(_entry.MemorizationJuz, _entry.MemorizationFromPage, _entry.MemorizationToPage) && _entry.MemorizationFromPage > _entry.MemorizationToPage)
            return "في التسميع، صفحة البداية يجب أن تكون قبل أو تساوي صفحة النهاية.";

        if (HasRange(_entry.ReviewJuz, _entry.ReviewFromPage, _entry.ReviewToPage) && _entry.ReviewFromPage > _entry.ReviewToPage)
            return "في المراجعة، صفحة البداية يجب أن تكون قبل أو تساوي صفحة النهاية.";

        if ((_entry.ExamJuzFrom > 0 || _entry.ExamJuzTo > 0 || _entry.ExamScore > 0) && (_entry.ExamJuzFrom <= 0 || _entry.ExamJuzTo <= 0))
            return "أكمل حقول الاختبار: من جزء وإلى جزء.";

        return null;
    }

    private void OpenSelectedStudentHistory()
    {
        if (SelectedStudentId.HasValue)
            Navigation.NavigateTo($"/Teacher/Progress?studentId={SelectedStudentId.Value}");
    }

    private void ResetEntryForm(bool keepMessages = false)
    {
        _entry = new DailyEntryForm();
        if (!keepMessages)
        {
            _successMessage = null;
            _errorMessage = null;
        }
    }

    private RenderFragment GradeOptions() => builder =>
    {
        var seq = 0;
        foreach (var item in new[]
        {
            (Grade.Excellent, "ممتاز"),
            (Grade.VeryGood, "جيد جداً"),
            (Grade.Good, "جيد"),
            (Grade.Acceptable, "مقبول"),
            (Grade.Weak, "ضعيف")
        })
        {
            builder.OpenElement(seq++, "option");
            builder.AddAttribute(seq++, "value", item.Item1);
            builder.AddContent(seq++, item.Item2);
            builder.CloseElement();
        }
    };

    private string GetStudentButtonClass(Guid studentId) => SelectedStudentId == studentId ? "student-button active" : "student-button";
    private string GetAttendanceClass(AttendanceStatus status) => _entry.AttendanceStatus == status ? "attendance-pill active" : "attendance-pill";
    private static bool HasRange(int juz, int from, int to) => juz > 0 && from > 0 && to > 0;
    private static bool IsPartialRange(int juz, int from, int to) => (juz > 0 || from > 0 || to > 0) && !HasRange(juz, from, to);
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "غير محدد" : value;
    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToLocalTime().ToString("yyyy/MM/dd") : "لا يوجد";

    private sealed class SelectableStudent
    {
        public Guid StudentId { get; set; }
        public string StudentName { get; set; } = string.Empty;
        public Guid HalqaId { get; set; }
        public string HalqaName { get; set; } = string.Empty;
        public int Points { get; set; }
        public int LatestPageNumber { get; set; }
        public int MemorizationPercent { get; set; }
        public int AttendanceRatePercent { get; set; }
        public DateTime? LastProgressDate { get; set; }
    }

    private sealed class DailyEntryForm
    {
        public DateTime Date { get; set; } = DateTime.Today;
        public AttendanceStatus AttendanceStatus { get; set; } = AttendanceStatus.Present;
        public int MemorizationJuz { get; set; }
        public int MemorizationFromPage { get; set; }
        public int MemorizationToPage { get; set; }
        public Grade MemorizationGrade { get; set; } = Grade.Good;
        public int ReviewJuz { get; set; }
        public int ReviewFromPage { get; set; }
        public int ReviewToPage { get; set; }
        public Grade ReviewGrade { get; set; } = Grade.Good;
        public int ExamJuzFrom { get; set; }
        public int ExamJuzTo { get; set; }
        public int ExamScore { get; set; }
        public int ExtraPoints { get; set; }
        public string? TeacherNotes { get; set; }
    }
}
