@page "/Teacher/TeacherDashboard"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Moeen.Dashboard.Infrastructure.Http.Clients
@using Moeen.Shared.Responses.TeacherDashboard
@inject InstructorHomeApiClient TeacherApiClient

<h1>الرئيسية</h1>

@if (_isLoading)
{
    <p>جاري تحميل البيانات...</p>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <p>@_errorMessage</p>
}
else if (_dashboard is not null)
{
    <p>@_dashboard.TeacherName</p>
    <p>الحلقات: @_dashboard.TotalHalaqas</p>
    <p>الطلاب: @_dashboard.TotalStudents</p>
}

@code {
    private TeacherDashboardOverviewResponse? _dashboard;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadDashboardAsync();
        StateHasChanged();
    }

    private async Task LoadDashboardAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try { _dashboard = await TeacherApiClient.GetOverviewAsync(); }
        catch (Exception ex) { _errorMessage = ex.Message; }
        finally { _isLoading = false; }
    }
}
