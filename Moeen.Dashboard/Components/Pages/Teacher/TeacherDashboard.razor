@page "/Teacher/TeacherDashboard"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Moeen.Dashboard.Infrastructure.Http.Clients
@using Moeen.Shared.Responses.TeacherDashboard
@inject InstructorHomeApiClient TeacherApiClient

<PageTitle>لوحة المعلم</PageTitle>

<style>
    .teacher-dashboard-page { direction: rtl; padding: 24px; color: #173f35; background: #faf7f0; min-height: calc(100vh - 70px); }
    .teacher-hero { background: linear-gradient(135deg, #195042, #26735f); color: #fff; border-radius: 26px; padding: 26px; box-shadow: 0 18px 45px rgba(25, 80, 66, .18); margin-bottom: 22px; display: flex; justify-content: space-between; gap: 18px; flex-wrap: wrap; align-items: center; }
    .teacher-hero h1 { margin: 0 0 8px; font-weight: 900; }
    .teacher-hero p { margin: 0; opacity: .88; }
    .hero-chip { background: rgba(255, 255, 255, .13); border: 1px solid rgba(255, 255, 255, .25); border-radius: 999px; padding: 10px 16px; display: inline-flex; align-items: center; gap: 8px; font-weight: 800; }
    .metrics-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-bottom: 22px; }
    .metric-card { background: #fff; border: 1px solid #e4eee9; border-radius: 20px; padding: 18px; box-shadow: 0 10px 28px rgba(25, 80, 66, .07); min-height: 128px; display: flex; flex-direction: column; justify-content: space-between; }
    .metric-icon { width: 42px; height: 42px; border-radius: 14px; background: #eef7f3; color: #195042; display: inline-flex; align-items: center; justify-content: center; font-size: 1.25rem; margin-bottom: 12px; }
    .metric-card small { color: #6b7280; font-weight: 800; }
    .metric-card strong { display: block; color: #195042; font-size: 2rem; line-height: 1; margin-top: 8px; }
    .dashboard-grid { display: grid; grid-template-columns: 1.25fr .75fr; gap: 16px; }
    .dashboard-panel { background: #fff; border: 1px solid #e4eee9; border-radius: 22px; padding: 18px; box-shadow: 0 10px 28px rgba(25, 80, 66, .06); }
    .panel-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; border-bottom: 1px solid #edf3f0; padding-bottom: 12px; margin-bottom: 14px; }
    .panel-title h2 { margin: 0; font-size: 1.05rem; font-weight: 900; color: #195042; }
    .halaqa-list { display: grid; gap: 12px; }
    .halaqa-row { border: 1px solid #edf1ee; background: #fbfdfa; border-radius: 16px; padding: 14px; }
    .halaqa-row-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 10px; }
    .halaqa-name { font-weight: 900; color: #173f35; }
    .halaqa-type { background: #f4f1ee; color: #195042; border-radius: 999px; padding: 4px 10px; font-size: .82rem; font-weight: 800; }
    .progress-track { height: 9px; border-radius: 999px; background: #edf3f0; overflow: hidden; }
    .progress-fill { height: 100%; border-radius: inherit; background: #195042; }
    .row-meta { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 10px; color: #6b7280; font-size: .88rem; }
    .student-table { width: 100%; border-collapse: separate; border-spacing: 0 8px; }
    .student-table td { background: #fbfdfa; border-top: 1px solid #edf1ee; border-bottom: 1px solid #edf1ee; padding: 10px; }
    .student-table td:first-child { border-radius: 0 12px 12px 0; }
    .student-table td:last-child { border-radius: 12px 0 0 12px; text-align: left; }
    .student-avatar { width: 36px; height: 36px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: #eef7f3; color: #195042; font-weight: 900; margin-left: 8px; }
    .empty-state, .loading-state, .error-state { background: #fff; border: 1px dashed #d6cabc; border-radius: 18px; padding: 26px; text-align: center; color: #667085; }
    .error-state { border-color: #f1b4b4; color: #b42318; background: #fff8f8; }
    .alert-list { display: grid; gap: 10px; }
    .alert-item { background: #fff8e7; border: 1px solid #f1d69a; color: #735900; border-radius: 14px; padding: 12px; }
    @@media (max-width: 1100px) { .metrics-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .dashboard-grid { grid-template-columns: 1fr; } }
    @@media (max-width: 640px) { .teacher-dashboard-page { padding: 14px; } .metrics-grid, .row-meta { grid-template-columns: 1fr; } }
</style>

<div class="teacher-dashboard-page">
    @if (_isLoading)
    {
        <div class="loading-state"><span class="spinner-border text-success" role="status"></span><div class="mt-3">جاري تحميل لوحة المعلم...</div></div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="error-state"><i class="bi bi-exclamation-triangle fs-3 d-block mb-2"></i>@_errorMessage</div>
    }
    else if (_dashboard is not null)
    {
        <section class="teacher-hero">
            <div>
                <h1>لوحة المعلم</h1>
                <p>مرحباً @Display(_dashboard.TeacherName)، هذه نظرة على حلقاتك وطلابك ومتابعاتك.</p>
            </div>
            <div class="hero-chip"><i class="bi bi-building"></i> @Display(_dashboard.MosqueName)</div>
        </section>

        <section class="metrics-grid">
            <div class="metric-card"><div><span class="metric-icon"><i class="bi bi-diagram-3"></i></span><small>الحلقات</small><strong>@_dashboard.TotalHalaqas</strong></div></div>
            <div class="metric-card"><div><span class="metric-icon"><i class="bi bi-people"></i></span><small>الطلاب</small><strong>@_dashboard.TotalStudents</strong></div></div>
            <div class="metric-card"><div><span class="metric-icon"><i class="bi bi-calendar-check"></i></span><small>حضور اليوم</small><strong>@_dashboard.AttendanceTodayPercent%</strong></div></div>
            <div class="metric-card"><div><span class="metric-icon"><i class="bi bi-star"></i></span><small>نقاط التميز</small><strong>@_dashboard.ExcellencePoints</strong></div></div>
        </section>

        <section class="dashboard-grid">
            <div class="dashboard-panel">
                <div class="panel-title"><h2><i class="bi bi-bar-chart ms-1"></i> تقدم الحلقات</h2><span>@_dashboard.TotalMemorizedPages صفحة محفوظة</span></div>
                @if (_dashboard.Halaqas.Count == 0)
                {
                    <div class="empty-state">لا توجد حلقات مرتبطة بحسابك حالياً.</div>
                }
                else
                {
                    <div class="halaqa-list">
                        @foreach (var halaqa in _dashboard.Halaqas)
                        {
                            <article class="halaqa-row">
                                <div class="halaqa-row-header"><span class="halaqa-name">@Display(halaqa.HalqaName)</span><span class="halaqa-type">@Display(halaqa.HalqaType)</span></div>
                                <div class="progress-track"><div class="progress-fill" style="width:@ClampPercent(halaqa.AttendanceRatePercent)%"></div></div>
                                <div class="row-meta">
                                    <span><i class="bi bi-people ms-1"></i>@halaqa.StudentsCount طالب</span>
                                    <span><i class="bi bi-journal-check ms-1"></i>@halaqa.ProgressEntriesThisMonth متابعة هذا الشهر</span>
                                    <span><i class="bi bi-graph-up ms-1"></i>متوسط المستوى @halaqa.AverageLevelScore</span>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>

            <div class="dashboard-panel">
                <div class="panel-title"><h2><i class="bi bi-trophy ms-1"></i> أفضل الطلاب</h2></div>
                @if (_dashboard.TopStudents.Count == 0)
                {
                    <div class="empty-state">لا توجد بيانات طلاب حالياً.</div>
                }
                else
                {
                    <table class="student-table"><tbody>
                        @foreach (var student in _dashboard.TopStudents)
                        {
                            <tr>
                                <td><span class="student-avatar">@Initial(student.StudentName)</span>@Display(student.StudentName)<br /><small>@Display(student.HalqaName)</small></td>
                                <td><strong>@student.LevelScore</strong><br /><small>@FormatDate(student.LastProgressDate)</small></td>
                            </tr>
                        }
                    </tbody></table>
                }
            </div>
        </section>

        <section class="dashboard-panel mt-3">
            <div class="panel-title"><h2><i class="bi bi-bell ms-1"></i> تنبيهات المتابعة</h2><span>@_dashboard.FollowUpAlerts تنبيه</span></div>
            @if (_dashboard.FollowUpStudents.Count == 0)
            {
                <div class="empty-state">لا توجد تنبيهات متابعة حالياً.</div>
            }
            else
            {
                <div class="alert-list">
                    @foreach (var alert in _dashboard.FollowUpStudents)
                    {
                        <div class="alert-item"><strong>@Display(alert.StudentName)</strong> - @Display(alert.HalqaName)<div>@Display(alert.Reason)</div></div>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    private TeacherDashboardOverviewResponse? _dashboard;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadDashboardAsync();
        StateHasChanged();
    }

    private async Task LoadDashboardAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try { _dashboard = await TeacherApiClient.GetOverviewAsync(); }
        catch (Exception ex) { _errorMessage = $"تعذر تحميل لوحة المعلم: {ex.Message}"; }
        finally { _isLoading = false; }
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "غير محدد" : value;
    private static string Initial(string? value) => string.IsNullOrWhiteSpace(value) ? "؟" : value.Trim()[0].ToString();
    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToLocalTime().ToString("yyyy/MM/dd") : "-";
    private static int ClampPercent(int value) => Math.Clamp(value, 0, 100);
}
