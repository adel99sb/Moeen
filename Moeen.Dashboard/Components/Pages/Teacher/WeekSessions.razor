@page "/Teacher/WeekSessions"

<style>
    /* 1. عزل التنسيقات وضبط الاتجاه */
    .week-sessions-container {
        direction: rtl;
        text-align: right;
        font-family: var(--font-family-main);
        background-color: var(--color-bg-page);
        padding-bottom: var(--spacing-pb-container);
    }

    /* 2. المتغيرات اللونية والخطوط والأبعاد */
    :root {
        /* الألوان الأساسية */
        --color-primary-green: #195042;
        --color-luxury-beige: #d6cabc;
        --color-text-dark: #2c3e50;
        --color-border-light: #e9ecef;
        --color-bg-page: #f8f9fa;
        --color-white: #ffffff;
        --color-border-input: #ced4da;
        --color-success: #28a745;
        --color-danger: #dc3545;
        --color-border-history: #eeeeee;
        
        /* ظلال وألوان شبه شفافة */
        --shadow-card: 0 4px 15px rgba(0,0,0,0.05);
        --bg-header-overlay: rgba(0,0,0,0.1);
        --shadow-focus: rgba(25, 80, 66, 0.15);
        --bg-success-soft: rgba(40, 167, 69, 0.1);
        
        /* الخطوط */
        --font-family-main: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        
        /* الأحجام والابعاد */
        --radius-card: 16px;
        --radius-badge: 20px;
        --radius-input: 10px;
        --radius-btn: 8px;
        --radius-icon: 50%;
        
        --width-points-input: 60px;
        --height-history-icon: 40px;
        --width-history-icon: 40px;
        
        --spacing-header-py: 2rem;
        --spacing-card-px: 1.5rem;
        --spacing-card-py: 1rem;
        --spacing-body: 1.5rem;
        --spacing-table-cell-py: 12px;
        --spacing-table-cell-px: 10px;
        --spacing-label-py: 6px;
        --spacing-label-px: 12px;
        --spacing-select-py: 10px;
        --spacing-input-py: 5px;
        --spacing-icon-py: 1rem;
        --spacing-icon-px: 1.5rem;
        --spacing-history-item-py: 1rem;
        --spacing-history-item-px: 1.5rem;
        
        --mb-header: 2rem;
        --mb-card: 1.5rem;
        --mb-select: 1.5rem;
        --ml-icon: 15px;
        --pr-table-first: 15px;
        
        --gap-header-actions: 10px;
        --gap-history: 10px;
        --gap-labels: 2px;
        
        --font-size-title: 1.1rem;
        --font-size-badge: 0.8rem;
        --font-size-icon: 1.2rem;
        --font-size-label: 0.85rem;
        --font-size-history-badge: 0.7rem;
        
        --font-weight-title: 800;
        --font-weight-th: 700;
        --font-weight-td: 600;
        --font-weight-badge: bold;
        
        --border-width-header: 4px;
        --border-width-th: 2px;
        --border-width-td: 1px;
        --border-width-label: 1px;
        --border-width-input: 1px;
        --border-width-select: 1px;
        
        --transition-icon: transform 0.3s ease;
        --transition-label: all 0.2s;
    }

    /* 3. رأسية الصفحة */
    .page-header {
        background-color: var(--color-primary-green);
        color: var(--color-luxury-beige);
        padding: var(--spacing-header-py) 0;
        margin-bottom: var(--mb-header);
        border-bottom: var(--border-width-header) solid var(--color-luxury-beige);
    }

    /* 4. تصميم البطاقة (Card) */
    .session-card {
        background: var(--color-white);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card);
        overflow: hidden;
        margin-bottom: var(--mb-card);
        border: none;
    }

    /* رأس البطاقة (الجزء البيج) */
    .card-header-custom {
        background-color: var(--color-luxury-beige);
        padding: var(--spacing-card-py) var(--spacing-card-px);
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        user-select: none;
    }

    .card-title {
        font-weight: var(--font-weight-title);
        color: var(--color-primary-green);
        font-size: var(--font-size-title);
        margin: 0;
    }

    .card-header-actions {
        display: flex;
        align-items: center;
        gap: var(--gap-header-actions);
    }

    .count-badge {
        background-color: var(--color-primary-green);
        color: var(--color-white);
        padding: 4px 10px;
        border-radius: var(--radius-badge);
        font-size: var(--font-size-badge);
        font-weight: var(--font-weight-badge);
    }

    /* أيقونة التدوير */
    .toggle-icon {
        transition: var(--transition-icon);
        color: var(--color-primary-green);
        font-size: var(--font-size-icon);
    }
    
    /* تدوير الأيقونة عند الفتح */
    details[open] .toggle-icon {
        transform: rotate(180deg);
    }

    /* إخفاء مثلث الديفتلز الافتراضي */
    summary::-webkit-details-marker { display: none; }
    summary { list-style: none; }

    /* محتوى البطاقة */
    .card-body-custom {
        padding: var(--spacing-body);
    }

    /* 5. الجدول والتنسيقات الداخلية */
    .custom-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .custom-table th {
        background-color: var(--color-bg-page);
        color: var(--color-primary-green);
        font-weight: var(--font-weight-th);
        padding: 10px;
        border-bottom: var(--border-width-th) solid var(--color-luxury-beige);
        text-align: center;
    }
    
    .custom-table th:first-child { 
        text-align: right; 
        padding-right: var(--pr-table-first); 
    }

    .custom-table td {
        padding: var(--spacing-table-cell-py) var(--spacing-table-cell-px);
        border-bottom: var(--border-width-td) solid var(--color-border-light);
        text-align: center;
        vertical-align: middle;
    }
    
    .custom-table td:first-child { 
        text-align: right; 
        padding-right: var(--pr-table-first); 
        font-weight: var(--font-weight-td);
        color: var(--color-text-dark);
    }

    /* أزرار الحالة */
    .status-radio { display: none; }
    
    .status-label {
        display: inline-block;
        padding: var(--spacing-label-py) var(--spacing-label-px);
        margin: 0 var(--gap-labels);
        border-radius: var(--radius-btn);
        border: var(--border-width-label) solid var(--color-border-input);
        cursor: pointer;
        font-size: var(--font-size-label);
        transition: var(--transition-label);
        background: var(--color-white);
    }

    /* تنسيق عند اختيار حاضر */
    .status-radio:checked + .status-label.present {
        background-color: var(--color-success);
        color: var(--color-white);
        border-color: var(--color-success);
    }

    /* تنسيق عند اختيار غائب */
    .status-radio:checked + .status-label.absent {
        background-color: var(--color-danger);
        color: var(--color-white);
        border-color: var(--color-danger);
    }

    /* حقل النقاط */
    .points-input {
        width: var(--width-points-input);
        text-align: center;
        border: var(--border-width-input) solid var(--color-luxury-beige);
        border-radius: var(--radius-btn);
        padding: var(--spacing-input-py);
        font-weight: var(--font-weight-td);
        color: var(--color-primary-green);
    }
    .points-input:focus {
        outline: none;
        border-color: var(--color-primary-green);
        box-shadow: 0 0 0 0.2rem var(--shadow-focus);
    }

    /* القائمة المنسدلة للدرس */
    .lesson-select {
        width: 100%;
        padding: var(--spacing-select-py);
        border: var(--border-width-select) solid var(--color-luxury-beige);
        border-radius: var(--radius-input);
        background-color: var(--color-white);
        color: var(--color-text-dark);
        margin-bottom: var(--mb-select);
    }

    /* سجل الدروس السابقة */
    .history-section {
        background-color: var(--color-primary-green);
        border-radius: var(--radius-card);
        color: var(--color-white);
        overflow: hidden;
    }
    .history-header {
        padding: var(--spacing-icon-py) var(--spacing-icon-px);
        background-color: var(--bg-header-overlay);
        font-weight: var(--font-weight-badge);
        display: flex;
        align-items: center;
        gap: var(--gap-history);
    }
    .history-item {
        background: var(--color-white);
        color: var(--color-text-dark);
        padding: var(--spacing-history-item-py) var(--spacing-history-item-px);
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: var(--border-width-td) solid var(--color-border-history);
    }
    .history-icon {
        width: var(--width-history-icon); 
        height: var(--height-history-icon);
        background: var(--color-luxury-beige);
        color: var(--color-primary-green);
        border-radius: var(--radius-icon);
        display: flex; 
        align-items: center; 
        justify-content: center;
        margin-left: var(--ml-icon);
    }
</style>

<div class="week-sessions-container container-fluid">
    
    <!-- رأسية الصفحة -->
    <header class="page-header text-center">
        <div class="container">
            <h2 class="fw-bold mb-1">دروس الاسبوع</h2>
            <p class="mb-0 opacity-75">متابعة كل مايخص الدروس</p>
        </div>
    </header>

    <div class="container">
        <div class="row g-4">
            
            <!-- كارد 1: حلقة اليافعين -->
            <div class="col-lg-6">
                <details class="session-card" open>
                    <summary class="card-header-custom">
                        <h3 class="card-title">حلقة اليافعين</h3>
                        <div class="card-header-actions">
                            <span class="count-badge">العدد: 12</span>
                            <i class="bi bi-chevron-down toggle-icon"></i>
                        </div>
                    </summary>
                    <div class="card-body-custom">
                        <label class="fw-bold small text-muted">الدرس الحالي من كتاب:</label>
                        <select class="lesson-select">
                            <option>رياض الصالحين</option>
                            <option>منهاج المسلم</option>
                        </select>

                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th>اسم الطالب</th>
                                    <th>الحالة</th>
                                    <th>النقاط</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>زينب سباعي</td>
                                    <td>
                                        <input type="radio" name="status-y1" id="p-y1" class="status-radio" >
                                        <label for="p-y1" class="status-label present">حاضر</label>
                                        <input type="radio" name="status-y1" id="a-y1" class="status-radio">
                                        <label for="a-y1" class="status-label absent">غائب</label>
                                    </td>
                                    <td><input type="number" class="points-input" value="0" min="0"></td>
                                </tr>
                                <tr>
                                    <td>الاء قاسم</td>
                                    <td>
                                        <input type="radio" name="status-y2" id="p-y2" class="status-radio" >
                                        <label for="p-y2" class="status-label present">حاضر</label>
                                        <input type="radio" name="status-y2" id="a-y2" class="status-radio">
                                        <label for="a-y2" class="status-label absent">غائب</label>
                                    </td>
                                    <td><input type="number" class="points-input" value="0" min="0" ></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </details>
            </div>

            <!-- كارد 2: حلقة الأطفال -->
            <div class="col-lg-6">
                <details class="session-card" open>
                    <summary class="card-header-custom">
                        <h3 class="card-title">حلقة الأطفال</h3>
                        <div class="card-header-actions">
                            <span class="count-badge">العدد: 15</span>
                            <i class="bi bi-chevron-down toggle-icon"></i>
                        </div>
                    </summary>
                    <div class="card-body-custom">
                        <label class="fw-bold small text-muted">الدرس الحالي من كتاب:</label>
                        <select class="lesson-select">
                            <option>قصص الأنبياء</option>
                            <option>العقيدة الإسلامية</option>
                        </select>

                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th>اسم الطالب</th>
                                    <th>الحالة</th>
                                    <th>النقاط</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>هبة عجم</td>
                                    <td>
                                        <input type="radio" name="status-c1" id="p-c1" class="status-radio" >
                                        <label for="p-c1" class="status-label present">حاضر</label>
                                        <input type="radio" name="status-c1" id="a-c1" class="status-radio">
                                        <label for="a-c1" class="status-label absent">غائب</label>
                                    </td>
                                    <td><input type="number" class="points-input" value="0" min="0"></td>
                                </tr>
                                <tr>
                                    <td>آية دعبول</td>
                                    <td>
                                        <input type="radio" name="status-c2" id="a3" class="status-radio" >
                                        <label for="a3" class="status-label present">حاضر</label>
                                        <input type="radio" name="status-c2" id="a4" class="status-radio">
                                        <label for="a4" class="status-label absent">غائب</label>
                                    </td>
                                    <td><input type="number" class="points-input" value="0" min="0"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </details>
            </div>

            <!-- سجل الدروس السابقة -->
            <div class="col-12">
                <div class="history-section">
                    <div class="history-header">
                        <i class="bi bi-clock-history"></i>
                        <span>سجل الدروس السابقة</span>
                    </div>
                    <div class="history-item">
                        <div class="d-flex align-items-center">
                            <div class="history-icon"><i class="bi bi-book"></i></div>
                            <div>
                                <span class="badge bg-light text-dark mb-1">حلقة اليافعين</span>
                                <h6 class="mb-0 fw-bold">  تفسير سورة البقرة: الآيات 1-20</h6>
                                <small class="text-muted">السبت 7 ذو القعدة | حضر: 10 طلاب</small>
                            </div>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success">مكتمل</span>
                    </div>
                    <div class="history-item">
                        <div class="d-flex align-items-center">
                            <div class="history-icon"><i class="bi bi-journal-text"></i></div>
                            <div>
                                <span class="badge bg-light text-dark mb-1">حلقة الأطفال</span>
                                <h6 class="mb-0 fw-bold">قصص الأنبياء: النبي يوسف</h6>
                                <small class="text-muted">السبت 30 شوال | حضر: 14 طالب</small>
                            </div>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success">مكتمل</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>