@page "/Teacher/WeekSessions"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Moeen.Dashboard.Services.Abstractions
@using Moeen.Shared.Constants
@using Moeen.Shared.Requests.LessonManagement
@using Moeen.Shared.Responses.LessonManagement
@inject IWeeklyLessonService WeeklyLessonService

<PageTitle>الدروس الأسبوعية</PageTitle>

<style>
    .week-sessions-container { direction: rtl; text-align: right; background-color: #f8f9fa; min-height: calc(100vh - 70px); padding-bottom: 42px; color: #163f35; }
    .page-header { background-color: #195042; color: #d6cabc; padding: 42px 0; margin-bottom: 32px; border-bottom: 4px solid #d6cabc; }
    .summary-strip { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; background: #fff; border: 1px solid rgba(25, 80, 66, .1); border-radius: 20px; padding: 16px 18px; margin-bottom: 20px; box-shadow: 0 10px 25px rgba(25, 80, 66, .06); }
    .date-input { border: 1.5px solid #d6cabc; border-radius: 12px; padding: 10px 12px; color: #195042; background: #fff; }
    .session-card { background: #fff; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); overflow: hidden; margin-bottom: 24px; border: 1px solid rgba(25, 80, 66, .08); }
    .card-header-custom { background-color: #d6cabc; padding: 16px 22px; display: flex; justify-content: space-between; align-items: center; user-select: none; }
    .card-title { font-weight: 900; color: #195042; font-size: 1.08rem; margin: 0; }
    .card-header-actions { display: flex; align-items: center; gap: 10px; }
    .count-badge { background-color: #195042; color: #fff; padding: 4px 10px; border-radius: 20px; font-size: .8rem; font-weight: 800; }
    .card-body-custom { padding: 22px; }
    .lesson-label { color: #5a6c7d; font-weight: 800; font-size: .88rem; }
    .lesson-title-box { margin: 8px 0 18px; border: 1.5px solid #d6cabc; border-radius: 12px; padding: 12px 14px; background: #fbfaf8; color: #195042; font-weight: 900; }
    .custom-table { width: 100%; border-collapse: separate; border-spacing: 0; }
    .custom-table th { background-color: #f8f9fa; color: #195042; font-weight: 800; padding: 12px 10px; border-bottom: 2px solid #d6cabc; text-align: center; }
    .custom-table th:first-child, .custom-table td:first-child { text-align: right; padding-right: 15px; }
    .custom-table td { padding: 12px 10px; border-bottom: 1px solid #e9ecef; text-align: center; vertical-align: middle; }
    .student-name { font-weight: 800; color: #2c3e50; }
    .status-buttons { display: inline-flex; gap: 6px; flex-wrap: wrap; justify-content: center; }
    .status-label { display: inline-block; padding: 7px 13px; border-radius: 9px; border: 1px solid #ced4da; cursor: pointer; font-size: .85rem; transition: all .2s; background: #fff; color: #195042; font-weight: 800; }
    .status-label.present.active { background-color: #28a745; color: #fff; border-color: #28a745; }
    .status-label.absent.active { background-color: #dc3545; color: #fff; border-color: #dc3545; }
    .points-input { width: 72px; text-align: center; border: 1px solid #d6cabc; border-radius: 9px; padding: 6px; font-weight: 800; color: #195042; }
    .save-btn { background: #195042; color: #fff; border: 0; border-radius: 12px; padding: 10px 18px; font-weight: 900; display: inline-flex; align-items: center; gap: 8px; }
    .save-btn:disabled { opacity: .6; cursor: not-allowed; }
    .history-section { background-color: #195042; border-radius: 16px; color: #fff; overflow: hidden; margin-top: 12px; }
    .history-header { padding: 16px 24px; background-color: rgba(0,0,0,0.1); font-weight: 900; display: flex; align-items: center; gap: 10px; }
    .history-item { background: #fff; color: #2c3e50; padding: 16px 24px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #eee; gap: 12px; }
    .history-icon { width: 40px; height: 40px; background: #d6cabc; color: #195042; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-left: 15px; flex: 0 0 auto; }
    .state-box { background: #fff; border: 1px dashed #d6cabc; border-radius: 16px; padding: 28px; text-align: center; color: #667085; }
    .alert-clean { border-radius: 14px; padding: 12px 14px; margin-bottom: 16px; }
    .alert-ok { background: #eaf8f0; color: #14723a; border: 1px solid #bde6cc; }
    .alert-bad { background: #fff1f1; color: #b42318; border: 1px solid #f3c4c4; }
</style>

<div class="week-sessions-container container-fluid">
    <header class="page-header text-center">
        <div class="container">
            <h2 class="fw-bold mb-1">الدروس الأسبوعية</h2>
            <p class="mb-0 opacity-75">متابعة الدرس الحالي لكل حلقة وحفظ حضور الطلاب ونقاطهم</p>
        </div>
    </header>

    <div class="container">
        <div class="summary-strip">
            <div>
                <strong>تاريخ المتابعة</strong>
                <div class="text-muted small">البيانات المعروضة مرتبطة بحساب المعلم الحالي فقط.</div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <input type="date" class="date-input" @bind="_selectedDate" />
                <button type="button" class="save-btn" @onclick="LoadAsync" disabled="@_isLoading"><i class="bi bi-arrow-clockwise"></i> تحديث</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert-clean alert-ok"><i class="bi bi-check-circle ms-1"></i>@_successMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert-clean alert-bad"><i class="bi bi-exclamation-triangle ms-1"></i>@_errorMessage</div>
        }

        @if (_isLoading)
        {
            <div class="state-box"><span class="spinner-border text-success"></span><div class="mt-3">جاري تحميل دروس المعلم...</div></div>
        }
        else if (_dashboard.Circles.Count == 0)
        {
            <div class="state-box">لا توجد دروس أسبوعية مرتبطة بحلقاتك حالياً.</div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var circle in _dashboard.Circles)
                {
                    <div class="col-lg-6">
                        <details class="session-card" open>
                            <summary class="card-header-custom">
                                <h3 class="card-title">@Display(circle.CircleName)</h3>
                                <div class="card-header-actions">
                                    <span class="count-badge">العدد: @circle.Students.Count</span>
                                    <i class="bi bi-chevron-down toggle-icon"></i>
                                </div>
                            </summary>
                            <div class="card-body-custom">
                                <label class="lesson-label">الدرس الحالي من كتاب:</label>
                                <div class="lesson-title-box">@Display(circle.CurrentLessonTitle)</div>

                                @if (circle.CurrentLessonId is null || circle.CurrentLessonId == Guid.Empty)
                                {
                                    <div class="state-box">لا يوجد درس حالي محدد لهذه الحلقة.</div>
                                }
                                else if (circle.Students.Count == 0)
                                {
                                    <div class="state-box">لا يوجد طلاب مرتبطون بهذه الحلقة.</div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="custom-table">
                                            <thead>
                                                <tr>
                                                    <th>اسم الطالب</th>
                                                    <th>الحالة</th>
                                                    <th>النقاط</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var student in circle.Students)
                                                {
                                                    <tr>
                                                        <td class="student-name">@Display(student.StudentName)</td>
                                                        <td>
                                                            <div class="status-buttons">
                                                                <button type="button" class="@GetPresentStatusClass(circle.CurrentLessonId, student.StudentId)" @onclick="() => SetStatus(circle.CurrentLessonId, student.StudentId, AttendanceStatus.Present)">حاضر</button>
                                                                <button type="button" class="@GetAbsentStatusClass(circle.CurrentLessonId, student.StudentId)" @onclick="() => SetStatus(circle.CurrentLessonId, student.StudentId, AttendanceStatus.Absent)">غائب</button>
                                                            </div>
                                                        </td>
                                                        <td><input type="number" min="0" class="points-input" value="@GetPoints(circle.CurrentLessonId, student.StudentId)" @onchange="e => SetPoints(circle.CurrentLessonId, student.StudentId, e.Value?.ToString())" /></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="text-start mt-3">
                                        <button type="button" class="save-btn" disabled="@_isSaving" @onclick="() => SaveCircleAsync(circle)">
                                            @if (_isSaving)
                                            {
                                                <span class="spinner-border spinner-border-sm"></span><span>جاري الحفظ...</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-cloud-arrow-up"></i><span>حفظ حضور الحلقة</span>
                                            }
                                        </button>
                                    </div>
                                }
                            </div>
                        </details>
                    </div>
                }

                <div class="col-12">
                    <div class="history-section">
                        <div class="history-header"><i class="bi bi-clock-history"></i><span>سجل الدروس السابقة</span></div>
                        @if (_history.Count == 0)
                        {
                            <div class="history-item"><span>لا يوجد سجل سابق بعد.</span></div>
                        }
                        else
                        {
                            @foreach (var item in _history)
                            {
                                <div class="history-item">
                                    <div class="d-flex align-items-center">
                                        <div class="history-icon"><i class="bi bi-book"></i></div>
                                        <div>
                                            <h6 class="mb-0 fw-bold">@Display(item.LessonTitle)</h6>
                                            <small class="text-muted">@item.Date.ToLocalTime().ToString("yyyy/MM/dd") | حاضر: @item.PresentCount | غائب: @item.AbsentCount</small>
                                        </div>
                                    </div>
                                    <span class="badge bg-success bg-opacity-10 text-success">مكتمل</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private WeeklyLessonDashboardDto _dashboard = new() { Date = DateTime.Today };
    private readonly Dictionary<string, AttendanceStatus> _statuses = new();
    private readonly Dictionary<string, int> _points = new();
    private readonly List<LessonHistoryItemDto> _history = new();
    private DateTime _selectedDate = DateTime.Today;
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _successMessage = null;
        try
        {
            _dashboard = await WeeklyLessonService.GetTeacherWeeklyDashboardAsync(_selectedDate);
            _selectedDate = _dashboard.Date == default ? _selectedDate : _dashboard.Date.Date;
            SeedCurrentState();
            await LoadHistoryAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"تعذر تحميل الدروس الأسبوعية: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SeedCurrentState()
    {
        _statuses.Clear();
        _points.Clear();

        foreach (var circle in _dashboard.Circles)
        {
            foreach (var student in circle.Students)
            {
                var key = Key(circle.CurrentLessonId, student.StudentId);
                _statuses[key] = ParseStatus(student.Status);
                _points[key] = Math.Max(0, student.Points);
            }
        }
    }

    private async Task LoadHistoryAsync()
    {
        _history.Clear();
        foreach (var circle in _dashboard.Circles.Take(5))
        {
            var items = await WeeklyLessonService.GetLessonHistoryAsync(circle.CircleId, 1, 5);
            _history.AddRange(items);
        }

        _history.Sort((a, b) => b.Date.CompareTo(a.Date));
    }

    private async Task SaveCircleAsync(CircleLessonCardDto circle)
    {
        if (circle.CurrentLessonId is null || circle.CurrentLessonId == Guid.Empty)
        {
            _errorMessage = "لا يوجد درس حالي لحفظ الحضور عليه.";
            return;
        }

        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;
        try
        {
            var request = new RecordAttendanceRequest
            {
                LessonId = circle.CurrentLessonId.Value,
                Date = _selectedDate.Date,
                Entries = circle.Students.Select(student => new LessonAttendanceEntryDto
                {
                    StudentId = student.StudentId,
                    Status = GetStatus(circle.CurrentLessonId, student.StudentId),
                    Points = GetPoints(circle.CurrentLessonId, student.StudentId)
                }).ToList()
            };

            var response = await WeeklyLessonService.RecordLessonAttendanceAsync(request);
            if (response == null || !response.Success)
            {
                _errorMessage = string.IsNullOrWhiteSpace(response?.Message) ? "فشل حفظ حضور الحلقة." : response.Message;
                return;
            }

            _successMessage = string.IsNullOrWhiteSpace(response.Message) ? "تم حفظ حضور الحلقة." : response.Message;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"حدث خطأ أثناء حفظ الحضور: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void SetStatus(Guid? lessonId, Guid studentId, AttendanceStatus status) => _statuses[Key(lessonId, studentId)] = status;

    private AttendanceStatus GetStatus(Guid? lessonId, Guid studentId)
        => _statuses.TryGetValue(Key(lessonId, studentId), out var status) ? status : AttendanceStatus.Present;

    private void SetPoints(Guid? lessonId, Guid studentId, string? value)
    {
        _points[Key(lessonId, studentId)] = int.TryParse(value, out var points) ? Math.Max(0, points) : 0;
    }

    private int GetPoints(Guid? lessonId, Guid studentId)
        => _points.TryGetValue(Key(lessonId, studentId), out var points) ? points : 0;

    private string GetPresentStatusClass(Guid? lessonId, Guid studentId)
        => GetStatus(lessonId, studentId) == AttendanceStatus.Present ? "status-label present active" : "status-label present";

    private string GetAbsentStatusClass(Guid? lessonId, Guid studentId)
        => GetStatus(lessonId, studentId) == AttendanceStatus.Absent ? "status-label absent active" : "status-label absent";

    private static AttendanceStatus ParseStatus(string? status)
    {
        if (Enum.TryParse<AttendanceStatus>(status, ignoreCase: true, out var parsed))
            return parsed;

        return status switch
        {
            "حاضر" => AttendanceStatus.Present,
            "غائب" => AttendanceStatus.Absent,
            "متأخر" => AttendanceStatus.Late,
            "معذور" => AttendanceStatus.Excused,
            _ => AttendanceStatus.Present
        };
    }

    private static string Key(Guid? lessonId, Guid studentId) => $"{lessonId ?? Guid.Empty:N}:{studentId:N}";
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "غير محدد" : value;
}
