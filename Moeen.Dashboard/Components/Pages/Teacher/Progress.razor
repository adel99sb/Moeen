@page "/Teacher/Progress"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Moeen.Dashboard.Infrastructure.Http.Clients
@using Moeen.Shared.Responses.TeacherDashboard
@inject InstructorHomeApiClient TeacherApiClient

<h1>تقدم حلقاتي</h1>

@if (_isLoading)
{
    <p>جاري تحميل البيانات...</p>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <p>@_errorMessage</p>
}
else if (_progress is not null)
{
    <div>
        <p>الأستاذ: @_progress.TeacherName</p>
        <p>الحلقات: @_progress.TotalHalaqas</p>
        <p>الطلاب: @_progress.TotalStudents</p>
        <p>Progress entries: @_progress.TotalProgressEntries</p>
        <p>Average attendance: @_progress.AverageAttendanceRatePercent%</p>

        @foreach (var halaqa in _progress.Halaqas)
        {
            <div class="card p-3 mb-3">
                <h3>@halaqa.HalqaName</h3>
                <p>@halaqa.StudentsCount students - @halaqa.ProgressEntriesCount entries - attendance @halaqa.AttendanceRatePercent%</p>

                <table class="table">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Last page</th>
                            <th>Memorization</th>
                            <th>Level</th>
                            <th>Attendance</th>
                            <th>Last progress</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in halaqa.Students)
                        {
                            <tr>
                                <td>@student.StudentName</td>
                                <td>@student.LatestPageNumber</td>
                                <td>@student.MemorizationPercent%</td>
                                <td>@student.LevelScore</td>
                                <td>@student.AttendanceRatePercent%</td>
                                <td>@FormatDate(student.LastProgressDate)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private TeacherHalaqaProgressResponse? _progress;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadProgressAsync();
        StateHasChanged();
    }

    private async Task LoadProgressAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try { _progress = await TeacherApiClient.GetMyHalaqasProgressAsync(); }
        catch (Exception ex) { _errorMessage = ex.Message; }
        finally { _isLoading = false; }
    }

    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToString("yyyy/MM/dd") : "-";
}
